<!--
    Значки пунктов навигации настроек и цвета их плиток.

    Знак — контур на сетке 24×24 одним пером, с круглыми концами и углами, без заливок: пункт
    рисует его белым на цветной плитке 20 точек, сам знак — 12 точек (SettingsNavItem). Каждый
    путь начинается с «M24,24z M0,0z»: две пустые фигуры по углам сетки держат её размер, и
    Stretch="Uniform" сжимает знак вместе с полями, а не растягивает сам знак до краёв — иначе
    молния вышла бы крупнее замка.

    Цвета одни на все палитры, как в концепте: плитка — отметка раздела, а не часть темы. Соседи
    по колонке разведены по тону — в порядке новых разделов янтарь, оранжевый и золото концепта
    встали бы подряд. У белого знака на каждой плитке контраст не ниже 3:1 (SettingsNavIconTests).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общие — два ползунка. -->
    <Geometry x:Key="NavIcon.General">M24,24z M0,0z M4.5,8 L13.5,8 M17.5,8 L19.5,8 M4.5,16 L6.5,16 M10.5,16 L19.5,16 M13.5,8 A2,2 0 1 0 17.5,8 A2,2 0 1 0 13.5,8 M6.5,16 A2,2 0 1 0 10.5,16 A2,2 0 1 0 6.5,16</Geometry>
    <!-- Оформление — палитра с тремя мазками. -->
    <Geometry x:Key="NavIcon.Appearance">M24,24z M0,0z M12,3.5 A8.5,8.5 0 0 0 12,20.5 C13.3,20.5 14,19.7 14,18.7 C14,17.7 13,17.2 13,16.1 C13,15.1 13.8,14.5 14.8,14.5 L17,14.5 A3.5,3.5 0 0 0 20.5,11 C20.5,6.9 16.7,3.5 12,3.5 Z M7.6,11 L8,11 M10,7.4 L10.4,7.4 M14.4,7.6 L14.8,7.6</Geometry>
    <!-- Профиль — человек. -->
    <Geometry x:Key="NavIcon.Profile">M24,24z M0,0z M8.4,8.5 A3.6,3.6 0 1 0 15.6,8.5 A3.6,3.6 0 1 0 8.4,8.5 M5,19.5 C6.1,16.2 8.8,14.5 12,14.5 C15.2,14.5 17.9,16.2 19,19.5</Geometry>
    <!-- Модели — искра. Микросхема концепта на 12 точках слипалась ножками в пятно. -->
    <Geometry x:Key="NavIcon.Models">M24,24z M0,0z M10.5,6.5 Q11.5,12.5 17.5,13.5 Q11.5,14.5 10.5,20.5 Q9.5,14.5 3.5,13.5 Q9.5,12.5 10.5,6.5 Z M17.5,3.5 L17.5,8.5 M15,6 L20,6</Geometry>
    <!-- Промпты — реплика со строками текста. -->
    <Geometry x:Key="NavIcon.Prompts">M24,24z M0,0z M6,5 L18,5 A2,2 0 0 1 20,7 L20,14.5 A2,2 0 0 1 18,16.5 L11.5,16.5 L7.5,20 L7.5,16.5 L6,16.5 A2,2 0 0 1 4,14.5 L4,7 A2,2 0 0 1 6,5 Z M8,9.5 L16,9.5 M8,12.5 L13,12.5</Geometry>
    <!-- Инструкции — книга. -->
    <Geometry x:Key="NavIcon.Instructions">M24,24z M0,0z M6,4.5 L17,4.5 A1.5,1.5 0 0 1 18.5,6 L18.5,19.5 L7.5,19.5 A1.5,1.5 0 0 1 6,18 Z M6,16.5 A1.5,1.5 0 0 1 7.5,15 L18.5,15 M9.5,8.5 L14.5,8.5</Geometry>
    <!-- Автоматизация — молния. -->
    <Geometry x:Key="NavIcon.Automation">M24,24z M0,0z M13,3.5 L5.5,13.5 L12,13.5 L11,20.5 L18.5,10.5 L12,10.5 Z</Geometry>
    <!-- Безопасность — щит с галкой: замок теперь читался бы как пароль, а он на «Профиле». -->
    <Geometry x:Key="NavIcon.Security">M24,24z M0,0z M12,3.5 L19,6.2 L19,11.5 C19,15.6 16.2,18.9 12,20.5 C7.8,18.9 5,15.6 5,11.5 L5,6.2 Z M8.8,12.1 L11,14.3 L15.3,9.9</Geometry>
    <!-- Ключи и траты — ключ. -->
    <Geometry x:Key="NavIcon.Keys">M24,24z M0,0z M4,15 A4,4 0 1 0 12,15 A4,4 0 1 0 4,15 M11,12 L19,4 M16,7 L18.5,9.5 M14,9 L15.8,10.8</Geometry>
    <!-- Данные — хранилище. -->
    <Geometry x:Key="NavIcon.Data">M24,24z M0,0z M5,6.5 A7,3 0 1 0 19,6.5 A7,3 0 1 0 5,6.5 M5,6.5 L5,17.5 C5,19.2 8.1,20.5 12,20.5 C15.9,20.5 19,19.2 19,17.5 L19,6.5 M5,12 C5,13.7 8.1,15 12,15 C15.9,15 19,13.7 19,12</Geometry>
    <!-- О программе — «i» в круге. -->
    <Geometry x:Key="NavIcon.About">M24,24z M0,0z M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 M12,11 L12,16.5 M12,7.6 L12,7.9</Geometry>

    <SolidColorBrush x:Key="NavTile.General" Color="#FF23874F"/>
    <SolidColorBrush x:Key="NavTile.Appearance" Color="#FFC9467A"/>
    <SolidColorBrush x:Key="NavTile.Profile" Color="#FF2F72E0"/>
    <SolidColorBrush x:Key="NavTile.Models" Color="#FF6A5CDB"/>
    <SolidColorBrush x:Key="NavTile.Prompts" Color="#FF568F1A"/>
    <SolidColorBrush x:Key="NavTile.Instructions" Color="#FF1A8D9A"/>
    <SolidColorBrush x:Key="NavTile.Automation" Color="#FFD05A28"/>
    <SolidColorBrush x:Key="NavTile.Security" Color="#FF9A45B5"/>
    <SolidColorBrush x:Key="NavTile.Keys" Color="#FFA88512"/>
    <SolidColorBrush x:Key="NavTile.Data" Color="#FF56738F"/>
    <SolidColorBrush x:Key="NavTile.About" Color="#FF7A7A82"/>
</ResourceDictionary>
