<UserControl x:Class="Amarin.UI.SettingsAutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="RecipeRowTemplate">
                <Button Style="{StaticResource CardButton}" Tag="{Binding Id}" Click="Card_Click"
                        AutomationProperties.Name="{Binding Name}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardGlyphTile}">
                            <Path Data="M2,1 L11,6.5 L2,12 Z" Width="11" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource Accent.Fill}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource Text.Dim}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DescriptionVisibility}"/>
                            <TextBlock Text="{Binding Technical}" FontSize="10.5" FontFamily="Consolas" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"/>
                            <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagPill}">
                                            <TextBlock Style="{StaticResource TagText}" Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="DeleteRow_Click"
                                    ToolTip="{DynamicResource S.Common.Delete}"
                                    AutomationProperties.Name="{DynamicResource S.Common.Delete}" Margin="0,0,4,0">
                                <Path Style="{StaticResource IconGlyph}"
                                      Data="M2,4 L12,4 M5,4 L5,2 L9,2 L9,4 M3,4 L4,13 L10,13 L11,4"/>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Tag="{Binding Id}" Click="RunRow_Click"
                                    Content="{DynamicResource S.Recipe.Run}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════ СПИСОК ═══════════ -->
        <!--
            Четыре вкладки — рецепты, расписание, компьютеры и MCP: всё, что агент делает сам или
            не на этом ПК. Прежде компьютеры и MCP жили отдельной страницей «Подключения», и
            навигация не помещалась в окно. Пока у вкладки открыт редактор, заголовок и вкладки
            уходят: у редактора своя шапка «‹».
        -->
        <Grid x:Name="ListPane" Margin="20,14,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Margin="0,0,30,14"
                       Text="{DynamicResource S.Settings.Automation.Title}"/>

            <WrapPanel x:Name="TabsRow" Grid.Row="1" Margin="0,0,0,14">
                <RadioButton x:Name="RecipesTab" GroupName="AutomationTab" Style="{StaticResource PageTab}"
                             IsChecked="True" Content="{DynamicResource S.Recipe.Tab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="ScheduleTab" GroupName="AutomationTab" Style="{StaticResource PageTab}"
                             Content="{DynamicResource S.Schedule.Tab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="MachinesTab" GroupName="AutomationTab" Style="{StaticResource PageTab}"
                             Content="{DynamicResource S.Machines.Tab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="McpTab" GroupName="AutomationTab" Style="{StaticResource PageTab}"
                             Content="{DynamicResource S.Mcp.Tab}" Checked="Tab_Checked"/>
            </WrapPanel>

            <!-- Рецепты: пояснение и «Новый рецепт», поиск — когда рецептов много, список. -->
            <Grid x:Name="RecipesContent" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Шапка вкладки одной высоты и в одну строку у всех четырёх вкладок: пока описание у одних
                     переносилось на вторую строку, список при переключении вкладок прыгал вниз. -->
                <Grid Height="28" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RecipesDesc" Style="{StaticResource SettingDesc}" Margin="0,0,12,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Text="{DynamicResource S.Recipe.Desc}"/>
                    <Button x:Name="CreateButton" Grid.Column="1" Style="{StaticResource AddButton}" VerticalAlignment="Center"
                            Content="{DynamicResource S.Recipe.Create}" Click="Create_Click"/>
                </Grid>

                <Border x:Name="SearchFrame" Grid.Row="1" Style="{StaticResource FieldFrame}" Padding="9,0" Height="28"
                        Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldTextBox}" FontSize="11.5"
                                 AutomationProperties.Name="{DynamicResource S.Recipe.SearchPlaceholder}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Style="{StaticResource Placeholder}" FontSize="11.5"
                                   Text="{DynamicResource S.Recipe.SearchPlaceholder}"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource SettingDesc}" Margin="0,-4,0,10"
                           Foreground="{DynamicResource Text.Muted}" Visibility="Collapsed"/>

                <ItemsControl x:Name="RecipeItems" Grid.Row="3" ItemTemplate="{StaticResource RecipeRowTemplate}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="ItemsScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>

                <TextBlock x:Name="NothingFoundText" Grid.Row="3" Style="{StaticResource SettingDesc}" Margin="2,0,0,0"
                           VerticalAlignment="Top" Text="{DynamicResource S.Common.NothingFound}" Visibility="Collapsed"/>

                <!-- Пусто — одна строка: кнопка «Новый рецепт» уже стоит выше, второй ей не нужно. -->
                <TextBlock x:Name="EmptyState" Grid.Row="3" Style="{StaticResource SettingDesc}" Margin="0,2,0,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource Text.Faint}" Visibility="Collapsed"
                           Text="{DynamicResource S.Recipe.EmptyDesc}"/>
            </Grid>

            <local:SchedulePanel x:Name="SchedulePane" Grid.Row="2" Visibility="Collapsed"/>
            <local:MachinesPanel x:Name="MachinesPane" Grid.Row="2" Visibility="Collapsed"/>
            <local:McpPanel x:Name="McpPane" Grid.Row="2" Visibility="Collapsed"/>
        </Grid>

        <!-- ═══════════ РЕДАКТОР ═══════════ -->
        <!-- Grid, а не StackPanel: аргументы растут в строке «*», подвал с «Сохранить» стоит на месте. -->
        <Grid x:Name="EditorPane" Margin="20,12,20,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Margin="-6,0,4,0" Click="Back_Click"
                        ToolTip="{DynamicResource S.Settings.Nav.Automation}"
                        AutomationProperties.Name="{DynamicResource S.Settings.Nav.Automation}">
                    <Path Style="{StaticResource IconGlyph}" Width="7" Data="M6,1 L1,6 L6,11"/>
                </Button>
                <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource PageTitle}" Margin="0"
                           VerticalAlignment="Center" Text="{DynamicResource S.Recipe.NewTitle}"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Recipe.NameLabel}"/>
                    <Border Style="{StaticResource FieldFrame}" Height="30">
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" FontSize="12.5"
                                 AutomationProperties.Name="{DynamicResource S.Recipe.NameLabel}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Recipe.ToolLabel}"/>
                    <Border Style="{StaticResource FieldFrame}" Height="30">
                        <TextBox x:Name="ToolBox" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                 AutomationProperties.Name="{DynamicResource S.Recipe.ToolLabel}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Recipe.DescriptionLabel}"/>
                <Border Grid.Row="1" Style="{StaticResource FieldFrame}" Height="30">
                    <TextBox x:Name="DescriptionBox" Style="{StaticResource FieldTextBox}"
                             AutomationProperties.Name="{DynamicResource S.Recipe.DescriptionLabel}"/>
                </Border>
                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Recipe.ArgumentsLabel}"/>
                <Border Grid.Row="3" Style="{StaticResource FieldFrame}" Padding="10,8,4,8" MinHeight="80">
                    <TextBox x:Name="ArgumentsBox" Style="{StaticResource CodeTextBox}" VerticalAlignment="Stretch"
                             AutomationProperties.Name="{DynamicResource S.Recipe.ArgumentsLabel}"
                             TextChanged="ArgumentsBox_TextChanged"/>
                </Border>
                <TextBlock Grid.Row="4" Style="{StaticResource FieldHint}" Text="{DynamicResource S.Recipe.ArgumentsHint}"/>
            </Grid>

            <!-- Значения параметров по умолчанию: строки появляются по мере того, как в аргументах
                 появляются {{имена}}. -->
            <StackPanel x:Name="DefaultsPanel" Grid.Row="3" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Recipe.DefaultsLabel}"/>
                <ItemsControl x:Name="DefaultsList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Style="{StaticResource FieldFrame}" Height="28">
                                    <TextBox Style="{StaticResource FieldTextBox}"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding Name}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="4" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Status.Danger}" Visibility="Collapsed"/>

            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                        Content="{DynamicResource S.Common.Delete}" Click="Delete_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S.Common.Cancel}" Click="Back_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                            Content="{DynamicResource S.Common.Save}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════════ ЗАПУСК ═══════════ -->
        <Grid x:Name="RunPane" Margin="20,12,20,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Margin="-6,0,4,0" Click="Back_Click"
                        ToolTip="{DynamicResource S.Settings.Nav.Automation}"
                        AutomationProperties.Name="{DynamicResource S.Settings.Nav.Automation}">
                    <Path Style="{StaticResource IconGlyph}" Width="7" Data="M6,1 L1,6 L6,11"/>
                </Button>
                <TextBlock x:Name="RunTitle" Grid.Column="1" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="RunTechnical" Grid.Row="1" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap"/>

            <StackPanel x:Name="RunParametersPanel" Grid.Row="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Recipe.ParametersLabel}"/>
                <ItemsControl x:Name="RunParameters" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Style="{StaticResource FieldFrame}" Height="28">
                                    <TextBox Style="{StaticResource FieldTextBox}"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding Name}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.Recipe.RunHint}"/>
            </StackPanel>

            <!-- Итог запуска: вывод инструмента, можно выделить и скопировать. -->
            <Grid Grid.Row="3" x:Name="RunResultHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="RunStatusText" Style="{StaticResource FieldLabel}"/>
                <Border Grid.Row="1" Style="{StaticResource FieldFrame}" Padding="10,8,4,8">
                    <TextBox x:Name="RunOutputBox" Style="{StaticResource CodeTextBox}" IsReadOnly="True"
                             IsReadOnlyCaretVisible="False" VerticalAlignment="Stretch"
                             AutomationProperties.Name="{DynamicResource S.Recipe.Output}"/>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="EditFromRunButton" Style="{StaticResource SecondaryButton}"
                        Content="{DynamicResource S.Recipe.Edit}" Click="EditFromRun_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="ViaAgentButton" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S.Recipe.ViaAgent}" ToolTip="{DynamicResource S.Recipe.ViaAgentTip}"
                            Click="ViaAgent_Click"/>
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}"
                            Content="{DynamicResource S.Recipe.Run}" Click="Run_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
