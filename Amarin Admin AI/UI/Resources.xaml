    <Style x:Key="ToolsExpander" TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <!-- Оба были зашиты в шаблон. В ленте чата блок обязан жаться влево по своей ширине, а в
             диалоге подтверждения — растягиваться на карточку; из сеттеров это переопределяется
             у экземпляра, из шаблона не переопределялось никак. -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1" CornerRadius="8"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            MinWidth="{TemplateBinding MinWidth}">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded,
                                RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeadBg" Background="Transparent"
                                                CornerRadius="8" Padding="10,7">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Chevron"
                                                      Data="M0,0 L4,4 L0,8"
                                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="5" Height="9" Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Margin="1,0,9,0"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeadBg" Property="Background" Value="{DynamicResource Bg.Card}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>
                            <Border x:Name="Body" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
                                    Padding="8,5,10,7">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
