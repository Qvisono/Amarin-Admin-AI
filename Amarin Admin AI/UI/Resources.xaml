        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1" CornerRadius="8"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            MinWidth="{TemplateBinding MinWidth}">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded,
                                RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeadBg" Background="Transparent"
                                                CornerRadius="8" Padding="10,7">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Chevron"
                                                      Data="M0,0 L4,4 L0,8"
                                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="5" Height="9" Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Margin="1,0,9,0"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeadBg" Property="Background" Value="{DynamicResource Bg.Card}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>
                            <Border x:Name="Body" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
                                    Padding="8,5,10,7">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ExpanderHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
    </Style>
    <Style x:Key="ActionsRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    <Style x:Key="MsgActionButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.28"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MsgActionIcon" TargetType="Image">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <Style x:Key="LockChromeCloseButton" TargetType="Button" BasedOn="{StaticResource LockChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent">
                        <Viewbox Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="icon"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{DynamicResource Text.Bright}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Status.DangerStrong}"/>
                            <Setter TargetName="icon" Property="Fill" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Плашка «домен заблокирован» под неудачной загрузкой ===== -->
    <Style x:Key="BlockedDomainNotice" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Status.WarningSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Status.WarningBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="24,4,4,6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!--
        Рамка фокуса с клавиатуры (I1) — цветом акцента, а не системный пунктир: тот на тёмных
        темах почти не виден. Ставит её AccessibilityDefaults всем элементам, у которых своей нет.
    -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1.5" RadiusX="6" RadiusY="6"
                               Stroke="{DynamicResource Accent.Fill}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InlineLinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="7,2">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Status.Warning}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Кнопки модальных диалогов (подтверждение, добавление домена) ===== -->
    <Style x:Key="DialogSecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5"
                                   Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <!-- Выключенная кнопка обязана это показывать: иначе «Спросить» или
                             «Откатить», пока идёт работа, выглядят сломанными, а не занятыми. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Та же вторичная кнопка, но с выпадашкой: «Разрешить…» в окне подтверждения. -->
    <Style x:Key="DialogSecondaryToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5"
                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="8" Height="5" Stretch="Uniform" Margin="7,1,0,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт выпадашки диалога: название и строка пояснения под ним. -->
    <Style x:Key="DialogMenuItemButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="10,7">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ДИАЛОГ: ОБЩИЙ ВИД ═══════════ -->
    <!--
        Все всплывающие окна собираются из этих кусков: карточка, заголовок, при нужде одна
        строка текста, поля с подписью сверху и подвал — слева строка состояния или ошибки,
        справа кнопки. До 1.28.0 каждое окно рисовалось своими полями и отступами, в каждом был
        абзац пояснений, а ошибка вставала под полем и меняла высоту окна: окно по центру
        экрана от этого подпрыгивало. В подвале ей место есть всегда.
    -->
    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Width" Value="400"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="22,20,22,18"/>
    </Style>

    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DialogText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="DialogLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>

    <Style x:Key="DialogField" TargetType="Border">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Поле диалога. Подсказка в пустом поле — из Tag: так ей не нужен ни свой код, ни имя поля. -->
    <Style x:Key="DialogInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Fill}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}" Foreground="{DynamicResource Text.Faint}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogPasswordInput" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Fill}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Строка подвала слева от кнопок: «Проверяю…» или ошибка. Место под неё есть всегда. -->
    <Style x:Key="DialogStatus" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <Style x:Key="DialogError" TargetType="TextBlock" BasedOn="{StaticResource DialogStatus}">
        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
    </Style>

    <!-- Подвал: волосок сверху не нужен, хватает воздуха. -->
    <Style x:Key="DialogFooter" TargetType="Grid">
        <Setter Property="Margin" Value="0,22,0,0"/>
    </Style>

    <!--
        Выбор из двух-трёх вариантов в диалоге — сегментами во всю ширину, как вкладки настроек.
        Полужирная копия-невидимка держит ширину подписи: выбор не сдвигает соседей.
    -->
    <Style x:Key="DialogSegment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="8" Padding="12,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Visibility="Hidden"/>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12.5"
                                       Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Необратимое действие: та же вторичная кнопка, только подпись красная. -->
    <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Кружок цвета тега: содержимое — сам кружок, выбранный обведён кольцом. -->
    <Style x:Key="TagSwatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                        <ContentPresenter Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ссылка в строке подписи поля: «Где взять» и т. п. -->
    <Style x:Key="DialogLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                               Foreground="{DynamicResource Text.Dim}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ГАЛОЧКА И КАРТОЧКА ВЫБОРА В ДИАЛОГАХ ═══════════ -->
    <!-- Живут здесь, а не в SettingsOverlay.Resources: окна экспорта и импорта лежат на
         верхнем уровне MainWindow, рядом с DomainOverlay, и до ресурсов страницы настроек
         не дотянутся.

         Настоящая квадратная галочка в программе появилась только здесь: все CheckBox до
         этого перерисованы в тумблер SettingsToggle, а тумблер в списке «что положить в
         архив» читается как пять независимых настроек, а не как выбор из набора. -->

    <Style x:Key="DialogCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Кликается вся строка, а не квадрат 16×16: попасть мышью в подпись
                         заметно легче, а промах по галочке здесь ничего не переключает. -->
                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    VerticalAlignment="Top" Margin="0,1,10,0"
                                    Background="{DynamicResource Bg.Card}"
                                    BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1">
                                <Path x:Name="Tick" Data="M0,3.2 L2.8,6 L8,0.6"
                                      Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform"
                                      Width="9" Height="7" Opacity="0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.FillHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Выбор из двух режимов карточками, а не точками: под каждым вариантом стоит описание
         в две строки, и точка рядом с абзацем теряется. -->
    <Style x:Key="DialogChoiceCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" Background="{DynamicResource Bg.Card}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ПОДСКАЗКИ ═══════════ -->
    <!--
        Неявный стиль: почти все подсказки в программе присвоены обычной строкой, и без него
        Windows рисовала под них свой жёлто-белый прямоугольник системным шрифтом - единственное
        место, где из программы выглядывала чужая эпоха.

        Форма - та же карточка со стрелкой, что у разбивки цены над ответом
        (CostBreakdownTooltip.Chrome) и у предупреждения о правах в шапке: фон Bg.Card, рамка
        Border.Default, скругление 8, поля 10/8. Эти три плашки человек видит рядом друг с другом,
        и выглядеть они обязаны одинаково.

        Тени здесь нет намеренно. Раньше её рисовал Border внутри шаблона, а поля вокруг него
        держали для неё место - но размытие 16 с отступом 4 выносит тень на ~10.8 пикселя вправо
        и вниз при запасе 8 и 10. Поля входят в размер подсказки, окно попапа режется ровно по
        ним, и человек видел тень, срезанную прямой линией по правому краю. Карточка с рамкой
        читается на любом фоне и без тени, а резать в ней нечего.

        HasDropShadow=False остаётся: системная тень легла бы под прозрачную подсказку
        прямоугольником - мимо скругления и мимо стрелки.

        Две подсказки в программе задают свой Template прямо на объекте - предупреждение о правах
        в шапке и разбивка цены над ответом. Локальное значение сильнее сеттера стиля, поэтому
        их этот стиль не трогает; на это есть тест.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="6"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Стрелка по центру: подсказка встаёт по центру под своей целью
                             (UiScale.PlaceUnderTarget), и только из середины она показывает
                             на то, на что навели. Минус пиксель снизу прячет стык её обводки
                             с рамкой карточки: иначе на склейке видна лишняя черта. -->
                        <!-- Bg.Panel, а не Bg.Card: подсказка — своё окно, и полупрозрачный в
                             «стекле» Bg.Card показывал бы сквозь неё рабочий стол. -->
                        <Path Grid.Row="0"
                              Data="M0,6 L6,0 L12,6 Z"
                              Fill="{DynamicResource Bg.Panel}"
                              Stroke="{DynamicResource Border.Default}"
                              StrokeThickness="1"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,-1"/>

                        <Border Grid.Row="1"
                                Background="{DynamicResource Bg.Panel}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <!--
                                        Своя разметка для строки. Почти все подсказки в программе -
                                        обычные строки, и ContentPresenter завернул бы их в TextBlock
                                        без переноса: TextWrapping не наследуется, задать его снаружи
                                        нечем. А подсказки у файлов, ссылок и записей журнала несут
                                        путь целиком - одной строкой карточка уезжала бы за край экрана
                                        мимо MaxWidth.
                                    -->
                                    <DataTemplate DataType="{x:Type system:String}">
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="15"
                                                   LineStackingStrategy="BlockLineHeight"/>
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ КОНТЕКСТНОЕ МЕНЮ ═══════════ -->
    <!-- Форма взята у ActionsPopup и ModelPickerPanel, чтобы меню читалось как часть
         программы, а не как системное. HasDropShadow=True обязателен: без него Popup меню
         не получает AllowsTransparency, и скругление срежется по прямоугольнику. -->

    <!-- Тень и поля под неё — общие (PopupShadow); смещение возвращает карточку туда, где она
         вставала с прежними полями 10,6: на 10 правее и на 6 ниже точки, где открыли меню. -->
    <Style x:Key="AppContextMenu" TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalOffset" Value="-6"/>
        <Setter Property="VerticalOffset" Value="-10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="{x:Static local:PopupShadow.Margin}" MinWidth="180"
                            Background="{DynamicResource Bg.Panel}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="10" Padding="6"
                            Effect="{x:Static local:PopupShadow.Effect}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppMenuItem" TargetType="MenuItem">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Свой шаблон целиком: штатный держит слева колонку под галочки и иконки
                     даже пустой, и текст уезжает вправо от края панели. Здесь колонка значка
                     есть только у пункта со значком (MenuIcon.Data). -->
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="9,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Icon" Width="16" Height="16" Margin="0,0,9,0" Stretch="None"
                                  VerticalAlignment="Center" Opacity="0.85"
                                  Data="{Binding Path=(local:MenuIcon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <ContentPresenter x:Name="Label" Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:MenuIcon.Data" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Необратимое действие: красный текст, и заливка только под курсором, чтобы пункт
         не выглядел тревожно, пока на него не навелись. -->
    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="9,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Icon" Width="16" Height="16" Margin="0,0,9,0" Stretch="None"
                                  VerticalAlignment="Center"
                                  Data="{Binding Path=(local:MenuIcon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <ContentPresenter x:Name="Label" Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:MenuIcon.Data" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Status.DangerStrong}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppMenuSeparator" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Background" Value="{DynamicResource Border.Subtle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ЦИТАТЫ: «ОТВЕТИТЬ» НА ФРАГМЕНТ ОТВЕТА ═══════════ -->
    <!-- Кнопки плашки «Ответить» и строк подсказки «@». Фокус им не нужен: нажатие не должно
         уводить его из ответа (выделение погасло бы) или из поля ввода (каретка ушла бы). -->

    <Style x:Key="QuotePillButton" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="9,0,10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Номер цитаты «@N»: один вид в поле ввода, в подсказке и в пузыре сообщения. -->
    <!-- Отметка «по инструкции» над ответом модели: пилюля, которая открывает инструкцию. -->
    <Style x:Key="InstructionChip" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="11" Padding="9,3,10,3">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuoteBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Elevated}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="QuoteBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
    </Style>
</ResourceDictionary>
