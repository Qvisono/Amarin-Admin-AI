<Window x:Class="Amarin.UI.NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        Title="Amarin">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <!-- Design-time only; the runtime theme comes from ThemeManager. -->
                <ResourceDictionary d:Source="Theme/Palette.Dark.xaml"/>
                <ResourceDictionary d:Source="Theme/Icons.Dark.xaml"/>
                <ResourceDictionary d:Source="Theme/AiLogos.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin leaves room for the card's drop shadow. -->
    <Grid Margin="30">
        <Grid.Resources>
            <Storyboard x:Key="ToastIn">
                <DoubleAnimation Storyboard.TargetName="Card"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Slide"
                                 Storyboard.TargetProperty="Y"
                                 From="18" To="0" Duration="0:0:0.24">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="ToastOut">
                <DoubleAnimation Storyboard.TargetName="Card"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Slide"
                                 Storyboard.TargetProperty="Y"
                                 To="12" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <!--
            Opacity starts at 1 on purpose. ToastIn only animates it from 0, so if the
            storyboard ever fails to start the card must still be on screen.
        -->
        <Border x:Name="Card" Width="330" Opacity="1"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="12" Padding="14,12" Cursor="Hand"
                MouseLeftButtonUp="Card_MouseLeftButtonUp"
                MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource AiLogoBorder}" VerticalAlignment="Top"
                        Margin="0,1,10,0">
                    <Grid>
                        <Image x:Name="Logo" Width="18" Height="18"/>
                        <TextBlock x:Name="LogoLetter" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Title2" Text="Ответ готов" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Body}"/>
                    <TextBlock x:Name="Preview" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" MaxHeight="34"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Meta" FontSize="11" Margin="0,5,0,0"
                               Foreground="{DynamicResource Text.Faint}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button x:Name="CloseButton" Grid.Column="2" Width="20" Height="20"
                        VerticalAlignment="Top" Margin="8,0,0,0" Cursor="Hand"
                        ToolTip="Закрыть" Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <Path x:Name="Icon" Data="M0,0 L8,8 M8,0 L0,8"
                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="8" Height="8" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Primary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
