<UserControl x:Class="Amarin.UI.HealthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Точка и подпись итога: цвет — по имени значения HealthStatus. -->
            <Style x:Key="ToneDot" TargetType="Ellipse">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{DynamicResource Text.Faint}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Ok">
                        <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Attention">
                        <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Problem">
                        <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Overlay.Scrim}" MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border x:Name="Card" Width="640" MaxHeight="580"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="20,16,20,18">
                <!-- Grid, а не StackPanel: карточки растут в прокручиваемой строке «*». -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource S.Health.Title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"/>
                                <Border x:Name="OverallPill" Margin="10,0,0,0" Padding="8,1,9,2" CornerRadius="9"
                                        VerticalAlignment="Center" Background="{DynamicResource Bg.Raised}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ToneDot}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{DynamicResource Text.Muted}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="UpdatedText" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Faint}"/>
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" VerticalAlignment="Top"
                                Content="{DynamicResource S.Health.Refresh}" Click="Refresh_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                                Click="Close_Click" ToolTip="{DynamicResource S.Common.Close}"
                                AutomationProperties.Name="{DynamicResource S.Common.Close}">
                            <Path Style="{StaticResource IconGlyph}" Width="9" Height="9" Data="M0,0 L8,8 M8,0 L0,8"/>
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="CardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
                        <ItemsControl x:Name="Cards" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="12,10" CornerRadius="9"
                                            Background="{DynamicResource Bg.Card}" BorderThickness="1"
                                            BorderBrush="{DynamicResource Border.Default}" MinHeight="118">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource ToneDot}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource Text.Muted}"/>
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Facts}" Margin="0,6,0,0" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"
                                                                   Margin="0,0,0,3" Foreground="{DynamicResource Text.Body}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,6,0,0"
                                                    Style="{StaticResource SecondaryButton}" Tag="{Binding Area}"
                                                    Content="{DynamicResource S.Health.Ask}" Click="Ask_Click"
                                                    Visibility="{Binding AskVisibility}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
