<UserControl x:Class="Amarin.UI.HealthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Цвет — только у того, что требует внимания: значение «в порядке» пишется обычным
                текстом, «не проверено» — бледным. Tone — имя значения HealthStatus или «Loading».
            -->
            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Attention">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Problem">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Unknown">
                        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Loading">
                        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BarFill" TargetType="Border">
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Background" Value="{DynamicResource Text.Dim}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Attention">
                        <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Problem">
                        <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ToneDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource Text.Faint}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Ok">
                        <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Attention">
                        <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Problem">
                        <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        «Состояние ПК» (C4) — сводка, как «Сведения о системе»: под заголовком одна строка итога,
        ниже пять разделов строками «подпись — значение». Цвет только у значений, которые требуют
        внимания; у дисков — полоска заполненности, как в Проводнике. «Разобраться» стоит у
        заголовка раздела, где есть на что смотреть. Прежде были карточки с плитками-значками и
        словом статуса на каждой строке, и панель читалась отчётом, а не сводкой.
    -->
    <Grid>
        <Border Background="{DynamicResource Overlay.Scrim}" MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>
        <!-- Прижата к верху, под кнопкой «Состояние ПК»: строки доезжают по одной, и панель по
             центру при каждой из них сдвигалась бы целиком, а так растёт только вниз. -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24,56,24,24" VerticalAlignment="Top">
            <Border x:Name="Card" Width="440" MaxHeight="700"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="20,16,20,18">
                <!-- Grid, а не StackPanel: список растёт в прокручиваемой строке «*». -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Health.Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <!-- Итог: точка цветом худшего, одна фраза и когда проверено; длинный — переносится. -->
                            <Grid x:Name="Summary" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource ToneDot}" Width="7" Height="7" Margin="1,6,7,0"
                                         VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}">
                                    <Run Text="{Binding Title, Mode=OneWay}"/><Run x:Name="UpdatedText" Foreground="{DynamicResource Text.Faint}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="0,0,2,0"
                                VerticalAlignment="Top"
                                Click="Refresh_Click" ToolTip="{DynamicResource S.Health.Refresh}"
                                AutomationProperties.Name="{DynamicResource S.Health.Refresh}">
                            <Path Style="{StaticResource IconGlyph}" Width="12" Height="12"
                                  Data="M11.5,6 A5,5 0 1 1 10,2.5 M10.5,0.5 L10.5,3 L8,3"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                                Click="Close_Click" ToolTip="{DynamicResource S.Common.Close}"
                                AutomationProperties.Name="{DynamicResource S.Common.Close}">
                            <Path Style="{StaticResource IconGlyph}" Width="9" Height="9" Data="M0,0 L8,8 M8,0 L0,8"/>
                        </Button>
                    </Grid>

                    <!-- Полоса прокрутки — в правом поле карточки, а не поверх значений. -->
                    <ScrollViewer x:Name="CardsScroll" Grid.Row="1" Margin="0,14,-14,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Cards" Focusable="False" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsDivider}" Margin="0,10" Visibility="{Binding DividerVisibility}"/>
                                        <!-- Заголовок раздела; высота — по кнопке, чтобы разделы с ней и без неё шли ровно. -->
                                        <Grid MinHeight="24" Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="24"
                                                    Tag="{Binding Area}" Content="{DynamicResource S.Health.Ask}" Click="Ask_Click"
                                                    Visibility="{Binding AskVisibility}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Строка без значения (проверка идёт, снимок прежней версии) —
                                                             во всю ширину, иначе длинная фраза не перенеслась бы. -->
                                                        <TextBlock Style="{StaticResource LabelText}" Text="{Binding Label}"
                                                                   Grid.ColumnSpan="{Binding LabelSpan}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Value}"
                                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        <!--
                                                            Полоска заполненности — под строкой во всю ширину, как в
                                                            Проводнике: рядом с текстом её длина зависела бы от длины
                                                            «свободно из», и у двух дисков полоски вышли бы разными.
                                                        -->
                                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Height="4" Margin="0,6,0,2"
                                                              Visibility="{Binding BarVisibility}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding UsedWidth}"/>
                                                                <ColumnDefinition Width="{Binding FreeWidth}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource Bg.Track}"/>
                                                            <Border Style="{StaticResource BarFill}"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
