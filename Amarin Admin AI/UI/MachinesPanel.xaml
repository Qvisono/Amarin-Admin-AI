<UserControl x:Class="Amarin.UI.MachinesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Вкладка «Компьютеры» страницы Automation (C10): удалённые машины для PowerShell Remoting. -->
    <Grid>
        <!-- ═══════════ СПИСОК ═══════════ -->
        <Grid x:Name="ListPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Высота и одна строка — общие с остальными вкладками Automation, иначе список прыгает. -->
            <Grid Height="28" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,12,0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Text="{DynamicResource S.Machines.Desc}"/>
                <Button Grid.Column="1" Style="{StaticResource AddButton}" VerticalAlignment="Center"
                        Content="{DynamicResource S.Machines.Add}" Click="Add_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="MachineItems" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}" Tag="{Binding Id}" Click="Card_Click"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardGlyphTile}">
                                            <Path Data="M1,1 L13,1 L13,9 L1,9 Z M5,12 L9,12 M7,9 L7,12" Width="13" Height="12" Stretch="Uniform"
                                                  Stroke="{DynamicResource Text.Muted}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="Consolas" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Probe}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Muted}" Visibility="{Binding ProbeVisibility}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Tag="{Binding Id}"
                                                VerticalAlignment="Center" Margin="12,0,0,0"
                                                Content="{DynamicResource S.Machines.Test}" Click="Test_Click"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyState" Style="{StaticResource SettingDesc}" Margin="0,2,0,0"
                               Foreground="{DynamicResource Text.Faint}" Visibility="Collapsed"
                               Text="{DynamicResource S.Machines.EmptyDesc}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════ РЕДАКТОР ═══════════ -->
        <Grid x:Name="EditorPane" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,30,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Margin="-6,0,4,0" Click="Back_Click"
                        ToolTip="{DynamicResource S.Common.Back}"
                        AutomationProperties.Name="{DynamicResource S.Common.Back}">
                    <Path Style="{StaticResource IconGlyph}" Width="7" Data="M6,1 L1,6 L6,11"/>
                </Button>
                <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource PageTitle}" Margin="0"
                           VerticalAlignment="Center" Text="{DynamicResource S.Machines.NewTitle}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Machines.NameLabel}"/>
                    <Border Style="{StaticResource FieldFrame}" Height="30">
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}"
                                 AutomationProperties.Name="{DynamicResource S.Machines.NameLabel}"/>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Machines.AddressLabel}"/>
                    <Border Style="{StaticResource FieldFrame}" Height="30">
                        <TextBox x:Name="AddressBox" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                 AutomationProperties.Name="{DynamicResource S.Machines.AddressLabel}"/>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Machines.MethodLabel}"/>
                    <WrapPanel>
                        <RadioButton x:Name="MethodWinRm" GroupName="RemoteMethod" Style="{StaticResource PageTab}"
                                     IsChecked="True" Content="WinRM" Checked="Method_Checked"/>
                        <RadioButton x:Name="MethodSsh" GroupName="RemoteMethod" Style="{StaticResource PageTab}"
                                     Content="SSH" Checked="Method_Checked"/>
                    </WrapPanel>
                    <TextBlock x:Name="MethodHint" Style="{StaticResource FieldHint}" Text="{DynamicResource S.Machines.WinRmHint}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Machines.UserLabel}"/>
                    <Border Style="{StaticResource FieldFrame}" Height="30">
                        <TextBox x:Name="UserBox" Style="{StaticResource FieldTextBox}"
                                 AutomationProperties.Name="{DynamicResource S.Machines.UserLabel}"/>
                    </Border>

                    <StackPanel x:Name="PasswordRow">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Machines.PasswordLabel}"/>
                        <Border Style="{StaticResource FieldFrame}" Height="30">
                            <PasswordBox x:Name="PasswordBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                         VerticalContentAlignment="Center" Foreground="{DynamicResource Text.Bright}"
                                         CaretBrush="{DynamicResource Text.Bright}"
                                         AutomationProperties.Name="{DynamicResource S.Machines.PasswordLabel}"/>
                        </Border>
                        <TextBlock x:Name="PasswordHint" Style="{StaticResource FieldHint}" Text="{DynamicResource S.Machines.PasswordHint}"/>
                    </StackPanel>

                    <StackPanel x:Name="KeyRow" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Machines.KeyLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FieldFrame}" Height="30">
                                <TextBox x:Name="KeyBox" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                         AutomationProperties.Name="{DynamicResource S.Machines.KeyLabel}"/>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                    Content="{DynamicResource S.Machines.Browse}" Click="BrowseKey_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="ErrorText" Grid.Row="2" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Status.Danger}" Visibility="Collapsed"/>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                        Content="{DynamicResource S.Common.Delete}" Click="Delete_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S.Common.Cancel}" Click="Back_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.Common.Save}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
