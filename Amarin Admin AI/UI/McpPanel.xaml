<UserControl x:Class="Amarin.UI.McpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════ СПИСОК ═══════════ -->
        <Grid x:Name="ListPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,12,0" VerticalAlignment="Center"
                           Text="{DynamicResource S.Mcp.Desc}"/>
                <Button Grid.Column="1" Style="{StaticResource AddButton}" VerticalAlignment="Top"
                        Content="{DynamicResource S.Mcp.Add}" Click="Add_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="ServerItems" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}" Tag="{Binding Id}" Click="Card_Click"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="Consolas" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Muted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Id}"
                                                      Click="Toggle_Click"
                                                      AutomationProperties.Name="{DynamicResource S.Mcp.EnabledLabel}"/>
                                            <Button Style="{StaticResource SecondaryButton}" Tag="{Binding Id}" Margin="0,8,0,0"
                                                    Content="{DynamicResource S.Machines.Test}" Click="Probe_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyState" Margin="0,4,0,0" Padding="24,22" CornerRadius="10"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            Background="{DynamicResource Bg.Card}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="{DynamicResource S.Mcp.EmptyTitle}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Body}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource SettingDesc}" TextAlignment="Center" Margin="0,5,0,0"
                                       Text="{DynamicResource S.Mcp.EmptyDesc}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════ РЕДАКТОР ═══════════ -->
        <Grid x:Name="EditorPane" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Margin="-6,0,4,0" Click="Back_Click"
                        ToolTip="{DynamicResource S.Mcp.Tab}" AutomationProperties.Name="{DynamicResource S.Mcp.Tab}">
                    <Path Style="{StaticResource IconGlyph}" Width="7" Data="M6,1 L1,6 L6,11"/>
                </Button>
                <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource PageTitle}" VerticalAlignment="Center"
                           Text="{DynamicResource S.Mcp.NewTitle}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.NameLabel}"/>
                    <Border Style="{StaticResource FieldFrame}" Height="30">
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}"
                                 AutomationProperties.Name="{DynamicResource S.Mcp.NameLabel}"/>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.TransportLabel}"/>
                    <WrapPanel>
                        <RadioButton x:Name="TransportStdio" GroupName="McpTransport" Style="{StaticResource ChipRadio}"
                                     IsChecked="True" Content="{DynamicResource S.Mcp.Stdio}" Checked="Transport_Checked"/>
                        <RadioButton x:Name="TransportHttp" GroupName="McpTransport" Style="{StaticResource ChipRadio}"
                                     Content="HTTP" Checked="Transport_Checked"/>
                    </WrapPanel>

                    <StackPanel x:Name="StdioRows">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.CommandLabel}"/>
                        <Border Style="{StaticResource FieldFrame}" Height="30">
                            <TextBox x:Name="CommandBox" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                     AutomationProperties.Name="{DynamicResource S.Mcp.CommandLabel}"/>
                        </Border>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.ArgumentsLabel}"/>
                        <Border Style="{StaticResource FieldFrame}" Padding="10,6,4,6" Height="70">
                            <TextBox x:Name="ArgumentsBox" Style="{StaticResource CodeTextBox}"
                                     AutomationProperties.Name="{DynamicResource S.Mcp.ArgumentsLabel}"/>
                        </Border>
                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.Mcp.ArgumentsHint}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.EnvLabel}"/>
                        <Border Style="{StaticResource FieldFrame}" Padding="10,6,4,6" Height="60">
                            <TextBox x:Name="EnvBox" Style="{StaticResource CodeTextBox}"
                                     AutomationProperties.Name="{DynamicResource S.Mcp.EnvLabel}"/>
                        </Border>
                        <TextBlock x:Name="EnvHint" Style="{StaticResource FieldHint}" Text="{DynamicResource S.Mcp.EnvHint}"/>
                    </StackPanel>

                    <StackPanel x:Name="HttpRows" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.UrlLabel}"/>
                        <Border Style="{StaticResource FieldFrame}" Height="30">
                            <TextBox x:Name="UrlBox" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                     AutomationProperties.Name="{DynamicResource S.Mcp.UrlLabel}"/>
                        </Border>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.AuthLabel}"/>
                        <Border Style="{StaticResource FieldFrame}" Height="30">
                            <PasswordBox x:Name="AuthBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                         VerticalContentAlignment="Center" Foreground="{DynamicResource Text.Bright}"
                                         CaretBrush="{DynamicResource Text.Bright}"
                                         AutomationProperties.Name="{DynamicResource S.Mcp.AuthLabel}"/>
                        </Border>
                        <TextBlock x:Name="AuthHint" Style="{StaticResource FieldHint}" Text="{DynamicResource S.Mcp.AuthHint}"/>
                    </StackPanel>

                    <StackPanel x:Name="ToolsSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mcp.ToolsLabel}"/>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="1,0,0,6" Text="{DynamicResource S.Mcp.ReadOnlyHint}"/>
                        <StackPanel x:Name="ToolRows"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="ErrorText" Grid.Row="2" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Status.Danger}" Visibility="Collapsed"/>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                        Content="{DynamicResource S.Common.Delete}" Click="Delete_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S.Common.Cancel}" Click="Back_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.Common.Save}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
