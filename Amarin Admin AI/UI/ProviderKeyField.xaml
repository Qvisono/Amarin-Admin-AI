<UserControl x:Class="Amarin.UI.ProviderKeyField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="170" Height="28">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Те же формы, что у плашки выбора модели: это соседние строки одной страницы,
                 и расходиться им незачем. Свои копии, а не общие: обе плашки держат стили
                 при себе, и вынос в общий словарь тронул бы оформление всей программы. -->
            <Style x:Key="PickerGroupHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                <Setter Property="Margin" Value="8,2,6,4"/>
            </Style>

            <Style x:Key="ChoiceItem" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PickerAddKeyButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="8,6,6,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6" Padding="12,0">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.OnAccent}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="OpenButton" Cursor="Hand" Focusable="False" ClickMode="Press">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="8" Height="4" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Grid Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedLabel" FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SelectedKeyLabel" Grid.Column="1" FontSize="11"
                       Margin="6,0,0,0" Foreground="{DynamicResource Text.Faint}"
                       TextTrimming="CharacterEllipsis" MaxWidth="90"
                       Visibility="Collapsed"/>
        </Grid>

        <Popup x:Name="ChoicePopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Opened="ChoicePopup_Opened"
               IsOpen="{Binding IsChecked, ElementName=OpenButton, Mode=TwoWay}">
            <Border Width="470" Height="228" Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PickerGroupHeader}"
                                   Text="{DynamicResource S.Models.ProviderColumn}"/>
                        <ScrollViewer x:Name="ProviderScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                            <StackPanel x:Name="ProviderItems"/>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" Background="{DynamicResource Border.Subtle}"/>

                    <DockPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PickerGroupHeader}"
                                   Text="{DynamicResource S.Models.KeyColumn}"/>
                        <Button x:Name="AddKeyButton" DockPanel.Dock="Bottom"
                                Style="{StaticResource PickerAddKeyButton}"
                                Content="{DynamicResource S.Models.AddKey}"
                                Click="AddKeyButton_Click" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="KeyScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                            <StackPanel x:Name="KeyItems"/>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="3" Background="{DynamicResource Border.Subtle}"/>

                    <!-- Движок есть только у OpenRouter: у Venice поиск один. Столбец всё равно
                         показывается всегда — выбор действует и когда провайдер не закреплён,
                         если ход и так идёт у OpenRouter. -->
                    <DockPanel Grid.Column="4" Margin="5,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PickerGroupHeader}"
                                   Text="{DynamicResource S.Models.EngineColumn}"/>
                        <ScrollViewer x:Name="EngineScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                            <StackPanel x:Name="EngineItems"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
