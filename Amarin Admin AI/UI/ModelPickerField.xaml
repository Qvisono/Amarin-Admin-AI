<UserControl x:Class="Amarin.UI.ModelPickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI"
             MinWidth="170" Height="28">
    <Grid>
        <ToggleButton x:Name="OpenButton" Cursor="Hand" Focusable="False" ClickMode="Press">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="8" Height="4" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <!-- Двумя элементами, а не двумя Run в одном: TextBlock.Text при сложном содержимом
             отдаёт пустую строку, и подпись становится недоступна и коду, и тестам. -->
        <Grid Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedLabel" FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
            <!-- Свёрнута до первого показа: ключ по умолчанию именем не подписывается, а
                 пустая видимая подпись роняет проверку «ни одной пустой надписи». -->
            <TextBlock x:Name="SelectedKeyLabel" Grid.Column="1" FontSize="11"
                       Margin="6,0,0,0" Foreground="{DynamicResource Text.Faint}"
                       TextTrimming="CharacterEllipsis" MaxWidth="90"
                       Visibility="Collapsed"/>
        </Grid>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Opened="PickerPopup_Opened"
               IsOpen="{Binding IsChecked, ElementName=OpenButton, Mode=TwoWay}">
            <local:ModelPickerPanel x:Name="Panel"
                                    AllowAuto="{Binding AllowAuto, RelativeSource={RelativeSource AncestorType=local:ModelPickerField}}"
                                    AutoTipKey="{Binding AutoTipKey, RelativeSource={RelativeSource AncestorType=local:ModelPickerField}}"
                                    ModelPicked="Panel_ModelPicked"
                                    KeyPicked="Panel_KeyPicked"
                                    AddKeyRequested="Panel_AddKeyRequested"
                                    ProviderShown="Panel_ProviderShown"/>
        </Popup>
    </Grid>
</UserControl>
