<UserControl x:Class="Amarin.UI.ChatFindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Bar_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Width="360" Height="38" Padding="10,0,4,0" CornerRadius="10"
            Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Path Data="M5.5,1 A4.5,4.5 0 1 1 5.49,1 Z M9,9 L13,13" Width="12" Height="12" Stretch="Uniform"
                  Stroke="{DynamicResource Text.Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="QueryBox" Style="{StaticResource FieldTextBox}" FontSize="12.5"
                         AutomationProperties.Name="{DynamicResource S.Find.Placeholder}"
                         TextChanged="QueryBox_TextChanged"/>
                <TextBlock x:Name="Placeholder" Style="{StaticResource Placeholder}" FontSize="12.5"
                           Text="{DynamicResource S.Find.Placeholder}"/>
            </Grid>
            <TextBlock x:Name="CountText" Grid.Column="2" FontSize="11.5" Margin="8,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Faint}"/>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="Older_Click"
                    ToolTip="{DynamicResource S.Find.Older}" AutomationProperties.Name="{DynamicResource S.Find.Older}">
                <Path Style="{StaticResource IconGlyph}" Width="10" Height="6" Data="M1,6 L6,1 L11,6"/>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource IconButton}" Click="Newer_Click"
                    ToolTip="{DynamicResource S.Find.Newer}" AutomationProperties.Name="{DynamicResource S.Find.Newer}">
                <Path Style="{StaticResource IconGlyph}" Width="10" Height="6" Data="M1,1 L6,6 L11,1"/>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource IconButton}" Click="Close_Click"
                    ToolTip="{DynamicResource S.Common.Close}" AutomationProperties.Name="{DynamicResource S.Common.Close}">
                <Path Style="{StaticResource IconGlyph}" Width="8" Height="8" Data="M0,0 L8,8 M8,0 L0,8"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
