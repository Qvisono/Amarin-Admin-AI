<UserControl x:Class="Amarin.UI.LanguagePickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="170" Height="28">
    <UserControl.Resources>
        <!-- Пункт списка. Форма взята у ModelItem из пикера моделей, чтобы обе выпадашки
             читались как одна программа. -->
        <Style x:Key="LanguageItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="OpenButton" Cursor="Hand" Focusable="False" ClickMode="Press">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="8" Height="4" Stretch="Uniform"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <TextBlock x:Name="SelectedLabel" Foreground="{DynamicResource Text.Secondary}" FontSize="12"
                   Margin="10,0,26,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               VerticalOffset="4"
               HorizontalOffset="-40"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=OpenButton, Mode=TwoWay}">
            <!-- Bg.Panel, а не Bg.Glass: у попапа своё окно, и сквозь «стекло» был бы виден
                 рабочий стол, а не фон приложения. -->
            <Border Width="230" Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                    CornerRadius="10" Padding="6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LanguageList"/>
                    </ScrollViewer>

                    <Border Height="1" Margin="4,6" Background="{DynamicResource Bg.Hover}"/>

                    <Button x:Name="NewLanguageButton" Style="{StaticResource LanguageItem}"
                            Click="NewLanguageButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M7,0 L7,14 M0,7 L14,7" Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{DynamicResource Accent.Fill}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource S.Language.New}" FontSize="12.5"
                                       Foreground="{DynamicResource Accent.Fill}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="ProgressText" FontSize="11" Margin="9,4,9,2"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource Text.Muted}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
