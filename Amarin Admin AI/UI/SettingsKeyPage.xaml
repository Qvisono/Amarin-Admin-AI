<UserControl x:Class="Amarin.UI.SettingsKeyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <!--
        Стили настроек (PageTitle, SettingTitle и прочие) объявлены локально в
        SettingsOverlay.Resources главного окна, и StaticResource из этого файла их не достанет:
        поиск идёт по словарям разметки, а не по дереву. Поэтому общие ключи повторены здесь
        один в один — тем же приёмом, что и на странице Info.
    -->
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>

        <!-- ===== Своё для этой страницы ===== -->

        <!-- Плашка с крупной цифрой: остаток в долларах и он же в кредитах -->
        <Style x:Key="BalanceTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>
        <Style x:Key="TileCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Отрезок времени. Радиокнопкой: выбран ровно один. -->
        <Style x:Key="PeriodChip" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SpendPeriod"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="12" Padding="10,0">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11"
                                       Foreground="{DynamicResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Кружок выбора активного ключа. Свой шаблон, потому что штатный RadioButton рисуется
            средствами Windows: рядом с тёмной карточкой он выглядит вставкой из чужой программы.
        -->
        <Style x:Key="KeyChoice" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ActiveVeniceKey"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Border.Strong}" StrokeThickness="1.4"/>
                            <Ellipse x:Name="Dot" Margin="4" Fill="{DynamicResource Accent.Fill}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent.Fill}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Метка источника ключа: «из окружения» рядом с названием, а не отдельной строкой -->
        <Style x:Key="KeyBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Мелкая кнопка-иконка: «глаз» и корзина в строке ключа -->
        <Style x:Key="KeyIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontSize="12"
                                       Foreground="{DynamicResource Text.Faint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddKeyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Path Data="M4,0 L4,8 M0,4 L8,4" Stroke="{DynamicResource Accent.Fill}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="9" Height="9" Stretch="Uniform"
                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                           Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="KeyPageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Key.Title}"/>

            <!-- ═══ Остаток ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource BalanceTile}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileCaption}" Text="{DynamicResource S.Key.Balance.Credits}"/>
                        <TextBlock x:Name="BalanceCreditsValue" Style="{StaticResource TileValue}" Text="—"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource BalanceTile}" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileCaption}" Text="{DynamicResource S.Key.Balance.Usd}"/>
                        <TextBlock x:Name="BalanceUsdValue" Style="{StaticResource TileValue}" Text="—"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="BalanceNote" Style="{StaticResource SettingDesc}" Margin="0,6,0,0"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <!-- ═══ График ═══ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,8,0" VerticalAlignment="Center"
                           Text="{DynamicResource S.Spend.Title}"/>
                <Button x:Name="SpendRefreshButton" Grid.Column="1" Style="{StaticResource KeyIconButton}"
                        Content="⟳" Click="SpendRefreshButton_Click"
                        ToolTip="{DynamicResource S.Key.Balance.Refresh}"/>
            </Grid>

            <!-- Отрезки времени. Заводской - неделя. -->
            <WrapPanel x:Name="PeriodChips" Margin="0,0,0,10">
                <RadioButton x:Name="PeriodDay" Style="{StaticResource PeriodChip}" Tag="Day"
                             Content="{DynamicResource S.Spend.Period.Day}" Checked="Period_Checked"/>
                <RadioButton x:Name="PeriodWeek" Style="{StaticResource PeriodChip}" Tag="Week" IsChecked="True"
                             Content="{DynamicResource S.Spend.Period.Week}" Checked="Period_Checked"/>
                <RadioButton x:Name="PeriodMonth" Style="{StaticResource PeriodChip}" Tag="Month"
                             Content="{DynamicResource S.Spend.Period.Month}" Checked="Period_Checked"/>
                <RadioButton x:Name="PeriodQuarter" Style="{StaticResource PeriodChip}" Tag="Quarter"
                             Content="{DynamicResource S.Spend.Period.Quarter}" Checked="Period_Checked"/>
                <RadioButton x:Name="PeriodYear" Style="{StaticResource PeriodChip}" Tag="Year"
                             Content="{DynamicResource S.Spend.Period.Year}" Checked="Period_Checked"/>
                <RadioButton x:Name="PeriodAll" Style="{StaticResource PeriodChip}" Tag="All"
                             Content="{DynamicResource S.Spend.Period.All}" Checked="Period_Checked"/>
            </WrapPanel>

            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel>
                    <!--
                        Итог за период слева сверху, над самим полем графика: он же и есть ответ
                        на вопрос «сколько я потратил», а линия - только его разбор по дням.
                    -->
                    <TextBlock x:Name="SpendTotalCaption" Style="{StaticResource TileCaption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="SpendTotalUsd" Style="{StaticResource TileValue}" Text="—" Margin="0"/>
                        <TextBlock x:Name="SpendTotalCredits" VerticalAlignment="Bottom" Margin="8,0,0,3"
                                   FontSize="11.5" Foreground="{DynamicResource Text.Dim}"/>
                    </StackPanel>
                    <local:SpendChart x:Name="Chart" Height="150" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SpendSourceNote" FontSize="10.5" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource Text.Faint}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsDivider}"/>

            <!-- ═══ Разбивка по моделям ═══ -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Spend.Models.Title}"/>
            <TextBlock x:Name="ModelsEmpty" Style="{StaticResource SettingDesc}"
                       Text="{DynamicResource S.Spend.Models.Empty}" Margin="0,0,0,4"/>
            <!--
                ItemsControl, а не ListBox: SmoothScroll сидит на туннелирующем PreviewMouseWheel,
                и вложенный список забрал бы колесо у страницы.
            -->
            <ItemsControl x:Name="ModelRows"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <!-- ═══ Ключи ═══ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Key.Section}"/>
                    <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Key.Storage}"/>
                </StackPanel>
                <Button x:Name="AddKeyButton" Grid.Column="1" VerticalAlignment="Center"
                        Style="{StaticResource AddKeyButton}"
                        Content="{DynamicResource S.Key.Add}" Click="AddKeyButton_Click"/>
            </Grid>
            <ItemsControl x:Name="KeyRows"/>
            <TextBlock x:Name="KeysBusyNote" Style="{StaticResource SettingDesc}"
                       Text="{DynamicResource S.Key.BusyTurns}" Visibility="Collapsed" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
