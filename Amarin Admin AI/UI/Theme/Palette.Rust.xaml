<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Rust». Поверхности не тонированы вовсе — тёплый нейтральный уголь, как у Dark. Весь цвет
         собран в одной точке: акцентные кнопки, полосы, точка «думает». Сравнить стоит
         с Ember, который тем же рыжим красит и окно, и колонку, и наведение. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF121110"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF0C0B0A"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF1A1918"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF1A1918"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF1F1E1C"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF242221"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF2A2827"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF312F2D"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF373432"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF4A4644"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF232120"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF302D2B"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF4E4A47"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"     Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="Text.Body"       Color="#FFE8E7E7"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#FFD4D2D1"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#FFBEBCBA"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#FF9C9A97"/>
    <SolidColorBrush x:Key="Text.Dim"        Color="#FF8B8885"/>
    <SolidColorBrush x:Key="Text.Faint"      Color="#FF6E6A66"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FF140A04"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FFE2652A"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FFE78150"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FFB95322"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFBF5050"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FF3B2F19"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF272015"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#9C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1F1E1C"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF7A7672"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFE29A6A"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF8C8884"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FFF08A50"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FFFBA97A"/>
</ResourceDictionary>
