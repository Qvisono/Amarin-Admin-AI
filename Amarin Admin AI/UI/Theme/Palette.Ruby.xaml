<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Ruby». Собран из Palette.Dark.xaml: нейтральный чёрный, чистый красный акцент -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF0F0E0E"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF141212"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF171514"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF171514"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF1B1918"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF211E1D"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF292524"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF332E2D"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF3A3433"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF474040"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF1F1D1C"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF2E2A29"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF4E4746"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFEDEAE9"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE6E2E1"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD2CECD"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFBEBAB9"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF979392"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF858180"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF6B6766"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF16100F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFFF4F45"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFFF7168"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFDC4038"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF829A87"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF8A80"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF382D17"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF231B0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48E2A9A4"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1F1C1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFEFB07A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFFF8177"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC29BD6"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA3C68A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF817D7C"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFED9E7C"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8AC1BC"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFC9ABDB"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFEBC58B"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF918C8B"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFFF8177"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFFFA79F"/>
</ResourceDictionary>
