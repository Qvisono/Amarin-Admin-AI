<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Crimson». Собран из Palette.Dark.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF120F0F"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF181314"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF1B1617"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF1B1617"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF211A1B"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF251E1F"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF2B2223"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF312829"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF362B2D"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF433638"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF2A2123"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF362B2D"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF554446"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFEBE9E9"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE9E7E7"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD9D7D7"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFCBC7C8"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF9D9798"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF8E8687"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF726A6B"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF260809"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFFF8E8E"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFFFB2B2"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFE07070"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFC9C9"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF241A1A"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE8C489"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFFF9E9E"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFD3A6E0"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA8CE9C"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFF0A98C"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8FC9C4"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFFF9C9C"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFFFC4C4"/>
</ResourceDictionary>
