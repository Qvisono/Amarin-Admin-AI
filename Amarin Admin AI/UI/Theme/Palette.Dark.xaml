<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF0E0E0E"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF131313"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF161616"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF1F1F1F"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF242424"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF3A3A3A"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF232323"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF4A4A4A"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD8D8D8"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFC9C9C9"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0E0E0E"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFD4D4D4"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFFFFFFF"/>
</ResourceDictionary>
