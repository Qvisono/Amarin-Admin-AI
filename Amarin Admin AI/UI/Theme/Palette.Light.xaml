<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Light» и образец для всех светлых. Bg.Panel здесь был чисто белым, Bg.Window —
         почти белым, а чернила почти чёрными: на полный экран без фоновой картинки это стена
         света, от которой у людей болели глаза, и пара «текст на окне» выдавала 15.7:1 — выше
         верхней границы комфортного чтения, а не достижение. Отсюда правило, которое держит
         Light_presets_do_not_glare: панель не белая (яркость ≤ 0.90), окно заметно ниже неё
         (≤ 0.86), контраст тела текста — в полосе 7:1…13:1. Исключение одно: Contrast, он
         предельно контрастен намеренно, ради доступности. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFEBEBEC"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE4E4E6"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF2F2F3"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF2F2F3"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFE8E8EA"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFE1E1E4"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFD9D9DD"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFCFCFD4"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFC7C7CD"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFBEBEC5"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFDADADE"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFCBCBD1"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFABABB3"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF212123"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF29292D"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF2F2F34"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF404047"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF55555D"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF6E6E75"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF83838A"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF9A9AA1"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF1B1B20"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF000000"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF3A3A42"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE6D3A0"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFBF3DF"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF1B1B20"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF000000"/>
</ResourceDictionary>
