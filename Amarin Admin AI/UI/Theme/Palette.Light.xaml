<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFF6F6F7"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFEFEFF1"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFF3F3F5"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFECECEF"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFE3E3E7"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFD8D8DE"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFD0D0D6"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFC6C6CD"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFE4E4E8"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFD4D4DA"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFB2B2BA"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF0E0E10"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF16161A"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF1C1C21"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF2E2E35"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF44444C"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF74747C"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF8C8C94"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF1B1B20"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF000000"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF3A3A42"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE6D3A0"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFBF3DF"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF1B1B20"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF000000"/>
</ResourceDictionary>
