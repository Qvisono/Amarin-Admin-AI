<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Vellum». Пергамент: самый жёлтый корпус семейства, акцент — глухие чернила.
         Цветного акцента здесь нет намеренно: пергамент с цветной кнопкой перестаёт быть
         пергаментом. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFECE6D6"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFE4DDCD"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFF3EEE1"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFF3EEE1"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFE8E1D0"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFE0D9C7"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFD6CDB8"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFC9BEA6"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFBDB196"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FFAAA184"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFE2DBC9"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFD1C7AE"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFACA183"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF272219"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF2F2A20"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF373127"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF484236"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF5D5646"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF766F5C"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF8A826D"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FFA19881"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF3C382F"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF2E2B24"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF4C473B"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#590E0C06"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF3C382F"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF24211B"/>
</ResourceDictionary>
