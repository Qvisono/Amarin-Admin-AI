<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Пресет «Carbon» (1.36.0) — нейтральный графит тёмного приложения ChatGPT/Codex, по снимкам
        человека: колонка #0F0F10, полоса значков #0D0D0E, кнопка и выбранная строка #1F1F21,
        всплывающее меню #222224 с тёмным краем, текст #E3E4E6 / #C6C7C9 / #B4B4B7.

        Нейтраль без подтона (синий канал на одну-две единицы выше: так серый не уходит в бурый
        на тёплых матрицах). Колонка темнее ленты, как у образца: глаз отделяет навигацию от
        разговора без рамки. Акцент — светлый, почти белый, с тёмной надписью: это главная
        примета образца — белая основная кнопка на графите.
    -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF161617"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF0F0F10"/>
    <!-- Меню, подсказки, диалоги и поле ввода — цвет меню с образца. -->
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF222224"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF222224"/>
    <SolidColorBrush x:Key="Bg.Sheet"    Color="#FF1A1A1C"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF1F1F21"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF262628"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF2A2A2C"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF303032"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF38383B"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF46464A"/>

    <!-- Рамки: у образца их почти нет — поверхности отделяет тон -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF2B2B2E"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF404044"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFECECEE"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE3E4E6"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFDCDDDF"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC6C7C9"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFB4B4B7"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF7C7C81"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF66666B"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0D0D0D"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6ECECEE"/>

    <!-- Акцент: светлая основная кнопка -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFECECEC"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFCFCFD1"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF4FBF7F"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A84"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFFFFF"/>

    <!-- Подложка логотипов: логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1F1F21"/>


    <!-- Подсветка кода и ссылки в markdown: привычная тёмная схема редакторов -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE5C07B"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFC678DD"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFE06C9F"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF98C379"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7F848E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD19A66"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF56B6C2"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFE5A5A5"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF61AFEF"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF7CACF8"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFA8C7FA"/>
</ResourceDictionary>
