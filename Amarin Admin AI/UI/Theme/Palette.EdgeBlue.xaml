<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    Пресет «Edge Blue» — нейтральная база, синий акцент.

    Один из четырёх пресетов семейства Edge. У всех четырёх шкала поверхностей одна и та
    же и почти лишена цвета (разброс каналов 4 единицы): цвет работает точечно — в акценте,
    в статусах и в подсветке кода, — а не разлит по фону. Разлитый по поверхностям цвет
    читается не как палитра, а как светофильтр поверх серого интерфейса.

    Второе отличие от остальных тем — рамки. Здесь плоскости разделяет граница, а не тень и
    не перепад заливки: Border.Default отличается от поверхности в 2.1 раза против 1.33 у
    Dark и Matte, а Border.Subtle, на котором держится контур поля ввода, — в 1.44 против
    1.07. Отсюда и жёсткость: шкала поверхностей нарочно сближена, работу по разделению
    делают линии.

    Отличается от соседей по семейству ровно акцентом — синим. Он единственный из
    четырёх, где текст на кнопке белый: у лайма, янтаря и мадженты заливка светлая,
    и белый на ней не проходит по контрасту.
    -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF0F0F10"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF0B0B0C"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF151517"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF151517"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF131315"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF1A1A1D"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF202024"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF292930"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF2E2E35"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF3A3A43"/>

    <!-- Рамки: здесь они и есть разделитель, поэтому заметны -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF32323A"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF4A4A55"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF6E6E7C"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"             Color="#FFEDEDEF"/>
    <SolidColorBrush x:Key="Text.Body"               Color="#FFE2E2E5"/>
    <SolidColorBrush x:Key="Text.Secondary"          Color="#FFC8C8CD"/>
    <SolidColorBrush x:Key="Text.Tertiary"           Color="#FFAEAEB5"/>
    <SolidColorBrush x:Key="Text.Muted"              Color="#FF85858E"/>
    <SolidColorBrush x:Key="Text.Dim"                Color="#FF70707A"/>
    <SolidColorBrush x:Key="Text.Faint"              Color="#FF5A5A64"/>
    <SolidColorBrush x:Key="Text.OnAccent"           Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент: синий, белый текст на нём -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF2A63D8"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF3B76EC"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF2150B4"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF3FB950"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF3D8F52"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFF85149"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFC93C36"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FFD29922"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FF3A2E12"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF251E0C"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#B00B0B0C"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#3AFFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1A1A1D"/>

    <!-- Подсветка кода и ссылки в markdown: плотная и контрастная, не припылённая -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF79C0FF"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFFF7B72"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFD2A8FF"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA5D6FF"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF8B949E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF79C0FF"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FFFFA657"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFFFA657"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFD2A8FF"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FFA5A5AE"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF6BA5FF"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF8FBDFF"/>
</ResourceDictionary>
