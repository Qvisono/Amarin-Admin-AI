<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Alpine». Мятная наледь: бледно-бирюзовый корпус, акцент — хвойная зелень.
         Подсветка кода нейтральная: зелёная поверх зелёного корпуса сливается в один тон. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFE0EDE8"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFD8E6E1"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFE9F4F1"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFE9F4F1"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFDCEAE5"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFD2E3DD"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFC5D9D2"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFB5CEC5"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFA8C4BA"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF93B4A9"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFD9E8E2"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFC6DAD2"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF9EBCB1"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF1B2422"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF232D2A"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF2B3633"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF3B4845"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF4F5F5A"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF687873"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF7C8D87"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF94A59F"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF23675C"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF1A544B"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF2E7C6F"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#5904100E"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF23675C"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF174C43"/>
</ResourceDictionary>
