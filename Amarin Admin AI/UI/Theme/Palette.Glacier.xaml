<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Glacier». Ледник в разрезе: корпус — сине-чёрный лёд, холод собран в акценте,
         рамках и состояниях. Подсветка кода нейтральная, как в Dark: разлитый по поверхностям
         цвет читается светофильтром поверх серого интерфейса, а не палитрой. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF0A1216"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF0C161B"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF101B21"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF101B21"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF142128"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF1A2831"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF20313C"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF273C49"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF2D4553"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF3C5A6B"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF16232A"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF21323C"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF3A5666"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFEAF4F7"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFDFEAEE"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFC7D6DC"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFAFC1C9"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF8FA3AC"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF7C9099"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF62747D"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF06181C"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF6FD3E4"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF8CE0EE"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF56AEBD"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF5FC08E"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF7AA391"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFFF7A7A"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFC4453C"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FFE5B45C"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FF32301E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FF221F14"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#99040A0C"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF142128"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF8ADCEA"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FFAEE9F3"/>
</ResourceDictionary>
