<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Sand». Собран из Palette.Light.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFEEEBE4"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE8E2D8"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF5F2EB"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF5F2EB"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFECE7DF"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFE5DFD2"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFDED4C5"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFD4C8B5"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFCCBEA8"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFBEAD92"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFE0D9CC"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFD2C7B5"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFB4A48B"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF27241F"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF2F2B26"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF343029"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF474036"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF5C5346"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF746856"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF877965"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FFA0927B"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFF8EF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF8A5F33"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF704C28"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFA5764A"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF4A7358"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF8F5D0E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE4CF9F"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFAF0D8"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59120C04"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48402A12"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF2A2118"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8A5A14"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF1F5484"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7C7266"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF14615C"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5A14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF635B50"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF8A5F33"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF5E3F1F"/>
</ResourceDictionary>
