<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Cream». Молоко с холодным акцентом: кремовый корпус и сланцевая синь — тот же
         контраст, что у облаков и гор. Тепло в корпусе, холод в акценте; поменяй местами —
         и получится обычная бежевая тема. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFEEE9DF"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFE6E1D5"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFF5F1E8"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFF5F1E8"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFEAE5DA"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFE2DCCE"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFD8D1C1"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFCBC3B0"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFBFB6A1"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FFACA189"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFE4DFD3"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFD4CCBB"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFAFA58F"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF25221C"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF2D2A23"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF35322A"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF46423A"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF5B564C"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF746E63"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF888176"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF9F978B"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF3E5E7A"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF324D64"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF4C7091"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#590E0B06"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF3E5E7A"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF2B4457"/>
</ResourceDictionary>
