<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Forest». Собран из Palette.Dark.xaml: нейтральные поверхности уведены
         в тёмно-хвойный, акцент, ссылки и подсветка кода заданы вручную. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF07100B"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF0A1610"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF0C1B13"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF0C1B13"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF0F2217"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF12291C"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF173322"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF1C3D29"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF20452E"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF2A593B"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF14301F"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF1D4229"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF336B47"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFEBF6EE"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFDEEFE2"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC8E3CE"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFACD2B6"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF83AE90"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF70997D"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF587B62"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF07160C"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF8FD694"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFA9E4AD"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF74B879"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF6FD18A"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7CA189"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF8080"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC4362B"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0B04A"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF34301A"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF201E10"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#8C000A05"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48D6F5DC"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF0F2217"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFDCC88A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF9AC4DE"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC1AEDC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA8CF96"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF728C79"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFDCA98A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8ACFC0"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFC6B5DE"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFDCC88A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF86A18D"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF9EE0A3"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFBDEFC0"/>
</ResourceDictionary>
