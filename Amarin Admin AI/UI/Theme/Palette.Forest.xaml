<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Forest». Хвойный цвет ушёл из заливок туда, где человек трогает интерфейс: наведение
         на строку, выделение, полосы и все рамки — зелёные, а окно, колонка, панель и карточка
         остаются почти нейтральным углём. Цвет появляется на действии, а не лежит фоном.
         Прежняя Forest была зелёной насквозь, включая фон окна. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"                Color="#FF0C0E0D"/>
    <SolidColorBrush x:Key="Bg.Sidebar"               Color="#FF101211"/>
    <SolidColorBrush x:Key="Bg.Panel"                 Color="#FF131514"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"                 Color="#FF131514"/>
    <SolidColorBrush x:Key="Bg.Card"                  Color="#FF181A19"/>
    <SolidColorBrush x:Key="Bg.Raised"                Color="#FF1C1E1D"/>
    <SolidColorBrush x:Key="Bg.Hover"                 Color="#FF1C2A21"/>
    <SolidColorBrush x:Key="Bg.Selected"              Color="#FF203226"/>
    <SolidColorBrush x:Key="Bg.Track"                 Color="#FF25372B"/>
    <SolidColorBrush x:Key="Bg.Elevated"              Color="#FF324237"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"            Color="#FF18281D"/>
    <SolidColorBrush x:Key="Border.Default"           Color="#FF213B2A"/>
    <SolidColorBrush x:Key="Border.Strong"            Color="#FF305C3F"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFEBEDEC"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE7E9E8"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFD5D7D6"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFC2C6C3"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF979D99"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF858D88"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF6B716D"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF061409"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"              Color="#FF63C97F"/>
    <SolidColorBrush x:Key="Accent.FillHover"         Color="#FF79D191"/>
    <SolidColorBrush x:Key="Accent.FillPressed"       Color="#FF55AD6D"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"           Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"       Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"            Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"      Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"           Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"     Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface"    Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"            Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"            Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"           Color="#FF181A19"/>

    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"              Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"             Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"             Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"              Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"             Color="#FF717F76"/>
    <SolidColorBrush x:Key="Code.Number"              Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"                Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"            Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"            Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"            Color="#FF86928A"/>
    <SolidColorBrush x:Key="Link.Default"             Color="#FF73CE8C"/>
    <SolidColorBrush x:Key="Link.Hover"               Color="#FF89D69E"/>
</ResourceDictionary>
