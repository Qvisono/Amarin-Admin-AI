<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Пресет «Rosé». Собран вручную, и вот из-за чего.

        Первая редакция уводила тени в баклажан (тон ~297°, синий канал выше красного): так
        тёплый тон не сваливался в бурую грязь. Тень получалась чистой, но её было слишком
        много — окно на девять десятых состоит из поверхностей, и тема читалась фиолетовой,
        а розовым оставался только акцент.

        Здесь тени переведены на винный тон (~345°): красный канал ведёт, синий идёт следом
        и держит поверхность от ухода в кирпич, зелёный самый низкий. Против бурости работает
        не смена тона, а насыщенность — она падает к низу шкалы, так что самая тёмная
        поверхность почти нейтральна и цвет набирает силу только к верху. Акцент по-прежнему
        тёплая роза: свет теплее тени, как в закатной живописи.
    -->

    <!-- Поверхности: винная тень внизу, роза к верху шкалы -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF130A0E"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF1A0F14"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF20141A"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF20141A"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF281920"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF311E27"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF3E2531"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF4C2D3B"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF5A3646"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF7A4A5E"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF2A1A22"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF3C2530"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF6B4353"/>

    <!-- Текст: тёплый белый, к низу шкалы уходит в пыльную розу -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFF9EAEE"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFF3E1E7"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFE3CBD4"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFCFAFBB"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FFAD8894"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF977380"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF7B5866"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF2B0A18"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент: тёплая роза, не фуксия — фуксия на винном вибрирует -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFFF9EC4"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFFFBBD5"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFE07FA6"/>

    <!-- Статусы: опасность уведена в малиновый, чтобы не спорить с акцентом -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF6FCF97"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7FA891"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF7A8A"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B45"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE8B65C"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3B2A20"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF281C14"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F120609"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFD6E3"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF291A21"/>


    <!-- Подсветка кода: роза, золото и мята — три тона, а не радуга -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFF0C48A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFFF9EC4"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFD9A6FF"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA8D8A0"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF856A76"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFF2A88E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8FD6D0"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFE7B6E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFF0C48A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FFA18391"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFFFA9CB"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFFFCBDF"/>
</ResourceDictionary>
