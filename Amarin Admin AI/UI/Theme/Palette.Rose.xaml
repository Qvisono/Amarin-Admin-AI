<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Rosé». Сумерки, а не ночь: поверхности подняты на регистр выше остальных тёмных тем
         и сделаны тёплым серо-розовым пеплом низкой насыщенности. Розовое здесь приглушённое
         и держится на акценте; горячая роза на почти чёрном — это Quartz, и повторять её
         незачем. Прежняя Rosé заливала розовым всё, вплоть до Bg.Elevated #7A4A5E. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"                Color="#FF201618"/>
    <SolidColorBrush x:Key="Bg.Sidebar"               Color="#FF251B1D"/>
    <SolidColorBrush x:Key="Bg.Panel"                 Color="#FF291F21"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"                 Color="#FF291F21"/>
    <SolidColorBrush x:Key="Bg.Card"                  Color="#FF2F2527"/>
    <SolidColorBrush x:Key="Bg.Raised"                Color="#FF342A2C"/>
    <SolidColorBrush x:Key="Bg.Hover"                 Color="#FF3A3032"/>
    <SolidColorBrush x:Key="Bg.Selected"              Color="#FF413739"/>
    <SolidColorBrush x:Key="Bg.Track"                 Color="#FF463C3E"/>
    <SolidColorBrush x:Key="Bg.Elevated"              Color="#FF554B4D"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"            Color="#FF34282A"/>
    <SolidColorBrush x:Key="Border.Default"           Color="#FF453739"/>
    <SolidColorBrush x:Key="Border.Strong"            Color="#FF645456"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFEDEBEB"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE9E7E7"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFD8D4D5"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFC7C1C2"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF9F9597"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF8F8385"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF74686A"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF200910"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"              Color="#FFDE7C96"/>
    <SolidColorBrush x:Key="Accent.FillHover"         Color="#FFE38EA5"/>
    <SolidColorBrush x:Key="Accent.FillPressed"       Color="#FFBF6B81"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"           Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"       Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"            Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"      Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"           Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"     Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface"    Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"            Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"            Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"           Color="#FF2F2527"/>

    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"              Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"             Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"             Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"              Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"             Color="#FF826E72"/>
    <SolidColorBrush x:Key="Code.Number"              Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"                Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"            Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"            Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"            Color="#FF948487"/>
    <SolidColorBrush x:Key="Link.Default"             Color="#FFE189A0"/>
    <SolidColorBrush x:Key="Link.Hover"               Color="#FFE69CAF"/>
</ResourceDictionary>
