<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Nord». Собран из Palette.Dark.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF11161A"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF151B21"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF171E24"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF171E24"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF1B232A"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF1E272F"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF222C35"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF27323D"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF2A3641"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF334250"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF212B34"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF2A3641"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF405264"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE9EAEB"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE6E8EA"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD5D8DB"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFC5C9CD"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF939AA1"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF828A92"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF676E75"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0F171E"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF88C0D0"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFA6D4E1"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF6FA7B8"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48CDE3EE"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF20262E"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFEBCB8B"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF81A1C1"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFB48EAD"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA3BE8C"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD08770"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8FBCBB"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF9CC6D6"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFC0DEE9"/>
</ResourceDictionary>
