<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Midnight». Собран из Palette.Dark.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF0C0F16"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF0F131D"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF121621"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF121621"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF151A27"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF181D2C"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF1B2233"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF20273B"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF222A40"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF2B354F"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF1B2131"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF222A40"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF364264"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE8E9EC"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE6E7EA"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD4D6DC"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFC4C7CE"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF9196A3"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF7F8595"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF646978"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0A1020"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF8FB2FF"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFB0C8FF"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF7096E8"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48B9CBFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF161B2B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE7C98C"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF8FB2FF"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF7FD1D6"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF9DBBFF"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFC2D5FF"/>
</ResourceDictionary>
