<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Midnight». Ночная синева осталась там, где она читается как ночь, — в самых глубоких
         поверхностях; чем выше слой, тем он нейтральнее, и панель с карточкой уже почти серые.
         Раньше один и тот же синий лежал на всех десяти поверхностях сразу, и акценту нечем
         было выделиться на фоне такого же синего. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"                Color="#FF0A0D14"/>
    <SolidColorBrush x:Key="Bg.Sidebar"               Color="#FF0E1118"/>
    <SolidColorBrush x:Key="Bg.Panel"                 Color="#FF11151D"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"                 Color="#FF11151D"/>
    <SolidColorBrush x:Key="Bg.Card"                  Color="#FF171A21"/>
    <SolidColorBrush x:Key="Bg.Raised"                Color="#FF1C1F26"/>
    <SolidColorBrush x:Key="Bg.Hover"                 Color="#FF22252C"/>
    <SolidColorBrush x:Key="Bg.Selected"              Color="#FF282B32"/>
    <SolidColorBrush x:Key="Bg.Track"                 Color="#FF2D3037"/>
    <SolidColorBrush x:Key="Bg.Elevated"              Color="#FF3A3C42"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"            Color="#FF181C24"/>
    <SolidColorBrush x:Key="Border.Default"           Color="#FF252933"/>
    <SolidColorBrush x:Key="Border.Strong"            Color="#FF3A404E"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFEBECED"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE7E8E9"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFD4D5D8"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFC1C3C7"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF95989F"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF83878F"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF686C74"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF070C18"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"              Color="#FF6C9BFF"/>
    <SolidColorBrush x:Key="Accent.FillHover"         Color="#FF81A9FF"/>
    <SolidColorBrush x:Key="Accent.FillPressed"       Color="#FF5D85DB"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"           Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"       Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"            Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"      Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"           Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"     Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface"    Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"            Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"            Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"           Color="#FF171A21"/>

    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"              Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"             Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"             Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"              Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"             Color="#FF6E7482"/>
    <SolidColorBrush x:Key="Code.Number"              Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"                Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"            Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"            Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"            Color="#FF848994"/>
    <SolidColorBrush x:Key="Link.Default"             Color="#FF7BA5FF"/>
    <SolidColorBrush x:Key="Link.Hover"               Color="#FF90B3FF"/>
</ResourceDictionary>
