<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Emerald». Изумруд остался в самых глубоких поверхностях — окне и колонке, — а всё, на
         чём лежит содержимое, уходит в нейтральный уголь. Насыщенное пятно в интерфейсе одно:
         кнопки, полосы, ссылки. Холодная пара к Rust, устроенная по тому же правилу. Раньше
         зелёным были покрашены и наведение, и выделение, и карточки — акценту оставалось
         спорить с собственным фоном. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"                Color="#FF0C1211"/>
    <SolidColorBrush x:Key="Bg.Sidebar"               Color="#FF0F1715"/>
    <SolidColorBrush x:Key="Bg.Panel"                 Color="#FF131B19"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"                 Color="#FF131B19"/>
    <SolidColorBrush x:Key="Bg.Card"                  Color="#FF191F1E"/>
    <SolidColorBrush x:Key="Bg.Raised"                Color="#FF1D2322"/>
    <SolidColorBrush x:Key="Bg.Hover"                 Color="#FF232928"/>
    <SolidColorBrush x:Key="Bg.Selected"              Color="#FF292F2E"/>
    <SolidColorBrush x:Key="Bg.Track"                 Color="#FF2E3433"/>
    <SolidColorBrush x:Key="Bg.Elevated"              Color="#FF3A403F"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"            Color="#FF1A2221"/>
    <SolidColorBrush x:Key="Border.Default"           Color="#FF27312F"/>
    <SolidColorBrush x:Key="Border.Strong"            Color="#FF3D4B48"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFEBEDEC"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE7E9E8"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFD5D7D7"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFC2C6C5"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF979D9C"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF858D8B"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF6B7170"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF04170F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"              Color="#FF35D69A"/>
    <SolidColorBrush x:Key="Accent.FillHover"         Color="#FF51DCA8"/>
    <SolidColorBrush x:Key="Accent.FillPressed"       Color="#FF2EB884"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"           Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"       Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"            Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"      Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"           Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"     Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface"    Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"            Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"            Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"           Color="#FF191F1E"/>

    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"              Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"             Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"             Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"              Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"             Color="#FF717F7C"/>
    <SolidColorBrush x:Key="Code.Number"              Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"                Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"            Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"            Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"            Color="#FF86928F"/>
    <SolidColorBrush x:Key="Link.Default"             Color="#FF49DAA4"/>
    <SolidColorBrush x:Key="Link.Hover"               Color="#FF66E0B3"/>
</ResourceDictionary>
