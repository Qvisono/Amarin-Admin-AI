<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Emerald». Собран из Palette.Dark.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF0C1412"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF101A17"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF121E1A"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF121E1A"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF162420"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF192924"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF1D2F2A"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF213730"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF253C35"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF2E4A42"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF1C2E29"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF253C35"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF3A5E53"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE8ECEB"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE6EAE9"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD5DBD9"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFC5CDCB"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF93A19D"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF82928D"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF667671"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF05170F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF6FE0B0"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF95ECC7"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF4FC494"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48BFF5DD"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF10241C"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE0CE8A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF7FD8C4"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF9AD6A0"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF7FE3BA"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFA8EED2"/>
</ResourceDictionary>
