<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Contrast». Отличается не цветом, а родом. Рамки видны по-настоящему (Border.Default #8A8A8A
         против почти невидимых в остальных темах), весь текстовый ряд держит читаемость до
         последней ступени — даже Text.Faint здесь тёмный. Для яркой комнаты и уставших глаз. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFFFFFFF"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFCFCFCF"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFC2C2C2"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF9A9A9A"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFC4C4C4"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF333333"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#FF000000"/>
    <SolidColorBrush x:Key="Text.Bright"     Color="#FF060606"/>
    <SolidColorBrush x:Key="Text.Body"       Color="#FF0C0C0C"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#FF171717"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#FF232323"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#FF353535"/>
    <SolidColorBrush x:Key="Text.Dim"        Color="#FF3E3E3E"/>
    <SolidColorBrush x:Key="Text.Faint"      Color="#FF4E4E4E"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF0B4FA8"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF09418A"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF376FB8"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF0F6B34"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF2E5F42"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFA8160A"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFBE5047"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FF7A4A00"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FFCCBA9E"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFECE6DB"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FFF5F5F5"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF7A4A00"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF0B4FA8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF5B2A8A"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF1F5E19"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF4E4E4E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF8A3A00"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF0A5A56"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF4A2A80"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF7A4A00"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF333333"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF0B4FA8"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF06336E"/>
</ResourceDictionary>
