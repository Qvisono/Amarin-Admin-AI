<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Coral». Собран из Palette.Light.xaml: тёплая нейтральная база, кирпичный акцент -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFECEAE8"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE7E3E0"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF4F2F0"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF4F2F0"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFEBE7E5"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFE4DFDD"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFDED8D4"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFD6D1CD"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFCFC8C5"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFC5BDB8"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFE2DDDA"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFD4CDC9"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFB1A6A0"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF272322"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF302B29"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF373230"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF4B4441"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF645A54"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF7E726B"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF958882"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FFAB9E99"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFF5F2"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFB3311F"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF972717"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFC6543F"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF4A7358"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE9D2A2"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFCF3E0"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF241D1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8F5218"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFB3311F"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7C7370"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4A1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF1F635E"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5A14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF645B58"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFB3311F"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF7E2012"/>
</ResourceDictionary>
