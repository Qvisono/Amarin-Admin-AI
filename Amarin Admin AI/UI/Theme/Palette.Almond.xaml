<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Almond». Самый глубокий из кремовых: какао-тёплый корпус, акцент — тёплая слива.
         Ниже по яркости остальных трёх — тема для вечера, а не для окна на солнце. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFE8E2D9"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFE0D9CF"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFEFEAE1"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFEFEAE1"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFE4DED4"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFDCD5C9"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFD1C9BC"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFC4BBAC"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFB8AE9D"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FFA59A87"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFDED7CD"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFCEC6B7"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFA99E8C"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF262120"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF2E2927"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF363130"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF474140"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF5C5553"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF756D6B"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF89817E"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FFA09792"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF75454A"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF5E373B"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF8B545A"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#590E0A08"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF75454A"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF573236"/>
</ResourceDictionary>
