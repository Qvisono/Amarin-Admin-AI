<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Plum». Собран из Palette.Dark.xaml: нейтральные поверхности уведены
         в винно-баклажановый, акцент, ссылки и подсветка кода заданы вручную. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF120A12"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF18101A"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF1C131F"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF1C131F"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF221826"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF291D2E"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF332438"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF3D2B43"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF45314C"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF583F61"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF2A1D2F"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF3A2941"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF5E4468"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFF6ECF5"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFEEDFED"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFE0CADE"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFCDB0CB"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FFA788A5"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF937792"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF7A5D77"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF1A0A18"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFE4A0D0"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFF0B8DE"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFC783B3"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF62C98A"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7E9C8A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF7B95"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B45"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A855"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF382C1C"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF231C11"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#8C0D000B"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48F5DDF0"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF221826"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE0C08A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFA8BCE8"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFD0A8DC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA3C795"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF8A7189"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFE0A08A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8FC6C9"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFD6B2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C08A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF9C849A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFEDAEDA"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFF7C8E9"/>
</ResourceDictionary>
