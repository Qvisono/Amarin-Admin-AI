<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Plum». Глубокая сливовая база: оттенок держится в самых тёмных поверхностях
         и уходит к нейтральному вверх, как у остальных переделанных тем. Отличие — акцент: он не
         светлый, а тёмный винный, и подпись на нём белая. Среди тёмных тем это единственная
         кнопка темнее своего окружения — именно это делает сливу сливой, а не жвачкой.
         Прежняя Plum красила винным все десять поверхностей сразу. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"                Color="#FF140A13"/>
    <SolidColorBrush x:Key="Bg.Sidebar"               Color="#FF180E17"/>
    <SolidColorBrush x:Key="Bg.Panel"                 Color="#FF1C121B"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"                 Color="#FF1C121B"/>
    <SolidColorBrush x:Key="Bg.Card"                  Color="#FF211720"/>
    <SolidColorBrush x:Key="Bg.Raised"                Color="#FF261C25"/>
    <SolidColorBrush x:Key="Bg.Hover"                 Color="#FF2B232B"/>
    <SolidColorBrush x:Key="Bg.Selected"              Color="#FF312930"/>
    <SolidColorBrush x:Key="Bg.Track"                 Color="#FF362E35"/>
    <SolidColorBrush x:Key="Bg.Elevated"              Color="#FF423A42"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"            Color="#FF231923"/>
    <SolidColorBrush x:Key="Border.Default"           Color="#FF332532"/>
    <SolidColorBrush x:Key="Border.Strong"            Color="#FF4D3B4B"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFEDEBED"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE9E7E9"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFD8D4D8"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFC7C1C6"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF9F959E"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF8F838E"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF746873"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"              Color="#FFC0397E"/>
    <SolidColorBrush x:Key="Accent.FillHover"         Color="#FFC95590"/>
    <SolidColorBrush x:Key="Accent.FillPressed"       Color="#FFA5316C"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"           Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"       Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"            Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"      Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"           Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"     Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface"    Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"            Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"            Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"           Color="#FF211720"/>

    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"              Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"             Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"             Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"              Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"             Color="#FF826E80"/>
    <SolidColorBrush x:Key="Code.Number"              Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"                Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"            Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"            Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"            Color="#FF948493"/>
    <SolidColorBrush x:Key="Link.Default"             Color="#FFE07BAE"/>
    <SolidColorBrush x:Key="Link.Hover"               Color="#FFE590BB"/>
</ResourceDictionary>
