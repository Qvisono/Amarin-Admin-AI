<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Iceberg». Надводная часть: сизо-синий корпус, бледное небо в акценте. Светлее
         Glacier на шаг и мягче по холоду — две темы одного семейства, а не одна с оттенком. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF0C1117"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF0F151C"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF131B23"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF131B23"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF18222B"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF1C2530"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF232E3A"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF2A3746"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF313F50"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF405168"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF18212B"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF24303D"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF3D5064"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFEDF2F8"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE1E8F0"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFC9D3DF"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFB1BDCC"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF93A0B0"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF8291A3"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF6A7787"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF0A141F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF9BC7F2"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FFB4D6F8"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF7CA5CC"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF63BE86"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF7F9E8C"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFFF8080"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFC74A40"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FFE3B45E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FF32311F"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FF222015"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#99050910"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF18222B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FFA9D2F6"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FFC6E1FA"/>
</ResourceDictionary>
