<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Mint». Собран из Palette.Light.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFEBEEEC"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE2EAE7"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF0F3F1"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF0F3F1"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFE7ECEB"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFDFE8E5"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFD5E2DE"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFCADBD5"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFC0D6CF"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFB5D0C6"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFD7E2DF"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFC5D9D2"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF9EC2B6"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF212322"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF292D2C"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF2F3432"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF3F4845"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF535E5B"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF6A7974"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF7D9089"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF95A6A0"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFF2FBF7"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF17694F"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF0F5340"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF3C8770"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE6D3A0"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFBF3DF"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48003D2C"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF0F241E"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF17694F"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF15605C"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF17694F"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF0A4234"/>
</ResourceDictionary>
