<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Frost». Собран из Palette.Light.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFEBEDEF"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE3E8EB"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF0F2F4"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF0F2F4"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFE8EBED"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFDFE5EA"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFD5DEE4"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFC8D5DF"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFBFCED9"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFB3C5D3"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFD6DFE5"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFC4D2DC"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF9BB4C7"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF202224"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF292B2D"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF2E3234"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF3E4449"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF525A5F"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF68737B"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF7B8992"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF939FA8"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFF3F9FF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF1B4F87"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF123C6B"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF3A6EA3"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE6D3A0"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFBF3DF"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#4800284F"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF12222F"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF1B4F87"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF14615C"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF1B4F87"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF0C2E55"/>
</ResourceDictionary>
