<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Obsidian». Единственная палитра, где фон окна — настоящий #000000:
         на OLED такой пиксель не светится вовсе. Поверхности расходятся мелкими шагами
         (#000 → #0A → #15), иначе на чёрном фоне панель читается как дыра, а не как слой. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF000000"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF060606"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF0A0A0A"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF0A0A0A"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF101010"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF151515"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF232323"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF282828"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF343434"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF272727"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF444444"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE6E6E6"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD2D2D2"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFBEBEBE"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF949494"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF828282"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF666666"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF000000"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFCFCFCF"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF56B672"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF6E8F78"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFDDA33C"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF332810"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF1C1608"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#A0000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF141414"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE3CE95"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFA0BCEC"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC8ACE0"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFA0BC8E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD8AC8E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF93C8C4"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCFB6E4"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE3CE95"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8E8E8E"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFFFFFFF"/>
</ResourceDictionary>
