<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Пресет «GlueGray» (1.37.0): та же холодная спокойная графитовая шкала, что у Carbon, на
        ступень глубже, но не чёрная. Синий канал на 1-3 единицы выше красного и зелёного по всей
        шкале — как у Carbon. Две первые версии с тёплым подтоном (синий ниже) человек назвал
        «грязными». Текст — холодный белый, основная кнопка — светлая с тёмной надписью.
    -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF111113"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF0B0B0C"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF1C1C1F"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF1C1C1F"/>
    <SolidColorBrush x:Key="Bg.Sheet"    Color="#FF151517"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF19191B"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF202023"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF252528"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF2B2B2E"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF333337"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF414146"/>

    <!-- Рамки: тон, а не линия, как у Carbon -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF18181A"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF27272A"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF3B3B3F"/>

    <!-- Текст и иконки: холодный белый -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFEBECEF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE2E3E7"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFDADBDF"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC3C4C9"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFB0B1B6"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF8A8B91"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF78797F"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF626369"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0D0D0F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6EBECEF"/>

    <!-- Акцент: светлая основная кнопка -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFE8E9EC"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFF6F7F9"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFCBCCD0"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF4FBF7F"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A84"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFFFFF"/>

    <!-- Подложка логотипов: логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF19191B"/>

    <!-- Подсветка кода и ссылки в markdown: та же тёмная схема редакторов, что у Carbon -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE5C07B"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFC678DD"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFE06C9F"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF98C379"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7F848E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD19A66"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF56B6C2"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFE5A5A5"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF61AFEF"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8B91"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF7CACF8"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFA8C7FA"/>
</ResourceDictionary>
