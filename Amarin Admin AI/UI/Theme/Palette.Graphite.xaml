<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Пресет «Graphite» — тёмная схема в духе macOS, «space gray».

        Отличие от Dark: там шкала строго нейтральна и акцент белый. Здесь у нейтралей
        едва заметный холодный подтон (синий канал на 2–4 единицы выше красного) — ровно
        столько, чтобы графит не выглядел выцветшим рядом с синим акцентом, и недостаточно,
        чтобы тема читалась синей. Шаг между поверхностями крупнее, чем в Dark: на тёмном
        фоне глаз различает разницу хуже, а карточки должны отделяться от подложки.
    -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF161618"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF242426"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF242426"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF323234"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF444446"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF48484A"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF5A5A5E"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF2A2A2C"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF545456"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFEDEDEF"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE3E3E6"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD1D1D6"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFC7C7CC"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF98989D"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF8A8A8E"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF7C7C80"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент: системный синий, тёмный вариант -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF0A72E6"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF2384F0"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF0859B8"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF30D158"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF74A98A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF453A"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFD70015"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFFF9F0A"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3D3122"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF2A2218"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF2C2C2E"/>


    <!-- Подсветка кода и ссылки в markdown: палитра Xcode, тёмный вариант -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFD9C97C"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFFF7AB2"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFB281EB"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FFFF8170"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7F8C98"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD9C97C"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF5DD8FF"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFACF2E4"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF67B7A4"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FFA8A8AD"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF64B5FF"/>
</ResourceDictionary>
