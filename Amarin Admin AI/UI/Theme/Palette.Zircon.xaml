<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Zircon». Холодный камень: фиолетово-серый корпус без тепла, акцент — ледяная
         лаванда. Самый нейтральный из кристальных, для тех, кому синева Glacier слишком громкая. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF0E0F16"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF111219"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF16171F"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF16171F"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF1B1D26"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF1F2130"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF262838"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF2D2F42"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF33364B"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF454863"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF1B1D26"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF272A38"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF474A62"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFF0F0F6"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE4E4EC"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFCDCDD8"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFB5B5C3"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF9797A6"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF868698"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF6E6E80"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF0E1020"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FFB5B9F0"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FFC9CCF6"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF9295C8"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF66BC8C"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF808F9E"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFFF7F8C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFC4454F"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FFE0B060"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FF33301F"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FF232014"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#99070810"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1D26"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FFC0C3F3"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FFD6D8F9"/>
</ResourceDictionary>
