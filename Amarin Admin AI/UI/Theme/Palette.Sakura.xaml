<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Sakura». Собран из Palette.Light.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFF9F2F4"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFF4EAED"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFFEFEFE"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFFEFEFE"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFF7EFF2"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFF2E7EB"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFEDDBE1"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFE6CED6"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFE0C4CD"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFDAB7C3"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFEDDDE2"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFE3C9D2"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFCD9DAD"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF100E0F"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF1A1617"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF211C1E"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF362D30"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF4F4146"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF6B595F"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF846C74"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF9B858C"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFF3F8"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFA83A6B"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF8B2A55"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFC25C89"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE6D3A0"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFBF3DF"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#4859133A"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF2A1520"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8F5A18"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFA83A6B"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF1F635E"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFA83A6B"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF75204A"/>
</ResourceDictionary>
