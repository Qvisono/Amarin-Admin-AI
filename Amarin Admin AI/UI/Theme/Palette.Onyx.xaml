<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Пресет «Onyx» (1.36.0) — синевато-чёрный, по снимку окна лаунчера, который человек назвал
        «просто красивым цветом»: фон #131518, тонкая рамка #2F3338, приглушённые #77787A–#898A8C.

        Подтон холодный, но едва заметный (синий канал на 5–8 единиц выше красного): тема должна
        читаться почти чёрной, а не синей. Акцент — холодное серебро с голубизной, а не цвет: на
        образце нет ни одного яркого пятна, и цветной акцент спорил бы с самой идеей темы.
    -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF131518"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF0F1114"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF1A1D21"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF1A1D21"/>
    <SolidColorBrush x:Key="Bg.Sheet"    Color="#FF15181B"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF1E2125"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF22262B"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF292D33"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF31363D"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF393E45"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF484E56"/>

    <!-- Рамки: та самая тонкая рамка окна с образца -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF202327"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF2F3338"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF464B52"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFF1F3F5"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE8EAED"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE0E3E7"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC9CDD3"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFB3B8BF"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF898C90"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF77797C"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF62666C"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0E1013"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6F1F3F5"/>

    <!-- Акцент: холодное серебро -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFA9BCD3"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFC3D3E6"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF8EA3BD"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A86"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF352B1A"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF211B11"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#8C05070A"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48FFFFFF"/>

    <!-- Подложка логотипов: логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1E2125"/>


    <!-- Подсветка кода и ссылки в markdown: приглушённая, в холодную сторону -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFD9C38A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF8FB4E6"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFB9A4E0"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9DC08B"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF6F7680"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD7A686"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF84C5C9"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFC7B6E2"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF898C90"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFA9BCD3"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFC9D7E8"/>
</ResourceDictionary>
