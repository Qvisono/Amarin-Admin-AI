<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Terminal». Двухзонная: боковая колонка заметно глубже и зеленее области чата — граница между
         списком и разговором видна сама, без разделителя. Поверхности при этом почти
         нейтральный уголь, а фосфорный зелёный живёт только на акценте и в подсветке кода. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF101211"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF080C0A"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF161A18"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF161A18"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF1A1E1C"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF1D2320"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF222926"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF27302C"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF2C3531"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF3A4741"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF1C2320"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF2A3430"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF46584F"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"     Color="#FFF2F4F3"/>
    <SolidColorBrush x:Key="Text.Body"       Color="#FFE5E8E7"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#FFCFD5D2"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#FFB7C0BB"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#FF929F98"/>
    <SolidColorBrush x:Key="Text.Dim"        Color="#FF7F8E86"/>
    <SolidColorBrush x:Key="Text.Faint"      Color="#FF5F7268"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FF04140A"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF3BD16F"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF5ED989"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF30AB5B"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF4FD17F"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF6E9E82"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFFF7B7B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFBF5C5C"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FFE0AE4A"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FF3A311C"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF252217"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#9C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1A1E1C"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFD7C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF7FD1A8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFA9C8F0"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF8FD694"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF5E7268"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFE0B080"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF7FD2CB"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFC3B6E6"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFD7C98A"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF7E9288"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF5FE08A"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF8CF0AC"/>
</ResourceDictionary>
