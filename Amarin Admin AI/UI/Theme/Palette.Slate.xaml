<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Slate». Собран из Palette.Dark.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF111316"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF15181B"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF181B1F"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF181B1F"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF1C2024"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF1F2329"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF24282E"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF292E35"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF2C323A"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF373E47"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF23272D"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF2C323A"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF454E59"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE9EAEB"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE7E8E9"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD6D8DA"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFC7C9CB"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF96999E"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF85898F"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF6A6D72"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0F151C"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFB4C2D2"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFD1DBE6"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF94A3B4"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48C9D8E8"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1C222A"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFD9C395"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF9DB4CC"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8FBEB8"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFB4C2D2"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFD8E1EA"/>
</ResourceDictionary>
