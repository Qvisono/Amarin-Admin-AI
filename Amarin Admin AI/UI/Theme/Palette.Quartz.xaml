<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Quartz». Розовая, но по-другому, чем Rosé: корпус нейтральный графит, розовый только там,
         где он что-то сообщает. Подсветка кода нарочно оставлена нейтральной, как в Dark, —
         сделай розовой и её, и вернётся ровно то, от чего уходили. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF121013"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF0C0B0D"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF1A181B"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF1A181B"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF1F1D20"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF242126"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF2A282D"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF312E34"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF37343B"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF4A4650"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF231F25"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF302B33"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF4E4755"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"     Color="#FFF3F3F4"/>
    <SolidColorBrush x:Key="Text.Body"       Color="#FFE8E7E9"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#FFD4D2D5"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#FFBEBBC0"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#FF9C98A0"/>
    <SolidColorBrush x:Key="Text.Dim"        Color="#FF8B8690"/>
    <SolidColorBrush x:Key="Text.Faint"      Color="#FF6E6874"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FF16060E"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FFFF6FA8"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FFFF89B8"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FFD15B8A"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFBF5050"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FF3B2E1C"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF271F17"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#9C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1F1D20"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF7E7A82"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF8A8490"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FFFF8FBC"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FFFFB3D1"/>
</ResourceDictionary>
