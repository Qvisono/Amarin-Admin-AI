<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Ochre». Единственная тема в среднем тёмном регистре: остальные сидят на #08–#1C, эта на
         #1D–#26, и это заметно сразу. Подсветка кода своя, в духе Gruvbox — для программы,
         которая круглые сутки показывает PowerShell, это самая видная часть экрана. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF1D1B17"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF171511"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF26231E"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF26231E"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF2B2822"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF302D26"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF38332C"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF3F3A32"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF454037"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF5A5347"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF2E2A24"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF3C372F"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF5F564A"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#FFFBF1C7"/>
    <SolidColorBrush x:Key="Text.Bright"     Color="#FFF1E7BF"/>
    <SolidColorBrush x:Key="Text.Body"       Color="#FFE7DCB7"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#FFD5CAA9"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#FFC2B69A"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#FFA59984"/>
    <SolidColorBrush x:Key="Text.Dim"        Color="#FF958978"/>
    <SolidColorBrush x:Key="Text.Faint"      Color="#FF7C6F64"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FF1D1B17"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FBF1C7"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FFD79921"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FFDEAB49"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FFB07D1B"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FFB8BB26"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF89985A"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFFB4934"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFBC3727"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FFFE8019"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FF4A2F17"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF342517"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#9C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF2B2822"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFD79921"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FFFB4934"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFD3869B"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FFB8BB26"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF928374"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFFE8019"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF8EC07C"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF83A598"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFFABD2F"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FFA89984"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FFE8B33C"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FFF2C65C"/>
</ResourceDictionary>
