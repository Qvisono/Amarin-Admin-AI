<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Steel». Собран из Palette.Light.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFE9EBEC"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE0E4E8"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF0F2F3"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF0F2F3"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFE6E9EC"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFDDE1E6"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFD2D9DF"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFC3CDD6"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFB7C4CF"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFA3B4C2"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFD8DEE3"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFC5CED6"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF99A9B7"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF1F2225"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF282D32"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF2D3339"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF3D454C"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF515B63"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF67727B"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF79858E"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF939EA8"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFF2F7FC"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF3F6E9C"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF2F5A85"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF5A87B2"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF8E5C0E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE2D2A4"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFF9F2E0"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59060A0E"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48123048"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF18222B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF2A5E8C"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF64398F"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3A6A2C"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF737C84"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF964E1D"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF13605B"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF573B85"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF5C666E"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF3F6E9C"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF274E74"/>
</ResourceDictionary>
