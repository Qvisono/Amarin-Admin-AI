<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Cherry». Собран из Palette.Light.xaml: прохладная нейтральная база, вишнёвый акцент -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFECEAEB"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE7E1E3"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF4F2F3"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF4F2F3"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFEBE6E8"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFE4DEE0"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFDED5D9"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFD6CCD1"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFCFC4C9"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFC5B8BE"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFE2DBDE"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFD3C8CD"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFAF9FA6"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF262224"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF2F2A2C"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF363134"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF494246"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF61565B"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF7B6F74"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF92868A"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FFA89CA0"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFF3F6"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFA8213E"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF8A1932"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFBE4257"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF477159"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE7D1A1"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFBF2DF"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF221B1E"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8F5A18"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFA8213E"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF797175"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF1F635E"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF615A5D"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFA8213E"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF751529"/>
</ResourceDictionary>
