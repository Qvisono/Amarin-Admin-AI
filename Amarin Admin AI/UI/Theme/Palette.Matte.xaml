<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Пресет «Matte» — тёмный титан с матовым покрытием.

        Отличие от Graphite: тот берёт холодные нейтрали и системный синий, то есть остаётся
        глянцевым — стекло и подсвеченная плитка. Здесь та же холодная шкала, но всё, чем
        поверхность выдаёт блеск, убрано намеренно.

        Чем матовая поверхность отличается от глянцевой, в четырёх решениях:

        1. Ни чистого белого, ни чистого чёрного. #FFFFFF в тексте на тёмном фоне читается
           как свечение, а свечение — это блик. Верх шкалы остановлен на #EDEFF2.
        2. Шаг между поверхностями ровный, около пяти единиц. У Graphite он рваный
           (1C→32→3A→44→48→5A), и поверхности читаются как разные материалы. Матовое
           покрытие рассеивает свет одинаково, поэтому здесь это разные плоскости одного.
        3. Рамки почти невидимы: Border.Subtle всего на пять единиц выше Bg.Panel. На
           матовом корпусе край держится сменой плоскости, а не светлой линией по ребру.
        4. Акцент и статусы припылены. Системный синий и иосовые #30D158/#FF453A светятся
           сами по себе; пыльная сталь и выцветшие статусы — нет.

        Холодный подтон задан формулой B = R + 3, G = R + 1: ровно столько, чтобы титан не
        выглядел бурым, и недостаточно, чтобы тема читалась синей.
    -->

    <!-- Поверхности: ровная шкала с постоянным шагом -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF17181A"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF141517"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF1C1D20"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF1C1D20"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF212326"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF26282C"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF2B2E32"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF33363B"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF383B41"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF454951"/>

    <!-- Рамки: край держится плоскостью, а не линией -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF212327"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF303338"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF4B4F56"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFEDEFF2"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE4E7EA"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFD8DCE0"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC3C8CE"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFAEB4BB"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF8B9199"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF7B818A"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF6B7179"/>
    <!-- Тушь, а не белила: на мягкой стали белый даёт контраст 3.4 и валит проверку
         читаемости акцентных кнопок, тёмный — 5.6. Тёмный текст на светлой стали это к
         тому же ровно то, как выглядит гравировка на анодированном корпусе. -->
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF0F1114"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6EDEFF2"/>

    <!-- Акцент: пыльная сталь вместо системного синего -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF6E8FB4"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF7F9DBF"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF5D7C9F"/>

    <!-- Статусы: выцветшие, чтобы не светиться на матовом -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF79B58C"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF6E8F7C"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFD98A86"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFB85B55"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FFD4A574"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FF3A342A"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF262219"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#8C101114"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#3AFFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF212326"/>

    <!-- Подсветка кода и ссылки в markdown: пастель, а не Xcode -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFD6C79A"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF9FB4D4"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFB6A8D0"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9DBBA3"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF6E757D"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFC9A98D"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF8FB8C4"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFC3BBD6"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFC7C39B"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8B9199"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF8FAACB"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFA8BFD9"/>
</ResourceDictionary>
