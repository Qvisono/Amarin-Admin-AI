<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Ink». Светлая без тонировки: небелёная бумага остаётся бумагой, цвет один — киноварь.
         Книжная вёрстка, а не «светлая тема с оттенком». -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFF4F1EA"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFEBE7DE"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFFFFDF8"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFFFFDF8"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFF8F6EF"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFF2EFE7"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFE9E5DB"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFDFDACF"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFD7D2C4"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FFBDB5A2"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFE4DFD3"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFD2CBBB"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFA79E8A"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#FF14120E"/>
    <SolidColorBrush x:Key="Text.Bright"     Color="#FF1D1B16"/>
    <SolidColorBrush x:Key="Text.Body"       Color="#FF27241E"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#FF37342D"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#FF49453C"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#FF645F54"/>
    <SolidColorBrush x:Key="Text.Dim"        Color="#FF726C60"/>
    <SolidColorBrush x:Key="Text.Faint"      Color="#FF8A8375"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FFFFF6F2"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E614120E"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FFB33A2B"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF933023"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FFC15D51"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF4A7358"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFB33A2B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFC66B60"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FF8F5D0E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FFCEB996"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFE6DCCB"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FFF8F6EF"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5A14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4E7A"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF39662B"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF7C7266"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF96471C"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF145E5A"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF573B85"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5A14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E574C"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FFB33A2B"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF8A2A1E"/>
</ResourceDictionary>
