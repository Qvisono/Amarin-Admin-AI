<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Cobalt». Собран из Palette.Dark.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF0A1116"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF0D161D"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF0E1922"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF0E1922"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF111E29"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF14222E"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF172835"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF1A2E3E"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF1D3243"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF243E54"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF162734"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF1D3243"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF2E4F6A"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE7EAED"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE5E8EB"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD3D8DD"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFC3CACF"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF8E9BA6"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF7C8B98"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF616F7B"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF04121F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF5AB6FF"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF8ACCFF"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF3E96D8"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48A8DCFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF10202E"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE3C88F"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF5AB6FF"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF7FD8CF"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF74C4FF"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFA5DAFF"/>
</ResourceDictionary>
