<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Neon». Два цвета в разных ролях: маджента — действие, циан — ссылки и типы в коде.
         Второй цвет взят у Link.*, у которого это и есть значение. Статусы не трогаем:
         перекрасить «опасно» ради красоты — значит сделать предупреждение незаметным. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF08070C"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF0C0A12"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF12101A"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF12101A"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF16141F"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF1A1725"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF201C2C"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF252134"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF2A253A"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF3A3350"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF1B1826"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF2A2438"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF473D63"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"     Color="#FFF3F3F5"/>
    <SolidColorBrush x:Key="Text.Body"       Color="#FFE7E6EB"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#FFD3D0D9"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#FFBCB9C6"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#FF9A96A9"/>
    <SolidColorBrush x:Key="Text.Dim"        Color="#FF898399"/>
    <SolidColorBrush x:Key="Text.Faint"      Color="#FF6B6480"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FF14000F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FFFF4FD8"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FFFF6FDF"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FFD141B1"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF4FE89A"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF6E9E87"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFFF5C8A"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FFBF4568"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FFFFC24F"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FF392C19"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF211A13"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#9C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF16141F"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFFFD166"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FFFF6FE0"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFC77DFF"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF8BE86B"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF6B6480"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFFFA45C"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF4FE8FF"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFC8A2FF"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFFFD166"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF8A82A0"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF4FE8FF"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF94F2FF"/>
</ResourceDictionary>
