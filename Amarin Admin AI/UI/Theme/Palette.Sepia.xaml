<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Sepia». Собран из Palette.Light.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFF6F2ED"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFF2ECE4"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFFCFAF8"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFFCFAF8"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFF5F0E9"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFF1E9E0"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFEBE1D5"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFE5D8C7"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFE0D0BC"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFD9C7AF"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFECE2D6"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFE2D4C2"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFCDB595"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF110F0D"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF1B1815"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF221F1B"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF37322C"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF504940"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF6D6357"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF857A6B"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF9C9284"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFDF6EA"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF6B4A28"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF54381C"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF89653D"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FF9A6512"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FFE6D3A0"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFFBF3DF"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48512E00"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF241C12"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF8A5A14"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF6B4A28"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF39625C"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF6B4A28"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF3F2A12"/>
</ResourceDictionary>
