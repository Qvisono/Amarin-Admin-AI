<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Tundra». Шалфей по сланцу: тёплый край холодного семейства, самый тихий из
         четырёх. Акцент низкой насыщенности намеренно — тема для долгого чтения. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFE6EBDF"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFDEE4D6"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFEEF3E8"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFEEF3E8"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFE2E8DA"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFD8DFCF"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFCCD5C1"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFBDC8B2"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFB1BDA5"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF9DAB8E"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFDCE3D4"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFC9D2BC"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFA2AF92"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF20231C"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF282C24"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF30342B"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF41463A"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF565C4E"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF6F7567"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF838A7A"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF9AA292"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF4A5A48"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF3C4A3A"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF5A6C57"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#590B0C08"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF4A5A48"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF36422F"/>
</ResourceDictionary>
