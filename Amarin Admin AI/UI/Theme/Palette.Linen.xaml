<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Linen». Серо-тёплое полотно: корпус холоднее Cream, акцент — шалфей.
         Между Cream и Vellum по температуре, и в этом весь смысл его существования. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFEAE7E1"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFE2DFD8"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFF1EEE8"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFF1EEE8"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFE6E3DC"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFDEDBD3"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFD4D0C7"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFC7C3B9"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFBBB6AB"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FFA8A296"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFE0DDD6"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFD0CBC1"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFABA69A"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF232220"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF2B2A27"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF33322E"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF44423D"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF59574F"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF726F66"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF86837A"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF9D9A8F"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF48634F"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF3A5240"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF56755D"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#590D0B07"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF48634F"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF344A3A"/>
</ResourceDictionary>
