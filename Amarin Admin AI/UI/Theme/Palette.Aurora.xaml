<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Aurora». Сияние над льдом: корпус уходит в тёмную бирюзу, акцент — бледная мята.
         Зелень держится в акценте и состояниях; уйдёт в панель и карточку — вернётся ровно то,
         на что жаловались в Forest. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FF091311"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FF0B1715"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FF0F1E1B"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FF0F1E1B"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FF132522"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FF182823"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FF1E332D"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FF243F37"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FF2A4A41"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FF385F54"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FF142422"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FF1E332E"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FF375C52"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFE9F6F1"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFDDEBE6"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFC4D8D2"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFACC5BD"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF8CA69F"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF7A948C"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF607A73"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF06180F"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF7FE0B4"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF9BEAC6"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF65B893"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF5FC08E"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF7AA391"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFFF7A7A"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFC4453C"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FFE0B060"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FF32311E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FF221F14"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#99030C09"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF132522"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF96E7C3"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FFB6F1D6"/>
</ResourceDictionary>
