<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Amethyst». Собран из Palette.Dark.xaml: нейтральные поверхности
         подкрашены в тон темы, акцент, ссылки и подсветка кода заданы вручную. -->


    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF120C15"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF17101C"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF1A121F"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF1A121F"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF201526"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF24182B"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF291C31"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF302039"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF34233E"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF412C4E"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF281B30"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF34233E"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF523762"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFEAE8EC"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFE9E6EA"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFD9D5DB"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFCAC4CE"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF9C92A2"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF8D8094"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF706577"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF130C22"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FFC7A8FF"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FFDCC6FF"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FFAA88EE"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#7F000000"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48DCC8FF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1E1730"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE9C0A0"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FFC7A8FF"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF7E7E7E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF9FD8C8"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FFCDB2FF"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFE3D3FF"/>
</ResourceDictionary>
