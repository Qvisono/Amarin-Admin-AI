<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Amethyst». Фиолетовый осел на дно: окно и колонка держат камень, а всё, что несёт
         содержимое, — панель, карточка, наведение, выделение — поднимается к нейтральному
         графиту. Прежняя версия красила сиреневым десять поверхностей одинаково, и аметист
         переставал быть камнем в оправе — становился заливкой. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"                Color="#FF100C14"/>
    <SolidColorBrush x:Key="Bg.Sidebar"               Color="#FF140F19"/>
    <SolidColorBrush x:Key="Bg.Panel"                 Color="#FF18131D"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"                 Color="#FF18131D"/>
    <SolidColorBrush x:Key="Bg.Card"                  Color="#FF1D1921"/>
    <SolidColorBrush x:Key="Bg.Raised"                Color="#FF221E26"/>
    <SolidColorBrush x:Key="Bg.Hover"                 Color="#FF28242C"/>
    <SolidColorBrush x:Key="Bg.Selected"              Color="#FF2E2A32"/>
    <SolidColorBrush x:Key="Bg.Track"                 Color="#FF332F37"/>
    <SolidColorBrush x:Key="Bg.Elevated"              Color="#FF3F3B43"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"            Color="#FF1F1A24"/>
    <SolidColorBrush x:Key="Border.Default"           Color="#FF2D2733"/>
    <SolidColorBrush x:Key="Border.Strong"            Color="#FF443D4D"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FFECEBED"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FFE8E7E9"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FFD6D4D8"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FFC4C2C6"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF9A969E"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF89848E"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF6E6A72"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FF0E0818"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"              Color="#FFB491FF"/>
    <SolidColorBrush x:Key="Accent.FillHover"         Color="#FFBEA0FF"/>
    <SolidColorBrush x:Key="Accent.FillPressed"       Color="#FF9B7DDB"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"           Color="#FF5FB878"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"       Color="#FF7A9A82"/>
    <SolidColorBrush x:Key="Status.Danger"            Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"      Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.Warning"           Color="#FFE0A73E"/>
    <SolidColorBrush x:Key="Status.WarningBorder"     Color="#FF3A2E16"/>
    <SolidColorBrush x:Key="Status.WarningSurface"    Color="#FF241C0E"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"            Color="#8C000000"/>
    <SolidColorBrush x:Key="Overlay.Glass"            Color="#48FFFFFF"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"           Color="#FF1D1921"/>

    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"              Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Keyword"             Color="#FF9CB8E8"/>
    <SolidColorBrush x:Key="Code.Control"             Color="#FFC4A8DC"/>
    <SolidColorBrush x:Key="Code.String"              Color="#FF9BB88A"/>
    <SolidColorBrush x:Key="Code.Comment"             Color="#FF777080"/>
    <SolidColorBrush x:Key="Code.Number"              Color="#FFD4A88A"/>
    <SolidColorBrush x:Key="Code.Type"                Color="#FF8FC4C0"/>
    <SolidColorBrush x:Key="Code.Variable"            Color="#FFCBB2E0"/>
    <SolidColorBrush x:Key="Code.Function"            Color="#FFE0C98A"/>
    <SolidColorBrush x:Key="Code.Operator"            Color="#FF8C8593"/>
    <SolidColorBrush x:Key="Link.Default"             Color="#FFBC9CFF"/>
    <SolidColorBrush x:Key="Link.Hover"               Color="#FFC7ACFF"/>
</ResourceDictionary>
