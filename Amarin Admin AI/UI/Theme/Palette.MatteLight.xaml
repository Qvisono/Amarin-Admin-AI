<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Пресет «Matte Light» — светлая половина матовой пары. Мел и керамика, не эмаль.

        Отличие от Silver, ближайшего холодного светлого родственника: там Bg.Panel — чистый
        #FFFFFF, и перепад «белая плитка на сером групповом фоне» читается как глянец. Здесь
        чистого белого нет нигде — ни в одной поверхности, ни в одной рамке. Это и есть
        главное решение темы: белое всегда выглядит подсвеченным, матовое — никогда.

        Остальное — те же правила, что в Matte: ровный шаг между поверхностями, почти
        невидимые рамки, приглушённая сталь в акценте и припылённые статусы.
    -->

    <!-- Поверхности: ровная шкала, верх остановлен до белого -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FFEDEEF0"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFE7E8EB"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFF7F8F9"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FFF7F8F9"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFF2F3F5"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FFE4E6E9"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FFDCDEE2"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FFD2D5DA"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FFC9CCD2"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFBEC2C9"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FFE4E6E9"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FFD2D5DA"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFA9AEB6"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FF1A1C1F"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FF212429"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FF2A2E33"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF3B4047"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF4B5058"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF6C727A"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF868C95"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FFA2A8B0"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6000000"/>

    <!-- Акцент: та же сталь, притемнённая до читаемости белого на ней -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF4A6E96"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF3C5C80"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF5C81AA"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"        Color="#FF3F7D55"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"    Color="#FF5F8A70"/>
    <SolidColorBrush x:Key="Status.Danger"         Color="#FFB04A45"/>
    <SolidColorBrush x:Key="Status.DangerStrong"   Color="#FF8F3833"/>
    <SolidColorBrush x:Key="Status.Warning"        Color="#FF96601F"/>
    <SolidColorBrush x:Key="Status.WarningBorder"  Color="#FFE6DCC6"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FFF6F1E5"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#59101114"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#3A000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF1A1C1F"/>

    <!-- Подсветка кода и ссылки в markdown: пыльный Xcode, без чистых спектральных -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FF7A5A22"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF8E4682"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FF7C3C73"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9C3A33"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF6B747E"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FF3A3F8C"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF24566F"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FF35676C"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FF34655D"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF4B5058"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF3C5C80"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FF2C4763"/>
</ResourceDictionary>
