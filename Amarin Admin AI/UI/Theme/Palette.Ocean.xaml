<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Ocean». Собран из Palette.Dark.xaml: нейтральные поверхности уведены
         в сине-зелёный, акцент, ссылки и подсветка кода заданы вручную. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#FF061014"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FF08161B"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FF0A1B21"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"    Color="#FF0A1B21"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FF0D222A"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#FF102A33"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#FF143440"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FF183E4C"/>
    <SolidColorBrush x:Key="Bg.Track"    Color="#FF1B4655"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FF235A6C"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"  Color="#FF123039"/>
    <SolidColorBrush x:Key="Border.Default" Color="#FF1A4250"/>
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF2E6B7E"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Bright"    Color="#FFE9F6F8"/>
    <SolidColorBrush x:Key="Text.Body"      Color="#FFDCEFF2"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC6E3E8"/>
    <SolidColorBrush x:Key="Text.Tertiary"  Color="#FFA9D2D9"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#FF7FAEB7"/>
    <SolidColorBrush x:Key="Text.Dim"       Color="#FF6C99A2"/>
    <SolidColorBrush x:Key="Text.Faint"     Color="#FF547B84"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#FF04161A"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent" Color="#E6FFFFFF"/>

    <!-- Акцент (инвертированная заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"        Color="#FF4FD1C5"/>
    <SolidColorBrush x:Key="Accent.FillHover"   Color="#FF6FE0D5"/>
    <SolidColorBrush x:Key="Accent.FillPressed" Color="#FF3AB3A8"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"       Color="#FF58C88A"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"   Color="#FF6E9E87"/>
    <SolidColorBrush x:Key="Status.Danger"        Color="#FFFF7B7B"/>
    <SolidColorBrush x:Key="Status.DangerStrong"  Color="#FFC4362B"/>
    <SolidColorBrush x:Key="Status.Warning"       Color="#FFE0AE4A"/>
    <SolidColorBrush x:Key="Status.WarningBorder" Color="#FF35301A"/>
    <SolidColorBrush x:Key="Status.WarningSurface" Color="#FF211E10"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#8C000A0E"/>
    <SolidColorBrush x:Key="Overlay.Glass" Color="#48CFF6FA"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip" Color="#FF0D222A"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"   Color="#FFE3CE95"/>
    <SolidColorBrush x:Key="Code.Keyword"  Color="#FF8FC7E8"/>
    <SolidColorBrush x:Key="Code.Control"  Color="#FFB6AEE4"/>
    <SolidColorBrush x:Key="Code.String"   Color="#FF9BC79A"/>
    <SolidColorBrush x:Key="Code.Comment"  Color="#FF6E8B92"/>
    <SolidColorBrush x:Key="Code.Number"   Color="#FFE0A98A"/>
    <SolidColorBrush x:Key="Code.Type"     Color="#FF7FD2CB"/>
    <SolidColorBrush x:Key="Code.Variable" Color="#FFC3B6E6"/>
    <SolidColorBrush x:Key="Code.Function" Color="#FFE3CE95"/>
    <SolidColorBrush x:Key="Code.Operator" Color="#FF7FA3AB"/>
    <SolidColorBrush x:Key="Link.Default"  Color="#FF7FE0D6"/>
    <SolidColorBrush x:Key="Link.Hover"    Color="#FFA7EFE8"/>
</ResourceDictionary>
