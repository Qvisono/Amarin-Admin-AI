<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Cirrus». Перистое облако: сине-белый корпус, акцент — глубокая ледниковая синь.
         Панель нарочно не белая: чистый белый на всё окно и есть та яркость, от которой
         светлые темы начинали жечь глаза. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFE9EDF1"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFE1E6EC"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFEFF3F6"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFEFF3F6"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFE5EAEF"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFDCE3EA"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFD2DBE4"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFC5D1DD"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFBAC8D6"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FFA8BACB"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFDFE5EB"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFCFD9E3"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFA9BAC9"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF1E2327"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF262C32"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF2E353C"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF3E464F"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF535D67"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF6C7681"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF808B96"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF98A3AE"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF2F6B86"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF23596F"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF3B7F9C"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#59060C12"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF2F6B86"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF1D4F66"/>
</ResourceDictionary>
