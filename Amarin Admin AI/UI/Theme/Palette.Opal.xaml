<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Пресет «Opal». Перламутр: сиреневый отлив по корпусу, акцент — индиго. Отлив держится
         на пределе спокойного - шаг дальше, и тема читается сиреневым светофильтром. -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="Bg.Window"    Color="#FFEBEAF0"/>
    <SolidColorBrush x:Key="Bg.Sidebar"   Color="#FFE3E2EA"/>
    <SolidColorBrush x:Key="Bg.Panel"     Color="#FFF3F2F8"/>
    <!-- Как Bg.Panel, но только для поверхностей внутри окна (поле ввода). Существует
         отдельно, чтобы «стекло» не делало полупрозрачными всплывающие меню и диалоги:
         это отдельные слоистые окна, сквозь них виден рабочий стол, а не фон приложения. -->
    <SolidColorBrush x:Key="Bg.Glass"     Color="#FFF3F2F8"/>
    <SolidColorBrush x:Key="Bg.Card"      Color="#FFE7E6EE"/>
    <SolidColorBrush x:Key="Bg.Raised"    Color="#FFDEDDE8"/>
    <SolidColorBrush x:Key="Bg.Hover"     Color="#FFD4D3E1"/>
    <SolidColorBrush x:Key="Bg.Selected"  Color="#FFC8C6D8"/>
    <SolidColorBrush x:Key="Bg.Track"     Color="#FFBCBACE"/>
    <SolidColorBrush x:Key="Bg.Elevated"  Color="#FFAAA8C0"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="Border.Subtle"   Color="#FFE1E0E9"/>
    <SolidColorBrush x:Key="Border.Default"  Color="#FFD1D0DE"/>
    <SolidColorBrush x:Key="Border.Strong"   Color="#FFAEACC2"/>

    <!-- Текст и иконки -->
    <SolidColorBrush x:Key="Text.Primary"             Color="#FF211F26"/>
    <SolidColorBrush x:Key="Text.Bright"              Color="#FF292731"/>
    <SolidColorBrush x:Key="Text.Body"                Color="#FF312F3A"/>
    <SolidColorBrush x:Key="Text.Secondary"           Color="#FF42404E"/>
    <SolidColorBrush x:Key="Text.Tertiary"            Color="#FF575466"/>
    <SolidColorBrush x:Key="Text.Muted"               Color="#FF706D80"/>
    <SolidColorBrush x:Key="Text.Dim"                 Color="#FF848194"/>
    <SolidColorBrush x:Key="Text.Faint"               Color="#FF9C99AC"/>
    <SolidColorBrush x:Key="Text.OnAccent"            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.PrimaryTranslucent"  Color="#E6000000"/>

    <!-- Акцент (заливка основных кнопок) -->
    <SolidColorBrush x:Key="Accent.Fill"         Color="#FF4A5486"/>
    <SolidColorBrush x:Key="Accent.FillHover"    Color="#FF3C456F"/>
    <SolidColorBrush x:Key="Accent.FillPressed"  Color="#FF5A6499"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="Status.Success"         Color="#FF1F7A46"/>
    <SolidColorBrush x:Key="Status.SuccessSoft"     Color="#FF43775A"/>
    <SolidColorBrush x:Key="Status.Danger"          Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Status.DangerStrong"    Color="#FFA81E12"/>
    <SolidColorBrush x:Key="Status.Warning"         Color="#FF8A5A12"/>
    <SolidColorBrush x:Key="Status.WarningBorder"   Color="#FFDFD09E"/>
    <SolidColorBrush x:Key="Status.WarningSurface"  Color="#FFF4EEDD"/>

    <!-- Оверлеи и прочее -->
    <SolidColorBrush x:Key="Overlay.Scrim"  Color="#59090812"/>
    <SolidColorBrush x:Key="Overlay.Glass"  Color="#48000000"/>

    <!-- Подложка логотипов: одинакова в обеих темах, логотипы вендоров белые -->
    <SolidColorBrush x:Key="Brand.LogoChip"  Color="#FF1B1B1B"/>


    <!-- Подсветка кода и ссылки в markdown -->
    <SolidColorBrush x:Key="Code.Inline"    Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Keyword"   Color="#FF1F4C8F"/>
    <SolidColorBrush x:Key="Code.Control"   Color="#FF6A3A96"/>
    <SolidColorBrush x:Key="Code.String"    Color="#FF3D6B2E"/>
    <SolidColorBrush x:Key="Code.Comment"   Color="#FF76767E"/>
    <SolidColorBrush x:Key="Code.Number"    Color="#FF9A4F1E"/>
    <SolidColorBrush x:Key="Code.Type"      Color="#FF1D6560"/>
    <SolidColorBrush x:Key="Code.Variable"  Color="#FF5E3E8C"/>
    <SolidColorBrush x:Key="Code.Function"  Color="#FF8A5F14"/>
    <SolidColorBrush x:Key="Code.Operator"  Color="#FF5E5E66"/>
    <SolidColorBrush x:Key="Link.Default"   Color="#FF4A5486"/>
    <SolidColorBrush x:Key="Link.Hover"     Color="#FF363E66"/>
</ResourceDictionary>
