<UserControl x:Class="Amarin.UI.AccessibilityBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Размер текста ленты и шрифт кода (I3) — строками той же группы, что масштаб и формат даты,
        а не отдельным разделом «Специальные возможности»: человек ищет их рядом с размером
        интерфейса. Высокая контрастность (I2) живёт у темы, рядом с «Как в Windows».
    -->
    <StackPanel>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="{DynamicResource S.Access.FontSize}"/>
            <ComboBox x:Name="SizeCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="110"
                      AutomationProperties.Name="{DynamicResource S.Access.FontSize}"
                      SelectionChanged="SizeCombo_SelectionChanged">
                <ComboBoxItem Tag="12" Content="{DynamicResource S.Access.SizeSmall}"/>
                <ComboBoxItem Tag="13.5" Content="{DynamicResource S.Access.SizeNormal}"/>
                <ComboBoxItem Tag="15" Content="{DynamicResource S.Access.SizeLarge}"/>
                <ComboBoxItem Tag="17" Content="{DynamicResource S.Access.SizeHuge}"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="{DynamicResource S.Access.CodeFont}"/>
            <ComboBox x:Name="MonoCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="110"
                      AutomationProperties.Name="{DynamicResource S.Access.CodeFont}"
                      ToolTip="{DynamicResource S.Access.CodeFontHint}"
                      SelectionChanged="MonoCombo_SelectionChanged">
                <ComboBoxItem Tag="consolas" Content="Consolas" FontFamily="Consolas"/>
                <ComboBoxItem Tag="cascadia" Content="Cascadia Mono" FontFamily="Cascadia Mono, Consolas"/>
                <ComboBoxItem Tag="courier" Content="Courier New" FontFamily="Courier New"/>
            </ComboBox>
        </Grid>
    </StackPanel>
</UserControl>
