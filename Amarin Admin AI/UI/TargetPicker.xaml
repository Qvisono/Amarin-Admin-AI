<UserControl x:Class="Amarin.UI.TargetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <Grid>
        <ToggleButton x:Name="Toggle" Height="32" Cursor="Hand" Margin="6,0,0,0"
                      AutomationProperties.Name="{DynamicResource S.Remote.PickerTip}"
                      ToolTip="{DynamicResource S.Remote.PickerTip}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6" Padding="8,0,10,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M1,1 L13,1 L13,9 L1,9 Z M5,12 L9,12 M7,9 L7,12" Width="13" Height="12" Stretch="Uniform"
                      Stroke="{DynamicResource Text.Muted}" StrokeThickness="1.3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                <!-- Точка цветом предупреждения: команды уходят не на этот ПК. -->
                <Ellipse x:Name="RemoteDot" Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                         Fill="{DynamicResource Status.Warning}" Visibility="Collapsed"/>
                <TextBlock x:Name="TargetLabel" FontSize="12.5" Margin="6,0,0,0" MaxWidth="140"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <!-- Поля под тень — PopupShadow; смещение держит карточку на 8 выше кнопки, как было. -->
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Top"
               HorizontalOffset="-14" VerticalOffset="14"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border MinWidth="220" MaxWidth="320" Margin="{x:Static local:PopupShadow.Margin}" Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="12" Padding="6"
                    Effect="{x:Static local:PopupShadow.Effect}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Remote.PickerTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Muted}" Margin="8,5,8,4"/>
                    <StackPanel x:Name="Items"/>
                    <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="4,4"/>
                    <Button x:Name="ManageButton" Click="Manage_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="10,6">
                                    <TextBlock Text="{DynamicResource S.Remote.Manage}" FontSize="12"
                                               Foreground="{DynamicResource Link.Default}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
