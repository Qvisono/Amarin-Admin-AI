<UserControl x:Class="Amarin.UI.VoiceSettingsBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Подстраница «Голосовой ввод» (D14): чем распознавать, какой моделью в облаке и на каком
        языке. Под выбором — строка о том, что будет сейчас: какая модель распознаёт или почему
        распознавать нечем. Без неё человек с русским языком перебирал все настройки, а микрофон
        так и не появлялся: русского распознавателя в Windows нет вовсе.
        Модели и языки — списками, а не полями для ввода кода (1.37.0).
        Ниже — чтение ответов вслух: Windows или модель Venice и OpenRouter, голос и скорость.
    -->
    <StackPanel>
    <Border Style="{StaticResource SettingsGroup}">
        <StackPanel>
            <Grid Style="{StaticResource GroupRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Voice.Engine}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <ComboBox x:Name="EngineCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190"
                          AutomationProperties.Name="{DynamicResource S.Voice.Engine}"
                          SelectionChanged="EngineCombo_SelectionChanged">
                    <ComboBoxItem Tag="Auto" Content="{DynamicResource S.Voice.EngineAuto}"/>
                    <ComboBoxItem Tag="Local" Content="{DynamicResource S.Voice.EngineLocal}"/>
                    <ComboBoxItem Tag="Cloud" Content="{DynamicResource S.Voice.EngineCloud}"/>
                </ComboBox>
            </Grid>

            <!-- Черта — вместе со строкой: прячется строка облака, прячется и её черта. -->
            <StackPanel x:Name="CloudRow">
                <Border Style="{StaticResource GroupDivider}"/>
                <Grid Style="{StaticResource GroupRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Voice.Model}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Voice.ModelHint}"/>
                    </StackPanel>
                    <ComboBox x:Name="ModelCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190" MaxWidth="240"
                              AutomationProperties.Name="{DynamicResource S.Voice.Model}"
                              SelectionChanged="ModelCombo_SelectionChanged"/>
                </Grid>
            </StackPanel>

            <Border Style="{StaticResource GroupDivider}"/>
            <Grid Style="{StaticResource GroupRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Voice.Language}"/>
                    <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Voice.LanguageHint}"/>
                </StackPanel>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190" MaxWidth="240"
                          AutomationProperties.Name="{DynamicResource S.Voice.Language}"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>
            </Grid>
        </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource S.Speech.Group}"/>
    <Border Style="{StaticResource SettingsGroup}">
        <StackPanel>
            <Grid Style="{StaticResource GroupRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Speech.Engine}"/>
                    <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Speech.EngineHint}"/>
                </StackPanel>
                <ComboBox x:Name="SpeechModelCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190" MaxWidth="240"
                          AutomationProperties.Name="{DynamicResource S.Speech.Engine}"
                          SelectionChanged="SpeechModelCombo_SelectionChanged"/>
            </Grid>
            <Border Style="{StaticResource GroupDivider}"/>
            <Grid Style="{StaticResource GroupRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Text="{DynamicResource S.Speech.Voice}"/>
                <ComboBox x:Name="SpeechVoiceCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190" MaxWidth="240"
                          AutomationProperties.Name="{DynamicResource S.Speech.Voice}"
                          SelectionChanged="SpeechVoiceCombo_SelectionChanged"/>
            </Grid>
            <Border Style="{StaticResource GroupDivider}"/>
            <Grid Style="{StaticResource GroupRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Text="{DynamicResource S.Speech.Rate}"/>
                <ComboBox x:Name="SpeechRateCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190"
                          AutomationProperties.Name="{DynamicResource S.Speech.Rate}"
                          SelectionChanged="SpeechRateCombo_SelectionChanged">
                    <ComboBoxItem Tag="-3" Content="{DynamicResource S.Speech.RateSlow}"/>
                    <ComboBoxItem Tag="0" Content="{DynamicResource S.Speech.RateNormal}"/>
                    <ComboBoxItem Tag="3" Content="{DynamicResource S.Speech.RateFast}"/>
                </ComboBox>
            </Grid>
        </StackPanel>
    </Border>
    </StackPanel>
</UserControl>
