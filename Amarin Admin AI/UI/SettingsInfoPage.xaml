<UserControl x:Class="Amarin.UI.SettingsInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <!--
        Стили настроек (PageTitle, SettingTitle и прочие) объявлены локально в
        SettingsOverlay.Resources главного окна, и StaticResource из этого файла их не достанет:
        поиск идёт по словарям разметки, а не по дереву. Поэтому шесть общих ключей повторены
        здесь один в один — иначе страница выпадет из общего вида настроек.
    -->
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,9,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Своё для гайда ===== -->

        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,11,12,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!--
            Команду человек копирует, а не перепечатывает: TextBox только для чтения даёт
            выделение мышью, TextBlock — нет.
        -->
        <Style x:Key="CodeLine" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CodeBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="452"/>
        </Style>

        <Style x:Key="Bullet" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Info.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Intro}" Margin="0,0,0,16"/>

            <!-- ═══ Подключение Venice ═══ -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Info.Setup.Section}"/>

            <!-- Шаг 1 -->
            <Border Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Fill="{DynamicResource Accent.Fill}"/>
                        <TextBlock Text="1" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Step1.Title}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Step1.Text}"/>
                        <local:GuideShot FileName="venice-01-signup.png"
                                         Caption="{DynamicResource S.Info.Shot.Signup}"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="{DynamicResource S.Info.Step1.Button}"
                                Click="OpenVeniceButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Шаг 2 -->
            <Border Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Fill="{DynamicResource Accent.Fill}"/>
                        <TextBlock Text="2" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Step2.Title}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Step2.Text}"/>
                        <local:GuideShot FileName="venice-02-credits.png"
                                         Caption="{DynamicResource S.Info.Shot.Credits}"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="{DynamicResource S.Info.Step2.Button}"
                                Click="OpenPricingButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Шаг 3 -->
            <Border Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Fill="{DynamicResource Accent.Fill}"/>
                        <TextBlock Text="3" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Step3.Title}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Step3.Text}"/>
                        <local:GuideShot FileName="venice-03-api-keys.png"
                                         Caption="{DynamicResource S.Info.Shot.Keys}"/>
                        <local:GuideShot FileName="venice-04-key-created.png"
                                         Caption="{DynamicResource S.Info.Shot.KeyCreated}"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="{DynamicResource S.Info.Step3.Button}"
                                Click="OpenApiKeysButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Шаг 4 -->
            <Border Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Fill="{DynamicResource Accent.Fill}"/>
                        <TextBlock Text="4" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Step4.Title}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Step4.Text}"/>
                        <local:GuideShot FileName="setup-05-env-var.png"
                                         Caption="{DynamicResource S.Info.Shot.EnvVar}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Step4.CmdHint}" Margin="0,10,0,0"/>
                        <Border Style="{StaticResource CodeBox}">
                            <TextBox Style="{StaticResource CodeLine}" Text="{DynamicResource S.Info.Step4.Cmd}"/>
                        </Border>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Step4.Restart}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Шаг 5 -->
            <Border Style="{StaticResource StepCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Fill="{DynamicResource Accent.Fill}"/>
                        <TextBlock Text="5" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Step5.Title}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Step5.Text}"/>
                        <local:GuideShot FileName="app-01-chat.png"
                                         Caption="{DynamicResource S.Info.Shot.Chat}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Безопасность ключа ═══ -->
            <Border Background="{DynamicResource Status.WarningSurface}"
                    BorderBrush="{DynamicResource Status.WarningBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,11" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{DynamicResource Alert}" Width="16" Height="16"
                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Safety.Title}"
                                   FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource S.Info.Safety.Config}"/>
                        <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource S.Info.Safety.Chat}"/>
                        <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource S.Info.Safety.Scope}"/>
                        <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource S.Info.Safety.Crash}"/>
                        <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource S.Info.Safety.Revoke}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsDivider}"/>

            <!-- ═══ Как пользоваться ═══ -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Info.Basics.Section}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Basics.Chat.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Basics.Chat.Text}"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Basics.Tools.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Basics.Tools.Text}"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Basics.Confirm.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Basics.Confirm.Text}"/>
            <local:GuideShot FileName="app-02-confirm.png"
                             Caption="{DynamicResource S.Info.Shot.Confirm}"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Basics.Models.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Basics.Models.Text}"/>
            <local:GuideShot FileName="app-03-models.png"
                             Caption="{DynamicResource S.Info.Shot.Models}"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Basics.Cost.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Basics.Cost.Text}"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Basics.Profiles.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Basics.Profiles.Text}"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Basics.Data.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Basics.Data.Text}"/>

            <Border Style="{StaticResource SettingsDivider}"/>

            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Info.Links.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Info.Links.Text}"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="{DynamicResource S.Info.Links.Docs}"
                        Click="OpenDocsButton_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Margin="8,9,0,0"
                        Content="{DynamicResource S.Info.Links.Repo}"
                        Click="OpenRepoButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
