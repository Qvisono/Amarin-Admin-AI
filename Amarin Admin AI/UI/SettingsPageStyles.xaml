<!--
    Общие стили страниц настроек, вынесенные в UserControl. Стили SettingsOverlay.Resources
    главного окна страницам недоступны: StaticResource ищется по словарям разметки, а не по
    дереву. Прежде каждая страница несла свою копию; новые подключают этот словарь.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Amarin.UI">
    <!-- Заголовок страницы крупнее заголовков разделов и диалогов: при 15 он не отличался от
         них и не держал страницу. Начертание прежнее — SemiBold у всех заголовков программы.
         Копии у Key, Info и Instructions повторяют размер: заголовок не должен прыгать между
         страницами (SettingsRedesignTests). Раздел — плотно к своим строкам. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!--
        Группа строк — карточка на подложке настроек. Раньше страница была одним списком через
        черту во всю ширину, и где кончается «уведомления» и начинается «язык», было видно только
        по смыслу. Цвета — те же ключи палитры, что везде: Bg.Panel поверх Bg.Window светлее в
        обеих темах, так что приём работает во всех пресетах без новых ключей.
    -->
    <Style x:Key="SettingsGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,2"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Строка внутри группы и черта между строками: черта уже группы на её поля. -->
    <Style x:Key="GroupRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,11"/>
    </Style>

    <!-- Строка списка моделей: их девять подряд, и с шагом обычной строки страница
         вышла бы вдвое длиннее. -->
    <Style x:Key="GroupRowDense" TargetType="Grid">
        <Setter Property="Margin" Value="0,7"/>
    </Style>

    <!-- По пикселям экрана: при масштабе 150 % черта на полупикселе расплывалась в две
         бледные, и соседние черты одной группы выходили разной толщины. -->
    <Style x:Key="GroupDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Border.Subtle}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Подпись над группой: что в ней собрано. -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        <Setter Property="Margin" Value="4,4,0,7"/>
    </Style>

    <Style x:Key="SettingDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- Пояснение ко всей группе — под её подписью, а не повтором в каждой строке. -->
    <Style x:Key="GroupNote" TargetType="TextBlock" BasedOn="{StaticResource SettingDesc}">
        <Setter Property="Margin" Value="4,-3,0,8"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        <Setter Property="Margin" Value="0,12,0,5"/>
    </Style>

    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="1,5,0,0"/>
    </Style>

    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="FieldFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Fill}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="local:UiMotion.SlideThumb" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource Bg.Track}">
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource Text.Dim}"
                                 HorizontalAlignment="Left" Margin="3,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.Tertiary}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AddButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Path Data="M4,0 L4,8 M0,4 L8,4" Stroke="{DynamicResource Accent.Fill}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="9" Height="9" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconGlyph" TargetType="Path">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>

    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
        <Setter Property="Margin" Value="2,14,0,6"/>
    </Style>

    <Style x:Key="SettingTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
    </Style>

    <Style x:Key="ChipRadio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chip" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="12" Height="24" Padding="11,0">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Та же пилюля, что ChipRadio, для выбора нескольких (дни недели). -->
    <Style x:Key="ChipCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Chip" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="12" Height="24" Padding="11,0">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Карточка списка: вся карточка — кнопка, как у инструкций. -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Card}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="10" Padding="12,11">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Плитка значка слева от карточки. -->
    <Style x:Key="CardGlyphTile" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- Пилюля: параметр, метка, состояние. -->
    <Style x:Key="TagPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,1,8,2"/>
        <Setter Property="Margin" Value="0,6,5,0"/>
        <Setter Property="MaxWidth" Value="190"/>
    </Style>
    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Моноширинное поле: аргументы, скрипты, вывод. -->
    <Style x:Key="CodeTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="False"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <!-- ═══════════ Строки страницы ═══════════ -->

    <!-- Черта между строками — как на страницах 1.27.1. -->
    <Style x:Key="SettingsDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!--
        Вложенный блок из нескольких строк (настройки компактного поля ввода): гаснет вместе
        с переключателем над ним, как и одиночная NestedRow. Без этого выключенные ползунки
        и тумблер выглядели рабочими.
    -->
    <Style x:Key="NestedPanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="18,0,0,11"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Вложенная строка: зависит от строки над ней (звук уведомления, «✕ прячет в трей»). -->
    <Style x:Key="NestedRow" TargetType="Grid">
        <Setter Property="Margin" Value="18,10,0,0"/>
        <Style.Triggers>
            <!-- Строка, которая без родительской ничего не значит, гаснет вместе с ней. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Строка-ссылка на подстраницу: слева заголовок (и, если нужно, строка пояснения), справа
        текущее значение серым и шеврон. Значение — в Tag: так строка читается без захода внутрь.
        Поля -8 по бокам — подсветка наведения выходит чуть за край текста, как у пунктов
        навигации, а сам текст стоит в одну линию с соседними строками.
    -->
    <Style x:Key="SettingsLinkRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="-8,-6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock x:Name="Value" Grid.Column="1" Text="{TemplateBinding Tag}"
                                       FontSize="12" Foreground="{DynamicResource Text.Dim}"
                                       VerticalAlignment="Center" Margin="16,0,10,0" MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"/>
                            <Path x:Name="Chevron" Grid.Column="2" Data="M1,1 L5,5 L1,9" Width="6" Height="10"
                                  Stretch="Uniform" Stroke="{DynamicResource Text.Faint}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Значения ещё нет (страница не наполнена) — нет и пустого места под него. -->
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Secondary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Шапка подстраницы «‹ Заголовок» — она же кнопка «назад». Справа поле 30: над всеми
        страницами настроек в этом углу висит общий крестик, и длинный заголовок уезжал бы под него.
    -->
    <Style x:Key="SubPageBack" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="-8,-4,30,10"/>
        <Setter Property="local:SettingsDrill.IsBack" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="8,4,10,4">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Chevron" Data="M6,1 L1,6 L6,11" Width="7" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="0,1,10,0"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Вкладки внутри страницы (Automation): тот же вид, что у переключателя фона на Appearance —
        залитый акцентом выбранный сегмент, а не обведённая пилюля.
    -->
    <Style x:Key="PageTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="6" Padding="12,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Полужирная копия-невидимка держит ширину: выбранная подпись толще, и без неё
                                 соседние кнопки сдвигались бы на пару точек при каждом переключении. -->
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Visibility="Hidden"/>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Выпадающий список ═══════════ -->

    <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                            Padding="8,5" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="170"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen,
                              RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              Focusable="False" ClickMode="Press" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="8" Height="4" Stretch="Uniform"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          Margin="10,0,26,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <!-- Фон — Bg.Panel, как у всех попапов: у попапа своё окно, и «стекло»
                             (полупрозрачный Bg.Card) показывало бы сквозь список страницу и рабочий
                             стол. Поля — место под тень (PopupShadow); смещение их возвращает, и
                             список встаёт ровно под полем, на 4 ниже его края, как и раньше. -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               VerticalOffset="-12" HorizontalOffset="-16"
                               AllowsTransparency="True" StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Margin="{x:Static local:PopupShadow.Margin}"
                                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="8" Padding="0,3"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220"
                                    Effect="{x:Static local:PopupShadow.Effect}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              local:SmoothScroll.IsEnabled="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Мелкий раскрывающийся пункт (модель SynGuard) =====
         Тот же приём с шевроном, что у ActionExpanderToggle, но по размеру подписи:
         тот занимает строку целиком и уводит шеврон к правому краю, а здесь стрелка
         обязана стоять сразу за текстом, иначе непонятно, что раскрывает. -->
    <Style x:Key="InlineExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path x:Name="Chevron" Data="M0,0 L4,4 L8,0"
                                  Stroke="{DynamicResource Text.Faint}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="9" Height="5" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="7,1,0,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Tertiary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Tertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
