<Window x:Class="Amarin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Amarin.UI"
        WindowStyle="ToolWindow"
        Title="Amarin Admin AI"
        Height="620"
        MinHeight="535"
        Width="1140"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <ResourceDictionary Source="AIlogos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
    CornerRadius="18"
    GlassFrameThickness="1"
    UseAeroCaptionButtons="False"
    CaptionHeight="0"
    ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="#FF0E0E0E" MouseDown="Grid_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Background="#FF131313">
                <Border.Resources>

                    <!-- Заголовок группы чатов -->
                    <Style x:Key="GroupHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#FF5A5A5A"/>
                        <Setter Property="Margin" Value="14,14,6,4"/>
                    </Style>

                    <!-- Пункт списка чатов -->
                    <!-- Пункт списка чатов -->
                    <Style x:Key="ChatItem" TargetType="Button">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="6,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                        CornerRadius="6" Padding="9,0,4,0">
                                        <Grid>
                                            <TextBlock x:Name="Title" Text="{TemplateBinding Content}"
                                   FontSize="12.5" Foreground="#FFC9C9C9"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,2,0"/>
                                            <Border x:Name="Actions" Width="22" Height="22" CornerRadius="4"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" Visibility="Collapsed"
                                ToolTip="Действия" Cursor="Hand">
                                                <TextBlock Text="⋯" FontSize="14" FontWeight="Bold"
                                       Foreground="#FF9A9A9A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,0,2"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FF1F1F1F"/>
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Title" Property="Margin" Value="0,0,26,0"/>
                                        </Trigger>
                                        <Trigger SourceName="Actions" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Actions" Property="Background" Value="#FF2E2E2E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Активный (выбранный) чат -->
                    <Style x:Key="ChatItemActive" TargetType="Button" BasedOn="{StaticResource ChatItem}">
                        <Setter Property="Background" Value="#FF242424"/>
                    </Style>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ClipToBounds="True" x:Name="SideBarScrollViewer" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="2,2,2,0">
                                <!-- Лого приложения -->
                                <Button Margin="6" Height="30" Width="30" HorizontalAlignment="Left" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Image Source="/jeklE-removebg-preview_1.ico" Width="20" Height="20"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF1F1F1F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Margin="6" Height="30" Width="30" HorizontalAlignment="Right"
                                        Cursor="Hand" ToolTip="Свернуть панель">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Path x:Name="Icon"
                                  Data="M 6,2 L 1,7 L 6,12 M 13,2 L 8,7 L 13,12"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="#FF8A8A8A" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF1F1F1F"/>
                                                    <Setter TargetName="Icon" Property="Stroke" Value="#FFEAEAEA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- New Chat: белая primary-кнопка -->
                            <Button Cursor="Hand" Margin="0,5,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="#FFEAEAEA" CornerRadius="6"
                            Margin="6,0,6,4" Height="28">
                                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M6,0 L6,12 M0,6 L12,6"
                                  Stroke="#FF0E0E0E" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Chat" FontSize="11.5"
                                       Foreground="#FF0E0E0E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#FFD4D4D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Поиск -->
                            <!-- Поиск -->
                            <Border Height="28" Margin="6,0,6,6" CornerRadius="6" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FF1F1F1F"/>
                                        <Setter Property="BorderBrush" Value="#FF2E2E2E"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF242424"/>
                                                <Setter Property="BorderBrush" Value="#FF383838"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="#FF242424"/>
                                                <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
              Fill="#FF8A8A8A" Width="12" Height="12" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SearchBox" Grid.Column="1"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 VerticalContentAlignment="Center" FontSize="12"
                 Foreground="#FFEAEAEA" CaretBrush="#FFEAEAEA"/>
                                    <TextBlock Grid.Column="1" Text="Поиск" FontSize="12" Foreground="#FF6E6E6E"
                   VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <!-- ===== СПИСОК ЧАТОВ ===== -->

                            <TextBlock Style="{StaticResource GroupHeader}" Text="Сегодня" Margin="14,6,6,4"/>
                            <Button Style="{StaticResource ChatItemActive}" Content="Ночная сводка"/>
                            <Button Style="{StaticResource ChatItem}" Content="Ошибки 500 в проде"/>
                            <Button Style="{StaticResource ChatItem}" Content="Экспорт в CSV"/>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="Вчера"/>
                            <Button Style="{StaticResource ChatItem}" Content="Миграция PostgreSQL"/>
                            <Button Style="{StaticResource ChatItem}" Content="Права модератора"/>
                            <Button Style="{StaticResource ChatItem}" Content="Метрики за июль"/>
                            <Button Style="{StaticResource ChatItem}" Content="Ротация бэкапов"/>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="Ранее"/>
                            <Button Style="{StaticResource ChatItem}" Content="Медленные запросы"/>
                            <Button Style="{StaticResource ChatItem}" Content="Webhook для алертов"/>
                            <Button Style="{StaticResource ChatItem}" Content="Ревизия API-ключей"/>
                            <Button Style="{StaticResource ChatItem}" Content="Логи nginx"/>
                            <Button Style="{StaticResource ChatItem}" Content="Сертификаты TLS"/>
                            <Button Style="{StaticResource ChatItem}" Content="Инвентаризация VM"/>
                            <Button Style="{StaticResource ChatItem}" Content="Инциденты Q2"/>
                            <Button Style="{StaticResource ChatItem}" Content="Чистка сессий"/>
                            <Button Style="{StaticResource ChatItem}" Content="Аудит аккаунтов"/>
                            <Button Style="{StaticResource ChatItem}" Content="Нагрузочные тесты"/>
                            <Button Style="{StaticResource ChatItem}" Content="Хранение логов"/>
                            <Button Style="{StaticResource ChatItem}" Content="Деплой 2.4"/>

                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1">
                        <Grid Height="40" Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24" Height="24" CornerRadius="6" Background="#FF2A2A2A" VerticalAlignment="Center">
                                <TextBlock Text="Г" FontSize="11" FontWeight="SemiBold" Foreground="#FFD8D8D8"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Гость" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFE8E8E8"/>
                                <TextBlock Text="Локальный режим" FontSize="9.5" Foreground="#FF6A6A6A"/>
                            </StackPanel>

                            <Button Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center"
                                    Cursor="Hand" Click="Button_Click_3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                            <Path x:Name="Icon" Width="13" Height="13" Stretch="Uniform" Fill="#FF7A7A7A"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19.14,12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6 3.6,1.62,3.6,3.6-1.62,3.6-3.6,3.6z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF262626" TargetName="Bg"/>
                                                <Setter Property="Fill" Value="#FFEAEAEA" TargetName="Icon"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1" x:Name="Chat">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="125"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" ClipToBounds="True"
              x:Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="27,18,20,10" MaxWidth="1070" x:Name="MessagesPanel">
                            <StackPanel.Resources>

                                <!-- ===== Галка выполненного инструмента ===== -->
                                <Style x:Key="ToolDoneIcon" TargetType="Path">
                                    <Setter Property="Data" Value="M0,4 L3.5,7.5 L10,0"/>
                                    <Setter Property="Stroke" Value="#FF5FB878"/>
                                    <Setter Property="StrokeThickness" Value="1.6"/>
                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                    <Setter Property="StrokeLineJoin" Value="Round"/>
                                    <Setter Property="Width" Value="10"/>
                                    <Setter Property="Height" Value="8"/>
                                    <Setter Property="Stretch" Value="Uniform"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>

                                <!-- ===== Превью результата ===== -->
                                <Style x:Key="ToolResult" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#FF7A9A82"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>

                                <!-- ===== Разделитель шагов ===== -->
                                <Style x:Key="ToolStepDivider" TargetType="Border">
                                    <Setter Property="Height" Value="1"/>
                                    <Setter Property="Background" Value="#FF1E1E1E"/>
                                    <Setter Property="Margin" Value="4,6"/>
                                </Style>

                                <!-- ===== ПУЗЫРЬ ПОЛЬЗОВАТЕЛЯ (справа) ===== -->
                                <Style x:Key="UserBubble" TargetType="Border">
                                    <Setter Property="Background" Value="#FF1F1F1F"/>
                                    <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="12,12,3,12"/>
                                    <Setter Property="Padding" Value="14,9"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="MaxWidth" Value="560"/>
                                    <Setter Property="Margin" Value="60,0,0,18"/>
                                </Style>
                                <Style x:Key="UserBubbleText" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFE8E8E8"/>
                                    <Setter Property="FontSize" Value="13.5"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="19"/>
                                </Style>

                                <!-- ===== ТЕКСТ ИИ (без пузыря) ===== -->
                                <Style x:Key="AiText" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFDCDCDC"/>
                                    <Setter Property="FontSize" Value="13.5"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="21"/>
                                </Style>

                                <!-- ===== ЛОГО ИИ ===== -->
                                <Style x:Key="AiLogoBorder" TargetType="Border">
                                    <Setter Property="Width" Value="28"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Background" Value="#FF1C1C1C"/>
                                    <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0,0,11,0"/>
                                </Style>

                                <!-- ===== МЕТА-ШАПКА СООБЩЕНИЯ ИИ ===== -->
                                <Style x:Key="AiMetaText" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#FF8A8A8A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="AiMetaDot" TargetType="Ellipse">
                                    <Setter Property="Width" Value="3"/>
                                    <Setter Property="Height" Value="3"/>
                                    <Setter Property="Fill" Value="#FF4A4A4A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="7,1,7,0"/>
                                </Style>

                                <!-- ===== СТРОКА ИНСТРУМЕНТА ===== -->
                                <Style x:Key="ToolRow" TargetType="Grid">
                                    <Setter Property="Margin" Value="4,3"/>
                                </Style>
                                <Style x:Key="ToolIcon" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Width" Value="20"/>
                                    <Setter Property="Foreground" Value="#FF8A8A8A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="ToolPendingIcon" TargetType="TextBlock" BasedOn="{StaticResource ToolIcon}">
                                    <Setter Property="Foreground" Value="#FFC9C9C9"/>
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.25" Duration="0:0:0.6"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="ToolName" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#FFB8B8B8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                                <Style x:Key="ToolArgs" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#FF6E6E6E"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>

                                <!-- ===== ЭКСПАНДЕР "ЗАПУСКАЮ ИНСТРУМЕНТЫ" ===== -->
                                <Style x:Key="ToolsExpander" TargetType="Expander">
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <Border Background="#FF141414" BorderBrush="#FF232323"
                                    BorderThickness="1" CornerRadius="8"
                                    HorizontalAlignment="Left" MinWidth="280">
                                                    <StackPanel>
                                                        <!-- Шапка -->
                                                        <ToggleButton IsChecked="{Binding IsExpanded,
                                        RelativeSource={RelativeSource TemplatedParent},
                                        Mode=TwoWay}"
                                        Cursor="Hand">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="HeadBg" Background="Transparent"
                                                        CornerRadius="8" Padding="10,7">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Path x:Name="Chevron"
                                                              Data="M0,0 L4,4 L0,8"
                                                              Stroke="#FF7A7A7A" StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Width="5" Height="9" Stretch="Uniform"
                                                              VerticalAlignment="Center"
                                                              Margin="1,0,9,0"
                                                              RenderTransformOrigin="0.5,0.5">
                                                                                <Path.RenderTransform>
                                                                                    <RotateTransform Angle="0"/>
                                                                                </Path.RenderTransform>
                                                                            </Path>
                                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HeadBg"
                                                                Property="Background" Value="#FF1B1B1B"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Chevron"
                                                                Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <ContentPresenter Content="{TemplateBinding Header}"/>
                                                        </ToggleButton>
                                                        <!-- Содержимое -->
                                                        <Border x:Name="Body" Visibility="Collapsed"
                                            BorderBrush="#FF1E1E1E" BorderThickness="0,1,0,0"
                                            Padding="8,5,10,7">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="ExpanderHeaderText" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#FF9A9A9A"/>
                                </Style>

                                <!-- ══════════════════════════════════════════════════ -->
                                <!-- ===== НОВОЕ: КНОПКИ ДЕЙСТВИЙ ПОД СООБЩЕНИЯМИ ===== -->
                                <!-- ══════════════════════════════════════════════════ -->

                                <!-- Контейнер ряда кнопок -->
                                <Style x:Key="ActionsRow" TargetType="StackPanel">
                                    <Setter Property="Orientation" Value="Horizontal"/>
                                </Style>

                                <!-- Маленькая иконка-кнопка (Copy / Regenerate / Delete и т.д.) -->
                                <Style x:Key="MsgActionButton" TargetType="Button">
                                    <Setter Property="Width" Value="26"/>
                                    <Setter Property="Height" Value="26"/>
                                    <Setter Property="Margin" Value="0,0,2,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
