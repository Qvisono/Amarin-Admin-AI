<Window x:Class="Amarin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Amarin.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        Title="Amarin Admin AI"
        Height="620"
        MinHeight="535"
        Width="1140"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <!--
                    Design-time only. At runtime the palette, icons and vendor logos come
                    from ThemeManager, which swaps three Application-level dictionaries so
                    the theme can flip Light/Dark live. The XAML designer never runs
                    ThemeManager, so without these every {DynamicResource} falls back to an
                    unstyled default and the window renders all-white. mc:Ignorable="d"
                    strips the d:-prefixed entries out of the runtime load, so they add
                    nothing (and cannot shadow the live theme) in the built app.
                -->
                <ResourceDictionary d:Source="Theme/Palette.Dark.xaml"/>
                <ResourceDictionary d:Source="Theme/Icons.Dark.xaml"/>
                <ResourceDictionary d:Source="Theme/AiLogos.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
    CornerRadius="18"
    GlassFrameThickness="1"
    UseAeroCaptionButtons="False"
    CaptionHeight="0"
    ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource Bg.Window}" MouseDown="Grid_MouseDown">
        <Grid x:Name="ScaledRoot">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="184"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarBorder" Background="{DynamicResource Bg.Sidebar}">
                <Border.Resources>

                    <!-- Заголовок группы чатов -->
                    <Style x:Key="GroupHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                        <Setter Property="Margin" Value="14,14,6,4"/>
                    </Style>

                    <!-- Пункт списка чатов -->
                    <!-- Пункт списка чатов -->
                    <Style x:Key="ChatItem" TargetType="Button">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="6,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                        CornerRadius="6" Padding="9,0,4,0">
                                        <Grid>
                                            <TextBlock x:Name="Title" Text="{TemplateBinding Content}"
                                   FontSize="12.5" Foreground="{DynamicResource Text.Tertiary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,2,0"/>
                                            <Button x:Name="Actions" Width="22" Height="22"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="Collapsed"
                                ToolTip="Действия" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ActionsBg" Background="Transparent" CornerRadius="4">
                                                            <TextBlock Text="⋯" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,0,2"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ActionsBg" Property="Background" Value="{DynamicResource Bg.Track}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Title" Property="Margin" Value="0,0,26,0"/>
                                        </Trigger>
                                        <!-- Keep the affordance up while its menu is open, or it
                                             vanishes the moment the pointer leaves the row. -->
                                        <Trigger SourceName="Actions" Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Title" Property="Margin" Value="0,0,26,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Активный (выбранный) чат -->
                    <Style x:Key="ChatItemActive" TargetType="Button" BasedOn="{StaticResource ChatItem}">
                        <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                    </Style>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ClipToBounds="True" x:Name="SideBarScrollViewer" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="2,2,2,0">
                                <!-- Лого приложения -->
                                <Button x:Name="SidebarLogoButton" Margin="6" Height="30" Width="30" HorizontalAlignment="Left"
                                        Cursor="Hand" Click="SidebarLogoButton_Click"
                                        MouseEnter="SidebarLogoButton_MouseEnter"
                                        MouseLeave="SidebarLogoButton_MouseLeave">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Grid>
                                                    <Image x:Name="LogoImage" Source="/jeklE-removebg-preview_1.ico" Width="20" Height="20"/>
                                                    <Path x:Name="ExpandIcon" Visibility="Collapsed"
                                                          Data="M 2,2 L 7,7 L 2,12 M 8,2 L 13,7 L 8,12"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{DynamicResource Text.Bright}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="CollapseSidebarButton" Margin="6" Height="30" Width="30" HorizontalAlignment="Right"
                                        Cursor="Hand" ToolTip="Свернуть панель" Click="CollapseSidebarButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Path x:Name="Icon"
                                  Data="M 6,2 L 1,7 L 6,12 M 13,2 L 8,7 L 13,12"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- New Chat: белая primary-кнопка -->
                            <Button x:Name="NewChatButton" Cursor="Hand" Margin="0,5,0,0" Click="NewChatButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6"
                            Margin="6,0,6,4" Height="28">
                                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="NewChatPlus" Data="M6,0 L6,12 M0,6 L12,6"
                                  Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="NewChatLabel" Text="New Chat" FontSize="11.5"
                                       Foreground="{DynamicResource Text.OnAccent}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Поиск -->
                            <!-- Поиск -->
                            <Border x:Name="SearchBorder" Height="28" Margin="6,0,6,6" CornerRadius="6" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
              Fill="{DynamicResource Text.Dim}" Width="12" Height="12" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SearchBox" Grid.Column="1"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 VerticalContentAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource Text.Bright}" CaretBrush="{DynamicResource Text.Bright}"
                 TextChanged="SearchBox_TextChanged"/>
                                    <TextBlock Grid.Column="1" Text="Поиск" FontSize="12" Foreground="{DynamicResource Text.Faint}"
                   VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <!-- ===== СПИСОК ЧАТОВ ===== -->
                            <StackPanel x:Name="ChatListPanel"/>

                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" x:Name="SidebarFooter">
                        <Grid Height="40" Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccountAvatar" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Bg.Selected}"
                                    VerticalAlignment="Center" local:RoundedClip.Radius="6">
                                <Grid>
                                    <TextBlock x:Name="SidebarAvatarLetter" Text="Г" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="SidebarAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="AccountLabels" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarAccountName" Text="Гость" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock x:Name="SidebarAccountMode" Text="Локальный режим" FontSize="9.5" Foreground="{DynamicResource Text.Faint}"/>
                            </StackPanel>

                            <Button x:Name="SettingsButton" Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center"
                                    Cursor="Hand" Click="Button_Click_3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                            <Path x:Name="Icon" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource Text.Dim}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19.14,12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6 3.6,1.62,3.6,3.6-1.62,3.6-3.6,3.6z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Bg.Hover}" TargetName="Bg"/>
                                                <Setter Property="Fill" Value="{DynamicResource Text.Bright}" TargetName="Icon"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1" x:Name="Chat">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <!-- Auto, not fixed: the composer grows when image thumbnails are attached. -->
                        <RowDefinition Height="Auto" MinHeight="125"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" ClipToBounds="True"
              x:Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="27,18,20,10" MaxWidth="1070" x:Name="MessagesPanel">
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" x:Name="ComposerBorder" Margin="27,0,27,20"
                            Background="{DynamicResource Bg.Panel}" MaxWidth="1070"
                            CornerRadius="6" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                            AllowDrop="True" PreviewDragOver="Composer_DragOver" Drop="Composer_Drop">
                        <Border.Resources>
                            <Style x:Key="ToolIconButton" TargetType="Button">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                            <Style x:Key="PrimaryActionButton" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6" Padding="16,0">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- ===== Бейдж-иконка пункта меню ===== -->
                            <Style x:Key="ActionBadge" TargetType="Border">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="CornerRadius" Value="7"/>
                                <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>

                            <Style x:Key="ActionBadgeIcon" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ActionTitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ActionSubtitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,1,0,0"/>
                            </Style>

                            <!-- ===== Простой пункт (Attach) ===== -->
                            <Style x:Key="ActionItem" TargetType="Button">
                                <Setter Property="Height" Value="46"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="6">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ===== Раскрывающийся пункт (Summarize video) ===== -->
                            <Style x:Key="ActionExpanderToggle" TargetType="ToggleButton">
                                <Setter Property="Height" Value="46"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="6">
                                                <Grid>
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron" Data="M0,0 L4,4 L8,0"
                                  Stroke="{DynamicResource Text.Faint}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="9" Height="5" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Card}"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Tertiary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ===== Плейсхолдер-текстбокс ===== -->
                            <Style x:Key="PopupUrlTextBox" TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                                <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="9,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <!-- ===== Сегментированный переключатель ===== -->
                            <Style x:Key="SegmentedOption" TargetType="RadioButton">
                                <Setter Property="GroupName" Value="SummarizeMode"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Height" Value="27"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bg" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="6">
                                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="10.5"
                                   Foreground="{DynamicResource Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>

                        <Grid Margin="14,10,14,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition MinHeight="45"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <!-- ===== ПРИКРЕПЛЁННЫЕ ИЗОБРАЖЕНИЯ ===== -->
                            <StackPanel x:Name="AttachedImagesHost" Grid.Row="0" Visibility="Collapsed"
                                        Margin="0,0,0,8">
                                <ItemsControl x:Name="AttachedImagesPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="AttachedImagesWarning" Visibility="Collapsed"
                                           FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Status.Warning}"/>
                            </StackPanel>

                            <!-- ===== ПОЛЕ ВВОДА ===== -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <TextBox x:Name="MessageTextBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Text.Bright}" CaretBrush="{DynamicResource Text.Bright}"
                     FontSize="13.5"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0"
                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"/>
                                <TextBlock Text="Спросите что-нибудь..." FontSize="14.5"
                       Foreground="{DynamicResource Text.Faint}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MessageTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- ===== ТУЛБАР ===== -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Кнопка "+" (прикрепить/добавить контекст) -->
                                <ToggleButton x:Name="AttachButton" Grid.Column="0" Width="32" Height="32"
              Margin="0,0,6,0" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6">
                                                <Path x:Name="PlusIcon" Data="M7,0 L7,14 M0,7 L14,7"
                      Stroke="{DynamicResource Text.Tertiary}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="13" Height="13" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                    <Setter TargetName="PlusIcon" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="45"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="ActionsPopup"
       PlacementTarget="{Binding ElementName=AttachButton}"
       Placement="Top"
       VerticalOffset="-8"
       AllowsTransparency="True"
       StaysOpen="False"
       PopupAnimation="Fade"
       IsOpen="{Binding IsChecked, ElementName=AttachButton, Mode=TwoWay}">
                                    <Border Width="300" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="1" CornerRadius="12" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Actions" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Muted}" Margin="8,6,8,4"/>

                                            <Button x:Name="AttachImageButton" Style="{StaticResource ActionItem}"
                                                    Click="AttachImageButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource ActionBadge}">
                                                        <Image Source="{DynamicResource attach}" Margin="6" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform/>
                                                                    <SkewTransform/>
                                                                    <RotateTransform Angle="40"/>
                                                                    <TranslateTransform/>
                                                                </TransformGroup>
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ActionTitle}" Text="Attach image/document"/>
                                                        <TextBlock Style="{StaticResource ActionSubtitle}" Text="Фото, PDF, документы"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                            <!-- Summarize video -->
                                            <ToggleButton x:Name="SummarizeToggle" Style="{StaticResource ActionExpanderToggle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource ActionBadge}">
                                                        <TextBlock Style="{StaticResource ActionBadgeIcon}" Text="▶"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ActionTitle}" Text="Summarize video"/>
                                                        <TextBlock Style="{StaticResource ActionSubtitle}" Text="YouTube-ссылка"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ToggleButton>

                                            <Border Margin="4,4,4,4" Padding="10" Background="{DynamicResource Bg.Card}"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=SummarizeToggle}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
            CornerRadius="6" Height="30">
                                                        <Grid>
                                                            <TextBox x:Name="YoutubeUrlBox" Style="{StaticResource PopupUrlTextBox}"/>
                                                            <TextBlock Text="https://youtube.com/watch?v=..." FontSize="11.5"
                       Foreground="{DynamicResource Text.Faint}" Margin="9,0" VerticalAlignment="Center"
                       IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=YoutubeUrlBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="RawTranscriptOption" Grid.Column="0" Style="{StaticResource SegmentedOption}"
                     Content="Raw Transcript" IsChecked="True" Margin="0,0,3,0"/>
                                                        <RadioButton x:Name="InfographicOption" Grid.Column="1" Style="{StaticResource SegmentedOption}"
                     Content="Create Infographic" Margin="3,0,0,0"/>
                                                    </Grid>

                                                    <TextBlock x:Name="SummarizeError" FontSize="11" Margin="2,8,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed"
                     Foreground="{DynamicResource Status.Danger}"/>

                                                    <Button x:Name="SummarizeStartButton" Style="{StaticResource PrimaryActionButton}"
                     Content="Начать" Margin="0,10,0,0" Click="SummarizeStartButton_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                
                                <!-- Селектор модели AI -->
                                <!-- Селектор модели AI -->
                                <ToggleButton x:Name="ModelButton" Grid.Column="2" Height="32" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6" Padding="6,0,10,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Width="20" Height="20" Margin="0,0,5,0">
                                                        <Image x:Name="ModelButtonLogo" Source="{DynamicResource Claude}" Width="20" Height="20"/>
                                                        <Path x:Name="ModelButtonLightning" Data="M6,0 L1,8 L5,8 L4,14 L10,5 L6,5 Z"
                              Fill="{DynamicResource Text.Muted}" Width="9" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="ModelButtonLetter" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock x:Name="ModelButtonLabel" Text="Claude Sonnet 5" FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="9" Height="5" Stretch="Uniform"
                          Margin="7,0,0,0" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="ModelPicker"
       PlacementTarget="{Binding ElementName=ModelButton}"
       Placement="Top"
       VerticalOffset="-8"
       AllowsTransparency="True"
       StaysOpen="False"
       PopupAnimation="Fade"
       IsOpen="{Binding IsChecked, ElementName=ModelButton, Mode=TwoWay}"
       Opened="ModelPicker_Opened">

                                    <Grid>
                                    <local:ModelPickerPanel x:Name="ChatModelPicker"
                                                            AllowAuto="True"
                                                            ModelPicked="ChatModelPicker_ModelPicked"/>
                                    <Border Visibility="Collapsed" Width="250" Height="320" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="1" CornerRadius="10" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                                        </Border.Effect>

                                        <Border.Resources>

                                            <!-- ===== Вкладка ===== -->
                                            <Style x:Key="PickerTab" TargetType="RadioButton">
                                                <Setter Property="GroupName" Value="ModelPickerTabs"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Height" Value="24"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Track}"/>
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- ===== Заголовок категории ===== -->
                                            <Style x:Key="PickerGroupHeader" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="9.5"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                                <Setter Property="Margin" Value="8,8,6,3"/>
                                            </Style>

                                            <!-- ===== Пункт модели (однострочный) ===== -->
                                            <Style x:Key="ModelItem" TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Height" Value="28"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="7,0">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- ===== Тексты пункта ===== -->
                                            <Style x:Key="ModelName" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
