                                                                <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="Авто"/>
                                                            </Grid>
                                                        </Button>

                                                        <Button Style="{StaticResource ModelItem}" ToolTip="claude-sonnet-5 · 1M · Reason, Vision, Code">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image Source="{DynamicResource Claude}" Width="15" Height="15"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="Claude Sonnet 5"/>
                                                                <Path Grid.Column="2" Style="{StaticResource SelectedCheck}"/>
                                                            </Grid>
                                                        </Button>

                                                        <Button Style="{StaticResource ModelItem}" ToolTip="grok-4-6 · 256k · Reason, Code">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image Source="{DynamicResource Grok}" Width="13" Height="13"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="Grok 4.6"/>
                                                            </Grid>
                                                        </Button>

                                                        <Button Style="{StaticResource ModelItem}" ToolTip="qwen-3-7-plus · 128k · Vision, Code">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Q" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                                <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="Qwen 3.7 Plus"/>
                                                            </Grid>
                                                        </Button>

                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>

                                        </Grid>
                                    </Border>
                                    </Grid>
                                </Popup>
                                
                                <!-- Кнопка отправки -->
                                <Button x:Name="SendButton" Grid.Column="4" Width="32" Height="32" Cursor="Hand" Click="SendButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="8">
                                                <Path Data="M6,11 L6,1 M1,5 L6,0 L11,5"
                                  Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent.FillHover}" TargetName="Bg"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid VerticalAlignment="Center" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleUrbanist}" Text="Amarin Admin AI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1">
                        <Border Width="32" Height="32" x:Name="Warn"
        Background="Transparent"
        CornerRadius="4"
        ToolTipService.Placement="Custom"
        ToolTipService.HorizontalOffset="0"
        ToolTipService.VerticalOffset="6"
        ToolTipService.InitialShowDelay="150"
        ToolTipService.ShowDuration="20000">
                            <Border.ToolTip>
                                <ToolTip Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 HasDropShadow="False">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <!-- Стрелка, указывающая на иконку -->
                                                <Path Grid.Row="0"
                              Data="M0,6 L6,0 L12,6 Z"
                              Fill="{DynamicResource Bg.Card}"
                              Stroke="{DynamicResource Status.WarningBorder}"
                              StrokeThickness="1"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,-1"/>

                                                <!-- Тело подсказки -->
                                                <Border Grid.Row="1"
                                Width="230"
                                Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Status.WarningBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠"
                                           FontSize="13"
                                           Foreground="{DynamicResource Status.Warning}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,8,0"/>
                                                        <TextBlock Text="Not running as administrator: many features are unavailable"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           MaxWidth="196"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Border.ToolTip>

                            <Image Source="{DynamicResource Alert}"
           Stretch="Uniform"
           Margin="6" />
                        </Border>
                        <Button Style="{StaticResource LockChromeButton}"
                                Tag="{DynamicResource Minimize}"
                                Click="Button_Click_1"/>
                        <Button Style="{StaticResource LockChromeButton}"
                                Tag="{DynamicResource Maximize}"
                                Click="Button_Click_2"/>
                        <Button Style="{StaticResource LockChromeCloseButton}"
                                Tag="{DynamicResource Close}"
                                Click="Button_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
            <Grid.Resources>
                <!-- ===== Кнопка "Сохранить" для промптов ===== -->
                <Style x:Key="SavePromptButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M0,3.5 L3,6.5 L8,0" Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="9" Height="7" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Сохранить" FontSize="11.5"
                                   Foreground="{DynamicResource Text.OnAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Elevated}"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- ===== Пункт навигации ===== -->
                <Style x:Key="SettingsNavItem" TargetType="RadioButton">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Margin" Value="8,1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="GroupName" Value="SettingsNav"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,0">
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       FontSize="12.5" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Body}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="SettingsNavGroup" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                    <Setter Property="Margin" Value="18,14,8,4"/>
                </Style>

                <!-- ===== Тумблер ===== -->
                <Style x:Key="SettingsToggle" TargetType="CheckBox">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource Bg.Track}">
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource Text.Dim}"
                                     HorizontalAlignment="Left" Margin="3,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                        <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.Tertiary}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsChecked" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                        <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Тексты ===== -->
                <Style x:Key="PageTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                    <Setter Property="Margin" Value="0,0,0,14"/>
                </Style>
                <Style x:Key="SectionTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                    <Setter Property="Margin" Value="0,4,0,8"/>
                </Style>
                <Style x:Key="SettingTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
                </Style>
                <Style x:Key="SettingDesc" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Margin" Value="0,3,0,0"/>
                </Style>
                <Style x:Key="SettingsDivider" TargetType="Border">
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                    <Setter Property="Margin" Value="0,12"/>
                </Style>

                <!-- ===== Вторичная кнопка (Manage/Open...) ===== -->
                <Style x:Key="SecondaryButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Опасная кнопка ===== -->
                <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                </Style>

                <!-- ===== ComboBox ===== -->
                <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                                Padding="8,5" Margin="3,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="DarkComboBox" TargetType="ComboBox">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Height" Value="28"/>
                    <Setter Property="MinWidth" Value="170"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                                                    <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="8" Height="4" Stretch="Uniform"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="10,0,26,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   VerticalOffset="4" AllowsTransparency="True" StaysOpen="False"
                                   PopupAnimation="Fade">
                                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1" CornerRadius="8" Padding="0,3"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Многострочный промпт ===== -->
                <Style x:Key="PromptTextBox" TargetType="TextBox">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                    <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="AcceptsReturn" Value="True"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="MinHeight" Value="64"/>
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="8,6">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Карточка темы ===== -->
                <Style x:Key="ThemeCard" TargetType="RadioButton">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="GroupName" Value="Theme"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bg" Width="110" Height="56" Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path x:Name="Check" Data="M0,3 L3,6 L8,0" Stroke="{DynamicResource Text.Bright}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="9" Height="7" Stretch="Uniform" Visibility="Collapsed"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </Grid.Resources>

            <!-- Затемнение -->
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="SettingsCloseButton_Click"></Button>
            </Border>

            <!-- Окно -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Width="640" Height="460" Background="{DynamicResource Bg.Panel}"
            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== НАВИГАЦИЯ ===== -->
                    <Border Background="{DynamicResource Bg.Sidebar}" CornerRadius="10,0,0,10"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsNavGroup}" Text="GENERAL" Margin="18,16,8,4"/>
                                <RadioButton x:Name="NavAccount" Style="{StaticResource SettingsNavItem}" Content="Account"/>
                                <RadioButton x:Name="NavAppearance" Style="{StaticResource SettingsNavItem}" Content="Appearance"/>
                                <RadioButton x:Name="NavBehavior" Style="{StaticResource SettingsNavItem}" Content="Behavior" IsChecked="True"/>
                                <TextBlock Style="{StaticResource SettingsNavGroup}" Text="MODEL"/>
                                <RadioButton x:Name="NavCustomize" Style="{StaticResource SettingsNavItem}" Content="Customize"/>
                                <TextBlock Style="{StaticResource SettingsNavGroup}" Text="DATA &amp; INFO"/>
                                <RadioButton x:Name="NavData" Style="{StaticResource SettingsNavItem}" Content="Data Controls"/>
                            </StackPanel>
                            <TextBlock x:Name="SettingsVersionText"
                                       Text="v1.13.0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Faint}"
                                       Margin="18,0,8,14"
                                       VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- ===== КОНТЕНТ ===== -->
                    <Grid Grid.Column="1">

                        <!-- Крестик поверх всех страниц -->
                        <Button x:Name="SettingsCloseButton" Width="26" Height="26" Panel.ZIndex="1"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                        Cursor="Hand" Click="SettingsCloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                        <Path x:Name="Icon" Data="M0,0 L8,8 M8,0 L0,8"
                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="9" Height="9" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Primary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ═══════════ ACCOUNT ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavAccount}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Account"/>

                                <!-- Карточка аккаунта -->
                                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Bg.Selected}"
                                                local:RoundedClip.Radius="8">
                                            <Grid>
                                                <TextBlock x:Name="AccountAvatarLetter" Text="Г" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="AccountAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountNameText" Text="Гость" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Body}"/>
                                            <TextBlock x:Name="AccountModeText" Text="Локальный режим" FontSize="11"
                                                       Foreground="{DynamicResource Text.Faint}"/>
                                        </StackPanel>
                                        <Button x:Name="SwitchAccountButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                Content="Сменить" Click="SwitchAccountButton_Click"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Изображение профиля" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="RemoveAvatarButton" Style="{StaticResource SecondaryButton}"
                                                Content="Убрать" Margin="0,0,6,0" Click="RemoveAvatarButton_Click"/>
                                        <Button x:Name="ChangeAvatarButton" Style="{StaticResource SecondaryButton}"
                                                Content="Изменить" Click="ChangeAvatarButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <StackPanel Margin="0,0,120,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Имя пользователя"/>
                                        <TextBlock x:Name="AccountNameHint" Style="{StaticResource SettingDesc}" Text="Гость"/>
                                    </StackPanel>
                                    <Button x:Name="ChangeNameButton" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Content="Изменить" Click="ChangeNameButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <StackPanel Margin="0,0,180,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Пароль"/>
                                        <TextBlock x:Name="AccountPasswordHint" Style="{StaticResource SettingDesc}"
                                                   Text="Не задан"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="RemovePasswordButton" Style="{StaticResource SecondaryButton}"
                                                Content="Удалить" Margin="0,0,6,0" Click="RemovePasswordButton_Click"/>
                                        <Button x:Name="ChangePasswordButton" Style="{StaticResource SecondaryButton}"
                                                Content="Изменить" Click="ChangePasswordButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Пароль при запуске"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Блокирует вход в приложение. Чаты на диске не шифруются"/>
                                    </StackPanel>
                                    <CheckBox x:Name="LockOnStartupToggle" Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                              Checked="LockOnStartupToggle_Changed" Unchecked="LockOnStartupToggle_Changed"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ APPEARANCE ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavAppearance}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Appearance"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Масштаб интерфейса"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="Размер элементов и текста"/>
                                    </StackPanel>
                                    <ComboBox x:Name="UiScaleComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      MinWidth="110" SelectedIndex="2"
                                      SelectionChanged="UiScaleComboBox_SelectionChanged">
                                        <ComboBoxItem Content="80%" Tag="80"/>
                                        <ComboBoxItem Content="90%" Tag="90"/>
                                        <ComboBoxItem Content="100%" Tag="100"/>
                                        <ComboBoxItem Content="110%" Tag="110"/>
                                        <ComboBoxItem Content="125%" Tag="125"/>
                                        <ComboBoxItem Content="150%" Tag="150"/>
                                        <ComboBoxItem Content="175%" Tag="175"/>
                                        <ComboBoxItem Content="200%" Tag="200"/>
                                        <ComboBoxItem Content="225%" Tag="225"/>
                                        <ComboBoxItem Content="250%" Tag="250"/>
                                    </ComboBox>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Тема"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="Цвет темы оформления. System следует настройке Windows"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeCardLight" Style="{StaticResource ThemeCard}" Content="Light"
                                                 Tag="Light" Checked="ThemeCard_Checked"/>
                                    <RadioButton x:Name="ThemeCardDark" Style="{StaticResource ThemeCard}" Content="Dark"
                                                 Tag="Dark" Checked="ThemeCard_Checked"/>
                                    <RadioButton x:Name="ThemeCardSystem" Style="{StaticResource ThemeCard}" Content="System"
                                                 Tag="System" Checked="ThemeCard_Checked"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ BEHAVIOR ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavBehavior}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Behavior"/>

                                <Grid>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Автопрокрутка чата" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="AutoScrollToggle" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right" IsChecked="True" Checked="AutoScrollToggle_Changed" Unchecked="AutoScrollToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Уведомлять о завершении ответа"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Всплывающее окно в правом нижнем углу, когда модель закончила генерацию, а окно не в фокусе"/>
                                    </StackPanel>
                                    <CheckBox x:Name="NotifyOnCompleteToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}" IsChecked="True"
                                              Checked="NotifyOnCompleteToggle_Changed"
                                              Unchecked="NotifyOnCompleteToggle_Changed"/>
                                </Grid>
                                <Grid Margin="18,10,0,0"
                                      IsEnabled="{Binding IsChecked, ElementName=NotifyOnCompleteToggle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Звук уведомления"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Короткий системный сигнал вместе с уведомлением"/>
                                    </StackPanel>
                                    <CheckBox x:Name="NotifySoundToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}" IsChecked="True"
                                              Checked="NotifySoundToggle_Changed"
                                              Unchecked="NotifySoundToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Режим работы"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
       Text="Режим работы для ИИ агента. Normal - спрашивать всегда"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ApprovalModeCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      MinWidth="140" SelectedIndex="1" VerticalAlignment="Center"
                                      SelectionChanged="ApprovalModeCombo_SelectionChanged">
                                        <ComboBoxItem Content="Always approve" Tag="AlwaysApprove"/>
                                        <ComboBoxItem Content="Normal" Tag="Normal"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ CUSTOMIZE ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavCustomize}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Customize"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Модели ответа"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Лёгкие задачи" VerticalAlignment="Center"/>
                                    <local:ModelPickerField x:Name="LiteModelPicker" HorizontalAlignment="Right" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Тяжёлые задачи" VerticalAlignment="Center"/>
                                    <local:ModelPickerField x:Name="HeavyModelPicker" HorizontalAlignment="Right" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Маршрутизатор"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Анализирует запрос и выбирает одну из моделей выше"/>
                                    </StackPanel>
                                    <local:ModelPickerField x:Name="RouterModelPicker" Grid.Column="1" Width="170" VerticalAlignment="Center"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="System-промпты"/>

                                <!-- Основной промпт ИИ -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Основной промпт ИИ" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveMainPromptButton" Grid.Column="1" Style="{StaticResource SavePromptButton}" Click="SaveMainPromptButton_Click"/>
                                </Grid>
                                <TextBox x:Name="MainPromptTextBox" Style="{StaticResource PromptTextBox}" Margin="0,0,0,10"/>

                                <!-- Технический промпт ИИ -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Технический промпт ИИ" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveTechAiPromptButton" Grid.Column="1" Style="{StaticResource SavePromptButton}" Click="SaveTechAiPromptButton_Click"/>
                                </Grid>
                                <TextBox x:Name="TechAiPromptTextBox" Style="{StaticResource PromptTextBox}" Margin="0,0,0,10"/>

                                <!-- Технический промпт агента -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Технический промпт агента" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveTechAgentPromptButton" Grid.Column="1" Style="{StaticResource SavePromptButton}" Click="SaveTechAgentPromptButton_Click"/>
                                </Grid>
                                <TextBox x:Name="TechAgentPromptTextBox" Style="{StaticResource PromptTextBox}"/>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Служебные модели"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Заголовки чатов" VerticalAlignment="Center"/>
                                    <local:ModelPickerField x:Name="TitleModelPicker" HorizontalAlignment="Right" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Агент — лёгкие задачи" VerticalAlignment="Center"/>
                                    <local:ModelPickerField x:Name="AgentLiteModelPicker" HorizontalAlignment="Right" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Агент — тяжёлые задачи" VerticalAlignment="Center"/>
                                    <local:ModelPickerField x:Name="AgentHeavyModelPicker" HorizontalAlignment="Right" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ DATA CONTROLS ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavData}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Data Controls"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Обмен чатами по ссылке"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Кнопки «Поделиться» и «Экспорт» под ответами. Код и JSON не шифруются"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChatSharingToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="ChatSharingToggle_Changed"
                                              Unchecked="ChatSharingToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Импорт чата"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Открыть экспортированный .json или файл .amrnchat как новый чат"/>
                                    </StackPanel>
                                    <Button x:Name="ImportChatButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="Открыть файл" Click="ImportChatButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Файлы приложения"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="Папка с настройками, чатами и логами"/>
                                    </StackPanel>
                                    <Button x:Name="OpenAppFilesButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="Открыть" Click="OpenAppFilesButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!-- Разрешённые сайты -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,34,0">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Разрешённые источники загрузки"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="Загрузка с других сайтов отклоняется. Поддомены разрешены автоматически"/>
                                    </StackPanel>
                                    <Button x:Name="AddDomainButton" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Content="+" Width="26" Padding="0" FontSize="14"
                                            Click="AddDomainButton_Click"/>
                                </Grid>
                                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                                    <Grid>
                                        <TextBlock x:Name="AllowedDomainsEmpty" Margin="8,7"
                                                   Text="Список пуст — любые загрузки заблокированы"
                                                   FontSize="12" Foreground="{DynamicResource Text.Faint}"
                                                   Visibility="Collapsed"/>
                                        <ScrollViewer MaxHeight="152" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="AllowedDomainsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="8,5">
                                                            <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas"
                                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                                       VerticalAlignment="Center" Margin="0,0,30,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                                                    Content="–" Width="22" Height="22" Padding="0"
                                                                    Tag="{Binding}" ToolTip="Удалить из списка"
                                                                    Click="RemoveDomainButton_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Удалить все чаты"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="Удаляет все сохранённые переписки"/>
                                    </StackPanel>
                                    <Button x:Name="DeleteAllChatsButton" Grid.Column="1" Style="{StaticResource DangerButton}"
                                            Content="Удалить" Click="DeleteAllChatsButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Удалить все данные"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Настройки, чаты, аккаунты — безвозвратно"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Удалить"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>
            </Viewbox>
        </Grid>

        <Grid x:Name="ConfirmationOverlay" Visibility="Collapsed" Panel.ZIndex="30">
            <Border Background="{DynamicResource Overlay.Scrim}"/>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Width="420" MinHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="10"
                    Padding="20,18">
                <StackPanel>
                    <TextBlock Text="Требуется подтверждение" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ConfirmationAgentText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ConfirmationSummaryText" FontSize="13.5" Foreground="{DynamicResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ConfirmationExplanationText" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmationNoButton" Content="Нет"
                                Style="{StaticResource DialogSecondaryButton}"
                                Margin="0,0,8,0" Click="ConfirmationNoButton_Click"/>
                        <Button x:Name="ConfirmationYesButton" Content="Да"
                                Style="{StaticResource DialogPrimaryButton}"
                                Click="ConfirmationYesButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ДОБАВЛЕНИЕ ДОМЕНА В БЕЛЫЙ СПИСОК ═══════════ -->
        <Grid x:Name="DomainOverlay" Visibility="Collapsed" Panel.ZIndex="35">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="DomainCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="Добавить домен в белый список" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                    <TextBlock Text="Агенту будет разрешено скачивать файлы с этого домена и его поддоменов."
                               FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="6" Padding="10,7">
                        <TextBox x:Name="DomainInput" Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="13"
                                 Foreground="{DynamicResource Text.Body}"
                                 CaretBrush="{DynamicResource Text.Bright}"
                                 KeyDown="DomainInput_KeyDown"
                                 TextChanged="DomainInput_TextChanged"/>
                    </Border>
                    <TextBlock x:Name="DomainError" FontSize="12" Foreground="{DynamicResource Status.Danger}"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="DomainCancelButton" Content="Отмена"
                                Style="{StaticResource DialogSecondaryButton}"
                                Margin="0,0,8,0" Click="DomainCancelButton_Click"/>
                        <Button x:Name="DomainAddButton" Content="Добавить"
                                Style="{StaticResource DialogPrimaryButton}"
                                Click="DomainAddButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПЕРЕИМЕНОВАНИЕ ПРОФИЛЯ ═══════════ -->
        <Grid x:Name="NameOverlay" Visibility="Collapsed" Panel.ZIndex="36">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="NameCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock x:Name="NameDialogTitle" Text="Имя пользователя" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="NameDialogSubtitle"
                                   Text="Отображается в настройках. Хранится только на этом компьютере."
                                   FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <TextBox x:Name="NameInput" Background="Transparent" BorderThickness="0"
                                     FontSize="13" MaxLength="40"
                                     Foreground="{DynamicResource Text.Body}"
                                     CaretBrush="{DynamicResource Text.Bright}"
                                     KeyDown="NameInput_KeyDown"/>
                        </Border>
                        <TextBlock x:Name="NameError" FontSize="12" Foreground="{DynamicResource Status.Danger}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Отмена" Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="NameCancelButton_Click"/>
                            <Button x:Name="NameSaveButton" Content="Сохранить"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="NameSaveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ВЫБОР ПРОФИЛЯ ═══════════ -->
        <Grid x:Name="ProfileOverlay" Visibility="Collapsed" Panel.ZIndex="37">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="ProfileCloseButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Профили" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                        <TextBlock Text="У каждого профиля свои чаты и настройки. Данные хранятся локально."
                                   FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ProfileList"/>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Новый профиль" Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="CreateProfileButton_Click"/>
                            <Button Content="Закрыть" Style="{StaticResource DialogPrimaryButton}"
                                    Click="ProfileCloseButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПРОСМОТР ИЗОБРАЖЕНИЯ ═══════════ -->
        <!-- Не отдельное окно: UiScale подменяет DPI одному HWND, и второе окно рисовалось бы
             в системном масштабе, разъезжаясь с остальной программой. -->
        <Grid x:Name="ImageViewerOverlay" Visibility="Collapsed" Panel.ZIndex="38"
              Focusable="True" PreviewKeyDown="ImageViewer_PreviewKeyDown">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="ImageViewerCloseButton_Click"/>
            </Border>

            <!-- Кадр просмотра. Картинка двигается трансформом, поэтому область фиксирована. -->
            <Border Margin="56,64,56,64" CornerRadius="10" ClipToBounds="True"
                    Background="Transparent">
                <Canvas x:Name="ImageViewerStage" Background="Transparent" ClipToBounds="True"
                        Cursor="SizeAll"
                        SizeChanged="ImageViewerStage_SizeChanged"
                        MouseLeftButtonDown="ImageViewerStage_MouseLeftButtonDown"
                        MouseLeftButtonUp="ImageViewerStage_MouseLeftButtonUp"
                        MouseMove="ImageViewerStage_MouseMove"
                        MouseWheel="ImageViewerStage_MouseWheel">
                    <Image x:Name="ImageViewerImage" Canvas.Left="0" Canvas.Top="0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageViewerZoom"/>
                                <TranslateTransform x:Name="ImageViewerPan"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </Border>

            <!-- Панель действий снизу по центру -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImageViewerPrevButton" Content="←" Width="32"
                            Style="{StaticResource DialogSecondaryButton}" Margin="0,0,4,0"
                            ToolTip="Предыдущая" Click="ImageViewerPrevButton_Click"/>
                    <TextBlock x:Name="ImageViewerCounter" VerticalAlignment="Center"
                               MinWidth="44" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Text.Muted}"/>
                    <Button x:Name="ImageViewerNextButton" Content="→" Width="32"
                            Style="{StaticResource DialogSecondaryButton}" Margin="4,0,10,0"
                            ToolTip="Следующая" Click="ImageViewerNextButton_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,4,0" Click="ImageViewerSaveButton_Click"/>
                    <Button Content="Копировать" Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,4,0" Click="ImageViewerCopyButton_Click"/>
                    <Button Content="Закрыть" Style="{StaticResource DialogPrimaryButton}"
                            Click="ImageViewerCloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.RowSpan="3" Cursor="SizeWE"   Tag="Left"/>
            <Border Grid.Column="2" Grid.RowSpan="3" Cursor="SizeWE"   Tag="Right"/>
            <Border Grid.Row="0" Grid.ColumnSpan="3"  Cursor="SizeNS"   Tag="Top"/>
            <Border Grid.Row="2" Grid.ColumnSpan="3"  Cursor="SizeNS"   Tag="Bottom"/>

            <Border Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE" Tag="TopLeft"/>
            <Border Grid.Row="0" Grid.Column="2" Cursor="SizeNESW" Tag="TopRight"/>
            <Border Grid.Row="2" Grid.Column="0" Cursor="SizeNESW" Tag="BottomLeft"/>
            <Border Grid.Row="2" Grid.Column="2" Cursor="SizeNWSE" Tag="BottomRight"/>

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <EventSetter Event="MouseLeftButtonDown" Handler="ResizeBorder_MouseLeftButtonDown"/>
                </Style>
            </Grid.Resources>
        </Grid>
    </Grid>
</Window>
