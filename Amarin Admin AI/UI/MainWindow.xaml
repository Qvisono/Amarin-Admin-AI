                                            <Grid Style="{StaticResource ToolRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Style="{StaticResource ToolDoneIcon}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ToolName}" Text="search_web"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource ToolResult}"
                                       Text="VAT — Value Added Tax, налог на добавленную... (+ещё 12)"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                    <!-- Текста ответа НЕТ — модель ещё генерирует -->

                                    <!-- Кнопка действия ИИ: у последнего (генерируемого) сообщения — только Stop -->
                                    <StackPanel Style="{StaticResource ActionsRow}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <Button Style="{StaticResource MsgActionButton}">
                                            <Image Source="{StaticResource Cancel}" Margin="4"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="27,0,27,20" Background="#FF161616" MaxWidth="1070"
                            CornerRadius="6" BorderBrush="#FF232323" BorderThickness="1">
                        <Border.Resources>
                            <Style x:Key="ToolIconButton" TargetType="Button">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                            <Style x:Key="PrimaryActionButton" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="#FFEAEAEA" CornerRadius="6" Padding="16,0">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#FF0E0E0E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFD4D4D4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- ===== Бейдж-иконка пункта меню ===== -->
                            <Style x:Key="ActionBadge" TargetType="Border">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="CornerRadius" Value="7"/>
                                <Setter Property="Background" Value="#FF1F1F1F"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>

                            <Style x:Key="ActionBadgeIcon" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="#FFB0B0B0"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ActionTitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ActionSubtitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Foreground" Value="#FF6E6E6E"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,1,0,0"/>
                            </Style>

                            <!-- ===== Простой пункт (Attach) ===== -->
                            <Style x:Key="ActionItem" TargetType="Button">
                                <Setter Property="Height" Value="46"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="6">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF202020"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ===== Раскрывающийся пункт (Summarize video) ===== -->
                            <Style x:Key="ActionExpanderToggle" TargetType="ToggleButton">
                                <Setter Property="Height" Value="46"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="6">
                                                <Grid>
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron" Data="M0,0 L4,4 L8,0"
                                  Stroke="#FF6E6E6E" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="9" Height="5" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF202020"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF1D1D1D"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="#FFAFAFAF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ===== Плейсхолдер-текстбокс ===== -->
                            <Style x:Key="PopupUrlTextBox" TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#FFEAEAEA"/>
                                <Setter Property="CaretBrush" Value="#FFEAEAEA"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="9,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <!-- ===== Сегментированный переключатель ===== -->
                            <Style x:Key="SegmentedOption" TargetType="RadioButton">
                                <Setter Property="GroupName" Value="SummarizeMode"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Height" Value="27"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bg" Background="#FF1B1B1B" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="6">
                                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="10.5"
                                   Foreground="#FF9A9A9A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF232323"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFEAEAEA"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#FFEAEAEA"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="#FF0E0E0E"/>
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>

                        <Grid Margin="14,10,14,8">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <!-- ===== ПОЛЕ ВВОДА ===== -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBox x:Name="MessageTextBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#FFEAEAEA" CaretBrush="#FFEAEAEA"
                     FontSize="13.5"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0"/>
                                <TextBlock Text="Спросите что-нибудь..." FontSize="14.5"
                       Foreground="#FF5A5A5A" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MessageTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- ===== ТУЛБАР ===== -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Кнопка "+" (прикрепить/добавить контекст) -->
                                <ToggleButton x:Name="AttachButton" Grid.Column="0" Width="32" Height="32"
              Margin="0,0,6,0" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="#FF1F1F1F" CornerRadius="6">
                                                <Path x:Name="PlusIcon" Data="M7,0 L7,14 M0,7 L14,7"
                      Stroke="#FFB0B0B0" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="13" Height="13" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF2A2A2A"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF2A2A2A"/>
                                                    <Setter TargetName="PlusIcon" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="45"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="ActionsPopup"
       PlacementTarget="{Binding ElementName=AttachButton}"
       Placement="Top"
       VerticalOffset="-8"
       AllowsTransparency="True"
       StaysOpen="False"
       PopupAnimation="Fade"
       IsOpen="{Binding IsChecked, ElementName=AttachButton, Mode=TwoWay}">
                                    <Border Width="300" Background="#FF161616" BorderBrush="#FF2A2A2A"
            BorderThickness="1" CornerRadius="12" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Actions" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="#FF9A9A9A" Margin="8,6,8,4"/>

                                            <Button Style="{StaticResource ActionItem}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource ActionBadge}">
                                                        <Image Source="{StaticResource attach}" Margin="6" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform/>
                                                                    <SkewTransform/>
                                                                    <RotateTransform Angle="40"/>
                                                                    <TranslateTransform/>
                                                                </TransformGroup>
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ActionTitle}" Text="Attach image/document"/>
                                                        <TextBlock Style="{StaticResource ActionSubtitle}" Text="Фото, PDF, документы"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                            <!-- Summarize video -->
                                            <ToggleButton x:Name="SummarizeToggle" Style="{StaticResource ActionExpanderToggle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource ActionBadge}">
                                                        <TextBlock Style="{StaticResource ActionBadgeIcon}" Text="▶"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ActionTitle}" Text="Summarize video"/>
                                                        <TextBlock Style="{StaticResource ActionSubtitle}" Text="YouTube-ссылка"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ToggleButton>

                                            <Border Margin="4,4,4,4" Padding="10" Background="#FF1B1B1B"
                    BorderBrush="#FF2A2A2A" BorderThickness="1" CornerRadius="9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=SummarizeToggle}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Border Background="#FF141414" BorderBrush="#FF2E2E2E" BorderThickness="1"
            CornerRadius="6" Height="30">
                                                        <Grid>
                                                            <TextBox x:Name="YoutubeUrlBox" Style="{StaticResource PopupUrlTextBox}"/>
                                                            <TextBlock Text="https://youtube.com/watch?v=..." FontSize="11.5"
                       Foreground="#FF525252" Margin="9,0" VerticalAlignment="Center"
                       IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=YoutubeUrlBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton Grid.Column="0" Style="{StaticResource SegmentedOption}"
                     Content="Raw Transcript" IsChecked="True" Margin="0,0,3,0"/>
                                                        <RadioButton Grid.Column="1" Style="{StaticResource SegmentedOption}"
                     Content="Create Infographic" Margin="3,0,0,0"/>
                                                    </Grid>

                                                    <!-- Кнопка подтверждения — без Click, чисто визуальная -->
                                                    <Button Style="{StaticResource PrimaryActionButton}" Content="Начать" Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                
                                <!-- Селектор модели AI -->
                                <!-- Селектор модели AI -->
                                <ToggleButton x:Name="ModelButton" Grid.Column="2" Height="32" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="#FF1F1F1F" CornerRadius="6" Padding="6,0,10,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{StaticResource Claude}" Width="20" Height="20" Margin="0 0 5 0"/>
                                                    <TextBlock Text="Claude Sonnet 5" FontSize="13"
                               Foreground="#FFD8D8D8" VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="#FF8A8A8A" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="9" Height="5" Stretch="Uniform"
                          Margin="7,0,0,0" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF2A2A2A"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF2A2A2A"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="ModelPicker"
       PlacementTarget="{Binding ElementName=ModelButton}"
       Placement="Top"
       VerticalOffset="-8"
       AllowsTransparency="True"
       StaysOpen="False"
       PopupAnimation="Fade"
       IsOpen="{Binding IsChecked, ElementName=ModelButton, Mode=TwoWay}">

                                    <Border Width="250" Height="320" Background="#FF161616" BorderBrush="#FF2A2A2A"
            BorderThickness="1" CornerRadius="10" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                                        </Border.Effect>

                                        <Border.Resources>

                                            <!-- ===== Вкладка ===== -->
                                            <Style x:Key="PickerTab" TargetType="RadioButton">
                                                <Setter Property="GroupName" Value="ModelPickerTabs"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Height" Value="24"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="11" Foreground="#FF9A9A9A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FF232323"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FF2E2E2E"/>
                                                                    <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- ===== Заголовок категории ===== -->
                                            <Style x:Key="PickerGroupHeader" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="9.5"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#FF5A5A5A"/>
                                                <Setter Property="Margin" Value="8,8,6,3"/>
                                            </Style>

                                            <!-- ===== Пункт модели (однострочный) ===== -->
                                            <Style x:Key="ModelItem" TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Height" Value="28"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="7,0">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FF1F1F1F"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FF2A2A2A"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- ===== Тексты пункта ===== -->
                                            <Style x:Key="ModelName" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="#FFD8D8D8"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>

                                            <!-- ===== Галка выбранной модели ===== -->
                                            <Style x:Key="SelectedCheck" TargetType="Path">
                                                <Setter Property="Data" Value="M0,3.5 L3,6.5 L8,0"/>
                                                <Setter Property="Stroke" Value="#FFEAEAEA"/>
                                                <Setter Property="StrokeThickness" Value="1.5"/>
                                                <Setter Property="StrokeStartLineCap" Value="Round"/>
                                                <Setter Property="StrokeEndLineCap" Value="Round"/>
                                                <Setter Property="StrokeLineJoin" Value="Round"/>
                                                <Setter Property="Width" Value="9"/>
                                                <Setter Property="Height" Value="7"/>
                                                <Setter Property="Stretch" Value="Uniform"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0,2,0"/>
                                            </Style>

                                            <!-- ===== Фильтр-чип ===== -->
                                            <Style x:Key="FilterChip" TargetType="ToggleButton">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Height" Value="24"/>
                                                <Setter Property="Margin" Value="4,0,0,0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Bg" Background="#FF1F1F1F" BorderBrush="#FF2E2E2E"
                                    BorderThickness="1" CornerRadius="5" Padding="8,0">
                                                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="10.5" Foreground="#FF9A9A9A"
                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FF242424"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FFEAEAEA"/>
                                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#FFEAEAEA"/>
                                                                    <Setter TargetName="Label" Property="Foreground" Value="#FF0E0E0E"/>
                                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                        </Border.Resources>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- ═══ ВКЛАДКИ ═══ -->
                                            <Border Background="#FF1B1B1B" BorderBrush="#FF262626" BorderThickness="1"
                    CornerRadius="7" Padding="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="TabRecommended" Style="{StaticResource PickerTab}"
                                 Content="Рекомендованы" IsChecked="True"/>
                                                    <RadioButton x:Name="TabAll" Grid.Column="1" Style="{StaticResource PickerTab}"
                                 Content="Все"/>
                                                </Grid>
                                            </Border>

                                            <!-- ═══ ВКЛАДКА «РЕКОМЕНДОВАНЫ» ═══ -->
                                            <ScrollViewer Grid.Row="1" Margin="0,2,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                                                <ScrollViewer.Style>
                                                    <Style TargetType="ScrollViewer">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=TabRecommended}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ScrollViewer.Style>
                                                <StackPanel Margin="0,2,0,2">

                                                    <!-- Авто -->
