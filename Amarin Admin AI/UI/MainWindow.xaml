<Window x:Class="Amarin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Amarin.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        Title="Amarin Admin AI"
        Height="620"
        MinHeight="535"
        Width="1140"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">
    <!--
        WindowStyle — обычное окно, а не ToolWindow. Системный заголовок и так убирает
        WindowChrome (CaptionHeight="0"), а стиль решает, кем окно считает Windows. С ToolWindow
        (WS_EX_TOOLWINDOW) оно было «окном-инструментом»: не попадало в Alt+Tab, кнопка на
        панели задач появлялась лишь после первого фокуса, а сворачивание чужой программы
        уносило его следом. Возвращать ToolWindow ради внешнего вида незачем — вид рисует
        WindowChrome.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <!--
                    Палитры здесь нет намеренно: в работающем приложении её подставляет
                    ThemeManager словарями уровня Application, и словарь уровня окна
                    перекрыл бы их — тема перестала бы переключаться. Конструктору XAML
                    палитру даёт Properties/DesignTimeResources.xaml.
                -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!--
            ResizeBorderThickness отличен от нуля намеренно: по краю окна WindowChrome сам
            отвечает на WM_NCHITTEST кодами HTLEFT…HTBOTTOMRIGHT, и размер меняет система.
            Отсюда родные курсоры, прилипание к краям экрана и разворот по вертикали двойным
            щелчком по кромке. Раньше на этом месте лежал слой из восьми прозрачных Border,
            пересылавших WM_NCLBUTTONDOWN руками: он стоял последним ребёнком корневого Grid и
            съедал полосу в 5 DIP по всему периметру, включая оверлеи.
            CaptionHeight остаётся нулевым — перетаскиванием занимается WindowMoveBehavior.
        -->
        <shell:WindowChrome
    CornerRadius="18"
    GlassFrameThickness="1"
    UseAeroCaptionButtons="False"
    CaptionHeight="0"
    ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource Bg.Window}" MouseDown="TitleBar_MouseDown">
        <!--
            Слой оформления: градиент или картинка «за стеклом», которые AppearanceManager
            собирает во время выполнения. ZIndex="-1" держит его под ScaledRoot независимо от
            порядка в разметке, а IsHitTestVisible="False" — чтобы перетаскивание окна по пустому
            месту (TitleBar_MouseDown) продолжало работать: попадание проваливается сквозь слой на
            заливку корневого Grid.
        -->
        <Grid x:Name="BackdropHost" Panel.ZIndex="-1" IsHitTestVisible="False"
              ClipToBounds="True" Visibility="Collapsed"/>
        <!--
            Матовое зерно: тонкая текстура поверх всего окна, которую собирает GrainOverlay.
            ZIndex="99" держит слой над ScaledRoot независимо от порядка в разметке — тем же
            приёмом, каким BackdropHost держится под ним, — а IsHitTestVisible="False" не даёт
            ему съесть перетаскивание окна за пустое место (TitleBar_MouseDown).
        -->
        <Rectangle x:Name="GrainLayer" Panel.ZIndex="99" IsHitTestVisible="False"
                   Visibility="Collapsed"/>
        <Grid x:Name="ScaledRoot">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="184"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!--
                Ручка ширины боковой панели (D5): тянется за правый край, ширина запоминается.
                Поверх колонки и невидимая — курсор-стрелка сам показывает, что край тянется.
            -->
            <Thumb x:Name="SidebarGrip" Grid.Column="0" Width="5" HorizontalAlignment="Right" Panel.ZIndex="10"
                   Cursor="SizeWE" DragDelta="SidebarGrip_DragDelta" DragCompleted="SidebarGrip_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Border x:Name="SidebarBorder" Background="{DynamicResource Bg.Sidebar}">
                <Border.Resources>

                    <!--
                        Переключатель режима поиска. Форма взята у JournalTab, чтобы два места, где
                        в программе выбирают «что именно смотрим», читались одинаково; размер меньше —
                        боковая панель узкая, и полноразмерные вкладки в неё не помещаются.
                    -->
                    <Style x:Key="SearchModeTab" TargetType="ToggleButton">
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Полужирная копия-невидимка держит ширину: выбранная подпись толще, и без неё
                                                 соседние кнопки сдвигались бы на пару точек при каждом переключении. -->
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Visibility="Hidden"/>
                                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11"
                                                       Foreground="{DynamicResource Text.Faint}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>


                    <!-- Кнопка-значок пакетной панели (D5). Подпись — в подсказке и для дикторов. -->
                    <Style x:Key="SidebarIconButton" TargetType="Button">
                        <Setter Property="Width" Value="24"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Margin" Value="1,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Заголовок группы чатов -->
                    <Style x:Key="GroupHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                        <Setter Property="Margin" Value="14,14,6,4"/>
                    </Style>

                    <!--
                        Заголовок папки или архива (D5) — кнопка, которая сворачивает свою группу.
                        Папка всегда карточка: свёрнутая — из одной строки, раскрытая — её верх
                        (ChatRowState.Band = Top), а низ дорисует последний чат. Верх у обеих
                        одинаковый — поле 3, подсветка с отступом 4, — поэтому при раскрытии
                        заголовок не сдвигается ни на точку: карточка просто растёт вниз. Пока
                        свёрнутая папка была голой строкой, она при раскрытии меняла высоту и
                        съезжала на несколько точек. Углы концентричны: у карточки 10, у подсветки 6.
                    -->
                    <Style x:Key="FolderHeader" TargetType="Button">
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Margin" Value="6,3"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Band" Background="{DynamicResource Bg.Card}" CornerRadius="10"/>
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="4"
                                                Padding="5,0,6,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="local:ChatRowState.Band" Value="Top">
                                            <Setter Property="Height" Value="35"/>
                                            <Setter Property="Margin" Value="6,3,6,0"/>
                                            <Setter TargetName="Band" Property="CornerRadius" Value="10,10,0,0"/>
                                            <Setter TargetName="Bg" Property="Margin" Value="4,4,4,1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Пункт списка чатов -->
                    <Style x:Key="ChatItem" TargetType="Button">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="6,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                    <!-- Кусок карточки раскрытой папки: см. FolderHeader и ChatRowState.Band. -->
                                    <Border x:Name="Band" Background="{DynamicResource Bg.Card}" Visibility="Collapsed"/>
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                        CornerRadius="6" Padding="9,0,4,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!--
                                                Вспышка «ответ готов». Заливка акцентная и
                                                проступает прозрачностью поверх собственного фона
                                                строки — поэтому одинаково читается и на чёрном
                                                Obsidian, и на светлой Sakura, без единого цвета,
                                                заданного отдельно под тему. Отрицательные поля
                                                гасят Padding родителя, чтобы вспыхивала вся
                                                плашка, а не её середина.
                                            -->
                                            <Border x:Name="Flash" CornerRadius="6" Opacity="0" Grid.ColumnSpan="2"
                                 IsHitTestVisible="False" Margin="-9,0,-4,0"
                                 Background="{DynamicResource Accent.Fill}"/>
                                            <!-- Теги (D5): до трёх точек перед названием. -->
                                            <StackPanel x:Name="TagDots" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="Tag1Dot" Width="6" Height="6" Margin="0,0,3,0"
                                                         Fill="{Binding Path=(local:ChatRowState.Tag1), RelativeSource={RelativeSource TemplatedParent}}"/>
                                                <Ellipse x:Name="Tag2Dot" Width="6" Height="6" Margin="0,0,3,0"
                                                         Fill="{Binding Path=(local:ChatRowState.Tag2), RelativeSource={RelativeSource TemplatedParent}}"/>
                                                <Ellipse x:Name="Tag3Dot" Width="6" Height="6" Margin="0,0,3,0"
                                                         Fill="{Binding Path=(local:ChatRowState.Tag3), RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="Title" Grid.Column="1" Text="{TemplateBinding Content}"
                                   FontSize="12.5" Foreground="{DynamicResource Text.Tertiary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,2,0"/>
                                            <!-- Пульсирующая точка: чат отвечает, пока мы
                                                 смотрим другой. Под курсором уступает место
                                                 кнопке действий — они стоят в одной точке.
                                                 Пульс заводит и гасит триггер IsWorking ниже:
                                                 на Loaded он запускался у каждой строки списка,
                                                 включая свёрнутые, и тикал вечно. -->
                                            <Ellipse x:Name="Working" Grid.Column="1" Width="7" Height="7"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,7,0" Visibility="Collapsed"
                                 Fill="{DynamicResource Accent.Fill}"/>
                                            <!-- Стойкая точка «ответ готов»: в отличие от Working
                                                 не пульсирует и держится до открытия чата. Стоит
                                                 в той же точке, что и Working с Actions, — все
                                                 трое одновременно не показываются. -->
                                            <Ellipse x:Name="Done" Grid.Column="1" Width="7" Height="7"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,7,0" Visibility="Collapsed"
                                 Fill="{DynamicResource Accent.Fill}"/>
                                            <Button x:Name="Actions" Grid.Column="1" Width="22" Height="22"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="Collapsed"
                                ToolTip="{DynamicResource S.Chat.RowActions}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ActionsBg" Background="Transparent" CornerRadius="4">
                                                            <TextBlock Text="⋯" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,0,2"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ActionsBg" Property="Background" Value="{DynamicResource Bg.Track}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!--
                                            Чат раскрытой папки. Название стоит под именем папки (после
                                            значка), подсветка — внутри карточки с отступом 4. Строки
                                            карточки идут без зазора (поле 6,0): куски подложки обязаны
                                            сомкнуться, зазор между подсветками даёт само поле Bg.
                                        -->
                                        <Trigger Property="local:ChatRowState.Band" Value="Middle">
                                            <Setter Property="Margin" Value="6,0"/>
                                            <Setter TargetName="Band" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Bg" Property="Margin" Value="4,1"/>
                                            <Setter TargetName="Bg" Property="Padding" Value="28,0,4,0"/>
                                            <Setter TargetName="Flash" Property="Margin" Value="-28,0,-4,0"/>
                                        </Trigger>
                                        <Trigger Property="local:ChatRowState.Band" Value="Bottom">
                                            <Setter Property="Height" Value="35"/>
                                            <Setter Property="Margin" Value="6,0,6,3"/>
                                            <Setter TargetName="Band" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Band" Property="CornerRadius" Value="0,0,10,10"/>
                                            <Setter TargetName="Bg" Property="Margin" Value="4,1,4,4"/>
                                            <Setter TargetName="Bg" Property="Padding" Value="28,0,4,0"/>
                                            <Setter TargetName="Flash" Property="Margin" Value="-28,0,-4,0"/>
                                        </Trigger>
                                        <!--
                                            Открытый чат. Стоит первым: IsMouseOver ниже перекрывает
                                            его фон, и это правильный порядок — под курсором строка
                                            подсвечивается независимо от того, открыта она или нет.
                                        -->
                                        <Trigger Property="local:ChatRowState.IsActive" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        </Trigger>
                                        <!-- Выбран для пакетного действия (Ctrl/Shift+щелчок). -->
                                        <Trigger Property="local:ChatRowState.IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        </Trigger>
                                        <Trigger Property="local:ChatRowState.Tag1" Value="{x:Null}">
                                            <Setter TargetName="Tag1Dot" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="local:ChatRowState.Tag2" Value="{x:Null}">
                                            <Setter TargetName="Tag2Dot" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="local:ChatRowState.Tag3" Value="{x:Null}">
                                            <Setter TargetName="Tag3Dot" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <!--
                                            В чате идёт ход. Пульс живёт ровно столько, сколько идёт
                                            ответ: заводится входом в это состояние и гасится выходом.
                                        -->
                                        <Trigger Property="local:ChatRowState.IsWorking" Value="True">
                                            <Setter TargetName="Working" Property="Visibility" Value="Visible"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard x:Name="WorkingPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="Working"
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1" To="0.25" Duration="0:0:0.7"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="WorkingPulse"/>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <!--
                                            Ответ доспел в этом чате, пока смотрели другой. Пульс
                                            повторяется трижды и гаснет: чат, ответивший час назад,
                                            мигать уже не должен, — а точка Done остаётся, пока
                                            чат не откроют. Порядок важен: этот триггер стоит
                                            первым, и IsMouseOver ниже перекрывает его точку.
                                        -->
                                        <Trigger Property="local:ChatRowState.NeedsAttention" Value="True">
                                            <Setter TargetName="Done" Property="Visibility" Value="Visible"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard x:Name="FlashRun">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="Flash"
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="0" To="0.22" Duration="0:0:0.45"
                                                            AutoReverse="True" RepeatBehavior="3x"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="FlashRun"/>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Working" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="Done" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="Title" Property="Margin" Value="0,0,26,0"/>
                                        </Trigger>
                                        <!-- Keep the affordance up while its menu is open, or it
                                             vanishes the moment the pointer leaves the row. -->
                                        <Trigger SourceName="Actions" Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Title" Property="Margin" Value="0,0,26,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ClipToBounds="True" x:Name="SideBarScrollViewer" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!--
                                Без горизонтальных полей: свёрнутая панель шириной 42 не может
                                позволить себе ни пикселя. Кнопка 30 плюс её поля 6+6 — это ровно
                                42, и любой отступ здесь заставил бы WPF обрезать её прямоугольным
                                layout-клипом (срез без скругления справа). Заодно логотип и «New
                                Chat» теперь начинаются с одного x.
                            -->
                            <Grid Margin="0,2,0,0">
                                <!-- Лого приложения -->
                                <Button x:Name="SidebarLogoButton" Margin="6" Height="30" Width="30" HorizontalAlignment="Left"
                                        Cursor="Hand" Click="SidebarLogoButton_Click"
                                        ToolTip="{DynamicResource S.ChatList.NewChat}"
                                        MouseEnter="SidebarLogoButton_MouseEnter"
                                        MouseLeave="SidebarLogoButton_MouseLeave">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Grid>
                                                    <Image x:Name="LogoImage" Source="/jeklE-removebg-preview_1.ico" Width="20" Height="20"/>
                                                    <Path x:Name="ExpandIcon" Visibility="Collapsed"
                                                          Data="M 2,2 L 7,7 L 2,12 M 8,2 L 13,7 L 8,12"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{DynamicResource Text.Bright}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="CollapseSidebarButton" Margin="6" Height="30" Width="30" HorizontalAlignment="Right"
                                        Cursor="Hand" ToolTip="{DynamicResource S.Sidebar.Collapse}" Click="CollapseSidebarButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Path x:Name="Icon"
                                  Data="M 6,2 L 1,7 L 6,12 M 13,2 L 8,7 L 13,12"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- New Chat: белая primary-кнопка -->
                            <Button x:Name="NewChatButton" AutomationProperties.Name="{DynamicResource S.ChatList.NewChat}" Cursor="Hand" Margin="0,5,0,0" Click="NewChatButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6"
                            Margin="6,0,6,4" Height="28">
                                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="NewChatPlus" Data="M6,0 L6,12 M0,6 L12,6"
                                  Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="NewChatLabel" Text="{DynamicResource S.Sidebar.NewChat}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.OnAccent}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Поиск -->
                            <Border x:Name="SearchBorder" Height="28" Margin="6,0,6,6" CornerRadius="6" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Сортировка, фильтр по тегу, папки и теги (D5) — меню у поиска: место в колонке дорого. -->
                                    <Button x:Name="ListOptionsButton" Grid.Column="2" Width="24" Height="22" Margin="0,0,2,0"
                                            Cursor="Hand" Click="ListOptionsButton_Click"
                                            ToolTip="{DynamicResource S.ChatList.Options}"
                                            AutomationProperties.Name="{DynamicResource S.ChatList.Options}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                                                    <Path Data="M3,1 L3,11 M0,8 L3,11 L6,8 M10,11 L10,1 M7,4 L10,1 L13,4" Width="12" Height="11"
                                                          Stretch="Uniform" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.3"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Ellipse x:Name="ListFilterDot" Grid.Column="2" Width="6" Height="6" Margin="0,4,4,0"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                                             Fill="{DynamicResource Accent.Fill}" Visibility="Collapsed"/>
                                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
              Fill="{DynamicResource Text.Dim}" Width="12" Height="12" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SearchBox" Grid.Column="1"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 VerticalContentAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource Text.Bright}" CaretBrush="{DynamicResource Text.Bright}"
                 TextChanged="SearchBox_TextChanged"
                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource S.Sidebar.Search}" FontSize="12" Foreground="{DynamicResource Text.Faint}"
                   VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <!--
                                Режим поиска. Появляется только при непустом запросе: место в
                                боковой панели дорого, а выбор осмыслен ровно тогда, когда есть
                                что искать, — заодно так видно, что выбор вообще есть.
                            -->
                            <!-- WrapPanel: три режима в узкой колонке переносятся, а не обрезаются. -->
                            <WrapPanel x:Name="SearchModeRow" Margin="6,0,6,6" Visibility="Collapsed">
                                <ToggleButton x:Name="SearchModeTitles" Style="{StaticResource SearchModeTab}"
                                              IsChecked="True" Content="{DynamicResource S.Search.Mode.Titles}"
                                              ToolTip="{DynamicResource S.Search.Mode.TitlesTip}"
                                              Click="SearchModeTitles_Click"/>
                                <ToggleButton x:Name="SearchModeText" Style="{StaticResource SearchModeTab}"
                                              Margin="3,0,0,0" Content="{DynamicResource S.Search.Mode.Text}"
                                              ToolTip="{DynamicResource S.Search.Mode.TextTip}"
                                              Click="SearchModeText_Click"/>
                                <ToggleButton x:Name="SearchModeContent" Style="{StaticResource SearchModeTab}"
                                              Margin="3,0,0,0" Content="{DynamicResource S.Search.Mode.Content}"
                                              ToolTip="{DynamicResource S.Search.Mode.ContentTip}"
                                              Click="SearchModeContent_Click"/>
                            </WrapPanel>

                            <!--
                                Фильтр по тегу (D5) ставится в меню ⇅, а здесь только видно, что он
                                включён, и снимается одним щелчком. Ряд всех тегов под поиском
                                отнимал у списка две строки и путал теги с папками.
                            -->
                            <Border x:Name="TagFilterPill" Margin="6,0,6,6" Height="26" CornerRadius="7" Padding="9,0,2,0"
                                    HorizontalAlignment="Left" Background="{DynamicResource Bg.Raised}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TagFilterDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TagFilterName" FontSize="11.5" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Text.Body}"/>
                                    <Button x:Name="TagFilterClear" Style="{StaticResource SidebarIconButton}" Width="20" Height="20"
                                            Margin="4,0,0,0" Click="TagFilterClear_Click"
                                            ToolTip="{DynamicResource S.ChatList.ClearFilter}"
                                            AutomationProperties.Name="{DynamicResource S.ChatList.ClearFilter}">
                                        <Path Data="M1,1 L8,8 M8,1 L1,8" Width="8" Height="8" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!--
                                Пакетные действия над выбранными чатами (D5): появляется при выборе
                                Ctrl/Shift+щелчком. Значки с подсказками — колонка узкая.
                            -->
                            <Border x:Name="BatchBar" Margin="6,0,6,6" Padding="8,5,4,5" CornerRadius="7"
                                    Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BatchCount" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel x:Name="BatchButtons" Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BatchFolderButton" Style="{StaticResource SidebarIconButton}" Click="BatchFolderButton_Click"
                                                ToolTip="{DynamicResource S.ChatList.MoveToFolder}"
                                                AutomationProperties.Name="{DynamicResource S.ChatList.MoveToFolder}">
                                            <Path Data="M1,3 L1,12 L14,12 L14,4.5 L7.5,4.5 L6,3 Z" Width="13" Height="11" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button x:Name="BatchTagButton" Style="{StaticResource SidebarIconButton}" Click="BatchTagButton_Click"
                                                ToolTip="{DynamicResource S.ChatList.Tags}"
                                                AutomationProperties.Name="{DynamicResource S.ChatList.Tags}">
                                            <Path Data="M1,1 L7,1 L13,7 L7,13 L1,7 Z M4,3.2 A0.9,0.9 0 1 0 4,5 A0.9,0.9 0 1 0 4,3.2" Width="12" Height="12" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button x:Name="BatchArchiveButton" Style="{StaticResource SidebarIconButton}" Click="BatchArchiveButton_Click"
                                                ToolTip="{DynamicResource S.ChatList.Archive}"
                                                AutomationProperties.Name="{DynamicResource S.ChatList.Archive}">
                                            <Path Data="M1,1 L13,1 L13,4 L1,4 Z M2,4 L2,12 L12,12 L12,4 M5,7 L9,7" Width="12" Height="11" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Button>
                                        <Button x:Name="BatchDeleteButton" Style="{StaticResource SidebarIconButton}" Click="BatchDeleteButton_Click"
                                                ToolTip="{DynamicResource S.Common.Delete}"
                                                AutomationProperties.Name="{DynamicResource S.Common.Delete}">
                                            <Path Data="M1,3 L13,3 M5,3 L5,1 L9,1 L9,3 M2.5,3 L3.5,13 L10.5,13 L11.5,3" Width="11" Height="12" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Button>
                                        <Button x:Name="BatchClearButton" Style="{StaticResource SidebarIconButton}" Click="BatchClearButton_Click"
                                                ToolTip="{DynamicResource S.ChatList.ClearSelection}"
                                                AutomationProperties.Name="{DynamicResource S.ChatList.ClearSelection}">
                                            <Path Data="M1,1 L9,9 M9,1 L1,9" Width="9" Height="9" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ===== СПИСОК ЧАТОВ ===== -->
                            <!-- Округление раскладки: куски карточки раскрытой папки лежат встык,
                                 и на дробном масштабе без него между ними светился бы шов. -->
                            <StackPanel x:Name="ChatListPanel" UseLayoutRounding="True"/>

                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" x:Name="SidebarFooter">
                        <Grid Height="40" Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccountAvatar" Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Bg.Selected}"
                                    VerticalAlignment="Center" local:RoundedClip.Radius="6">
                                <Grid>
                                    <TextBlock x:Name="SidebarAvatarLetter" Text="Г" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="SidebarAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="AccountLabels" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarAccountName" Text="{DynamicResource S.Account.Guest}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock x:Name="SidebarAccountMode" Text="{DynamicResource S.Account.LocalMode}" FontSize="9.5" Foreground="{DynamicResource Text.Faint}"/>
                            </StackPanel>

                            <Button x:Name="SettingsButton" AutomationProperties.Name="{DynamicResource S.A11y.Settings}" Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center"
                                    Cursor="Hand" Click="SettingsButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                            <Path x:Name="Icon" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource Text.Dim}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19.14,12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6 3.6,1.62,3.6,3.6-1.62,3.6-3.6,3.6z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Bg.Hover}" TargetName="Bg"/>
                                                <Setter Property="Fill" Value="{DynamicResource Text.Bright}" TargetName="Icon"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1" x:Name="Chat">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <!-- Auto, not fixed: the composer grows when image thumbnails are attached. -->
                        <RowDefinition x:Name="ComposerRow" Height="Auto" MinHeight="125"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" ClipToBounds="True"
              x:Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled">
                        <!--
                            Прослойка лупы: Ctrl с колесом приближает ленту, левая кнопка
                            таскает приближённое. Стоит именно здесь, внутри прокрутки и снаружи
                            ленты, — тогда увеличенная высота достаётся полосе прокрутки, а ширина,
                            которой меряются сообщения, остаётся прежней, и текст не переносится
                            заново. Композер и шапка лежат соседними строками и не увеличиваются.
                        -->
                        <local:ChatZoomHost x:Name="ChatZoomLayer">
                            <StackPanel Margin="27,18,58,10" MaxWidth="1070" x:Name="MessagesPanel">
                            </StackPanel>
                        </local:ChatZoomHost>
                    </ScrollViewer>

                    <!--
                        «Ответить» на выделенное в ответе модели. Встаёт у курсора, а не у текста:
                        положение курсора верно и под лупой, и когда выделение кончается внутри
                        формулы или блока кода, у которых нет позиции символа. Регистрируется в
                        PopupManager — клик мимо, колесо и Esc закрывают её сами.
                    -->
                    <Popup x:Name="ReplyPill" Placement="MousePoint" HorizontalOffset="6" VerticalOffset="16"
                           AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
                        <!-- Поля под тень: она рисуется наружу и иначе обрежется. -->
                        <Border Margin="6,4,10,12" Background="{DynamicResource Bg.Panel}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="9" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.4"/>
                            </Border.Effect>
                            <Button x:Name="ReplyPillButton" Style="{StaticResource QuotePillButton}"
                                    Click="ReplyPillButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource Reply}" Width="14" Height="14"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource S.Quote.Reply}" FontSize="12.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Body}"/>
                                    <TextBlock x:Name="ReplyPillHint" FontSize="11" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Popup>

                    <!--
                        Журнал действий этого чата. Лежит поверх ленты, а не в тулбаре композера:
                        тулбар целиком уезжает в компактном режиме, и кнопка пропадала бы вместе с
                        ним. Отсюда и непрозрачный фон со скруглением — сообщения проезжают под
                        кнопкой, и без подложки текст читался бы сквозь иконку. Правое поле 28, а
                        не 20 как у ленты: между кнопкой и краем должна помещаться полоса
                        прокрутки, иначе они наезжают друг на друга на длинном чате.
                    -->
                    <Button x:Name="JournalButton" Grid.Row="0" Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,28,0" Cursor="Hand"
                            ToolTip="{DynamicResource S.Journal.Open}"
                            Click="JournalButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Glass}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        CornerRadius="8">
                                    <Image x:Name="Icon" Source="{DynamicResource Journal}"
                                           Width="15" Height="15" Stretch="Uniform" Opacity="0.55"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Icon" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Поиск по чату (D1, Ctrl+F): над лентой по центру, под рядом кнопок. -->
                    <local:ChatFindBar x:Name="FindBar" Grid.Row="0" Panel.ZIndex="5" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"/>

                    <!-- «Состояние ПК» (C4): рядом с журналом и в той же подложке. -->
                    <Button x:Name="HealthButton" Grid.Row="0" Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,66,0" Cursor="Hand"
                            ToolTip="{DynamicResource S.Health.Open}"
                            AutomationProperties.Name="{DynamicResource S.Health.Open}"
                            Click="HealthButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Glass}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        CornerRadius="8">
                                    <Path x:Name="Icon" Data="M0,7 L3,7 L5,2 L8,12 L10,5 L12,7 L15,7"
                                          Width="15" Height="13" Stretch="Uniform" Opacity="0.55"
                                          Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Icon" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!--
                        Текущий масштаб лупы. Слева от кнопок журнала и «Состояния ПК» (28 + 30 + 8 +
                        30 + 8), чтобы не наезжать на них; Opacity="0" — плашка живёт только во время жеста, её
                        зажигает и гасит ChatZoom. IsHitTestVisible="False": ловить мышь ей нечем,
                        а лежит она поверх ленты, которую в этот момент как раз тащат.
                    -->
                    <Border x:Name="ChatZoomBadge" Grid.Row="0" Opacity="0" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,104,0"
                            Height="30" Padding="10,0" CornerRadius="8"
                            Background="{DynamicResource Bg.Glass}"
                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                        <TextBlock x:Name="ChatZoomBadgeText" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource Text.Muted}"/>
                    </Border>
                    <!--
                        В начало и в конец чата — каждая кнопка у того края, куда ведёт, и только
                        когда он не виден. «В начало» — под кнопкой журнала, той же стеклянной
                        породы и с тем же правым полем 28 (место под полосу прокрутки); «в конец» —
                        круглая, по центру над полем ввода, как в мессенджерах. Обе прозрачны и не
                        ловят мышь, пока не нужны; проявляет их ChatScrollViewer_ScrollChanged.
                        Прежняя капсула справа внизу висела всегда и лежала прямо на тексте.
                    -->
                    <Button x:Name="ScrollTopButton" Grid.Row="0" Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,28,0"
                            Opacity="0" IsHitTestVisible="False" Cursor="Hand" Focusable="False"
                            ToolTip="{DynamicResource S.Chat.ScrollTop}" ToolTipService.VerticalOffset="4"
                            Click="ScrollTopButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Glass}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        CornerRadius="8">
                                    <Path x:Name="Icon" Data="M 1,7 L 6,2 L 11,7" Width="11" Height="7" Stretch="Uniform"
                                          Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ScrollBottomButton" Grid.Row="0" Width="36" Height="36"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                            Opacity="0" IsHitTestVisible="False" Cursor="Hand" Focusable="False"
                            AutomationProperties.Name="{DynamicResource S.Chat.ScrollBottom}"
                            MouseEnter="ScrollBottomButton_MouseEnter" MouseLeave="ScrollBottomButton_MouseLeave"
                            Click="ScrollBottomButton_Click">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="ScrollBottomShift" Y="8"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Glass}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        CornerRadius="18">
                                    <Path x:Name="Icon" Data="M 1,2 L 6,7 L 11,2" Width="12" Height="7" Stretch="Uniform"
                                          Margin="0,2,0,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!--
                        Подсказка к «в конец» — не ToolTip, а элемент окна над кнопкой. Под кнопкой
                        поле ввода, значит подсказке место сверху, а всплывающее окно подсказки
                        сверху вставало не там: его высоту WPF отдаёт размещению не такой, какой
                        карточка выходит на экране. Здесь положение задаёт сама раскладка:
                        поле 12 + кнопка 36 + зазор 4. Вид — тот же, что у подсказок в
                        Resources.xaml, только носик снизу и смотрит на кнопку.
                    -->
                    <StackPanel x:Name="ScrollBottomHint" Grid.Row="0" Opacity="0" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,52">
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="{DynamicResource S.Chat.ScrollBottom}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.Body}"/>
                        </Border>
                        <Path Data="M0,0 L6,6 L12,0 Z" HorizontalAlignment="Center" Margin="0,-1,0,0"
                              Fill="{DynamicResource Bg.Card}" Stroke="{DynamicResource Border.Default}"
                              StrokeThickness="1"/>
                    </StackPanel>
                    <!--
                        VerticalAlignment="Bottom" и ClipToBounds нужны компактному режиму: при
                        Stretch заданная высота центрируется в строке, и полоска зависла бы над
                        нижним краем, а Border не обрезает детей — тулбар вылезал бы за
                        скруглённый край во время анимации. На развёрнутый вид это не влияет:
                        строка ровно по высоте composer'а плюс отступ.
                    -->
                    <Border Grid.Row="1" x:Name="ComposerBorder" Margin="27,0,27,20"
                            Background="{DynamicResource Bg.Glass}" MaxWidth="1070"
                            VerticalAlignment="Bottom" ClipToBounds="True"
                            CornerRadius="6" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                            AllowDrop="True" PreviewDragOver="Composer_DragOver" Drop="Composer_Drop">
                        <Border.Resources>
                            <Style x:Key="ToolIconButton" TargetType="Button">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                            <Style x:Key="PrimaryActionButton" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6" Padding="16,0">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- ===== Бейдж-иконка пункта меню ===== -->
                            <Style x:Key="ActionBadge" TargetType="Border">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="CornerRadius" Value="7"/>
                                <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>

                            <Style x:Key="ActionBadgeIcon" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ActionTitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ActionSubtitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,1,0,0"/>
                            </Style>

                            <!-- ===== Простой пункт (Attach) ===== -->
                            <Style x:Key="ActionItem" TargetType="Button">
                                <Setter Property="Height" Value="46"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="6">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ===== Раскрывающийся пункт (Summarize video) ===== -->
                            <Style x:Key="ActionExpanderToggle" TargetType="ToggleButton">
                                <Setter Property="Height" Value="46"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="6">
                                                <Grid>
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron" Data="M0,0 L4,4 L8,0"
                                  Stroke="{DynamicResource Text.Faint}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="9" Height="5" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Card}"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Tertiary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ===== Плейсхолдер-текстбокс ===== -->
                            <Style x:Key="PopupUrlTextBox" TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                                <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="9,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <!-- ===== Сегментированный переключатель ===== -->
                            <Style x:Key="SegmentedOption" TargetType="RadioButton">
                                <Setter Property="GroupName" Value="SummarizeMode"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Height" Value="27"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bg" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="6">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Полужирная копия-невидимка держит ширину: выбранная подпись толще, и без неё
                                                         соседние кнопки сдвигались бы на пару точек при каждом переключении. -->
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" FontWeight="SemiBold" Visibility="Hidden"/>
                                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="10.5"
                                       Foreground="{DynamicResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>

                        <Grid x:Name="ComposerLayout" Margin="14,10,14,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="ComposerInputRowDef" MinHeight="45"/>
                                <!--
                                    Auto, а не фиксированные 36: высоту задаёт сам тулбар, и
                                    компактный режим анимирует её до нуля. Со строкой Height="36"
                                    строка держала бы высоту, сколько бы тулбар ни ужимался.
                                -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ===== ПРИКРЕПЛЁННЫЕ ВЛОЖЕНИЯ ===== -->
                            <StackPanel x:Name="AttachmentsHost" Grid.Row="0" Visibility="Collapsed"
                                        Margin="0,0,0,8">
                                <!-- Цитаты из ответов — над картинками и файлами: они про то, на что
                                     отвечают, и читаются перед текстом сообщения. Строки собирает
                                     MainWindow.Quotes.cs. -->
                                <StackPanel x:Name="QuotesPanel" Visibility="Collapsed"/>
                                <ItemsControl x:Name="AttachmentsPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="AttachmentsWarning" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"
                                           FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Status.Warning}"/>
                            </StackPanel>

                            <!-- ===== ПОЛЕ ВВОДА ===== -->
                            <Grid x:Name="ComposerInputRow" Grid.Row="1" Margin="0,0,0,6">
                                <TextBox x:Name="MessageTextBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Text.Bright}" CaretBrush="{DynamicResource Text.Bright}"
                     FontSize="13.5"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0"
                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"/>

                                <!--
                                    Подсказка «@»: список прикреплённых цитат над кареткой. Фокус
                                    остаётся в поле ввода, а стрелки, Enter и Tab разбирает
                                    MessageTextBox_PreviewKeyDown раньше отправки.
                                -->
                                <Popup x:Name="QuoteSuggestPopup" PlacementTarget="{Binding ElementName=MessageTextBox}"
                                       Placement="Top" AllowsTransparency="True" PopupAnimation="Fade"
                                       StaysOpen="True" Focusable="False">
                                    <Border Margin="6,12,10,4" MinWidth="220" MaxWidth="380"
                                            Background="{DynamicResource Bg.Panel}"
                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                            CornerRadius="10" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Quote.SuggestTitle}" FontSize="11"
                                                       FontWeight="SemiBold" Margin="8,4,8,4"
                                                       Foreground="{DynamicResource Text.Muted}"/>
                                            <StackPanel x:Name="QuoteSuggestList"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <!--
                                    Подсказка команд «/» (D9): пока набирается имя. Фокус остаётся в
                                    поле, стрелки, Tab и Enter разбирает MessageTextBox_PreviewKeyDown.
                                -->
                                <Popup x:Name="CommandSuggestPopup" PlacementTarget="{Binding ElementName=MessageTextBox}"
                                       Placement="Top" AllowsTransparency="True" PopupAnimation="Fade"
                                       StaysOpen="True" Focusable="False">
                                    <Border Margin="6,12,10,4" MinWidth="260" MaxWidth="420"
                                            Background="{DynamicResource Bg.Panel}"
                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                            CornerRadius="10" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Command.SuggestTitle}" FontSize="11"
                                                       FontWeight="SemiBold" Margin="8,4,8,4"
                                                       Foreground="{DynamicResource Text.Muted}"/>
                                            <StackPanel x:Name="CommandSuggestList"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <TextBlock x:Name="ComposerPlaceholder" Text="{DynamicResource S.Composer.Placeholder}" FontSize="14.5"
                       Foreground="{DynamicResource Text.Faint}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MessageTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- ===== ТУЛБАР ===== -->
                            <Grid x:Name="ComposerToolbar" Grid.Row="2" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Кнопка "+" (прикрепить/добавить контекст) -->
                                <ToggleButton x:Name="AttachButton" AutomationProperties.Name="{DynamicResource S.A11y.Attach}" Grid.Column="0" Width="32" Height="32"
              Margin="0,0,6,0" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6">
                                                <Path x:Name="PlusIcon" Data="M7,0 L7,14 M0,7 L14,7"
                      Stroke="{DynamicResource Text.Tertiary}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="13" Height="13" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                    <Setter TargetName="PlusIcon" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="45"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="ActionsPopup"
       PlacementTarget="{Binding ElementName=AttachButton}"
       Placement="Top"
       VerticalOffset="-8"
       AllowsTransparency="True"
       StaysOpen="True"
       PopupAnimation="Fade"
       IsOpen="{Binding IsChecked, ElementName=AttachButton, Mode=TwoWay}">
                                    <Border Width="300" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="1" CornerRadius="12" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Actions.Title}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Muted}" Margin="8,6,8,4"/>

                                            <Button x:Name="AttachFileButton" Style="{StaticResource ActionItem}"
                                                    Click="AttachFileButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource ActionBadge}">
                                                        <Image Source="{DynamicResource attach}" Margin="6" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform/>
                                                                    <SkewTransform/>
                                                                    <RotateTransform Angle="40"/>
                                                                    <TranslateTransform/>
                                                                </TransformGroup>
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ActionTitle}" Text="{DynamicResource S.Actions.AttachTitle}"/>
                                                        <TextBlock Style="{StaticResource ActionSubtitle}" Text="{DynamicResource S.Actions.AttachSubtitle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                            <!-- Summarize video -->
                                            <ToggleButton x:Name="SummarizeToggle" Style="{StaticResource ActionExpanderToggle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource ActionBadge}">
                                                        <TextBlock Style="{StaticResource ActionBadgeIcon}" Text="▶"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ActionTitle}" Text="{DynamicResource S.Actions.SummarizeTitle}"/>
                                                        <TextBlock Style="{StaticResource ActionSubtitle}" Text="{DynamicResource S.Actions.SummarizeSubtitle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ToggleButton>

                                            <Border Margin="4,4,4,4" Padding="10" Background="{DynamicResource Bg.Card}"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=SummarizeToggle}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
            CornerRadius="6" Height="30">
                                                        <Grid>
                                                            <TextBox x:Name="YoutubeUrlBox" Style="{StaticResource PopupUrlTextBox}"/>
                                                            <TextBlock Text="https://youtube.com/watch?v=..." FontSize="11.5"
                       Foreground="{DynamicResource Text.Faint}" Margin="9,0" VerticalAlignment="Center"
                       IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=YoutubeUrlBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="RawTranscriptOption" Grid.Column="0" Style="{StaticResource SegmentedOption}"
                     Content="{DynamicResource S.Actions.RawTranscript}" IsChecked="True" Margin="0,0,3,0"/>
                                                        <RadioButton x:Name="InfographicOption" Grid.Column="1" Style="{StaticResource SegmentedOption}"
                     Content="{DynamicResource S.Actions.CreateInfographic}" Margin="3,0,0,0"/>
                                                    </Grid>

                                                    <TextBlock x:Name="SummarizeError" FontSize="11" Margin="2,8,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed"
                     Foreground="{DynamicResource Status.Danger}"/>

                                                    <Button x:Name="SummarizeStartButton" Style="{StaticResource PrimaryActionButton}"
                     Content="{DynamicResource S.Actions.Start}" Margin="0,10,0,0" Click="SummarizeStartButton_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                
                                <!-- Селектор модели AI -->
                                <ToggleButton x:Name="ModelButton" AutomationProperties.Name="{DynamicResource S.A11y.Model}" Grid.Column="1" Height="32" Cursor="Hand" Margin="0,0,6,0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6" Padding="6,0,10,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Width="20" Height="20" Margin="0,0,5,0">
                                                        <Image x:Name="ModelButtonLogo" Source="{DynamicResource Claude}" Width="20" Height="20"/>
                                                        <Path x:Name="ModelButtonLightning" Data="M6,0 L1,8 L5,8 L4,14 L10,5 L6,5 Z"
                              Fill="{DynamicResource Text.Muted}" Width="9" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="ModelButtonLetter" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock x:Name="ModelButtonLabel" Text="Claude Sonnet 5" FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="9" Height="5" Stretch="Uniform"
                          Margin="7,0,0,0" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="ModelPicker"
                                       PlacementTarget="{Binding ElementName=ModelButton}"
                                       Placement="Top"
                                       VerticalOffset="-8"
                                       AllowsTransparency="True"
                                       StaysOpen="True"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsChecked, ElementName=ModelButton, Mode=TwoWay}"
                                       Opened="ModelPicker_Opened">
                                    <local:ModelPickerPanel x:Name="ChatModelPicker"
                                                            AllowAuto="True"
                                                            ModelPicked="ChatModelPicker_ModelPicked"
                                                            KeyPicked="ChatModelPicker_KeyPicked"
                                                            AddKeyRequested="ChatModelPicker_AddKeyRequested"
                                                            ProviderShown="ModelPicker_ProviderShown"/>
                                </Popup>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:ReasoningPicker x:Name="ChatReasoningPicker" Height="32"
                                                           VerticalAlignment="Center" ShowGaugeIcon="True"
                                                           ChoiceChanged="ChatReasoningPicker_ChoiceChanged"/>
                                    <!-- Где исполняются команды чата (C10). Без машин в списке не показывается. -->
                                    <local:TargetPicker x:Name="ChatTargetPicker" VerticalAlignment="Center"
                                                        Visibility="Collapsed"/>
                                    <!-- У чата свой промпт или набор инструкций (D11). Щелчок — настройки чата. -->
                                    <Button x:Name="ProfileChip" Visibility="Collapsed" Height="26" Margin="6,0,0,0"
                                            Padding="8,0,10,0" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="{DynamicResource S.ChatProfile.ChipTip}"
                                            AutomationProperties.Name="{DynamicResource S.ChatProfile.Chip}"
                                            Click="ProfileChip_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="7" BorderThickness="1"
                                                        Background="{DynamicResource Bg.Raised}"
                                                        BorderBrush="{DynamicResource Border.Default}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M2,3 L12,3 M2,7 L9,7 M2,11 L11,11" Width="10" Height="9"
                                                              Stretch="Uniform" StrokeThickness="1.3" StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" Stroke="{DynamicResource Accent.Fill}"
                                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource S.ChatProfile.Chip}" FontSize="11.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Text.Primary}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Чат в режиме «только чтение» (/readonly, D9). Щелчок выключает. -->
                                    <Button x:Name="ReadOnlyChip" Visibility="Collapsed" Height="26" Margin="6,0,0,0"
                                            Padding="8,0,10,0" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="{DynamicResource S.Command.ReadOnlyChipTip}"
                                            AutomationProperties.Name="{DynamicResource S.Command.ReadOnlyChip}"
                                            Click="ReadOnlyChip_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="7" BorderThickness="1"
                                                        Background="{DynamicResource Status.WarningSurface}"
                                                        BorderBrush="{DynamicResource Status.Warning}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M3,6 L3,4 A3,3 0 0 1 9,4 L9,6 M1.5,6 L10.5,6 L10.5,12 L1.5,12 Z"
                                                              Width="10" Height="11" Stretch="Uniform" StrokeThickness="1.2"
                                                              Stroke="{DynamicResource Status.Warning}" Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource S.Command.ReadOnlyChip}" FontSize="11.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Text.Primary}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Во что обошёлся чат целиком, со всеми вариантами (E3). Разбивка — в подсказке. -->
                                    <Border x:Name="ChatCostChip" Visibility="Collapsed" Height="26" Margin="6,0,0,0"
                                            Padding="8,0,10,0" CornerRadius="7" BorderThickness="1" VerticalAlignment="Center"
                                            Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                                            AutomationProperties.Name="{DynamicResource S.ChatCost.Name}"
                                            ToolTipService.InitialShowDelay="250" ToolTipOpening="ChatCostChip_ToolTipOpening">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Σ" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Faint}"/>
                                            <TextBlock x:Name="ChatCostText" FontSize="11.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                    <!--
                                        Остаток на счету. Высота задана явно, а не растянута по
                                        строке: тулбар меняет высоту в компактном режиме, и плашка
                                        на Stretch скакала бы вместе с ним. Радиус и высота взяты
                                        от кнопки отправки справа, чтобы пара читалась как один
                                        ряд. Цвета ставит BalanceBadge из палитры — здесь только
                                        форма. Видна всегда: до первого ответа Venice цифра берётся
                                        из кэша на диске, а если и его нет — стоит прочерк.
                                    -->
                                    <!--
                                        Кольцо контекста и остаток на счету — один ряд показаний.
                                        Обёрнуты в общую панель, потому что оба жмутся вправо в
                                        одну звёздную колонку: два независимых HorizontalAlignment
                                        встали бы друг на друга.
                                    -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">

                                    <!--
                                        Заполненность контекстного окна. Геометрию обеих дуг
                                        строит код (ContextRing): дуга прогресса обязана лечь
                                        ровно на фоновую, а два набора чисел — в разметке и в
                                        коде — рано или поздно разъезжаются. Форма повторяет
                                        плашку баланса справа, цвета ставит ContextRing.
                                    -->
                                    <!-- «Сжать» (D10): появляется, когда окно заполнено почти целиком. -->
                                    <Button x:Name="ContextHintButton" Visibility="Collapsed" Margin="0,0,6,0"
                                            Height="28" Padding="10,0" Cursor="Hand" VerticalAlignment="Center"
                                            Content="{DynamicResource S.Compact.Hint}"
                                            ToolTip="{DynamicResource S.Compact.HintTip}"
                                            Click="ContextHintButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="8" BorderThickness="1"
                                                        Background="{DynamicResource Status.WarningSurface}"
                                                        BorderBrush="{DynamicResource Status.Warning}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      TextBlock.FontSize="12" TextBlock.FontWeight="SemiBold"
                                                                      TextBlock.Foreground="{DynamicResource Text.Primary}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Оценка цены следующего ответа (E2): тихой подписью, без плашки. -->
                                    <TextBlock x:Name="CostEstimateText" Visibility="Collapsed" Margin="0,0,8,0"
                                               FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                    <Border x:Name="ContextBadge"
                                            VerticalAlignment="Center"
                                            Height="28" CornerRadius="8" Padding="8,0,10,0"
                                            BorderThickness="1" Margin="0,0,8,0"
                                            Cursor="Hand" MouseLeftButtonUp="ContextBadge_MouseLeftButtonUp">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="18" Height="18" Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                <Path x:Name="ContextTrack" Width="18" Height="18" Stretch="None"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Path x:Name="ContextProgress" Width="18" Height="18" Stretch="None"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                            <TextBlock x:Name="ContextAmount" Text="-" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="BalanceBadge"
                                            VerticalAlignment="Center"
                                            Height="28" CornerRadius="8" Padding="8,0,10,0"
                                            BorderThickness="1" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!--
                                                Обе фигуры одним Path: у них общая система
                                                координат 24x24, и растянуть их порознь нельзя —
                                                задняя монетка занимает лишь угол бокса и,
                                                растянутая сама по себе, раздулась бы на всю
                                                иконку.
                                            -->
                                            <Path x:Name="BalanceCoin" Width="15" Height="15"
                                                  Stretch="Uniform" Margin="0,0,6,0"
                                                  VerticalAlignment="Center">
                                                <Path.Data>
                                                    <GeometryGroup FillRule="Nonzero">
                                                        <StaticResource ResourceKey="Coin.Back"/>
                                                        <StaticResource ResourceKey="Coin.Face"/>
                                                    </GeometryGroup>
                                                </Path.Data>
                                            </Path>
                                            <TextBlock x:Name="BalanceAmount" Text="-" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!--
                                        Голосовой ввод (D14): щелчок — начать и остановить, удержание —
                                        говорить, пока держишь; Esc отменяет. Круг за кнопкой дышит
                                        громкостью, рядом — время записи. Без распознавания (нет
                                        распознавателя Windows для языка и не задана облачная модель)
                                        кнопки нет вовсе: записывать было бы нечем распознавать.
                                    -->
                                    <TextBlock x:Name="VoiceTimer" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource Status.Danger}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <Grid x:Name="MicHost" Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="VoiceLevel" Fill="{DynamicResource Status.Danger}" Opacity="0"
                                                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="VoiceLevelScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Button x:Name="MicButton" Cursor="Hand"
                                                ToolTip="{DynamicResource S.Voice.Button}"
                                                AutomationProperties.Name="{DynamicResource S.Voice.Button}"
                                                PreviewMouseLeftButtonDown="MicButton_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="MicButton_PreviewMouseLeftButtonUp"
                                                Click="MicButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                                        <Path Data="M6,1 A2.5,2.5 0 0 1 8.5,3.5 L8.5,7.5 A2.5,2.5 0 0 1 3.5,7.5 L3.5,3.5 A2.5,2.5 0 0 1 6,1 Z M1,7 A5,5 0 0 0 11,7 M6,12 L6,14.5"
                                                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Width="12" Height="15" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    </StackPanel>

                                    <Button x:Name="SendButton" AutomationProperties.Name="{DynamicResource S.A11y.Send}" Grid.Column="4" Width="32" Height="32" Cursor="Hand" Click="SendButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="8">
                                                <Path Data="M6,11 L6,1 M1,5 L6,0 L11,5"
                                  Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent.FillHover}" TargetName="Bg"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid VerticalAlignment="Center" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleUrbanist}" Text="Amarin Admin AI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1">
                        <!--
                            Кнопка, а не значок: щелчок перезапускает программу от администратора (C9).
                            Вид и подсказка — ровно как в 1.27.1: без подсветки под курсором и с одной
                            строкой текста; о щелчке говорит курсор-рука.
                        -->
                        <Button Width="32" Height="32" x:Name="Warn"
        Cursor="Hand"
        Click="Warn_Click"
        AutomationProperties.Name="{DynamicResource S.Elevation.Restart}"
        ToolTipService.Placement="Custom"
        ToolTipService.HorizontalOffset="0"
        ToolTipService.VerticalOffset="6"
        ToolTipService.InitialShowDelay="150"
        ToolTipService.ShowDuration="20000">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="4">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip>
                                <ToolTip Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 HasDropShadow="False">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <!-- Стрелка, указывающая на иконку -->
                                                <Path Grid.Row="0"
                              Data="M0,6 L6,0 L12,6 Z"
                              Fill="{DynamicResource Bg.Card}"
                              Stroke="{DynamicResource Status.WarningBorder}"
                              StrokeThickness="1"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,-1"/>

                                                <!-- Тело подсказки -->
                                                <Border Grid.Row="1"
                                Width="230"
                                Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Status.WarningBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠"
                                           FontSize="13"
                                           Foreground="{DynamicResource Status.Warning}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,8,0"/>
                                                        <TextBlock Text="{DynamicResource S.Chrome.NotAdmin}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           MaxWidth="196"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Button.ToolTip>

                            <Image Source="{DynamicResource Alert}"
           Stretch="Uniform"
           Margin="6" />
                        </Button>
                        <Button Style="{StaticResource LockChromeButton}"
                                Tag="{DynamicResource Minimize}" AutomationProperties.Name="{DynamicResource S.A11y.Minimize}"
                                Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource LockChromeButton}"
                                Tag="{DynamicResource Maximize}" AutomationProperties.Name="{DynamicResource S.A11y.Maximize}"
                                Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource LockChromeCloseButton}"
                                Tag="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource S.A11y.CloseApp}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
            <Grid.Resources>
                <ResourceDictionary>
                <!--
                    Общие стили настроек — один словарь на окно и на страницы-UserControl: у
                    страниц 1.28.0 были свои копии тумблера, кнопок и заголовков, и вид
                    расходился от страницы к странице. Здесь остаётся только своё.
                -->
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="SettingsPageStyles.xaml"/>
                </ResourceDictionary.MergedDictionaries>
                <!-- ===== Кнопка "Сохранить" для промптов ===== -->
                <Style x:Key="SavePromptButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M0,3.5 L3,6.5 L8,0" Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="9" Height="7" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource S.Settings.SavePrompt}" FontSize="11.5"
                                   Foreground="{DynamicResource Text.OnAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Elevated}"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!--
                    «+ Создать» у библиотеки заготовок. Своя копия SavePromptButton, потому что
                    там подпись и галочка зашиты в шаблон: у кнопки «сохранить» она одна на всю
                    программу, а здесь нужен плюс и своя надпись.
                -->
                <Style x:Key="PromptAddButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M4,0 L4,8 M0,4 L8,4" Stroke="{DynamicResource Accent.Fill}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="9" Height="9" Stretch="Uniform"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Пункт навигации ===== -->
                <Style x:Key="SettingsNavItem" TargetType="RadioButton">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Margin" Value="8,1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="GroupName" Value="SettingsNav"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,0">
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       FontSize="12.5" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Body}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Отступ сверху 12, а не 14: с пунктом «Инструкции» в колонке восемь страниц,
                     и плашка версии с надписью об обновлении в две строки иначе вставала
                     почти вплотную к последнему пункту. -->
                <Style x:Key="SettingsNavGroup" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                    <Setter Property="Margin" Value="18,12,8,4"/>
                </Style>


                <!-- ===== Мелкий раскрывающийся пункт (модель SynGuard) =====
                     Тот же приём с шевроном, что у ActionExpanderToggle, но по размеру подписи:
                     тот занимает строку целиком и уводит шеврон к правому краю, а здесь стрелка
                     обязана стоять сразу за текстом, иначе непонятно, что раскрывает. -->
                <Style x:Key="InlineExpanderToggle" TargetType="ToggleButton">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6,3">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                        <Path x:Name="Chevron" Data="M0,0 L4,4 L8,0"
                                              Stroke="{DynamicResource Text.Faint}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="9" Height="5" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="7,1,0,0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Tertiary}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text.Tertiary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>




                <!--
                    Нижняя половина плашки «версия и репозиторий». Своим шаблоном, а не Hyperlink:
                    Hyperlink живёт только внутри текстового потока и тянет собственное
                    подчёркивание, а здесь нужен кликабельный прямоугольник во всю ширину плашки.

                    Фон Bg.Selected, а не Bg.Raised: от Bg.Card, которым залита верхняя половина,
                    Raised отличается на четыре уровня яркости — в тёмных палитрах две части
                    сливались бы в одну. Плюс отбивка сверху линией, чтобы граница читалась даже
                    там, где палитра выбрана малоконтрастной.
                -->
                <Style x:Key="SettingsAboutLink" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <!--
                                    Нижние углы скругляются здесь: ClipToBounds у родителя режет по
                                    прямоугольнику и CornerRadius не учитывает, так что нижние углы
                                    плашки оставались квадратными. Радиус 6 — это внешние 7 минус
                                    пиксель рамки карточки.
                                -->
                                <Border x:Name="Bg" Padding="8,4" CornerRadius="0,0,6,6"
                                        Background="{DynamicResource Bg.Selected}"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Path x:Name="Mark" Data="{StaticResource Icon.Github}"
                                              Stretch="Uniform" Width="11" Height="11"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource Text.Body}"/>
                                        <TextBlock x:Name="Label" Text="{DynamicResource S.About.Github}"
                                                   FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Body}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!--
                                        Подсветка цветом акцента, а не фоном: Bg.Hover в тёмных
                                        палитрах темнее Bg.Selected, и наведение выглядело бы
                                        как «кнопка погасла».
                                    -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource Accent.Fill}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Accent.Fill}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>



                <!-- ===== Многострочный промпт ===== -->
                <!--
                    Рамка и отступы теперь на карточке (PromptEditor), а не на самом поле:
                    кнопки «Сбросить» и «Сохранить» стоят внутри той же рамки, под текстом.
                    Пока они висели над полем, в столбик шли три одинаковые кнопки на три поля,
                    и какая к какому относится, приходилось угадывать.
                -->
                <Style x:Key="PromptTextBox" TargetType="TextBox">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                    <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="AcceptsReturn" Value="True"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="MinHeight" Value="96"/>
                    <!--
                        Без потолка поле растёт вместе с текстом: системный промпт на сотню строк
                        растягивал страницу настроек, и до полей под ним приходилось прокручивать
                        весь его текст. Своя полоса прокрутки у поля была и раньше, но включалась
                        только когда упираться было не во что.
                    -->
                    <Setter Property="MaxHeight" Value="176"/>
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" local:SmoothScroll.IsEnabled="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--
                    Карточка промпта: поле сверху, его кнопки снизу, всё в одной рамке.
                    Grid со строкой «*» под полем, а не StackPanel: тогда потолок высоты
                    карточки достаётся полю, а ряд кнопок остаётся на месте при любом тексте.
                -->
                <Style x:Key="PromptEditor" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!--
                    «Сбросить» у технических промптов. Своя копия PromptAddButton: там плюс и
                    подпись от Content, здесь круговая стрелка и одна подпись на всю программу.
                    Только у технических — основной промпт человек пишет сам, и «заводского»
                    текста, к которому его возвращать, у него нет.
                -->
                <Style x:Key="ResetPromptButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent"
                                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="Glyph" Data="{DynamicResource Icon.Revert}"
                                              Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="11" Height="11" Stretch="Uniform"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Label"
                                                   Text="{DynamicResource S.Settings.ResetPrompt}" FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                        <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Text.Body}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Body}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Карточка темы ===== -->
                <!--
                    Карточка темы. Содержимое — превью палитры, которое собирается кодом из
                    ThemeCatalog, поэтому здесь ContentPresenter, а не TextBlock: шаблон не может
                    принять три цвета через TemplateBinding.
                -->
                <Style x:Key="ThemeCard" TargetType="RadioButton">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="GroupName" Value="Theme"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bg" Width="98" Height="68" Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Path x:Name="Check" Data="M0,3 L3,6 L8,0" Stroke="{DynamicResource Text.Bright}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="9" Height="7" Stretch="Uniform" Visibility="Collapsed"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,8,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--
                    Плитка заготовки основного промпта. Кнопка, а не RadioButton как у тем:
                    выбор ничего не запоминает, нажатие только предлагает подменить текст.
                    Карандаш и корзина проявляются по наведению - иначе две иконки на каждой
                    плитке забивают собой название, ради которого плитка и нужна.
                -->
                <Style x:Key="PromptCard" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Width" Value="152"/>
                    <Setter Property="Height" Value="62"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--
                    Карандаш и корзина внутри плитки. Кнопка внутри кнопки: нажатие гасится
                    в коде, иначе клик по корзине заодно предложил бы применить заготовку.
                -->
                <Style x:Key="PromptCardAction" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Width" Value="18"/>
                    <Setter Property="Height" Value="18"/>
                    <Setter Property="Margin" Value="2,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                                    <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                               FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Сегмент переключателя «Нет / Градиент / Изображение» -->
                <Style x:Key="SettingsSegment" TargetType="RadioButton">
                    <Setter Property="GroupName" Value="BackdropMode"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,0">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Полужирная копия-невидимка держит ширину: выбранная подпись толще, и без неё
                                             соседние кнопки сдвигались бы на пару точек при каждом переключении. -->
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Visibility="Hidden"/>
                                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Ползунок настройки: заполненная дорожка слева от бегунка -->
                <Style x:Key="SettingsRangeSlider" TargetType="Slider">
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="IsMoveToPointEnabled" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Slider">
                                <Grid>
                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{DynamicResource Bg.Track}"/>
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                                Background="{DynamicResource Accent.Fill}"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Width="13" Height="13"
                                                                 Fill="{DynamicResource Accent.Fill}"
                                                                 Stroke="{DynamicResource Bg.Panel}" StrokeThickness="2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="SettingValue" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>

                </ResourceDictionary>
            </Grid.Resources>

            <!-- Затемнение -->
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="SettingsCloseButton_Click"></Button>
            </Border>

            <!-- Окно -->
            <!--
                690×520 и десять страниц в четырёх группах, как в 1.27.1 (там было 690×460 и восемь).
                1.28.0 растянула окно до 620: каждая новая страница шла отдельным пунктом, и колонка
                перестала помещаться. Теперь компьютеры и MCP — вкладки Automation, а тяжёлые блоки
                живут на подстраницах (SettingsDrill), и окно снова не выше, чем нужно. Колонка
                навигации всё равно прокручивается, а плашка версии стоит своей строкой под ней.
                На маленьком экране Viewbox ужимает окно целиком.
            -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border x:Name="SettingsCard" Width="690" Height="520" Background="{DynamicResource Bg.Panel}"
            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== НАВИГАЦИЯ ===== -->
                    <Border Background="{DynamicResource Bg.Sidebar}" CornerRadius="10,0,0,10"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="SettingsNavScroll" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled" local:SmoothScroll.IsEnabled="True">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource SettingsNavGroup}" Text="{DynamicResource S.Settings.Nav.General}" Margin="18,16,8,4"/>
                                <RadioButton x:Name="NavAccount" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Account}"/>
                                <RadioButton x:Name="NavAppearance" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Appearance}"/>
                                <RadioButton x:Name="NavBehavior" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Behavior}" IsChecked="True"/>
                                <RadioButton x:Name="NavSecurity" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Security}" Checked="NavSecurity_Checked"/>
                                <TextBlock Style="{StaticResource SettingsNavGroup}" Text="{DynamicResource S.Settings.Nav.Model}"/>
                                <RadioButton x:Name="NavCustomize" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Customize}"/>
                                <RadioButton x:Name="NavInstructions" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Instructions}" Checked="NavInstructions_Checked"/>
                                <RadioButton x:Name="NavAutomation" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Automation}" Checked="NavAutomation_Checked"/>
                                <TextBlock Style="{StaticResource SettingsNavGroup}" Text="{DynamicResource S.Settings.Nav.Key}"/>
                    <RadioButton x:Name="NavKey" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.KeyInfo}" Checked="NavKey_Checked"/>
                    <TextBlock Style="{StaticResource SettingsNavGroup}" Text="{DynamicResource S.Settings.Nav.DataAndInfo}"/>
                                <RadioButton x:Name="NavData" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.DataControls}" Checked="NavData_Checked"/>
                                <RadioButton x:Name="NavInfo" Style="{StaticResource SettingsNavItem}" Content="{DynamicResource S.Settings.Nav.Info}"/>
                            </StackPanel>
                            </ScrollViewer>

                            <!--
                                Плашка «версия и репозиторий»: верхняя половина — номер версии,
                                нижняя — ссылка на репозиторий, залитая своим фоном.

                                Растягивается по ширине колонки, а не по содержимому: при найденном
                                обновлении MainWindow.Updates.cs переписывает SettingsVersionText
                                длинной строкой S.Updates.SidebarBadge. Сжатая по содержимому
                                карточка на ней раздувалась бы за пределы колонки в 170 пикселей
                                прямо под страницу настроек; здесь ширина задана полями, а лишнее
                                уходит в перенос.
                            -->
                            <Border x:Name="SettingsAboutCard" Grid.Row="1"
                                    VerticalAlignment="Bottom" Margin="20,0,20,12"
                                    Background="{DynamicResource Bg.Card}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Text.Secondary, а не Text.Faint: блёклый серый на тёмной карточке не читался. -->
                                    <TextBlock x:Name="SettingsVersionText"
                                               Text="v1.28.0"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="7,3,7,4"/>
                                    <Button x:Name="GithubLinkButton" Grid.Row="1"
                                            Style="{StaticResource SettingsAboutLink}"
                                            Click="GithubLinkButton_Click"
                                            ToolTip="{DynamicResource S.About.GithubHint}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ===== КОНТЕНТ ===== -->
                    <Grid Grid.Column="1">

                        <!-- Крестик поверх всех страниц -->
                        <Button x:Name="SettingsCloseButton" AutomationProperties.Name="{DynamicResource S.Common.Close}" Width="26" Height="26" Panel.ZIndex="1"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                        Cursor="Hand" Click="SettingsCloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                        <Path x:Name="Icon" Data="M0,0 L8,8 M8,0 L0,8"
                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="9" Height="9" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Primary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ═══════════ ACCOUNT ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" local:UiMotion.FadeOnShow="True">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavAccount}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Account.Title}"/>

                                <!-- Карточка аккаунта -->
                                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Bg.Selected}"
                                                local:RoundedClip.Radius="8">
                                            <Grid>
                                                <TextBlock x:Name="AccountAvatarLetter" Text="Г" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="AccountAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountNameText" Text="{DynamicResource S.Account.Guest}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Body}"/>
                                            <TextBlock x:Name="AccountModeText" Text="{DynamicResource S.Account.LocalMode}" FontSize="11"
                                                       Foreground="{DynamicResource Text.Faint}"/>
                                        </StackPanel>
                                        <Button x:Name="SwitchAccountButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Account.SwitchProfile}" Click="SwitchAccountButton_Click"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Account.Avatar}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="RemoveAvatarButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Common.Remove}" Margin="0,0,6,0" Click="RemoveAvatarButton_Click"/>
                                        <Button x:Name="ChangeAvatarButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Common.Change}" Click="ChangeAvatarButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <StackPanel Margin="0,0,120,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Account.UserName}"/>
                                        <TextBlock x:Name="AccountNameHint" Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Account.Guest}"/>
                                    </StackPanel>
                                    <Button x:Name="ChangeNameButton" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Content="{DynamicResource S.Common.Change}" Click="ChangeNameButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <StackPanel Margin="0,0,180,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Account.Password}"/>
                                        <TextBlock x:Name="AccountPasswordHint" Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Account.PasswordNotSet}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="RemovePasswordButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Common.Delete}" Margin="0,0,6,0" Click="RemovePasswordButton_Click"/>
                                        <Button x:Name="ChangePasswordButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Common.Change}" Click="ChangePasswordButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Account.PasswordAtStartup}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Account.PasswordAtStartupDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Account.PasswordAtStartup}" x:Name="LockOnStartupToggle" Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                              Checked="LockOnStartupToggle_Changed" Unchecked="LockOnStartupToggle_Changed"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ APPEARANCE ═══════════ -->
                        <ScrollViewer x:Name="AppearancePageScroll" VerticalScrollBarVisibility="Auto" local:UiMotion.FadeOnShow="True">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavAppearance}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Appearance.Title}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.UiScale}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Appearance.UiScaleDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="UiScaleComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      MinWidth="110" SelectedIndex="2"
                                      SelectionChanged="UiScaleComboBox_SelectionChanged">
                                        <ComboBoxItem Content="80%" Tag="80"/>
                                        <ComboBoxItem Content="90%" Tag="90"/>
                                        <ComboBoxItem Content="100%" Tag="100"/>
                                        <ComboBoxItem Content="110%" Tag="110"/>
                                        <ComboBoxItem Content="125%" Tag="125"/>
                                        <ComboBoxItem Content="150%" Tag="150"/>
                                        <ComboBoxItem Content="175%" Tag="175"/>
                                        <ComboBoxItem Content="200%" Tag="200"/>
                                        <ComboBoxItem Content="225%" Tag="225"/>
                                        <ComboBoxItem Content="250%" Tag="250"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.DateFormat}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Appearance.DateFormatDesc}"/>
                                    </StackPanel>
                                    <!--
                                        Подписи пунктов — литералы, а не ключи словаря: это шаблон даты,
                                        а не текст, и перевод развалил бы его вместе с выбором.
                                    -->
                                    <ComboBox x:Name="DateFormatComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      MinWidth="110" SelectedIndex="0"
                                      SelectionChanged="DateFormatComboBox_SelectionChanged">
                                        <ComboBoxItem Content="DD.MM.YY" Tag="DayMonthShort"/>
                                        <ComboBoxItem Content="MM.DD.YY" Tag="MonthDayShort"/>
                                        <ComboBoxItem Content="DD.MM.YYYY" Tag="DayMonthFull"/>
                                        <ComboBoxItem Content="MM.DD.YYYY" Tag="MonthDayFull"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Углы окна рисует Windows 11, и видов у неё ровно три — см. WindowCornerStyle. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.WindowCorners}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Appearance.WindowCornersDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="WindowCornersComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      MinWidth="110" SelectedIndex="0"
                                      SelectionChanged="WindowCornersComboBox_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.CornersSmall}" Tag="Small"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.CornersRound}" Tag="Round"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.CornersSquare}" Tag="Square"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Размер текста ленты и шрифт кода (I3) — в той же группе, что масштаб. -->
                                <local:AccessibilityBlock x:Name="AccessibilitySettings"/>
                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.Theme}"/>
                                <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Appearance.ThemeDesc}"
                                           Margin="0,0,0,8"/>
                                <!-- Карточки строятся кодом из ThemeCatalog.Presets: новая тема = одна строка в каталоге -->
                                <WrapPanel x:Name="ThemeCardsHost" Orientation="Horizontal"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.FollowSystem}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.FollowSystemDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Appearance.FollowSystem}" x:Name="ThemeFollowSystemToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="ThemeFollowSystemToggle_Changed"
                                              Unchecked="ThemeFollowSystemToggle_Changed"/>
                                </Grid>
                                <!-- Высокая контрастность Windows (I2) — рядом с другим «как в Windows» у темы. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Access.Contrast}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Access.ContrastDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Access.Contrast}" x:Name="HighContrastToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="HighContrastToggle_Changed"
                                              Unchecked="HighContrastToggle_Changed"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.Customisation}" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.CustomisationDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Appearance.Customisation}" x:Name="AppearanceEnabledToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="AppearanceEnabledToggle_Changed"
                                              Unchecked="AppearanceEnabledToggle_Changed"/>
                                </Grid>

                                <StackPanel x:Name="AppearanceBody" Margin="0,10,0,0"
                                            IsEnabled="{Binding IsChecked, ElementName=AppearanceEnabledToggle}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Accent}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}"
                                                       Text="{DynamicResource S.Appearance.AccentDesc}"/>
                                        </StackPanel>
                                        <local:ColorPickerField x:Name="AccentPicker" Grid.Column="1" Width="118"
                                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Style="{StaticResource SettingsDivider}"/>

                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.Backdrop}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                        <RadioButton x:Name="BackdropNone" Style="{StaticResource SettingsSegment}"
                                                     Content="{DynamicResource S.Common.None}" Tag="None" Checked="BackdropMode_Checked"/>
                                        <RadioButton x:Name="BackdropGradient" Style="{StaticResource SettingsSegment}"
                                                     Content="{DynamicResource S.Appearance.Gradient}" Tag="Gradient" Checked="BackdropMode_Checked"/>
                                        <RadioButton x:Name="BackdropImage" Style="{StaticResource SettingsSegment}"
                                                     Content="{DynamicResource S.Appearance.Image}" Tag="Image" Checked="BackdropMode_Checked"/>
                                    </StackPanel>

                                    <!-- ── Градиент ── -->
                                    <StackPanel x:Name="GradientPanel" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Appearance.Presets}"
                                                   Margin="0,0,0,6"/>
                                        <WrapPanel x:Name="GradientPresetsHost" Margin="0,0,0,10"/>

                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Colours}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <local:ColorPickerField x:Name="GradientColor1" Width="106" Margin="0,0,6,0"/>
                                            <local:ColorPickerField x:Name="GradientColor2" Width="106" Margin="0,0,6,0"/>
                                            <local:ColorPickerField x:Name="GradientColor3" Width="106" Margin="0,0,6,0"/>
                                            <local:ColorPickerField x:Name="GradientColor4" Width="106"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Angle}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="GradientAngleSlider" Grid.Column="1"
                                                    Style="{StaticResource SettingsRangeSlider}"
                                                    Minimum="0" Maximum="359" SmallChange="1" LargeChange="15"/>
                                            <TextBlock x:Name="GradientAngleValue" Grid.Column="2"
                                                       Style="{StaticResource SettingValue}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Motion}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="{DynamicResource S.Appearance.MotionDesc}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="MotionCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                                      MinWidth="130" VerticalAlignment="Center"
                                                      SelectionChanged="MotionCombo_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource S.Common.None}" Tag="None"/>
                                                <ComboBoxItem Content="{DynamicResource S.Appearance.MotionDrift}" Tag="Drift"/>
                                                <ComboBoxItem Content="{DynamicResource S.Appearance.MotionAurora}" Tag="Aurora"/>
                                                <ComboBoxItem Content="{DynamicResource S.Appearance.MotionPulse}" Tag="Pulse"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Speed}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="MotionSpeedSlider" Grid.Column="1"
                                                    Style="{StaticResource SettingsRangeSlider}"
                                                    Minimum="0.25" Maximum="3" SmallChange="0.05" LargeChange="0.25"/>
                                            <TextBlock x:Name="MotionSpeedValue" Grid.Column="2"
                                                       Style="{StaticResource SettingValue}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- ── Изображение ── -->
                                    <StackPanel x:Name="ImagePanel" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.File}"/>
                                                <TextBlock x:Name="BackgroundImageName" Style="{StaticResource SettingDesc}"
                                                           Text="{DynamicResource S.Common.NotChosen}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="RemoveBackgroundButton" Style="{StaticResource SecondaryButton}"
                                                        Content="{DynamicResource S.Common.Remove}" Margin="0,0,6,0" Click="RemoveBackgroundButton_Click"/>
                                                <Button x:Name="ChooseBackgroundButton" Style="{StaticResource SecondaryButton}"
                                                        Content="{DynamicResource S.Common.Choose}" Click="ChooseBackgroundButton_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.ImageFit}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="ImageFitCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                                      MinWidth="130" VerticalAlignment="Center"
                                                      SelectionChanged="ImageFitCombo_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource S.Appearance.FitFill}" Tag="Fill"/>
                                                <ComboBoxItem Content="{DynamicResource S.Appearance.FitWhole}" Tag="Fit"/>
                                                <ComboBoxItem Content="{DynamicResource S.Appearance.FitTile}" Tag="Tile"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Brightness}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="ImageBrightnessSlider" Grid.Column="1"
                                                    Style="{StaticResource SettingsRangeSlider}"
                                                    Minimum="0.2" Maximum="1.6" SmallChange="0.02" LargeChange="0.1"/>
                                            <TextBlock x:Name="ImageBrightnessValue" Grid.Column="2"
                                                       Style="{StaticResource SettingValue}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Saturation}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="ImageSaturationSlider" Grid.Column="1"
                                                    Style="{StaticResource SettingsRangeSlider}"
                                                    Minimum="0" Maximum="2" SmallChange="0.02" LargeChange="0.1"/>
                                            <TextBlock x:Name="ImageSaturationValue" Grid.Column="2"
                                                       Style="{StaticResource SettingValue}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.CrystalDepth}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Appearance.PhotoBlur}"/>
                                            </StackPanel>
                                            <Slider x:Name="ImageBlurSlider" Grid.Column="1"
                                                    Style="{StaticResource SettingsRangeSlider}"
                                                    Minimum="0" Maximum="80" SmallChange="1" LargeChange="5"/>
                                            <TextBlock x:Name="ImageBlurValue" Grid.Column="2"
                                                       Style="{StaticResource SettingValue}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- ── Стекло ── -->
                                    <StackPanel x:Name="GlassPanel" Visibility="Collapsed">
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.Glass}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.GlassDesc}"
                                                   Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.PanelDensity}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="GlassOpacitySlider" Grid.Column="1"
                                                    Style="{StaticResource SettingsRangeSlider}"
                                                    Minimum="0.15" Maximum="1" SmallChange="0.01" LargeChange="0.05"/>
                                            <TextBlock x:Name="GlassOpacityValue" Grid.Column="2"
                                                       Style="{StaticResource SettingValue}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Frost}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="GlassFrostSlider" Grid.Column="1"
                                                    Style="{StaticResource SettingsRangeSlider}"
                                                    Minimum="0" Maximum="0.6" SmallChange="0.01" LargeChange="0.05"/>
                                            <TextBlock x:Name="GlassFrostValue" Grid.Column="2"
                                                       Style="{StaticResource SettingValue}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Sheen}"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox AutomationProperties.Name="{DynamicResource S.Appearance.Sheen}" x:Name="GlassSheenToggle" Grid.Column="1"
                                                      Style="{StaticResource SettingsToggle}"
                                                      Checked="GlassSheenToggle_Changed" Unchecked="GlassSheenToggle_Changed"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Vignette}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="{DynamicResource S.Appearance.VignetteDesc}"/>
                                            </StackPanel>
                                            <CheckBox AutomationProperties.Name="{DynamicResource S.Appearance.Vignette}" x:Name="VignetteToggle" Grid.Column="1"
                                                      Style="{StaticResource SettingsToggle}"
                                                      Checked="VignetteToggle_Changed" Unchecked="VignetteToggle_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.Interface}"/>

                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Font}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.FontDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                              MinWidth="130" VerticalAlignment="Center"
                                              SelectionChanged="FontCombo_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.FontSystem}" Tag=""/>
                                        <ComboBoxItem Content="Urbanist" Tag="Urbanist"/>
                                        <ComboBoxItem Content="Outfit" Tag="Outfit"/>
                                        <ComboBoxItem Content="Rubik" Tag="Rubik"/>
                                        <ComboBoxItem Content="Arimo" Tag="Arimo"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.ChatWidth}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.ChatWidthDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ChatWidthCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                              MinWidth="130" VerticalAlignment="Center"
                                              SelectionChanged="ChatWidthCombo_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthNarrow}" Tag="760"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthNormal}" Tag="1070"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthWide}" Tag="1400"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthFull}" Tag="100000"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.InputRadius}"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="CornerRadiusSlider" Grid.Column="1"
                                            Style="{StaticResource SettingsRangeSlider}"
                                            Minimum="0" Maximum="20" SmallChange="1" LargeChange="2"/>
                                    <TextBlock x:Name="CornerRadiusValue" Grid.Column="2"
                                               Style="{StaticResource SettingValue}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Grain}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.GrainDesc}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="176" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GrainSlider"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"/>
                                        <TextBlock x:Name="GrainValue" Grid.Column="1"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Animations}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.AnimationsDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Appearance.Animations}" x:Name="AnimationsToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="AnimationsToggle_Changed" Unchecked="AnimationsToggle_Changed"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.CompactComposer}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.CompactComposerDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Appearance.CompactComposer}" x:Name="CompactComposerToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="CompactComposerToggle_Changed"
                                              Unchecked="CompactComposerToggle_Changed"/>
                                </Grid>

                                <StackPanel x:Name="CompactBody" Margin="18,10,0,0"
                                            IsEnabled="{Binding IsChecked, ElementName=CompactComposerToggle}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.MouseReaction}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}"
                                                       Text="{DynamicResource S.Appearance.MouseReactionDesc}"/>
                                        </StackPanel>
                                        <CheckBox AutomationProperties.Name="{DynamicResource S.Appearance.MouseReaction}" x:Name="CompactHoverToggle" Grid.Column="1"
                                                  Style="{StaticResource SettingsToggle}"
                                                  Checked="CompactHoverToggle_Changed"
                                                  Unchecked="CompactHoverToggle_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Delay}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="CompactDelaySlider" Grid.Column="1"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="300" Maximum="5000" SmallChange="50" LargeChange="250"/>
                                        <TextBlock x:Name="CompactDelayValue" Grid.Column="2"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.StripWidth}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="CompactWidthSlider" Grid.Column="1"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="30" Maximum="100" SmallChange="1" LargeChange="5"/>
                                        <TextBlock x:Name="CompactWidthValue" Grid.Column="2"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                    <Grid IsEnabled="{Binding IsChecked, ElementName=CompactHoverToggle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.ReactionRadius}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Appearance.ReactionRadiusDesc}"/>
                                        </StackPanel>
                                        <Slider x:Name="CompactHoverSlider" Grid.Column="1"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="25" Maximum="400" SmallChange="5" LargeChange="20"/>
                                        <TextBlock x:Name="CompactHoverValue" Grid.Column="2"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <Button x:Name="ResetAppearanceButton" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Content="{DynamicResource S.Appearance.Reset}"
                                        Click="ResetAppearanceButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ BEHAVIOR ═══════════ -->
                        <!--
                            Порядок 1.27.1: чат, окно, уведомления, язык, горячие клавиши. Новое 1.28.0
                            встало туда, где его ищут: номера строк — к чату, вид уведомлений — к
                            уведомлениям, сочетания из любой программы — к горячим клавишам, а трей с
                            автозапуском и голосовой ввод — строками «›» на свои подстраницы.
                        -->
                        <ScrollViewer x:Name="BehaviorPageScroll" VerticalScrollBarVisibility="Auto"
                                      local:UiMotion.FadeOnShow="True">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavBehavior}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid local:SettingsDrill.IsHost="True">
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Behavior.Title}"/>

                                <Grid>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.AutoScroll}" VerticalAlignment="Center"/>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Behavior.AutoScroll}" x:Name="AutoScrollToggle" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right" IsChecked="True" Checked="AutoScrollToggle_Changed" Unchecked="AutoScrollToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <!-- Номера строк у блоков кода (D13). -->
                                <Grid>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.CodeLineNumbers}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CodeLineNumbersToggle" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                                              AutomationProperties.Name="{DynamicResource S.Behavior.CodeLineNumbers}"
                                              Checked="CodeLineNumbersToggle_Changed" Unchecked="CodeLineNumbersToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.RememberWindow}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Behavior.RememberWindowDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Behavior.RememberWindow}" x:Name="RememberWindowSizeToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}" IsChecked="True"
                                              Checked="RememberWindowSizeToggle_Changed"
                                              Unchecked="RememberWindowSizeToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.NotifyOnComplete}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Behavior.NotifyOnCompleteDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Behavior.NotifyOnComplete}" x:Name="NotifyOnCompleteToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}" IsChecked="True"
                                              Checked="NotifyOnCompleteToggle_Changed"
                                              Unchecked="NotifyOnCompleteToggle_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource NestedRow}"
                                      IsEnabled="{Binding IsChecked, ElementName=NotifyOnCompleteToggle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.NotifySound}"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Behavior.NotifySound}" x:Name="NotifySoundToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}" IsChecked="True"
                                              Checked="NotifySoundToggle_Changed"
                                              Unchecked="NotifySoundToggle_Changed"/>
                                </Grid>
                                <!-- Вид всех уведомлений программы (G3), не только о готовом ответе. -->
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Windows.Notifications}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Windows.NotifyHint}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="NotifyStyleCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                              AutomationProperties.Name="{DynamicResource S.Windows.Notifications}"
                                              SelectionChanged="NotifyStyleCombo_SelectionChanged">
                                        <ComboBoxItem Tag="Card" Content="{DynamicResource S.Windows.NotifyCard}"/>
                                        <ComboBoxItem Tag="System" Content="{DynamicResource S.Windows.NotifySystem}"/>
                                    </ComboBox>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Language.Title}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
       Text="{DynamicResource S.Language.Desc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <local:LanguagePickerField x:Name="LanguagePicker"
                                                                   MinWidth="170"
                                                                   LanguagePicked="LanguagePicker_LanguagePicked"
                                                                   NewLanguageRequested="LanguagePicker_NewLanguageRequested"
                                   LanguageDeleteRequested="LanguagePicker_LanguageDeleteRequested"/>
                                        <!-- Правка машинного перевода (I4): только у переведённого моделью языка. -->
                                        <Button x:Name="EditTranslationButton" Style="{StaticResource InlineLinkButton}"
                                                HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="Collapsed"
                                                Content="{DynamicResource S.TranslationEditor.Open}"
                                                Click="EditTranslationButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Трей, автозапуск, Проводник (G1, G4) и голосовой ввод (D14) — подстраницами. -->
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Button x:Name="WindowsLinkRow" Style="{StaticResource SettingsLinkRow}"
                                        local:SettingsDrill.Opens="{Binding ElementName=BehaviorWindowsSub}"
                                        AutomationProperties.Name="{DynamicResource S.Windows.Title}">
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Windows.Title}"/>
                                </Button>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Button x:Name="VoiceLinkRow" Style="{StaticResource SettingsLinkRow}"
                                        local:SettingsDrill.Opens="{Binding ElementName=BehaviorVoiceSub}"
                                        AutomationProperties.Name="{DynamicResource S.Voice.Title}">
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Voice.Title}"/>
                                </Button>

                                <!--
                                    Горячие клавиши. Строки собираются кодом по HotkeyMap.All:
                                    список действий один на программу, и вторая его копия
                                    в разметке разошлась бы с ним молча. Ниже — сочетания из любой
                                    программы (G5): их ищут здесь же, а не в трее.
                                -->
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{DynamicResource S.Behavior.Hotkeys}"/>
                                <StackPanel x:Name="HotkeyList"/>
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,8,0,8"
                                           Text="{DynamicResource S.Windows.Hotkeys}"/>
                                <local:GlobalHotkeysBlock x:Name="GlobalHotkeysSettings"/>
                            </StackPanel>

                            <StackPanel x:Name="BehaviorWindowsSub" Margin="20,14,20,16" Visibility="Collapsed">
                                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Windows.Title}"/>
                                <local:WindowsIntegrationBlock x:Name="WindowsSettings"/>
                            </StackPanel>

                            <StackPanel x:Name="BehaviorVoiceSub" Margin="20,14,20,16" Visibility="Collapsed">
                                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Voice.Title}"/>
                                <local:VoiceSettingsBlock x:Name="VoiceSettings"/>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ═══════════ CUSTOMIZE ═══════════ -->
                        <ScrollViewer x:Name="CustomizePageScroll" VerticalScrollBarVisibility="Auto" local:UiMotion.FadeOnShow="True">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavCustomize}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Customize.Title}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Customize.AnswerModels}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.Light}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="LiteReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="LiteModelPicker" Grid.Column="2"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.Heavy}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="HeavyReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="HeavyModelPicker" Grid.Column="2"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.Router}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Customize.RouterDesc}"/>
                                    </StackPanel>
                                    <local:ReasoningPicker x:Name="RouterReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="RouterModelPicker" Grid.Column="2" VerticalAlignment="Center"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Customize.ServiceModels}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.ChatTitles}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="TitleReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="TitleModelPicker" Grid.Column="2"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.Summary}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="SummaryReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="SummaryModelPicker" Grid.Column="2"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>
                                <!-- Поиск в интернете — настройка инструмента, а не модели:
                                     человек выбирает, через кого искать и чьим ключом платить,
                                     а модель под них программа подбирает сама. -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.WebSearch}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Customize.WebSearch.Desc}"/>
                                    </StackPanel>
                                    <local:ProviderKeyField x:Name="WebSearchField" Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Changed="WebSearchTargetChanged"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.AgentFast}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="AgentFastReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="AgentFastModelPicker" Grid.Column="2"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.AgentLight}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="AgentLiteReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="AgentLiteModelPicker" Grid.Column="2"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.AgentHeavy}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="AgentHeavyReasoningPicker" Grid.Column="1" Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="AgentHeavyModelPicker" Grid.Column="2"
                                              ModelPicked="SettingsModelPicked"
                                              AddKeyRequested="SettingsPickerAddKeyRequested"
                                              ProviderShown="SettingsPickerProviderShown"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!-- ═══ SynGuard ═══ -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Customize.Protection}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <!-- Имя защитника не переводится: это название, а не подпись. -->
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="SynGuard"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Customize.GuardDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SynGuardToggle" AutomationProperties.Name="SynGuard" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="SynGuardToggle_Changed" Unchecked="SynGuardToggle_Changed"/>
                                </Grid>

                                <!-- Модель защитника: голым ID и мелко — она нужна редко, а места
                                     под три модели агента рядом уже нет. -->
                                <ToggleButton x:Name="SynGuardModelToggle" Style="{StaticResource InlineExpanderToggle}"
                                              HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <TextBlock x:Name="SynGuardModelLabel" FontSize="11"
                                               Foreground="{DynamicResource Text.Faint}"
                                               VerticalAlignment="Center"/>
                                </ToggleButton>
                                <Border Margin="0,4,0,0" Padding="10,8" CornerRadius="9"
                                        Background="{DynamicResource Bg.Card}"
                                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=SynGuardModelToggle}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingTitle}" TextWrapping="Wrap"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Text="{DynamicResource S.Customize.GuardModel}"/>
                                        <local:ReasoningPicker x:Name="SynGuardReasoningPicker" Grid.Column="1"
                                                               Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                               Margin="8,0" VerticalAlignment="Center"
                                                               ChoiceChanged="SettingsReasoningChanged"/>
                                        <local:ModelPickerField x:Name="SynGuardModelPicker" Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  ModelPicked="SettingsModelPicked"
                                                  AddKeyRequested="SettingsPickerAddKeyRequested"
                                                  ProviderShown="SettingsPickerProviderShown"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Customize.SystemPrompts}"/>

                                <!-- Основной промпт ИИ -->
                                <TextBlock Style="{StaticResource SettingTitle}"
                                           Text="{DynamicResource S.Customize.MainPrompt}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PromptEditor}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="MainPromptTextBox" Style="{StaticResource PromptTextBox}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button x:Name="SaveMainPromptButton" Style="{StaticResource SavePromptButton}"
                                                    Click="SaveMainPromptButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--
                                    Библиотека заготовок - только у основного промпта.
                                    У технических её нет намеренно: их меняют раз в жизни, и
                                    держать наготове несколько вариантов незачем.
                                -->
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}"
                                                   Text="{DynamicResource S.Customize.PromptLibrary}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Customize.PromptLibraryDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="PromptCreateButton" Grid.Column="1" VerticalAlignment="Center"
                                            Style="{StaticResource PromptAddButton}"
                                            Content="{DynamicResource S.Customize.PromptCreate}"
                                            Click="PromptCreateButton_Click"/>
                                </Grid>
                                <TextBlock x:Name="PromptLibraryEmpty" Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Customize.PromptEmpty}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <!-- Плитки строятся кодом из prompts.json -->
                                <WrapPanel x:Name="PromptLibraryHost" Margin="0,0,0,4"/>

                                <!-- Технический промпт ИИ -->
                                <TextBlock Style="{StaticResource SettingTitle}"
                                           Text="{DynamicResource S.Customize.TechPrompt}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PromptEditor}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="TechAiPromptTextBox" Style="{StaticResource PromptTextBox}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button x:Name="ResetTechAiPromptButton" Style="{StaticResource ResetPromptButton}"
                                                    Margin="0,0,8,0" Click="ResetTechAiPromptButton_Click"/>
                                            <Button x:Name="SaveTechAiPromptButton" Style="{StaticResource SavePromptButton}"
                                                    Click="SaveTechAiPromptButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Технический промпт агента -->
                                <TextBlock Style="{StaticResource SettingTitle}"
                                           Text="{DynamicResource S.Customize.AgentPrompt}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PromptEditor}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="TechAgentPromptTextBox" Style="{StaticResource PromptTextBox}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button x:Name="ResetTechAgentPromptButton" Style="{StaticResource ResetPromptButton}"
                                                    Margin="0,0,8,0" Click="ResetTechAgentPromptButton_Click"/>
                                            <Button x:Name="SaveTechAgentPromptButton" Style="{StaticResource SavePromptButton}"
                                                    Click="SaveTechAgentPromptButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ DATA CONTROLS ═══════════ -->
                        <ScrollViewer x:Name="DataPageScroll" VerticalScrollBarVisibility="Auto"
                                      local:UiMotion.FadeOnShow="True">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavData}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid local:SettingsDrill.IsHost="True">
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Data.Title}"/>

                                <!-- Занято на диске -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Usage}"/>
                                        <TextBlock x:Name="UsageSummaryText" Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Data.Usage.Desc}"/>
                                    </StackPanel>
                                    <Button x:Name="UsageRefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource S.Data.Usage.Refresh}" Click="UsageRefreshButton_Click"/>
                                </Grid>
                                <!--
                                    Строки разбивки собираются кодом: их состав зависит от того,
                                    что у человека реально лежит на диске, и пустая категория в
                                    списке была бы шумом. Полоска доли — Bg.Track под Accent.Fill,
                                    ширина звёздными колонками, как у полосы загрузки обновления.
                                -->
                                <ItemsControl x:Name="UsageList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding Indent}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Grid Height="4" Margin="0,4,0,0">
                                                        <Border CornerRadius="2" Background="{DynamicResource Bg.Track}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Share}"/>
                                                                <ColumnDefinition Width="{Binding Rest}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border CornerRadius="2" Background="{DynamicResource Accent.Fill}"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Size}" FontSize="12.5"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Text.Secondary}"/>
                                                    <TextBlock Text="{Binding Files}" FontSize="11"
                                                               HorizontalAlignment="Right" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource Text.Faint}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="UsageAppText" FontSize="12"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource Text.Faint}"/>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Sharing}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Data.SharingDesc}"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="{DynamicResource S.Data.Sharing}" x:Name="ChatSharingToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="ChatSharingToggle_Changed"
                                              Unchecked="ChatSharingToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Import}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Data.ImportDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="ImportChatButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource S.Data.OpenFile}" Click="ImportChatButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!--
                                    Экспорт и импорт всех данных. Стоит рядом с импортом одного
                                    чата: две соседние задачи, и человек, пришедший «перенести
                                    переписку», видит обе сразу. Две кнопки в ряд — как у
                                    обновлений ниже.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Bundle.Row}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Bundle.RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="DataExportButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Bundle.Export}" Margin="0,0,6,0"
                                                Click="DataExportButton_Click"/>
                                        <Button x:Name="DataImportButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Bundle.Import}"
                                                Click="DataImportButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <!--
                                    Резервные копии (F1) и хранение с очисткой (F3) — подстраницами:
                                    в 1.28.0 два блока по экрану высотой стояли посреди страницы, и до
                                    обновлений и удаления данных было не долистать.
                                -->
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Button x:Name="BackupLinkRow" Style="{StaticResource SettingsLinkRow}"
                                        local:SettingsDrill.Opens="{Binding ElementName=DataBackupSub}"
                                        AutomationProperties.Name="{DynamicResource S.Backup.Title}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Backup.Title}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Backup.LinkDesc}"/>
                                    </StackPanel>
                                </Button>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Button x:Name="CareLinkRow" Style="{StaticResource SettingsLinkRow}"
                                        local:SettingsDrill.Opens="{Binding ElementName=DataCareSub}"
                                        AutomationProperties.Name="{DynamicResource S.Care.Title}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Care.Title}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Care.LinkDesc}"/>
                                    </StackPanel>
                                </Button>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.AppFiles}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Data.AppFilesDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="OpenAppFilesButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource S.Common.Open}" Click="OpenAppFilesButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!--
                                    Плашка обновлений. Карточкой, а не плоскими строками общего
                                    потока: версия, дата последней проверки, состояние и кнопки —
                                    один предмет, и вразброс они читались как несвязанные настройки.
                                -->
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{DynamicResource S.Updates.Title}" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource Bg.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="{DynamicResource S.Updates.CurrentVersion}"
                                                           Margin="0,0,0,1"/>
                                                <!--
                                                    Заготовка для конструктора XAML: живое значение
                                                    ставит LoadUpdatesUi из RuntimeContext.AppVersion,
                                                    как и у подписи в боковой колонке.
                                                -->
                                                <TextBlock x:Name="UpdateVersionText" Text="v1.24.1"
                                                           FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"/>
                                            </StackPanel>
                                            <!--
                                                Пилюля состояния. Заливку, обводку и текст ставит
                                                код через SetResourceReference: цвет зависит от
                                                того, что сейчас происходит, а не от разметки.
                                            -->
                                            <Border x:Name="UpdateStatePill" Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="6" Padding="10,4"
                                                    Background="{DynamicResource Bg.Raised}"
                                                    BorderBrush="{DynamicResource Accent.Fill}"
                                                    BorderThickness="1.2">
                                                <TextBlock x:Name="UpdateStatePillText" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{DynamicResource S.Updates.Pill.UpToDate}"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Updates.NeverChecked}"
                                                   Margin="0,9,0,0"/>
                                        <TextBlock x:Name="UpdateLastCheckText" Style="{StaticResource SettingDesc}"
                                                   Foreground="{DynamicResource Text.Faint}"
                                                   Margin="0,2,0,0"/>

                                        <!-- Полоса загрузки обновления -->
                                        <Grid x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Visibility="Collapsed">
                                            <Border CornerRadius="2" Background="{DynamicResource Bg.Track}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="UpdateProgressDone" Width="0*"/>
                                                    <ColumnDefinition x:Name="UpdateProgressLeft" Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="2" Background="{DynamicResource Accent.Fill}"/>
                                            </Grid>
                                        </Grid>

                                        <WrapPanel Orientation="Horizontal" Margin="0,11,0,0">
                                            <Button x:Name="CheckUpdatesButton" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,6,0"
                                                    Content="{DynamicResource S.Updates.Check}"
                                                    Click="CheckUpdatesButton_Click"/>
                                            <Button x:Name="UpdateNowButton" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,6,0" Visibility="Collapsed"
                                                    Content="{DynamicResource S.Updates.Update}"
                                                    Click="UpdateNowButton_Click"/>
                                            <Button x:Name="OpenReleaseButton" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,6,0" Visibility="Collapsed"
                                                    Content="{DynamicResource S.Updates.OpenRelease}"
                                                    Click="OpenReleaseButton_Click"/>
                                            <!-- Прошлая версия лежит рядом (.previous) — вернуться к ней (H4). -->
                                            <Button x:Name="RollbackButton" Style="{StaticResource SecondaryButton}"
                                                    Margin="0" Visibility="Collapsed"
                                                    Content="{DynamicResource S.Updates.RollbackUnknown}"
                                                    Click="RollbackButton_Click"/>
                                        </WrapPanel>

                                        <Border Style="{StaticResource SettingsDivider}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Updates.Auto}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="{DynamicResource S.Updates.AutoDesc}"/>
                                            </StackPanel>
                                            <CheckBox AutomationProperties.Name="{DynamicResource S.Updates.Auto}" x:Name="AutoUpdateToggle" Grid.Column="1"
                                                      Style="{StaticResource SettingsToggle}"
                                                      Checked="AutoUpdateToggle_Changed"
                                                      Unchecked="AutoUpdateToggle_Changed"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Updates.Beta}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="{DynamicResource S.Updates.BetaDesc}"/>
                                            </StackPanel>
                                            <CheckBox AutomationProperties.Name="{DynamicResource S.Updates.Beta}" x:Name="BetaChannelToggle" Grid.Column="1"
                                                      Style="{StaticResource SettingsToggle}"
                                                      Checked="BetaChannelToggle_Changed"
                                                      Unchecked="BetaChannelToggle_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!-- Разрешённые сайты -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,34,0">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Allowlist}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Data.AllowlistDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="AddDomainButton" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Content="+" Width="26" Padding="0" FontSize="14"
                                            Click="AddDomainButton_Click"/>
                                </Grid>
                                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                                    <Grid>
                                        <TextBlock x:Name="AllowedDomainsEmpty" Margin="8,7"
                                                   Text="{DynamicResource S.Data.AllowlistEmpty}"
                                                   FontSize="12" Foreground="{DynamicResource Text.Faint}"
                                                   Visibility="Collapsed"/>
                                        <ScrollViewer x:Name="AllowedDomainsScroll" MaxHeight="152" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="AllowedDomainsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="8,5">
                                                            <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas"
                                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                                       VerticalAlignment="Center" Margin="0,0,30,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                                                    Content="–" Width="22" Height="22" Padding="0"
                                                                    Tag="{Binding}" ToolTip="{DynamicResource S.Data.AllowlistRemove}"
                                                                    Click="RemoveDomainButton_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.DeleteChats}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Data.DeleteChatsDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="DeleteAllChatsButton" Grid.Column="1" Style="{StaticResource DangerButton}"
                                            Content="{DynamicResource S.Common.Delete}" Click="DeleteAllChatsButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.DeleteAll}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Data.DeleteAllDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="DeleteAllDataButton" Grid.Column="1" Style="{StaticResource DangerButton}"
                                            Content="{DynamicResource S.Common.Delete}" Click="DeleteAllDataButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="DataBackupSub" Margin="20,14,20,16" Visibility="Collapsed">
                                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Backup.Title}"/>
                                <local:BackupBlock x:Name="BackupPanel"/>
                            </StackPanel>

                            <StackPanel x:Name="DataCareSub" Margin="20,14,20,16" Visibility="Collapsed">
                                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Care.Title}"/>
                                <local:DataCareBlock x:Name="DataCarePanel"/>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ═══════════ KEY AND INFO ═══════════ -->
                        <!--
                            Тоже отдельным UserControl: остаток, график трат, разбивка по моделям
                            и список ключей - страница длиннее любой из соседних. Стиль с триггером
                            остаётся здесь, потому что ElementName=NavKey ищется в области имён
                            этого файла.
                        -->
                        <local:SettingsKeyPage x:Name="KeyPage" local:UiMotion.FadeOnShow="True">
                            <local:SettingsKeyPage.Style>
                                <Style TargetType="local:SettingsKeyPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavKey}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SettingsKeyPage.Style>
                        </local:SettingsKeyPage>

                        <!-- ═══════════ SECURITY ═══════════ -->
                        <!-- Отдельным UserControl, как Key и Instructions: режим доступа и инструменты. -->
                        <local:SettingsSecurityPage x:Name="SecurityPage" local:UiMotion.FadeOnShow="True">
                            <local:SettingsSecurityPage.Style>
                                <Style TargetType="local:SettingsSecurityPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavSecurity}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SettingsSecurityPage.Style>
                        </local:SettingsSecurityPage>

                        <!-- ═══════════ INSTRUCTIONS ═══════════ -->
                        <!--
                            Отдельным UserControl, как Key и Info: список и редактор инструкций.
                            Стиль с триггером остаётся здесь, потому что ElementName=NavInstructions
                            ищется в области имён этого файла.
                        -->
                        <local:SettingsInstructionsPage x:Name="InstructionsPage" local:UiMotion.FadeOnShow="True">
                            <local:SettingsInstructionsPage.Style>
                                <Style TargetType="local:SettingsInstructionsPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavInstructions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SettingsInstructionsPage.Style>
                        </local:SettingsInstructionsPage>

                        <!-- ═══════════ AUTOMATION ═══════════ -->
                        <!-- Отдельным UserControl: рецепты (C7), расписание, удалённые компьютеры (C10) и MCP (C11). -->
                        <local:SettingsAutomationPage x:Name="AutomationPage" local:UiMotion.FadeOnShow="True">
                            <local:SettingsAutomationPage.Style>
                                <Style TargetType="local:SettingsAutomationPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavAutomation}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SettingsAutomationPage.Style>
                        </local:SettingsAutomationPage>

                        <!-- ═══════════ INFO ═══════════ -->
                        <!--
                            Отдельным UserControl, а не шестым ScrollViewer в этой разметке: гайд
                            со скриншотами длиннее любой из соседних страниц, а в MainWindow.xaml
                            и так три тысячи строк. Стиль с триггером остаётся здесь, потому что
                            ElementName=NavInfo ищется в области имён этого файла.
                        -->
                        <local:SettingsInfoPage local:UiMotion.FadeOnShow="True">
                            <local:SettingsInfoPage.Style>
                                <Style TargetType="local:SettingsInfoPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavInfo}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SettingsInfoPage.Style>
                        </local:SettingsInfoPage>

                    </Grid>
                </Grid>
            </Border>
            </Viewbox>
        </Grid>

        <!--
            Журнал действий. ZIndex 34: выше подтверждения (30), но ниже диалога домена (35) —
            из журнала можно открыть чат, а тот способен тут же спросить про домен, и вопрос
            обязан лечь поверх. Карточка шире обычных диалогов на 420: это таблица, а не вопрос.
        -->
        <local:HealthPanel x:Name="HealthOverlay" Visibility="Collapsed" Panel.ZIndex="33"/>

        <Grid x:Name="JournalOverlay" Visibility="Collapsed" Panel.ZIndex="34"
              Focusable="True" PreviewKeyDown="Journal_PreviewKeyDown">
            <Grid.Resources>
                <!-- ===== Вкладка / переключатель охвата ===== -->
                <Style x:Key="JournalTab" TargetType="ToggleButton">
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Полужирная копия-невидимка держит ширину: выбранная подпись толще, и без неё
                                             соседние кнопки сдвигались бы на пару точек при каждом переключении. -->
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Visibility="Hidden"/>
                                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Кнопка в строке вкладок: выгрузка аудита ===== -->
                <Style x:Key="JournalChipButton" TargetType="Button">
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="6,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Строка журнала ===== -->
                <!--
                    Высота строки фиксирована, а длинные значения обрезаются многоточием: при
                    переменной высоте VirtualizingStackPanel не может заранее посчитать полосу
                    прокрутки, и она прыгала бы на каждом шаге. Полный текст — в подсказке.
                -->
                <Style x:Key="JournalRowButton" TargetType="Button">
                    <Setter Property="Height" Value="46"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="JournalCloseButton_Click"/>
            </Border>

            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="760" Height="560" Background="{DynamicResource Bg.Panel}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="10"
                        Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ===== ЗАГОЛОВОК ===== -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="JournalBackButton" Width="24" Height="24" Cursor="Hand"
                                        Visibility="Collapsed" Margin="0,0,8,0"
                                        ToolTip="{DynamicResource S.Journal.Back}"
                                        Click="JournalBackButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Path x:Name="Icon" Data="M5,0 L0,5 L5,10"
                                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="7" Height="12" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock x:Name="JournalTitleText" Text="{DynamicResource S.Journal.Title}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="JournalCloseButton" AutomationProperties.Name="{DynamicResource S.Common.Close}" Width="26" Height="26"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Cursor="Hand" Click="JournalCloseButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                            <Path x:Name="Icon" Data="M0,0 L8,8 M8,0 L0,8"
                                                  Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="9" Height="9" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ===== ВКЛАДКИ И ОХВАТ ===== -->
                        <Grid x:Name="JournalTabsRow" Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="JournalActionsTab" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Tab.Actions}" IsChecked="True"
                                              Click="JournalActionsTab_Click"/>
                                <ToggleButton x:Name="JournalSnapshotsTab" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Tab.Snapshots}"
                                              Click="JournalSnapshotsTab_Click"/>
                                <ToggleButton x:Name="JournalSummariesTab" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Tab.Summaries}"
                                              Click="JournalSummariesTab_Click"/>
                                <ToggleButton x:Name="JournalAuditTab" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Tab.Audit}"
                                              Click="JournalAuditTab_Click"/>
                            </StackPanel>
                            <!-- Выгружается то, что в списке: с поиском — найденное, без него — всё. -->
                            <StackPanel x:Name="JournalAuditExportPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Visibility="Collapsed">
                                <Button x:Name="JournalAuditCsvButton" Style="{StaticResource JournalChipButton}"
                                        Content="{DynamicResource S.Journal.Audit.ExportCsv}"
                                        Click="JournalAuditCsvButton_Click"/>
                                <Button x:Name="JournalAuditJsonButton" Style="{StaticResource JournalChipButton}"
                                        Content="{DynamicResource S.Journal.Audit.ExportJson}"
                                        Click="JournalAuditJsonButton_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="JournalScopePanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="JournalScopeChat" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Scope.Chat}" IsChecked="True"
                                              Click="JournalScopeChat_Click"/>
                                <ToggleButton x:Name="JournalScopeAll" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Scope.All}" Margin="0"
                                              Click="JournalScopeAll_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- ===== ПОИСК ===== -->
                        <Border Grid.Row="2" x:Name="JournalSearchBox" Margin="0,0,0,10"
                                Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <Grid>
                                <TextBlock x:Name="JournalSearchPlaceholder"
                                           Text="{DynamicResource S.Journal.SearchHint}" FontSize="12.5"
                                           Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="JournalSearch" Background="Transparent" BorderThickness="0"
                                         FontSize="12.5" Foreground="{DynamicResource Text.Body}"
                                         CaretBrush="{DynamicResource Text.Bright}"
                                         TextChanged="JournalSearch_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- ===== СПИСОК ===== -->
                        <Grid Grid.Row="3">
                            <ItemsControl x:Name="JournalList"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource JournalRowButton}"
                                                ToolTip="{Binding Tooltip}" Click="JournalRow_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.RowSpan="2" Text="{Binding Glyph}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,9,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Title}"
                                                           FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Body}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Subtitle}"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="{DynamicResource Text.Faint}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>

                                                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Timestamp}"
                                                           FontSize="11" Foreground="{DynamicResource Text.Dim}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Trailer}"
                                                           FontSize="11" Foreground="{DynamicResource Text.Faint}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                           Margin="10,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="JournalEmpty" Visibility="Collapsed"
                                       FontSize="12.5" Foreground="{DynamicResource Text.Faint}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!--
                                Подробности одной записи. Лежат в той же ячейке, что и список, и
                                подменяют его: отдельное окно поверх модалки — уже третий слой,
                                из которого непонятно, куда возвращает Esc.
                            -->
                            <ScrollViewer x:Name="JournalDetails" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="JournalDetailTitle" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Body}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="JournalDetailMeta" FontSize="11.5" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap"/>

                                    <!-- WrapPanel: кнопок стало шесть, в одну строку на узком журнале они не влезают. -->
                                    <WrapPanel Margin="0,12,0,-6">
                                        <Button x:Name="JournalAskButton" Style="{StaticResource DialogPrimaryButton}"
                                                Content="{DynamicResource S.Journal.Ask}" Margin="0,0,8,6"
                                                Click="JournalAskButton_Click"/>
                                        <Button x:Name="JournalOpenChatButton" Style="{StaticResource DialogSecondaryButton}"
                                                Content="{DynamicResource S.Journal.OpenChat}" Margin="0,0,8,6"
                                                Click="JournalOpenChatButton_Click"/>
                                        <Button x:Name="JournalRebuildSummaryButton" Style="{StaticResource DialogSecondaryButton}"
                                                Visibility="Collapsed" Margin="0,0,8,6"
                                                Content="{DynamicResource S.Journal.Summary.Rebuild}"
                                                Click="JournalRebuildSummaryButton_Click"/>
                                        <Button x:Name="JournalRollbackButton" Style="{StaticResource DialogPrimaryButton}"
                                                Visibility="Collapsed" Margin="0,0,8,6"
                                                Content="{DynamicResource S.Journal.Rollback.Preview}"
                                                Click="JournalRollbackButton_Click"/>
                                        <Button x:Name="JournalRestoreSystemButton" Style="{StaticResource DialogSecondaryButton}"
                                                Visibility="Collapsed" Margin="0,0,8,6"
                                                Content="{DynamicResource S.Journal.RestoreSystem}"
                                                Click="JournalRestoreSystemButton_Click"/>
                                        <Button x:Name="JournalSaveRecipeButton" Style="{StaticResource DialogSecondaryButton}"
                                                Visibility="Collapsed" Margin="0,0,8,6"
                                                Content="{DynamicResource S.Recipe.SaveFromJournal}"
                                                ToolTip="{DynamicResource S.Recipe.SaveFromJournalTip}"
                                                Click="JournalSaveRecipeButton_Click"/>
                                    </WrapPanel>

                                    <Border x:Name="JournalAnswerBox" Visibility="Collapsed" Margin="0,12,0,0"
                                            Background="{DynamicResource Bg.Card}"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10">
                                        <TextBlock x:Name="JournalAnswerText" FontSize="12.5" TextWrapping="Wrap"
                                                   LineHeight="18" Foreground="{DynamicResource Text.Body}"/>
                                    </Border>

                                    <!--
                                        План отката: что вернётся и чего откат не тронет. Лежит в
                                        подробностях снимка, а не отдельным окном: окно поверх
                                        журнала было бы третьим слоем, из которого непонятно, куда
                                        возвращает Esc. Подтверждение — кнопка под самим списком.
                                    -->
                                    <Border x:Name="JournalRollbackBox" Visibility="Collapsed" Margin="0,12,0,0"
                                            Background="{DynamicResource Bg.Card}"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock x:Name="JournalRollbackTitle" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Body}" TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="JournalRollbackLines" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tone}" Value="Success">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tone}" Value="Failure">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                                                       TextWrapping="Wrap" LineHeight="17"
                                                                       Foreground="{DynamicResource Text.Body}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="JournalRollbackNotesTitle" Margin="0,10,0,6"
                                                       Text="{DynamicResource S.Journal.Rollback.NotesTitle}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Faint}"/>
                                            <ItemsControl x:Name="JournalRollbackNotes">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"
                                                                   Margin="0,0,0,4" Foreground="{DynamicResource Text.Faint}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="JournalRollbackHint" Margin="0,8,0,0"
                                                       Text="{DynamicResource S.Journal.Rollback.Hint}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Faint}"/>
                                            <StackPanel x:Name="JournalRollbackActions" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button x:Name="JournalRollbackCancelButton"
                                                        Style="{StaticResource DialogSecondaryButton}"
                                                        Content="{DynamicResource S.Journal.Rollback.Cancel}"
                                                        Margin="0,0,8,0" Click="JournalRollbackCancelButton_Click"/>
                                                <Button x:Name="JournalRollbackApplyButton"
                                                        Style="{StaticResource DialogPrimaryButton}"
                                                        Click="JournalRollbackApplyButton_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{DynamicResource S.Journal.Arguments}" Margin="0,16,0,6"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                    <ContentControl x:Name="JournalArgumentsHost"/>

                                    <TextBlock Text="{DynamicResource S.Journal.Result}" Margin="0,14,0,6"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                    <ContentControl x:Name="JournalResultHost" Margin="0,0,0,4"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===== ПОДВАЛ ===== -->
                        <TextBlock Grid.Row="4" x:Name="JournalFooter" Margin="0,12,0,0"
                                   FontSize="11" Foreground="{DynamicResource Text.Faint}"/>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>

        <!-- План агента на одобрение (C1). Под вопросом о действии: тот срочнее — ход уже стоит
             на конкретном вызове, а план лишь ждёт, когда его прочтут. -->
        <local:PlanReviewOverlay x:Name="PlanOverlay" Visibility="Collapsed" Panel.ZIndex="29"/>
        <local:WorkReportOverlay x:Name="ReportOverlay" Visibility="Collapsed" Panel.ZIndex="29"/>
        <local:HotkeySheetOverlay x:Name="HotkeySheet" Visibility="Collapsed" Panel.ZIndex="29"/>
        <local:ChatSettingsOverlay x:Name="ChatSettings" Visibility="Collapsed" Panel.ZIndex="29"/>
        <local:TranslationEditorOverlay x:Name="TranslationEditor" Visibility="Collapsed" Panel.ZIndex="29"/>
        <!--
            Перетаскивание на всё окно (D15). Появляется, когда файл внесли в окно, и накрывает его
            целиком: дальше события получает только он, и уход курсора с него — это уход из окна.
        -->
        <Grid x:Name="DropOverlay" Visibility="Collapsed" Panel.ZIndex="28" AllowDrop="True" Background="Transparent"
              DragOver="DropOverlay_DragOver" DragLeave="DropOverlay_DragLeave" Drop="DropOverlay_Drop">
            <!-- Потомки не ловят мышь: тогда DragLeave приходит, только когда курсор ушёл из окна
                 или перетаскивание отменили, а не на каждом переходе между надписями. -->
            <Border Background="{DynamicResource Overlay.Scrim}" IsHitTestVisible="False"/>
            <Border Margin="28" CornerRadius="16" BorderThickness="2" Background="Transparent" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource Accent.Fill}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <Path Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,20 L20,20 L20,17" Width="34" Height="34"
                          Stretch="Uniform" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Stroke="{DynamicResource Accent.Fill}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource S.Drop.Title}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="{DynamicResource S.Drop.Types}" FontSize="12.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ConfirmationOverlay" Visibility="Collapsed" Panel.ZIndex="30">
            <Border Background="{DynamicResource Overlay.Scrim}"/>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <!--
                Шире обычных диалогов и с потолком высоты: сюда кладётся блок кода, а карточка
                живёт внутри Viewbox со Stretch="Uniform" — без MaxHeight длинный скрипт растянул
                бы её, и Viewbox ужал бы весь диалог вместе с кнопками до нечитаемого.
            -->
            <Border x:Name="ConfirmationCard" Style="{StaticResource DialogCard}"
                    Width="480" MinHeight="180" MaxHeight="580">
                <!--
                    Grid, а не StackPanel, — и в этом вся суть. StackPanel меряет детей
                    бесконечностью и раскладывает подряд на полную желаемую высоту: потолок
                    карточки он не соблюдает, и ряд кнопок, стоявший последним, уезжал ниже её
                    кромки. Длинное разъяснение с двумя раскрытыми экспандерами набирало под
                    девятьсот точек против пятисот доступных, и человек видел вопрос без «Да» и
                    «Нет». Здесь всё, что может вырасти, лежит в строке «*» с прокруткой, а
                    заголовок и кнопки — в строках Auto, и вытолкнуть их нечем.
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Вопрос — заголовком: кнопки внизу отвечают именно на него. -->
                    <TextBlock Style="{StaticResource DialogTitle}" Text="{DynamicResource S.Confirm.Title}"/>

                    <!-- Кто спрашивает и из какого чата: спрашивать могут сразу несколько, и
                         «удалить папку X» без имени разговора — опасная неизвестность. -->
                    <WrapPanel Grid.Row="1" Margin="0,4,0,14">
                        <TextBlock x:Name="ConfirmationAgentText" FontSize="12" Foreground="{DynamicResource Text.Dim}"/>
                        <TextBlock x:Name="ConfirmationChatDot" Text=" · " FontSize="12" Foreground="{DynamicResource Text.Dim}"
                                   Visibility="{Binding Visibility, ElementName=ConfirmationChatButton}"/>
                        <Button x:Name="ConfirmationChatButton" Style="{StaticResource DialogLink}" Visibility="Collapsed"
                                Click="ConfirmationChatButton_Click"/>
                    </WrapPanel>

                    <!-- Отступ справа отрицательный: полоса прокрутки встаёт в поле карточки,
                         а не отжимает текст от него. -->
                    <ScrollViewer x:Name="ConfirmationBodyScroll" Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmationSummaryText" FontSize="13" Foreground="{DynamicResource Text.Body}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ConfirmationExplanationText" Style="{StaticResource DialogText}" Margin="0,8,0,0"/>
                            <!--
                                Разъяснение от ИИ: то же, что в журнале умеет кнопка «Спросить ИИ», только
                                здесь оно спрашивается само и заранее. Поле explanation у инструмента —
                                просьба к модели, а не обязанность, и чаще всего оно пустое; человек при
                                этом жмёт «Разрешить» под текстом скрипта, который никто ему не объяснил.
                                Отбито чертой слева: это слова модели, а не факты о вызове.
                                Обычный TextBlock: текст пришёл от модели и остаётся текстом.
                            -->
                            <Border x:Name="ConfirmationAiBox" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="2,0,0,0"
                                    Padding="10,1,0,1" Margin="0,12,0,0"
                                    Visibility="{Binding Visibility, ElementName=ConfirmationAiText}">
                                <TextBlock x:Name="ConfirmationAiText" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </Border>
                            <!--
                                Пробный прогон (-WhatIf): что именно изменится. Над текстом команды, потому
                                что отвечает на тот же вопрос короче. Появляется, только когда прогон
                                возможен, и кнопки его не ждут — как и разъяснение выше.
                                Ниже — что именно выполнится, целиком, и технические подробности.
                                Наполняются из кода: пустой экспандер в диалоге хуже его отсутствия.
                            -->
                            <ContentControl x:Name="ConfirmationWhatIfHost" Visibility="Collapsed" Margin="0,14,0,0"/>
                            <ContentControl x:Name="ConfirmationCodeHost" Visibility="Collapsed" Margin="0,10,0,0"/>
                            <ContentControl x:Name="ConfirmationDetailsHost" Visibility="Collapsed" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        Подвал: слева «Не спрашивать…» (разрешение впрок, отдельно от пары ответов),
                        справа «Запретить» и «Разрешить». Волосок сверху — край прокручиваемого тела.
                    -->
                    <StackPanel Grid.Row="3">
                        <Border Height="1" Background="{DynamicResource Bg.Hover}" Margin="0,14,0,0"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!--
                                «Не спрашивать…» — ответ «да» с запасом: этот инструмент в этом чате до
                                конца ответа или до конца разговора больше не спрашивается. У
                                вопросов SynGuard и вопросов без чата кнопки нет.
                            -->
                            <ToggleButton x:Name="ConfirmationAllowToggle" Content="{DynamicResource S.Confirm.Allow}"
                                          Style="{StaticResource DialogSecondaryToggle}"
                                          ToolTip="{DynamicResource S.Confirm.Allow.Tooltip}"/>
                            <Popup x:Name="ConfirmationAllowPopup"
                                   PlacementTarget="{Binding ElementName=ConfirmationAllowToggle}"
                                   Placement="Top" VerticalOffset="-6" AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsChecked, ElementName=ConfirmationAllowToggle, Mode=TwoWay}">
                                <Border Width="280" Background="{DynamicResource Bg.Panel}"
                                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                        CornerRadius="10" Padding="5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Button x:Name="ConfirmationAllowTurnButton" Style="{StaticResource DialogMenuItemButton}"
                                                Click="ConfirmationAllowTurnButton_Click">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S.Confirm.AllowTurn}" FontSize="12.5"
                                                           Foreground="{DynamicResource Text.Body}"/>
                                                <TextBlock x:Name="ConfirmationAllowTurnDesc" FontSize="11" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Faint}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ConfirmationAllowChatButton" Style="{StaticResource DialogMenuItemButton}"
                                                Click="ConfirmationAllowChatButton_Click">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S.Confirm.AllowChat}" FontSize="12.5"
                                                           Foreground="{DynamicResource Text.Body}"/>
                                                <TextBlock x:Name="ConfirmationAllowChatDesc" FontSize="11" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Faint}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="ConfirmationNoButton" Content="{DynamicResource S.Confirm.Deny}"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="ConfirmationNoButton_Click"/>
                                <Button x:Name="ConfirmationYesButton" Content="{DynamicResource S.Confirm.Approve}"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        Click="ConfirmationYesButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ДОБАВЛЕНИЕ ДОМЕНА В БЕЛЫЙ СПИСОК ═══════════ -->
        <Grid x:Name="DomainOverlay" Visibility="Collapsed" Panel.ZIndex="35">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="DomainCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Style="{StaticResource DialogCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DialogTitle}" Text="{DynamicResource S.Domain.Title}"/>
                    <TextBlock Style="{StaticResource DialogText}" Text="{DynamicResource S.Domain.Desc}"/>
                    <Border Style="{StaticResource DialogField}" Margin="0,16,0,0">
                        <TextBox x:Name="DomainInput" Style="{StaticResource DialogInput}" FontFamily="Consolas"
                                 Tag="example.com" AutomationProperties.Name="{DynamicResource S.Domain.Title}"
                                 KeyDown="DomainInput_KeyDown"
                                 TextChanged="DomainInput_TextChanged"/>
                    </Border>
                    <Grid Style="{StaticResource DialogFooter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DomainError" Style="{StaticResource DialogError}" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="DomainCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="DomainCancelButton_Click"/>
                            <Button x:Name="DomainAddButton" Content="{DynamicResource S.Common.Add}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="DomainAddButton_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ЭКСПОРТ ДАННЫХ ═══════════ -->
        <!--
            ZIndex 31: выше вопроса о действии (30) — окно человек открыл сам, и фоновый вопрос
            от модели не должен лечь поверх списка галочек; тот же выбор уже сделан для
            DomainOverlay. Ниже всего остального: с экспортом ничто из этого одновременно не
            живёт, а если появится вопрос о загрузке — он важнее.
        -->
        <Grid x:Name="DataExportOverlay" Visibility="Collapsed" Panel.ZIndex="31"
              Focusable="True" PreviewKeyDown="DataExport_PreviewKeyDown">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="DataExportCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <!--
                    Grid с потолком высоты, а не StackPanel: с паролем на архив карточка растёт, и
                    по правилу памятки всё, что может вырасти, лежит в строке «*» с прокруткой, а
                    заголовок и кнопки — в строках Auto.
                -->
                <Border x:Name="DataExportCard" Style="{StaticResource DialogCard}" Width="460" MaxHeight="560">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Bundle.Export.Title}" Style="{StaticResource DialogTitle}"/>
                            <TextBlock Text="{DynamicResource S.Bundle.Export.Desc}" FontSize="12.5"
                                       Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Margin="0,0,-8,0" Padding="0,0,8,0">
                        <StackPanel>
                        <!--
                            Строки категорий собираются кодом: их состав зависит от того, что
                            реально лежит на диске, и пустая категория в списке была бы шумом —
                            тот же мотив, что у разбивки «Занято на диске».
                        -->
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel x:Name="ExportCategoryList"/>
                        </Border>

                        <!--
                            Пароль на архив (PasswordEnvelope). Архив уезжает в облако и на флешку,
                            а зашифрованные на диске чаты едут в нём открытым текстом: DPAPI на
                            чужой машине не расшифровать.
                        -->
                        <CheckBox x:Name="ExportProtectToggle" Style="{StaticResource DialogCheckBox}"
                                  Margin="-4,10,0,0" Content="{DynamicResource S.Bundle.Export.Protect}"
                                  Checked="ExportProtect_Changed" Unchecked="ExportProtect_Changed"/>
                        <StackPanel x:Name="ExportPasswordPanel" Visibility="Collapsed" Margin="4,2,0,0">
                            <TextBlock Text="{DynamicResource S.Bundle.Export.ProtectHint}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.Dim}" TextWrapping="Wrap"/>
                            <Border Margin="0,8,0,0" CornerRadius="6" Height="30"
                                    Background="{DynamicResource Bg.Raised}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <PasswordBox x:Name="ExportPasswordBox" Background="Transparent" BorderThickness="0"
                                             Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                             Foreground="{DynamicResource Text.Bright}"
                                             CaretBrush="{DynamicResource Text.Bright}"
                                             ToolTip="{DynamicResource S.Account.Password}"/>
                            </Border>
                            <Border Margin="0,6,0,0" CornerRadius="6" Height="30"
                                    Background="{DynamicResource Bg.Raised}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <PasswordBox x:Name="ExportPasswordRepeatBox" Background="Transparent" BorderThickness="0"
                                             Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                             Foreground="{DynamicResource Text.Bright}"
                                             CaretBrush="{DynamicResource Text.Bright}"
                                             ToolTip="{DynamicResource S.Bundle.Export.PasswordRepeat}"/>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="ExportSummaryText" FontSize="12" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ExportErrorText" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Status.Danger}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button x:Name="DataExportCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                        Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0"
                                        Click="DataExportCancelButton_Click"/>
                                <Button x:Name="DataExportSaveButton" Content="{DynamicResource S.Bundle.Export.Save}"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        Click="DataExportSaveButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ИМПОРТ ДАННЫХ ═══════════ -->
        <!-- ZIndex 32: на слой выше экспорта, чтобы два родственных окна нельзя было перепутать. -->
        <Grid x:Name="DataImportOverlay" Visibility="Collapsed" Panel.ZIndex="32"
              Focusable="True" PreviewKeyDown="DataImport_PreviewKeyDown">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="DataImportCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <!--
                    Потолок высоты и Grid вместо StackPanel: с журналом аудита категорий стало
                    шесть, и карточка выросла за экран раннера. Список, выбор режима и итог лежат
                    в строке «*» с прокруткой, заголовок и кнопки — в строках Auto, и вытолкнуть
                    кнопки за кромку нечем.
                -->
                <Border x:Name="DataImportCard" Style="{StaticResource DialogCard}" Width="460" MaxHeight="660">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource S.Bundle.Import.Title}" Style="{StaticResource DialogTitle}"
                                   Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Margin="0,0,-8,0" Padding="0,0,8,0">
                        <StackPanel>
                        <!-- Что в архиве: сводка читается из описи, без распаковки. -->
                        <StackPanel x:Name="ImportChoicePanel">
                            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                                <TextBlock x:Name="ImportMetaText" FontSize="12"
                                           Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <StackPanel x:Name="ImportCategoryList"/>
                            </Border>

                            <TextBlock Text="{DynamicResource S.Bundle.Import.Mode}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"
                                       Margin="0,14,0,8"/>
                            <RadioButton x:Name="ImportMergeChoice" GroupName="DataImportMode"
                                         Style="{StaticResource DialogChoiceCard}" IsChecked="True"
                                         Margin="0,0,0,6" Checked="ImportModeChoice_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.Merge}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}"/>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.MergeDesc}" FontSize="11.5"
                                               Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ImportReplaceChoice" GroupName="DataImportMode"
                                         Style="{StaticResource DialogChoiceCard}"
                                         Checked="ImportModeChoice_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.Replace}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}"/>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.ReplaceDesc}" FontSize="11.5"
                                               Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="{DynamicResource S.Bundle.Import.SecurityKept}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>

                        <!-- Итог показывается здесь же: отдельное системное окно поверх своего
                             выглядит как сбой, а не как ответ на нажатую кнопку. -->
                        <TextBlock x:Name="ImportDoneText" FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Text.Body}" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="ImportErrorText" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Status.Danger}" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="DataImportCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                    Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0"
                                    Click="DataImportCancelButton_Click"/>
                            <Button x:Name="DataImportApplyButton" Content="{DynamicResource S.Bundle.Import.Apply}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="DataImportApplyButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПОДТВЕРЖДЕНИЕ ОБНОВЛЕНИЯ ═══════════ -->
        <Grid x:Name="UpdateConfirmOverlay" Visibility="Collapsed" Panel.ZIndex="39">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="UpdateConfirmCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}" Width="440">
                    <StackPanel>
                        <TextBlock x:Name="UpdateConfirmTitle" Text="{DynamicResource S.Update.Title}" Style="{StaticResource DialogTitle}"/>
                        <TextBlock x:Name="UpdateConfirmText" Style="{StaticResource DialogText}" Margin="0,6,0,14"/>
                        <!--
                            Заметки к релизу (H4). Высота ограничена, текст листается внутри: карточка
                            лежит в Viewbox, и длинные заметки иначе сжали бы её целиком до мелкого
                            шрифта, а не уехали бы под прокрутку.
                        -->
                        <StackPanel x:Name="UpdateConfirmNotesPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource S.Updates.NotesTitle}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8,2,8">
                                <RichTextBox x:Name="UpdateConfirmNotes" IsReadOnly="True" IsDocumentEnabled="True"
                                             MaxHeight="220" Background="Transparent" BorderThickness="0"
                                             Padding="0,0,8,0" VerticalScrollBarVisibility="Auto"
                                             Foreground="{DynamicResource Text.Secondary}"
                                             AutomationProperties.Name="{DynamicResource S.Updates.NotesTitle}"/>
                            </Border>
                        </StackPanel>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <StackPanel>
                                <TextBlock x:Name="UpdateConfirmFile" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource Text.Body}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UpdateConfirmFolder" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource Text.Faint}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!--
                            Заполняется из кода: сюда попадает и обещание не трогать имя файла,
                            и предупреждение про права администратора, когда папка программы
                            обычному процессу не по зубам.
                        -->
                        <TextBlock x:Name="UpdateConfirmNote" FontSize="11.5"
                                   Foreground="{DynamicResource Text.Faint}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <!--
                            Сборку нечем сверить: сама программа её не ставит, а кнопкой — только
                            отдельным согласием. Плашка стоит над кнопками, чтобы её нельзя было
                            не прочитать по пути к «Обновить».
                        -->
                        <Border x:Name="UpdateConfirmNoChecksum" Visibility="Collapsed" Margin="0,12,0,0"
                                Background="{DynamicResource Status.WarningSurface}"
                                BorderBrush="{DynamicResource Status.WarningBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="10,7">
                            <TextBlock Text="{DynamicResource S.Updates.NoChecksumNote}" FontSize="11.5"
                                       Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="UpdateConfirmCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="UpdateConfirmCancelButton_Click"/>
                            <Button x:Name="UpdateConfirmUnverifiedButton" Content="{DynamicResource S.Updates.InstallUnverified}"
                                    Style="{StaticResource DialogSecondaryButton}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="UpdateConfirmUnverifiedButton_Click"/>
                            <Button x:Name="UpdateConfirmApplyButton" Content="{DynamicResource S.Update.Confirm}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="UpdateConfirmApplyButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ЗАПРОС НА РАЗРЕШЕНИЕ ЗАГРУЗКИ ═══════════ -->
        <Grid x:Name="DownloadRequestOverlay" Visibility="Collapsed" Panel.ZIndex="38">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="DownloadRequestDenyButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DialogTitle}" Text="{DynamicResource S.Download.Title}"/>
                        <TextBlock x:Name="DownloadRequestText" Style="{StaticResource DialogText}"/>
                        <!-- Сайт — крупно и моноширинно: решение принимается про этот адрес. -->
                        <Border Style="{StaticResource DialogField}" Margin="0,16,0,0">
                            <TextBlock x:Name="DownloadRequestHost" FontFamily="Consolas" FontSize="13"
                                       Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock Style="{StaticResource DialogText}" FontSize="12" Foreground="{DynamicResource Text.Dim}"
                                   Margin="1,8,0,0" Text="{DynamicResource S.Download.Desc}"/>
                        <Grid Style="{StaticResource DialogFooter}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DownloadRequestDenyButton" Content="{DynamicResource S.Download.Refuse}"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="DownloadRequestDenyButton_Click"/>
                                <Button x:Name="DownloadRequestAllowButton" Content="{DynamicResource S.Download.Allow}"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        Click="DownloadRequestAllowButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПЕРЕИМЕНОВАНИЕ ПРОФИЛЯ ═══════════ -->
        <Grid x:Name="NameOverlay" Visibility="Collapsed" Panel.ZIndex="36">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="NameCancelButton_Click"/>
            </Border>
            <!-- Одно поле: название чата, папки, тега, профиля, имя пользователя, язык. Без абзаца
                 пояснений — заголовок говорит, что вводить; редкая подсказка — строкой под полем. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}">
                    <StackPanel>
                        <TextBlock x:Name="NameDialogTitle" Style="{StaticResource DialogTitle}" Margin="0,0,0,16"
                                   Text="{DynamicResource S.Account.UserName}"/>
                        <Border Style="{StaticResource DialogField}">
                            <TextBox x:Name="NameInput" Style="{StaticResource DialogInput}" MaxLength="40"
                                     AutomationProperties.Name="{Binding Text, ElementName=NameDialogTitle}"
                                     KeyDown="NameInput_KeyDown"/>
                        </Border>
                        <TextBlock x:Name="NameDialogHint" Style="{StaticResource DialogText}" FontSize="12"
                                   Foreground="{DynamicResource Text.Dim}" Margin="1,8,0,0" Visibility="Collapsed"/>
                        <!-- Цвет тега: шесть кружков из набора ChatOrganizer.TagColors, строит код. -->
                        <StackPanel x:Name="NameColorRow" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource DialogLabel}" Text="{DynamicResource S.ChatList.TagColor}"/>
                            <StackPanel x:Name="NameColors" Orientation="Horizontal" Margin="-3,0,0,0"/>
                        </StackPanel>
                        <Grid Style="{StaticResource DialogFooter}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NameDeleteButton" Style="{StaticResource DialogDangerButton}" Margin="0,0,12,0"
                                    Content="{DynamicResource S.Common.Delete}" Visibility="Collapsed"
                                    Click="NameDeleteButton_Click"/>
                            <TextBlock x:Name="NameError" Grid.Column="1" Style="{StaticResource DialogError}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{DynamicResource S.Common.Cancel}" Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="NameCancelButton_Click"/>
                                <Button x:Name="NameSaveButton" Content="{DynamicResource S.Common.Save}"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        Click="NameSaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ДОБАВЛЕНИЕ КЛЮЧА ═══════════ -->
        <!--
            Провайдер — сегментами сверху: от него зависят и проверка ключа, и ссылка «Где взять»
            у подписи поля. Чем провайдеры различаются, видно в подсказке на сегменте, а не
            абзацем в окне. «Проверяю…» и отказ — в подвале, окно от них не меняет высоту.
        -->
        <Grid x:Name="KeyOverlay" Visibility="Collapsed" Panel.ZIndex="42">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="KeyDialogCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}" Width="420">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DialogTitle}" Text="{DynamicResource S.Key.AddTitle}"/>

                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <RadioButton x:Name="KeyDialogVenice" GroupName="KeyDialogProvider" IsChecked="True"
                                         Style="{StaticResource DialogSegment}" Margin="0,0,4,0" Content="Venice"
                                         ToolTip="{DynamicResource S.Key.Provider.VeniceDesc}"
                                         Checked="KeyDialogProvider_Checked"/>
                            <RadioButton x:Name="KeyDialogOpenRouter" GroupName="KeyDialogProvider"
                                         Style="{StaticResource DialogSegment}" Margin="4,0,0,0" Content="OpenRouter"
                                         ToolTip="{DynamicResource S.Key.Provider.OpenRouterDesc}"
                                         Checked="KeyDialogProvider_Checked"/>
                        </UniformGrid>

                        <Grid Margin="0,16,0,6">
                            <TextBlock Style="{StaticResource DialogLabel}" Margin="0" Text="{DynamicResource S.Key.Value}"/>
                            <!-- Адрес идёт за выбранным провайдером: он же в подсказке ссылки. -->
                            <Button x:Name="KeyDialogKeysLink" Style="{StaticResource DialogLink}" HorizontalAlignment="Right"
                                    Content="{DynamicResource S.Key.WhereToGet}" Click="KeyDialogKeysLink_Click"/>
                        </Grid>
                        <!-- Обычный TextBox, а не PasswordBox: ключ вставляют из буфера, и видно должно быть,
                             что вставилось. Прячется он в списке, а не здесь. -->
                        <Border Style="{StaticResource DialogField}">
                            <TextBox x:Name="KeyDialogValue" Style="{StaticResource DialogInput}" FontFamily="Consolas" FontSize="12.5"
                                     AutomationProperties.Name="{DynamicResource S.Key.Value}"
                                     KeyDown="KeyDialogValue_KeyDown"/>
                        </Border>

                        <TextBlock Style="{StaticResource DialogLabel}" Text="{DynamicResource S.Key.Name}"/>
                        <Border Style="{StaticResource DialogField}">
                            <TextBox x:Name="KeyDialogLabel" Style="{StaticResource DialogInput}" MaxLength="40"
                                     Tag="{DynamicResource S.Key.NamePlaceholder}"
                                     AutomationProperties.Name="{DynamicResource S.Key.Name}"/>
                        </Border>

                        <Grid Style="{StaticResource DialogFooter}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KeyDialogStatus" Style="{StaticResource DialogStatus}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{DynamicResource S.Common.Cancel}" Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="KeyDialogCancelButton_Click"/>
                                <Button x:Name="KeyDialogSaveButton" Content="{DynamicResource S.Common.Add}"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        Click="KeyDialogSaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПЕРЕИМЕНОВАНИЕ КЛЮЧА ═══════════ -->
        <!--
            Поверх диалога удаления: открывается он из того же списка, и ZIndex ниже давал бы
            ему уехать под уже показанный вопрос.
        -->
        <Grid x:Name="KeyRenameOverlay" Visibility="Collapsed" Panel.ZIndex="44">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="KeyRenameCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DialogTitle}" Margin="0,0,0,16" Text="{DynamicResource S.Key.RenameTitle}"/>
                        <Border Style="{StaticResource DialogField}">
                            <!-- Пустое название возвращает то, что стояло по умолчанию: подсказка в пустом поле. -->
                            <TextBox x:Name="KeyRenameValue" Style="{StaticResource DialogInput}" MaxLength="40"
                                     Tag="{DynamicResource S.Key.RenamePlaceholder}"
                                     AutomationProperties.Name="{DynamicResource S.Key.RenameTitle}"
                                     KeyDown="KeyRenameValue_KeyDown"/>
                        </Border>
                        <Grid Style="{StaticResource DialogFooter}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource S.Common.Cancel}" Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="KeyRenameCancelButton_Click"/>
                                <Button x:Name="KeyRenameSaveButton" Content="{DynamicResource S.Common.Save}"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        Click="KeyRenameSaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ УДАЛЕНИЕ КЛЮЧА ═══════════ -->
        <Grid x:Name="KeyRemoveOverlay" Visibility="Collapsed" Panel.ZIndex="43">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="KeyRemoveNoButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}">
                    <StackPanel>
                        <TextBlock x:Name="KeyRemoveTitle" Style="{StaticResource DialogTitle}"/>
                        <TextBlock x:Name="KeyRemoveText" Style="{StaticResource DialogText}"/>
                        <Grid Style="{StaticResource DialogFooter}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource S.Common.Cancel}" Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="KeyRemoveNoButton_Click"/>
                                <Button x:Name="KeyRemoveYesButton" Content="{DynamicResource S.Common.Delete}"
                                        Style="{StaticResource DialogDangerButton}"
                                        Click="KeyRemoveYesButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ УВЕДОМЛЕНИЕ ═══════════ -->
        <!--
            Общее окно «сообщить или переспросить» вместо системного MessageBox: тот рисовался
            чужим стилем и в системном масштабе (UiScale подменяет DPI только нашему окну).
            ZIndex выше прочих диалогов: его зовут и из настроек, и поверх других окон.
        -->
        <Grid x:Name="NoticeOverlay" Visibility="Collapsed" Panel.ZIndex="46">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Focusable="False" Click="NoticeSecondaryButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <!--
                    Тон вопроса — у главной кнопки (красная подпись у необратимого), а не цветной
                    точкой у заголовка: точка ничего не говорила, а кнопка отвечает на вопрос.
                -->
                <Border x:Name="NoticeCard" Style="{StaticResource DialogCard}" Width="420" MaxHeight="520">
                    <!-- Grid, а не StackPanel: длинный текст уходит в прокрутку, кнопки остаются. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="NoticeTitle" Style="{StaticResource DialogTitle}"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Margin="0,0,-8,0" Padding="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="NoticeText" Style="{StaticResource DialogText}"/>
                                <!-- Своё содержимое вопроса: галочка, поле для слова-подтверждения. -->
                                <ContentControl x:Name="NoticeExtra" Focusable="False" Margin="0,14,0,0"
                                                Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Style="{StaticResource DialogFooter}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="NoticeSecondaryButton" Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="NoticeSecondaryButton_Click"/>
                                <Button x:Name="NoticePrimaryButton" Style="{StaticResource DialogPrimaryButton}"
                                        Click="NoticePrimaryButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ЗАГОТОВКА ПРОМПТА ═══════════ -->
        <!--
            Оверлеем, а не отдельным окном: UiScale подменяет DPI одному HWND, и второе окно
            рисовалось бы в системном масштабе, разъезжаясь с остальной программой. Поверх
            настроек, поэтому ZIndex выше всех диалогов, что были до этой версии.
        -->
        <Grid x:Name="PromptPresetOverlay" Visibility="Collapsed" Panel.ZIndex="40">
            <Grid.Resources>
                <!--
                    Своя копия поля промпта. Оригинал лежит в Resources сетки настроек, а этот
                    оверлей ей не родня - он сосед, поверх неё. Тот же приём, каким SettingsInfoPage
                    дублирует шесть общих стилей: StaticResource ищет только вверх по дереву.
                    Потолок выше, чем на странице: в модалке под текст отведено всё окно.
                -->
                <Style x:Key="PromptDialogTextBox" TargetType="TextBox">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                    <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="AcceptsReturn" Value="True"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="MinHeight" Value="120"/>
                    <Setter Property="MaxHeight" Value="220"/>
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6">
                                    <ScrollViewer x:Name="PART_ContentHost" local:SmoothScroll.IsEnabled="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="PromptPresetCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}" Width="460">
                    <StackPanel>
                        <TextBlock x:Name="PromptPresetTitle" Style="{StaticResource DialogTitle}" Margin="0,0,0,2"/>

                        <TextBlock Text="{DynamicResource S.Customize.PromptName}" FontSize="12"
                                   Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,5"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <TextBox x:Name="PromptPresetName" Background="Transparent" BorderThickness="0"
                                     FontSize="13" MaxLength="40"
                                     Foreground="{DynamicResource Text.Body}"
                                     CaretBrush="{DynamicResource Text.Bright}"
                                     KeyDown="PromptPresetName_KeyDown"/>
                        </Border>

                        <TextBlock Text="{DynamicResource S.Customize.PromptText}" FontSize="12"
                                   Foreground="{DynamicResource Text.Muted}" Margin="0,12,0,5"/>
                        <TextBox x:Name="PromptPresetText" Style="{StaticResource PromptDialogTextBox}"/>

                        <TextBlock x:Name="PromptPresetError" FontSize="12" Foreground="{DynamicResource Status.Danger}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                        <Grid Margin="0,16,0,0">
                            <!--
                                DangerButton живёт в Resources настроек и сюда не достаёт;
                                красный цвет задан значением на самой кнопке - локальное
                                значение сильнее сеттера стиля.
                            -->
                            <Button x:Name="PromptPresetDeleteButton" HorizontalAlignment="Left"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Foreground="{DynamicResource Status.Danger}"
                                    Content="{DynamicResource S.Common.Delete}"
                                    Click="PromptPresetDeleteButton_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource S.Common.Reset}" Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="PromptPresetResetButton_Click"/>
                                <Button Content="{DynamicResource S.Common.Save}" Style="{StaticResource DialogPrimaryButton}"
                                        Click="PromptPresetSaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПОДТВЕРЖДЕНИЕ ДЛЯ ЗАГОТОВКИ ═══════════ -->
        <!--
            Свой маленький оверлей, а не системный MessageBox: тот рисуется средствами Windows
            и рядом с модалкой заготовки выглядел бы из другой программы. Поверх неё же, поэтому
            ZIndex на единицу выше.
        -->
        <Grid x:Name="PromptApplyOverlay" Visibility="Collapsed" Panel.ZIndex="41">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="PromptApplyNoButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}" Width="420">
                    <StackPanel>
                        <TextBlock x:Name="PromptApplyTitle" Style="{StaticResource DialogTitle}"/>
                        <TextBlock x:Name="PromptApplyText" Style="{StaticResource DialogText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Content="{DynamicResource S.Common.Cancel}" Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="PromptApplyNoButton_Click"/>
                            <Button x:Name="PromptApplyYesButton" Content="{DynamicResource S.Common.Apply}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="PromptApplyYesButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ВЫБОР ПРОФИЛЯ ═══════════ -->
        <Grid x:Name="ProfileOverlay" Visibility="Collapsed" Panel.ZIndex="37">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="ProfileCloseButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Style="{StaticResource DialogCard}" Width="420">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Profiles.Title}" Style="{StaticResource DialogTitle}" Margin="0,0,0,14"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ProfileList"/>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <!-- Только у профиля с паролем: без него снять блокировку нечем. -->
                            <Button x:Name="ProfileLockNowButton" Content="{DynamicResource S.Security.LockNow}"
                                    Style="{StaticResource DialogSecondaryButton}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="ProfileLockNowButton_Click"/>
                            <Button Content="{DynamicResource S.Profiles.New}" Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="CreateProfileButton_Click"/>
                            <Button Content="{DynamicResource S.Common.Close}" Style="{StaticResource DialogPrimaryButton}"
                                    Click="ProfileCloseButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПРОСМОТР ИЗОБРАЖЕНИЯ ═══════════ -->
        <!-- Не отдельное окно: UiScale подменяет DPI одному HWND, и второе окно рисовалось бы
             в системном масштабе, разъезжаясь с остальной программой. -->
        <Grid x:Name="ImageViewerOverlay" Visibility="Collapsed" Panel.ZIndex="38"
              Focusable="True" PreviewKeyDown="ImageViewer_PreviewKeyDown">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="ImageViewerCloseButton_Click"/>
            </Border>

            <!-- Кадр просмотра. Картинка двигается трансформом, поэтому область фиксирована. -->
            <Border Margin="56,64,56,64" CornerRadius="10" ClipToBounds="True"
                    Background="Transparent">
                <Canvas x:Name="ImageViewerStage" Background="Transparent" ClipToBounds="True"
                        Cursor="SizeAll"
                        SizeChanged="ImageViewerStage_SizeChanged"
                        MouseLeftButtonDown="ImageViewerStage_MouseLeftButtonDown"
                        MouseLeftButtonUp="ImageViewerStage_MouseLeftButtonUp"
                        MouseMove="ImageViewerStage_MouseMove"
                        MouseWheel="ImageViewerStage_MouseWheel">
                    <Image x:Name="ImageViewerImage" Canvas.Left="0" Canvas.Top="0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageViewerZoom"/>
                                <TranslateTransform x:Name="ImageViewerPan"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </Border>

            <!-- Панель действий снизу по центру -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImageViewerPrevButton" Content="←" Width="32"
                            Style="{StaticResource DialogSecondaryButton}" Margin="0,0,4,0"
                            ToolTip="{DynamicResource S.Viewer.Previous}" Click="ImageViewerPrevButton_Click"/>
                    <TextBlock x:Name="ImageViewerCounter" VerticalAlignment="Center"
                               MinWidth="44" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Text.Muted}"/>
                    <Button x:Name="ImageViewerNextButton" Content="→" Width="32"
                            Style="{StaticResource DialogSecondaryButton}" Margin="4,0,10,0"
                            ToolTip="{DynamicResource S.Viewer.Next}" Click="ImageViewerNextButton_Click"/>
                    <Button Content="{DynamicResource S.Common.Save}" Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,4,0" Click="ImageViewerSaveButton_Click"/>
                    <Button Content="{DynamicResource S.Common.Copy}" Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,4,0" Click="ImageViewerCopyButton_Click"/>
                    <Button Content="{DynamicResource S.Common.Close}" Style="{StaticResource DialogPrimaryButton}"
                            Click="ImageViewerCloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            Экран блокировки (AppSettings.AutoLockMinutes, «Заблокировать сейчас»). Выше всех
            диалогов, включая вопрос об опасном действии: тот дождётся разблокировки. Слои под
            ним окно на время блокировки прячет само — см. MainWindow.Lock.
        -->
        <local:LockScreen x:Name="LockOverlay" Visibility="Collapsed" Panel.ZIndex="90"/>

        </Grid>
    </Grid>
</Window>
