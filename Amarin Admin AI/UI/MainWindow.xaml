                                                   Text="{DynamicResource S.Appearance.GlassDesc}"
                                                   Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.PanelDensity}"
                                                       VerticalAlignment="Center"/>
