                                              SelectionChanged="ChatWidthCombo_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthNarrow}" Tag="760"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthNormal}" Tag="1070"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthWide}" Tag="1400"/>
                                        <ComboBoxItem Content="{DynamicResource S.Appearance.WidthFull}" Tag="100000"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.InputRadius}"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="CornerRadiusSlider" Grid.Column="1"
                                            Style="{StaticResource SettingsRangeSlider}"
                                            Minimum="0" Maximum="20" SmallChange="1" LargeChange="2"/>
                                    <TextBlock x:Name="CornerRadiusValue" Grid.Column="2"
                                               Style="{StaticResource SettingValue}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Grain}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.GrainDesc}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="176" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GrainSlider"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"/>
                                        <TextBlock x:Name="GrainValue" Grid.Column="1"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Animations}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.AnimationsDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AnimationsToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="AnimationsToggle_Changed" Unchecked="AnimationsToggle_Changed"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.CompactComposer}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Appearance.CompactComposerDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="CompactComposerToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="CompactComposerToggle_Changed"
                                              Unchecked="CompactComposerToggle_Changed"/>
                                </Grid>

                                <StackPanel x:Name="CompactBody" Margin="18,10,0,0"
                                            IsEnabled="{Binding IsChecked, ElementName=CompactComposerToggle}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.MouseReaction}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}"
                                                       Text="{DynamicResource S.Appearance.MouseReactionDesc}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="CompactHoverToggle" Grid.Column="1"
                                                  Style="{StaticResource SettingsToggle}"
                                                  Checked="CompactHoverToggle_Changed"
                                                  Unchecked="CompactHoverToggle_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.Delay}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="CompactDelaySlider" Grid.Column="1"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="300" Maximum="5000" SmallChange="50" LargeChange="250"/>
                                        <TextBlock x:Name="CompactDelayValue" Grid.Column="2"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.StripWidth}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="CompactWidthSlider" Grid.Column="1"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="30" Maximum="100" SmallChange="1" LargeChange="5"/>
                                        <TextBlock x:Name="CompactWidthValue" Grid.Column="2"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                    <Grid IsEnabled="{Binding IsChecked, ElementName=CompactHoverToggle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Appearance.ReactionRadius}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Appearance.ReactionRadiusDesc}"/>
                                        </StackPanel>
                                        <Slider x:Name="CompactHoverSlider" Grid.Column="1"
                                                Style="{StaticResource SettingsRangeSlider}"
                                                Minimum="25" Maximum="400" SmallChange="5" LargeChange="20"/>
                                        <TextBlock x:Name="CompactHoverValue" Grid.Column="2"
                                                   Style="{StaticResource SettingValue}"/>
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <Button x:Name="ResetAppearanceButton" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Content="{DynamicResource S.Appearance.Reset}"
                                        Click="ResetAppearanceButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ BEHAVIOR ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavBehavior}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Behavior.Title}"/>

                                <Grid>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.AutoScroll}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="AutoScrollToggle" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right" IsChecked="True" Checked="AutoScrollToggle_Changed" Unchecked="AutoScrollToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.NotifyOnComplete}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Behavior.NotifyOnCompleteDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="NotifyOnCompleteToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}" IsChecked="True"
                                              Checked="NotifyOnCompleteToggle_Changed"
                                              Unchecked="NotifyOnCompleteToggle_Changed"/>
                                </Grid>
                                <Grid Margin="18,10,0,0"
                                      IsEnabled="{Binding IsChecked, ElementName=NotifyOnCompleteToggle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.NotifySound}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Behavior.NotifySoundDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="NotifySoundToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}" IsChecked="True"
                                              Checked="NotifySoundToggle_Changed"
                                              Unchecked="NotifySoundToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Behavior.ApprovalMode}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
       Text="{DynamicResource S.Behavior.ApprovalModeDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ApprovalModeCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      MinWidth="140" SelectedIndex="1" VerticalAlignment="Center"
