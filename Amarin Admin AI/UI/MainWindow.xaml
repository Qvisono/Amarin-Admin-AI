                                                    <TextBlock Style="{StaticResource PickerGroupHeader}" Text="СРЕДНИЙ УРОВЕНЬ"/>

                                                    <Button Style="{StaticResource ModelItem}" ToolTip="openai-gpt-53-codex · 400k">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="O" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="GPT-5.3 Codex"/>
                                                        </Grid>
                                                    </Button>

                                                    <Button Style="{StaticResource ModelItem}" ToolTip="kimi-k2-7-code · 256k">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="K" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="Kimi K2.7 Code"/>
                                                        </Grid>
                                                    </Button>

                                                    <TextBlock Style="{StaticResource PickerGroupHeader}" Text="БЮДЖЕТНЫЙ УРОВЕНЬ"/>

                                                    <Button Style="{StaticResource ModelItem}" ToolTip="minimax-m3-preview · 128k">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="M" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"
