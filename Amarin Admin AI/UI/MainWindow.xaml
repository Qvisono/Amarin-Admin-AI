                                        <ComboBoxItem Content="Always approve" Tag="AlwaysApprove"/>
                                        <ComboBoxItem Content="Normal" Tag="Normal"/>
                                    </ComboBox>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Language.Title}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
       Text="{DynamicResource S.Language.Desc}"/>
                                    </StackPanel>
                                    <local:LanguagePickerField x:Name="LanguagePicker" Grid.Column="1"
                                                               MinWidth="170" VerticalAlignment="Center"
                                                               LanguagePicked="LanguagePicker_LanguagePicked"
                                                               NewLanguageRequested="LanguagePicker_NewLanguageRequested"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ CUSTOMIZE ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavCustomize}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Customize.Title}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Customize.AnswerModels}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
