                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="LiteModelPicker" Grid.Column="2" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.Heavy}" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="HeavyReasoningPicker" Grid.Column="1" Height="28" MinWidth="72"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="HeavyModelPicker" Grid.Column="2" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.Router}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Customize.RouterDesc}"/>
                                    </StackPanel>
                                    <local:ReasoningPicker x:Name="RouterReasoningPicker" Grid.Column="1" Height="28" MinWidth="72"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="RouterModelPicker" Grid.Column="2" Width="170" VerticalAlignment="Center"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Customize.SystemPrompts}"/>

                                <!-- Основной промпт ИИ -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.MainPrompt}" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveMainPromptButton" Grid.Column="1" Style="{StaticResource SavePromptButton}" Click="SaveMainPromptButton_Click"/>
                                </Grid>
                                <TextBox x:Name="MainPromptTextBox" Style="{StaticResource PromptTextBox}" Margin="0,0,0,10"/>

                                <!-- Технический промпт ИИ -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.TechPrompt}" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveTechAiPromptButton" Grid.Column="1" Style="{StaticResource SavePromptButton}" Click="SaveTechAiPromptButton_Click"/>
                                </Grid>
                                <TextBox x:Name="TechAiPromptTextBox" Style="{StaticResource PromptTextBox}" Margin="0,0,0,10"/>

                                <!-- Технический промпт агента -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.AgentPrompt}" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveTechAgentPromptButton" Grid.Column="1" Style="{StaticResource SavePromptButton}" Click="SaveTechAgentPromptButton_Click"/>
                                </Grid>
                                <TextBox x:Name="TechAgentPromptTextBox" Style="{StaticResource PromptTextBox}"/>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Customize.ServiceModels}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.ChatTitles}" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="TitleReasoningPicker" Grid.Column="1" Height="28" MinWidth="72"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="TitleModelPicker" Grid.Column="2" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.AgentFast}" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="AgentFastReasoningPicker" Grid.Column="1" Height="28" MinWidth="72"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="AgentFastModelPicker" Grid.Column="2" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.AgentLight}" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="AgentLiteReasoningPicker" Grid.Column="1" Height="28" MinWidth="72"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="AgentLiteModelPicker" Grid.Column="2" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Customize.AgentHeavy}" VerticalAlignment="Center"/>
                                    <local:ReasoningPicker x:Name="AgentHeavyReasoningPicker" Grid.Column="1" Height="28" MinWidth="72"
                                                           Margin="8,0" VerticalAlignment="Center"
                                                           ChoiceChanged="SettingsReasoningChanged"/>
                                    <local:ModelPickerField x:Name="AgentHeavyModelPicker" Grid.Column="2" Width="170"
                                              ModelPicked="SettingsModelPicked"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══════════ DATA CONTROLS ═══════════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavData}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,14,20,16">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Data.Title}"/>

                                <!-- Занято на диске -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Usage}"/>
                                        <TextBlock x:Name="UsageSummaryText" Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Data.Usage.Desc}"/>
                                    </StackPanel>
                                    <Button x:Name="UsageRefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource S.Data.Usage.Refresh}" Click="UsageRefreshButton_Click"/>
                                </Grid>
                                <!--
                                    Строки разбивки собираются кодом: их состав зависит от того,
                                    что у человека реально лежит на диске, и пустая категория в
                                    списке была бы шумом. Полоска доли — Bg.Track под Accent.Fill,
                                    ширина звёздными колонками, как у полосы загрузки обновления.
                                -->
                                <ItemsControl x:Name="UsageList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding Indent}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Grid Height="4" Margin="0,4,0,0">
                                                        <Border CornerRadius="2" Background="{DynamicResource Bg.Track}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Share}"/>
                                                                <ColumnDefinition Width="{Binding Rest}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border CornerRadius="2" Background="{DynamicResource Accent.Fill}"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Size}" FontSize="12.5"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Text.Secondary}"/>
                                                    <TextBlock Text="{Binding Files}" FontSize="11"
                                                               HorizontalAlignment="Right" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource Text.Faint}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="UsageAppText" FontSize="12"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource Text.Faint}"/>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Sharing}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Data.SharingDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChatSharingToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="ChatSharingToggle_Changed"
                                              Unchecked="ChatSharingToggle_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Import}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Data.ImportDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="ImportChatButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource S.Data.OpenFile}" Click="ImportChatButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!--
                                    Экспорт и импорт всех данных. Стоит рядом с импортом одного
                                    чата: две соседние задачи, и человек, пришедший «перенести
                                    переписку», видит обе сразу. Две кнопки в ряд — как у
                                    обновлений ниже.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Bundle.Row}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Bundle.RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="DataExportButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Bundle.Export}" Margin="0,0,6,0"
                                                Click="DataExportButton_Click"/>
                                        <Button x:Name="DataImportButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Bundle.Import}"
                                                Click="DataImportButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.AppFiles}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Data.AppFilesDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="OpenAppFilesButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource S.Common.Open}" Click="OpenAppFilesButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!-- Обновления -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Updates.Title}"/>
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Updates.NeverChecked}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="OpenReleaseButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Updates.OpenRelease}" Margin="0,0,6,0" Visibility="Collapsed"
                                                Click="OpenReleaseButton_Click"/>
                                        <Button x:Name="UpdateNowButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Updates.Update}" Margin="0,0,6,0" Visibility="Collapsed"
                                                Click="UpdateNowButton_Click"/>
                                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource S.Updates.Check}" Click="CheckUpdatesButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Полоса загрузки обновления -->
                                <Grid x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Border CornerRadius="2" Background="{DynamicResource Bg.Card}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="UpdateProgressDone" Width="0*"/>
                                            <ColumnDefinition x:Name="UpdateProgressLeft" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="2" Background="{DynamicResource Accent.Fill}"/>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Updates.Auto}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="{DynamicResource S.Updates.AutoDesc}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoUpdateToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              Checked="AutoUpdateToggle_Changed"
                                              Unchecked="AutoUpdateToggle_Changed"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsDivider}"/>

                                <!-- Разрешённые сайты -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,34,0">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Allowlist}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Data.AllowlistDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="AddDomainButton" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Content="+" Width="26" Padding="0" FontSize="14"
                                            Click="AddDomainButton_Click"/>
                                </Grid>
                                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                                    <Grid>
                                        <TextBlock x:Name="AllowedDomainsEmpty" Margin="8,7"
                                                   Text="{DynamicResource S.Data.AllowlistEmpty}"
                                                   FontSize="12" Foreground="{DynamicResource Text.Faint}"
                                                   Visibility="Collapsed"/>
                                        <ScrollViewer MaxHeight="152" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="AllowedDomainsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="8,5">
                                                            <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas"
                                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                                       VerticalAlignment="Center" Margin="0,0,30,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                                                    Content="–" Width="22" Height="22" Padding="0"
                                                                    Tag="{Binding}" ToolTip="{DynamicResource S.Data.AllowlistRemove}"
                                                                    Click="RemoveDomainButton_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.DeleteChats}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Data.DeleteChatsDesc}"/>
                                    </StackPanel>
                                    <Button x:Name="DeleteAllChatsButton" Grid.Column="1" Style="{StaticResource DangerButton}"
                                            Content="{DynamicResource S.Common.Delete}" Click="DeleteAllChatsButton_Click"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.DeleteAll}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Data.DeleteAllDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="{DynamicResource S.Common.Delete}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>
            </Viewbox>
        </Grid>

        <!--
            Журнал действий. ZIndex 34: выше подтверждения (30), но ниже диалога домена (35) —
            из журнала можно открыть чат, а тот способен тут же спросить про домен, и вопрос
            обязан лечь поверх. Карточка шире обычных диалогов на 420: это таблица, а не вопрос.
        -->
        <Grid x:Name="JournalOverlay" Visibility="Collapsed" Panel.ZIndex="34"
              Focusable="True" PreviewKeyDown="Journal_PreviewKeyDown">
            <Grid.Resources>
                <!-- ===== Вкладка / переключатель охвата ===== -->
                <Style x:Key="JournalTab" TargetType="ToggleButton">
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ===== Строка журнала ===== -->
                <!--
                    Высота строки фиксирована, а длинные значения обрезаются многоточием: при
                    переменной высоте VirtualizingStackPanel не может заранее посчитать полосу
                    прокрутки, и она прыгала бы на каждом шаге. Полный текст — в подсказке.
                -->
                <Style x:Key="JournalRowButton" TargetType="Button">
                    <Setter Property="Height" Value="46"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="JournalCloseButton_Click"/>
            </Border>

            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="760" Height="560" Background="{DynamicResource Bg.Panel}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="10"
                        Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ===== ЗАГОЛОВОК ===== -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="JournalBackButton" Width="24" Height="24" Cursor="Hand"
                                        Visibility="Collapsed" Margin="0,0,8,0"
                                        ToolTip="{DynamicResource S.Journal.Back}"
                                        Click="JournalBackButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                <Path x:Name="Icon" Data="M5,0 L0,5 L5,10"
                                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="7" Height="12" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock x:Name="JournalTitleText" Text="{DynamicResource S.Journal.Title}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="JournalCloseButton" Width="26" Height="26"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Cursor="Hand" Click="JournalCloseButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                            <Path x:Name="Icon" Data="M0,0 L8,8 M8,0 L0,8"
                                                  Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="9" Height="9" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ===== ВКЛАДКИ И ОХВАТ ===== -->
                        <Grid x:Name="JournalTabsRow" Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="JournalActionsTab" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Tab.Actions}" IsChecked="True"
                                              Click="JournalActionsTab_Click"/>
                                <ToggleButton x:Name="JournalSnapshotsTab" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Tab.Snapshots}"
                                              Click="JournalSnapshotsTab_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="JournalScopePanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="JournalScopeChat" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Scope.Chat}" IsChecked="True"
                                              Click="JournalScopeChat_Click"/>
                                <ToggleButton x:Name="JournalScopeAll" Style="{StaticResource JournalTab}"
                                              Content="{DynamicResource S.Journal.Scope.All}" Margin="0"
                                              Click="JournalScopeAll_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- ===== ПОИСК ===== -->
                        <Border Grid.Row="2" x:Name="JournalSearchBox" Margin="0,0,0,10"
                                Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <Grid>
                                <TextBlock x:Name="JournalSearchPlaceholder"
                                           Text="{DynamicResource S.Journal.SearchHint}" FontSize="12.5"
                                           Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="JournalSearch" Background="Transparent" BorderThickness="0"
                                         FontSize="12.5" Foreground="{DynamicResource Text.Body}"
                                         CaretBrush="{DynamicResource Text.Bright}"
                                         TextChanged="JournalSearch_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- ===== СПИСОК ===== -->
                        <Grid Grid.Row="3">
                            <ItemsControl x:Name="JournalList"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource JournalRowButton}"
                                                ToolTip="{Binding Tooltip}" Click="JournalRow_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.RowSpan="2" Text="{Binding Glyph}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,9,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Title}"
                                                           FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Body}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Subtitle}"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="{DynamicResource Text.Faint}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>

                                                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Timestamp}"
                                                           FontSize="11" Foreground="{DynamicResource Text.Dim}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Trailer}"
                                                           FontSize="11" Foreground="{DynamicResource Text.Faint}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                           Margin="10,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="JournalEmpty" Visibility="Collapsed"
                                       FontSize="12.5" Foreground="{DynamicResource Text.Faint}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!--
                                Подробности одной записи. Лежат в той же ячейке, что и список, и
                                подменяют его: отдельное окно поверх модалки — уже третий слой,
                                из которого непонятно, куда возвращает Esc.
                            -->
                            <ScrollViewer x:Name="JournalDetails" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="JournalDetailTitle" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Body}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="JournalDetailMeta" FontSize="11.5" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="JournalAskButton" Style="{StaticResource DialogPrimaryButton}"
                                                Content="{DynamicResource S.Journal.Ask}" Margin="0,0,8,0"
                                                Click="JournalAskButton_Click"/>
                                        <Button x:Name="JournalOpenChatButton" Style="{StaticResource DialogSecondaryButton}"
                                                Content="{DynamicResource S.Journal.OpenChat}"
                                                Click="JournalOpenChatButton_Click"/>
                                    </StackPanel>

                                    <Border x:Name="JournalAnswerBox" Visibility="Collapsed" Margin="0,12,0,0"
                                            Background="{DynamicResource Bg.Card}"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10">
                                        <TextBlock x:Name="JournalAnswerText" FontSize="12.5" TextWrapping="Wrap"
                                                   LineHeight="18" Foreground="{DynamicResource Text.Body}"/>
                                    </Border>

                                    <TextBlock Text="{DynamicResource S.Journal.Arguments}" Margin="0,16,0,6"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                    <ContentControl x:Name="JournalArgumentsHost"/>

                                    <TextBlock Text="{DynamicResource S.Journal.Result}" Margin="0,14,0,6"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                    <ContentControl x:Name="JournalResultHost" Margin="0,0,0,4"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===== ПОДВАЛ ===== -->
                        <TextBlock Grid.Row="4" x:Name="JournalFooter" Margin="0,12,0,0"
                                   FontSize="11" Foreground="{DynamicResource Text.Faint}"/>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>

        <Grid x:Name="ConfirmationOverlay" Visibility="Collapsed" Panel.ZIndex="30">
            <Border Background="{DynamicResource Overlay.Scrim}"/>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <!--
                Шире обычных 420 и с потолком высоты: сюда кладётся блок кода, а карточка живёт
                внутри Viewbox со Stretch="Uniform" — без MaxHeight длинный скрипт растянул бы её,
                и Viewbox ужал бы весь диалог вместе с кнопками до нечитаемого.
            -->
            <Border x:Name="ConfirmationCard"
                    Width="460" MinHeight="180" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="10"
                    Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Confirm.Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,12"/>
                    <!-- Из какого чата пришёл вопрос: спрашивать могут сразу несколько, и
                         «удалить папку X» без имени разговора — опасная неизвестность. -->
                    <Button x:Name="ConfirmationChatButton" Style="{StaticResource InlineLinkButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed"
                            Click="ConfirmationChatButton_Click"/>
                    <TextBlock x:Name="ConfirmationAgentText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ConfirmationSummaryText" FontSize="13.5" Foreground="{DynamicResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ConfirmationExplanationText" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <!--
                        Разъяснение от ИИ: то же, что в журнале умеет кнопка «Спросить ИИ», только
                        здесь оно спрашивается само и заранее. Поле explanation у инструмента —
                        просьба к модели, а не обязанность, и чаще всего оно пустое; человек при
                        этом жмёт «Да» под текстом скрипта, который никто ему не объяснил.
                        Обычный TextBlock: текст пришёл от модели и остаётся текстом.
                    -->
                    <TextBlock x:Name="ConfirmationAiText" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <!--
                        Что именно выполнится, целиком, и технические подробности. Наполняются из
                        кода: заголовок и подсветка зависят от инструмента, а пустой экспандер в
                        диалоге хуже, чем его отсутствие.
                    -->
                    <ContentControl x:Name="ConfirmationCodeHost" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <ContentControl x:Name="ConfirmationDetailsHost" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="ConfirmationNoButton" Content="{DynamicResource S.Common.No}"
                                Style="{StaticResource DialogSecondaryButton}"
                                Margin="0,0,8,0" Click="ConfirmationNoButton_Click"/>
                        <Button x:Name="ConfirmationYesButton" Content="{DynamicResource S.Common.Yes}"
                                Style="{StaticResource DialogPrimaryButton}"
                                Click="ConfirmationYesButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ДОБАВЛЕНИЕ ДОМЕНА В БЕЛЫЙ СПИСОК ═══════════ -->
        <Grid x:Name="DomainOverlay" Visibility="Collapsed" Panel.ZIndex="35">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="DomainCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Domain.Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource S.Domain.Desc}"
                               FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="6" Padding="10,7">
                        <TextBox x:Name="DomainInput" Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="13"
                                 Foreground="{DynamicResource Text.Body}"
                                 CaretBrush="{DynamicResource Text.Bright}"
                                 KeyDown="DomainInput_KeyDown"
                                 TextChanged="DomainInput_TextChanged"/>
                    </Border>
                    <TextBlock x:Name="DomainError" FontSize="12" Foreground="{DynamicResource Status.Danger}"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="DomainCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                Style="{StaticResource DialogSecondaryButton}"
                                Margin="0,0,8,0" Click="DomainCancelButton_Click"/>
                        <Button x:Name="DomainAddButton" Content="{DynamicResource S.Common.Add}"
                                Style="{StaticResource DialogPrimaryButton}"
                                Click="DomainAddButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ЭКСПОРТ ДАННЫХ ═══════════ -->
        <!--
            ZIndex 31: выше вопроса о действии (30) — окно человек открыл сам, и фоновый вопрос
            от модели не должен лечь поверх списка галочек; тот же выбор уже сделан для
            DomainOverlay. Ниже всего остального: с экспортом ничто из этого одновременно не
            живёт, а если появится вопрос о загрузке — он важнее.
        -->
        <Grid x:Name="DataExportOverlay" Visibility="Collapsed" Panel.ZIndex="31"
              Focusable="True" PreviewKeyDown="DataExport_PreviewKeyDown">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="DataExportCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border x:Name="DataExportCard" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Bundle.Export.Title}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource S.Bundle.Export.Desc}" FontSize="12.5"
                                   Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <!--
                            Строки категорий собираются кодом: их состав зависит от того, что
                            реально лежит на диске, и пустая категория в списке была бы шумом —
                            тот же мотив, что у разбивки «Занято на диске».
                        -->
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel x:Name="ExportCategoryList"/>
                        </Border>

                        <TextBlock x:Name="ExportSummaryText" FontSize="12" Margin="0,10,0,0"
                                   Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExportErrorText" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Status.Danger}" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="DataExportCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                    Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0"
                                    Click="DataExportCancelButton_Click"/>
                            <Button x:Name="DataExportSaveButton" Content="{DynamicResource S.Bundle.Export.Save}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="DataExportSaveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ИМПОРТ ДАННЫХ ═══════════ -->
        <!-- ZIndex 32: на слой выше экспорта, чтобы два родственных окна нельзя было перепутать. -->
        <Grid x:Name="DataImportOverlay" Visibility="Collapsed" Panel.ZIndex="32"
              Focusable="True" PreviewKeyDown="DataImport_PreviewKeyDown">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="DataImportCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border x:Name="DataImportCard" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Bundle.Import.Title}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                   Margin="0,0,0,10"/>

                        <!-- Что в архиве: сводка читается из описи, без распаковки. -->
                        <StackPanel x:Name="ImportChoicePanel">
                            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                                <TextBlock x:Name="ImportMetaText" FontSize="12"
                                           Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <StackPanel x:Name="ImportCategoryList"/>
                            </Border>

                            <TextBlock Text="{DynamicResource S.Bundle.Import.Mode}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"
                                       Margin="0,14,0,8"/>
                            <RadioButton x:Name="ImportMergeChoice" GroupName="DataImportMode"
                                         Style="{StaticResource DialogChoiceCard}" IsChecked="True"
                                         Margin="0,0,0,6" Checked="ImportModeChoice_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.Merge}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}"/>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.MergeDesc}" FontSize="11.5"
                                               Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ImportReplaceChoice" GroupName="DataImportMode"
                                         Style="{StaticResource DialogChoiceCard}"
                                         Checked="ImportModeChoice_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.Replace}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}"/>
                                    <TextBlock Text="{DynamicResource S.Bundle.Import.ReplaceDesc}" FontSize="11.5"
                                               Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="{DynamicResource S.Bundle.Import.SecurityKept}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>

                        <!-- Итог показывается здесь же: отдельное системное окно поверх своего
                             выглядит как сбой, а не как ответ на нажатую кнопку. -->
                        <TextBlock x:Name="ImportDoneText" FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Text.Body}" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="ImportErrorText" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Status.Danger}" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="DataImportCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                    Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0"
                                    Click="DataImportCancelButton_Click"/>
                            <Button x:Name="DataImportApplyButton" Content="{DynamicResource S.Bundle.Import.Apply}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="DataImportApplyButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПОДТВЕРЖДЕНИЕ ОБНОВЛЕНИЯ ═══════════ -->
        <Grid x:Name="UpdateConfirmOverlay" Visibility="Collapsed" Panel.ZIndex="39">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="UpdateConfirmCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock x:Name="UpdateConfirmTitle" Text="{DynamicResource S.Update.Title}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="UpdateConfirmText" FontSize="12.5"
                                   Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <StackPanel>
                                <TextBlock x:Name="UpdateConfirmFile" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource Text.Body}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UpdateConfirmFolder" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource Text.Faint}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource S.Update.Desc}"
                                   FontSize="11.5" Foreground="{DynamicResource Text.Faint}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="UpdateConfirmCancelButton" Content="{DynamicResource S.Common.Cancel}"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="UpdateConfirmCancelButton_Click"/>
                            <Button x:Name="UpdateConfirmApplyButton" Content="{DynamicResource S.Update.Confirm}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="UpdateConfirmApplyButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ЗАПРОС НА РАЗРЕШЕНИЕ ЗАГРУЗКИ ═══════════ -->
        <Grid x:Name="DownloadRequestOverlay" Visibility="Collapsed" Panel.ZIndex="38">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="DownloadRequestDenyButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{DynamicResource Status.Warning}"/>
                            <TextBlock Text="{DynamicResource S.Download.Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>
                        <TextBlock x:Name="DownloadRequestText" FontSize="12.5"
                                   Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <TextBlock x:Name="DownloadRequestHost" FontFamily="Consolas" FontSize="13"
                                       Foreground="{DynamicResource Text.Body}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock Text="{DynamicResource S.Download.Desc}"
                                   FontSize="11.5" Foreground="{DynamicResource Text.Faint}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="DownloadRequestDenyButton" Content="{DynamicResource S.Download.Refuse}"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="DownloadRequestDenyButton_Click"/>
                            <Button x:Name="DownloadRequestAllowButton" Content="{DynamicResource S.Download.Allow}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="DownloadRequestAllowButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПЕРЕИМЕНОВАНИЕ ПРОФИЛЯ ═══════════ -->
        <Grid x:Name="NameOverlay" Visibility="Collapsed" Panel.ZIndex="36">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="NameCancelButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock x:Name="NameDialogTitle" Text="{DynamicResource S.Name.Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="NameDialogSubtitle"
                                   Text="{DynamicResource S.Name.Desc}"
                                   FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <TextBox x:Name="NameInput" Background="Transparent" BorderThickness="0"
                                     FontSize="13" MaxLength="40"
                                     Foreground="{DynamicResource Text.Body}"
                                     CaretBrush="{DynamicResource Text.Bright}"
                                     KeyDown="NameInput_KeyDown"/>
                        </Border>
                        <TextBlock x:Name="NameError" FontSize="12" Foreground="{DynamicResource Status.Danger}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{DynamicResource S.Common.Cancel}" Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="NameCancelButton_Click"/>
                            <Button x:Name="NameSaveButton" Content="{DynamicResource S.Common.Save}"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="NameSaveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ВЫБОР ПРОФИЛЯ ═══════════ -->
        <Grid x:Name="ProfileOverlay" Visibility="Collapsed" Panel.ZIndex="37">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="ProfileCloseButton_Click"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Profiles.Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource S.Profiles.Desc}"
                                   FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ProfileList"/>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{DynamicResource S.Profiles.New}" Style="{StaticResource DialogSecondaryButton}"
                                    Margin="0,0,8,0" Click="CreateProfileButton_Click"/>
                            <Button Content="{DynamicResource S.Common.Close}" Style="{StaticResource DialogPrimaryButton}"
                                    Click="ProfileCloseButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ═══════════ ПРОСМОТР ИЗОБРАЖЕНИЯ ═══════════ -->
        <!-- Не отдельное окно: UiScale подменяет DPI одному HWND, и второе окно рисовалось бы
             в системном масштабе, разъезжаясь с остальной программой. -->
        <Grid x:Name="ImageViewerOverlay" Visibility="Collapsed" Panel.ZIndex="38"
              Focusable="True" PreviewKeyDown="ImageViewer_PreviewKeyDown">
            <Border Background="{DynamicResource Overlay.Scrim}">
                <Button Opacity="0" Click="ImageViewerCloseButton_Click"/>
            </Border>

            <!-- Кадр просмотра. Картинка двигается трансформом, поэтому область фиксирована. -->
            <Border Margin="56,64,56,64" CornerRadius="10" ClipToBounds="True"
                    Background="Transparent">
                <Canvas x:Name="ImageViewerStage" Background="Transparent" ClipToBounds="True"
                        Cursor="SizeAll"
                        SizeChanged="ImageViewerStage_SizeChanged"
                        MouseLeftButtonDown="ImageViewerStage_MouseLeftButtonDown"
                        MouseLeftButtonUp="ImageViewerStage_MouseLeftButtonUp"
                        MouseMove="ImageViewerStage_MouseMove"
                        MouseWheel="ImageViewerStage_MouseWheel">
                    <Image x:Name="ImageViewerImage" Canvas.Left="0" Canvas.Top="0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageViewerZoom"/>
                                <TranslateTransform x:Name="ImageViewerPan"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </Border>

            <!-- Панель действий снизу по центру -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImageViewerPrevButton" Content="←" Width="32"
                            Style="{StaticResource DialogSecondaryButton}" Margin="0,0,4,0"
                            ToolTip="{DynamicResource S.Viewer.Previous}" Click="ImageViewerPrevButton_Click"/>
                    <TextBlock x:Name="ImageViewerCounter" VerticalAlignment="Center"
                               MinWidth="44" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Text.Muted}"/>
                    <Button x:Name="ImageViewerNextButton" Content="→" Width="32"
                            Style="{StaticResource DialogSecondaryButton}" Margin="4,0,10,0"
                            ToolTip="{DynamicResource S.Viewer.Next}" Click="ImageViewerNextButton_Click"/>
                    <Button Content="{DynamicResource S.Common.Save}" Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,4,0" Click="ImageViewerSaveButton_Click"/>
                    <Button Content="{DynamicResource S.Common.Copy}" Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,4,0" Click="ImageViewerCopyButton_Click"/>
                    <Button Content="{DynamicResource S.Common.Close}" Style="{StaticResource DialogPrimaryButton}"
                            Click="ImageViewerCloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        </Grid>
    </Grid>
</Window>
