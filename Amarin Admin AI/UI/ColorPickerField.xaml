<UserControl x:Class="Amarin.UI.ColorPickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI"
             MinWidth="92" Height="26">
    <UserControl.Resources>
        <Style x:Key="ChannelSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="Track" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource Text.Primary}"
                                                         Stroke="{DynamicResource Bg.Panel}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="OpenButton" Cursor="Hand" Focusable="False" ClickMode="Press">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                        <Grid Margin="5,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Шахматка под образцом: показывает, что «не задано» — это прозрачность -->
                            <Border Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1"
                                    local:RoundedClip.Radius="4">
                                <Grid>
                                    <Rectangle Fill="{DynamicResource Bg.Elevated}"/>
                                    <Rectangle x:Name="SwatchFill"/>
                                    <Path x:Name="EmptyMark" Data="M0,10 L10,0" Stretch="Fill" Margin="2"
                                          Stroke="{DynamicResource Status.Danger}" StrokeThickness="1.2"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="SwatchLabel" Grid.Column="1" Margin="7,0,0,0"
                                       FontSize="11" FontFamily="Consolas"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               VerticalOffset="4"
               HorizontalOffset="-70"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=OpenButton, Mode=TwoWay}">
            <Border Width="228" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel>
                    <Border Height="34" CornerRadius="6" Margin="0,0,0,9"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Rectangle x:Name="PreviewFill"/>
                    </Border>

                    <ItemsControl x:Name="SwatchList" Margin="0,0,0,9">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="H" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Faint}"/>
                        <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource ChannelSlider}"
                                Maximum="360" ValueChanged="Channel_ValueChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="S" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Faint}"/>
                        <Slider x:Name="SatSlider" Grid.Column="1" Style="{StaticResource ChannelSlider}"
                                Maximum="100" ValueChanged="Channel_ValueChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="V" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Faint}"/>
                        <Slider x:Name="ValSlider" Grid.Column="1" Style="{StaticResource ChannelSlider}"
                                Maximum="100" ValueChanged="Channel_ValueChanged"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Height="26">
                            <TextBox x:Name="HexBox" Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11.5"
                                     Foreground="{DynamicResource Text.Bright}"
                                     CaretBrush="{DynamicResource Text.Bright}"
                                     VerticalContentAlignment="Center" Padding="8,0"
                                     MaxLength="9"
                                     LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown"/>
                        </Border>
                        <Button x:Name="ClearButton" Grid.Column="1" Margin="6,0,0,0" Height="26"
                                Cursor="Hand" Click="ClearButton_Click"
                                ToolTip="Вернуть цвет темы">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,0">
                                        <TextBlock Text="Сброс" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Secondary}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
