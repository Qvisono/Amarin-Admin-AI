<UserControl x:Class="Amarin.UI.WhatsNewSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Sheet_PreviewKeyDown">
    <UserControl.Resources>
        <!--
            Вид — концепта «Капля» (1-drop.html, 1-drop-dark.html) один в один (1.37.1). Цвета — в двух
            палитрах, WhatsNew.Light.xaml и WhatsNew.Dark.xaml: лист берёт ту, что у темы Windows, когда
            показывается, поэтому всё здесь читает их через DynamicResource.
        -->
        <FontFamily x:Key="WhatsNew.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="WhatsNew.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="WhatsNew.Mono">Consolas</FontFamily>

        <!-- Флаги рисуются вручную; цвета у них свои, государственные. Рамка рисунка задана
             обрезкой: штрихи креста иначе раздвинули бы границы картинки за флаг. -->
        <DrawingImage x:Key="Flag.Ru">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 H9 V6 H0 Z">
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H9 V2 H0 Z"/>
                    <GeometryDrawing Brush="#0039A6" Geometry="M0,2 H9 V4 H0 Z"/>
                    <GeometryDrawing Brush="#D52B1E" Geometry="M0,4 H9 V6 H0 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="Flag.En">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 H60 V30 H0 Z">
                    <GeometryDrawing Brush="#012169" Geometry="M0,0 H60 V30 H0 Z"/>
                    <GeometryDrawing Geometry="M0,0 L60,30 M60,0 L0,30">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFFFFF" Thickness="6"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <DrawingGroup ClipGeometry="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z">
                        <GeometryDrawing Geometry="M0,0 L60,30 M60,0 L0,30">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#C8102E" Thickness="4"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup>
                    <GeometryDrawing Geometry="M30,0 V30 M0,15 H60">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFFFFF" Thickness="10"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M30,0 V30 M0,15 H60">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#C8102E" Thickness="6"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Знак раздела (.rg концепта): маленькое красное кольцо — эхо больших колец сцены. -->
        <Style x:Key="WhatsNewRing" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="Stroke" Value="{DynamicResource WhatsNew.Red}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Тонкая полоса прокрутки концепта: 4 точки, бледный бегунок, без стрелок. -->
        <Style x:Key="WhatsNewScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource WhatsNew.Thumb}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WhatsNewScroll" TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource WhatsNewScrollBar}"
                                       HorizontalAlignment="Right" Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт колонки разделов (.toc a): кольцо видно только у выбранного. -->
        <Style x:Key="WhatsNewTocItem" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Ring" Style="{StaticResource WhatsNewRing}" Margin="0,0,7,0" Opacity="0"/>
                                <TextBlock x:Name="Label" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource WhatsNew.Text3}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WhatsNew.Hover}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WhatsNew.Text2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WhatsNew.On}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WhatsNew.Text1}"/>
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка языка заметок (.lang button): флаг из Tag (нет флага — одна подпись) и название.
             Рамка у выбранной есть всегда, только прозрачная: состояние не двигает раскладку. -->
        <Style x:Key="WhatsNewLanguageButton" TargetType="RadioButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="WhatsNewLanguage"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" Padding="7,0,9,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid x:Name="Flag" Width="16" Height="11" Margin="0,0,6,0">
                                    <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,16,11" RadiusX="2" RadiusY="2"/>
                                        </Image.Clip>
                                    </Image>
                                    <Border Margin="-1" BorderBrush="{DynamicResource WhatsNew.FlagEdge}" BorderThickness="1" CornerRadius="3"/>
                                </Grid>
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="Medium"
                                           Foreground="{DynamicResource WhatsNew.Text3}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                <Setter TargetName="Flag" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WhatsNew.Text1}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WhatsNew.SegmentOn}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource WhatsNew.SegmentEdge}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WhatsNew.Text1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «Понятно» (.ok): красная кнопка с белой подписью. -->
        <Style x:Key="WhatsNewOkButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource WhatsNew.Red}" CornerRadius="7" Padding="14,0">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhatsNew.OkText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WhatsNew.RedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WhatsNew.RedPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        «Что нового» (1.37.1): сцена «Капля» во весь слой и карточка над ней. Слева — разделы заметок,
        справа — сами заметки; наведённый раздел подсвечен в колонке. Язык заметок — переключателем в
        подвале: перевод делает модель ИИ, если есть ключ.
    -->
    <Grid x:Name="Stage" SizeChanged="Stage_SizeChanged">
        <local:WhatsNewDrop x:Name="Scene" Fill="{DynamicResource WhatsNew.Back}" Ring="{DynamicResource WhatsNew.Red}"
                            Feather="{DynamicResource WhatsNew.Feather}" Sheen="{DynamicResource WhatsNew.Sheen}"
                            Shaft="{DynamicResource WhatsNew.Shaft}" Shadow="{DynamicResource WhatsNew.Shadow}"
                            MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

        <!-- Карточка рисуется вживую, без кэша картинкой и без эффектов: у «Занавеса» растровый кэш
             поверх стекла давал мыло. Непрозрачная, с округлением раскладки до точек экрана. -->
        <Grid x:Name="Card" Width="680" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" TextElement.FontFamily="{StaticResource WhatsNew.Font}"
              UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale"/>
                    <TranslateTransform x:Name="CardShift"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Border Background="{DynamicResource WhatsNew.Card}" BorderBrush="{DynamicResource WhatsNew.Edge}"
                    BorderThickness="1" CornerRadius="12"/>

            <Grid Margin="17,15,17,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- .head -->
                <Grid Height="26" Margin="0,0,0,4">
                    <!-- Закрыть — «Понятно» в подвале, Esc и щелчок мимо: второй кнопки выхода в шапке нет. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Amarin Admin AI;component/jeklE-removebg-preview_1.ico" Width="18" Height="18"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource S.Updates.WhatsNewHeading}" FontSize="15"
                               FontWeight="SemiBold" FontFamily="{StaticResource WhatsNew.Display}"
                               Foreground="{DynamicResource WhatsNew.Text1}" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="{DynamicResource WhatsNew.RedTint}" CornerRadius="4" Padding="6,4"
                            Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="11" FontWeight="SemiBold" LineHeight="11"
                                   LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource WhatsNew.RedInk}"/>
                    </Border>
                </Grid>

                <!-- .lead -->
                <StackPanel x:Name="Lead" Grid.Row="1" Margin="0,0,0,8"/>

                <!-- .split -->
                <Grid x:Name="Split" Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TocColumn" Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TocBorder" BorderBrush="{DynamicResource WhatsNew.Line}" BorderThickness="0,0,1,0"
                            Padding="0,2,10,0" Margin="0,0,14,0">
                        <ScrollViewer x:Name="TocScroll" Style="{StaticResource WhatsNewScroll}" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="TocPanel"
                                        AutomationProperties.Name="{DynamicResource S.Updates.WhatsNewSections}"/>
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer x:Name="NotesScroll" Grid.Column="1" Style="{StaticResource WhatsNewScroll}"
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0"
                                  AutomationProperties.Name="{DynamicResource S.Updates.NotesTitle}">
                        <StackPanel x:Name="NotesPanel" Background="Transparent"/>
                    </ScrollViewer>
                </Grid>

                <!-- .foot -->
                <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource WhatsNew.Line}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LanguageSwitch" Background="{DynamicResource WhatsNew.On}" CornerRadius="7" Padding="2"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource S.Updates.WhatsNewLanguages}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NativeButton" Style="{StaticResource WhatsNewLanguageButton}"
                                             Margin="0,0,2,0" Checked="NativeButton_Checked"/>
                                <RadioButton x:Name="EnglishButton" Style="{StaticResource WhatsNewLanguageButton}"
                                             Content="English" Tag="{StaticResource Flag.En}" Checked="EnglishButton_Checked"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LanguageStatus" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource WhatsNew.Text4}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="OkButton" Grid.Column="2" Style="{StaticResource WhatsNewOkButton}"
                                Content="{DynamicResource S.Updates.WhatsNewOk}" Click="Close_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
