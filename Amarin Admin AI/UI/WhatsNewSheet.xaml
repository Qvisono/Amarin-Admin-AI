<UserControl x:Class="Amarin.UI.WhatsNewSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Sheet_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        «Что нового» (1.37.0) — своя карточка, а не общее уведомление: заметки стоят прямо в ней
        одним текстом, без рамки в рамке и второй прокрутки, версия — плашкой у заголовка, а не
        заголовком самих заметок.
    -->
    <Grid>
        <Border Background="{DynamicResource Overlay.Scrim}" MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border x:Name="Card" Style="{StaticResource DialogCard}" Width="520" MaxHeight="600" Padding="16,12,16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Height="26" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DialogTitle}" Text="{DynamicResource S.Updates.WhatsNewHeading}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource Bg.Card}" CornerRadius="4" Padding="6,1"
                                Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"/>
                        </Border>
                        <Button x:Name="CloseButton" Grid.Column="2" Width="24" Height="24" Cursor="Hand"
                                AutomationProperties.Name="{DynamicResource S.Common.Close}" Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                        <Path x:Name="Icon" Data="M0,0 L8,8 M8,0 L0,8"
                                              Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="9" Height="9" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Текст листается сам: карточка лежит в Viewbox, и длинные заметки иначе ужали бы её всю. -->
                    <RichTextBox x:Name="Notes" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                                 Background="Transparent" BorderThickness="0" Padding="0,0,8,0" Margin="0,0,-8,0"
                                 VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text.Secondary}"
                                 AutomationProperties.Name="{DynamicResource S.Updates.NotesTitle}"/>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageNote" Text="{DynamicResource S.Updates.WhatsNewText}" FontSize="11.5"
                                   Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="OkButton" Grid.Column="1" Style="{StaticResource DialogPrimaryButton}"
                                Content="{DynamicResource S.Updates.WhatsNewOk}" Click="Close_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
