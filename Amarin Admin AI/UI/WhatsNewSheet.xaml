<UserControl x:Class="Amarin.UI.WhatsNewSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Sheet_PreviewKeyDown">
    <UserControl.Resources>
        <!--
            Вид — концепта «Занавес» (3d-curtain.html) один в один: стеклянная карточка над сценой,
            его шрифты, цвета текста и состояния. Это рисунок одного окна, а не элементы темы: тема
            их не меняет, как не меняет она и саму сцену.
        -->
        <SolidColorBrush x:Key="Curtain.Fill" Color="#0B1638"/>
        <SolidColorBrush x:Key="Curtain.Line" Color="#F2F5FC"/>
        <SolidColorBrush x:Key="Curtain.Star" Color="#FF3D4F"/>
        <SolidColorBrush x:Key="Curtain.Shade" Color="#010410"/>

        <SolidColorBrush x:Key="WhatsNew.Glass" Color="#8F0A132A"/>
        <SolidColorBrush x:Key="WhatsNew.GlassLine" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.GlassTop" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Rule" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Text1" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Text2" Color="#C9D2E6"/>
        <SolidColorBrush x:Key="WhatsNew.Text3" Color="#8F9BB8"/>
        <SolidColorBrush x:Key="WhatsNew.Text4" Color="#67739A"/>
        <SolidColorBrush x:Key="WhatsNew.Chip" Color="#13FFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Hover" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.On" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Pill" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.PillOn" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Marker" Color="#56679A"/>
        <SolidColorBrush x:Key="WhatsNew.Code" Color="#E6D7A6"/>
        <SolidColorBrush x:Key="WhatsNew.CodeBack" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Thumb" Color="#29FFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.Ok" Color="#EEF2FA"/>
        <SolidColorBrush x:Key="WhatsNew.OkHover" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WhatsNew.OkPressed" Color="#D9E0EE"/>
        <SolidColorBrush x:Key="WhatsNew.OkText" Color="#0A1430"/>
        <SolidColorBrush x:Key="WhatsNew.FlagEdge" Color="#1AFFFFFF"/>
        <FontFamily x:Key="WhatsNew.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="WhatsNew.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="WhatsNew.Mono">Consolas</FontFamily>

        <!-- Четырёхконечная звезда концепта: у выбранного раздела в колонке и у заголовков разделов. -->
        <Geometry x:Key="WhatsNew.StarShape">M0,-1 L0.2,-0.2 L1,0 L0.2,0.2 L0,1 L-0.2,0.2 L-1,0 L-0.2,-0.2Z</Geometry>

        <!-- Флаги рисуются вручную; цвета у них свои, государственные. Рамка рисунка задана
             обрезкой: штрихи креста иначе раздвинули бы границы картинки за флаг. -->
        <DrawingImage x:Key="Flag.Ru">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 H9 V6 H0 Z">
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H9 V2 H0 Z"/>
                    <GeometryDrawing Brush="#0039A6" Geometry="M0,2 H9 V4 H0 Z"/>
                    <GeometryDrawing Brush="#D52B1E" Geometry="M0,4 H9 V6 H0 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="Flag.En">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 H60 V30 H0 Z">
                    <GeometryDrawing Brush="#012169" Geometry="M0,0 H60 V30 H0 Z"/>
                    <GeometryDrawing Geometry="M0,0 L60,30 M60,0 L0,30">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFFFFF" Thickness="6"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <DrawingGroup ClipGeometry="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z">
                        <GeometryDrawing Geometry="M0,0 L60,30 M60,0 L0,30">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#C8102E" Thickness="4"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup>
                    <GeometryDrawing Geometry="M30,0 V30 M0,15 H60">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFFFFF" Thickness="10"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M30,0 V30 M0,15 H60">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#C8102E" Thickness="6"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Тонкая полоса прокрутки концепта: 4 точки, бледный бегунок, без стрелок. -->
        <Style x:Key="WhatsNewScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource WhatsNew.Thumb}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WhatsNewScroll" TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource WhatsNewScrollBar}"
                                       HorizontalAlignment="Right" Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт колонки разделов (.toc a): звезда видна только у выбранного. -->
        <Style x:Key="WhatsNewTocItem" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Star" Data="{StaticResource WhatsNew.StarShape}" Fill="{StaticResource Curtain.Star}"
                                      Width="8" Height="8" Stretch="Uniform" Margin="0,0,7,0" Opacity="0"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource WhatsNew.Text3}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WhatsNew.Hover}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WhatsNew.Text2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WhatsNew.On}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WhatsNew.Text1}"/>
                                <Setter TargetName="Star" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка языка заметок (.lang button): флаг из Tag (нет флага — одна подпись) и название. -->
        <Style x:Key="WhatsNewLanguageButton" TargetType="RadioButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="WhatsNewLanguage"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="8,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid x:Name="Flag" Width="16" Height="11" Margin="0,0,6,0">
                                    <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,16,11" RadiusX="2" RadiusY="2"/>
                                        </Image.Clip>
                                    </Image>
                                    <Border Margin="-1" BorderBrush="{StaticResource WhatsNew.FlagEdge}" BorderThickness="1" CornerRadius="3"/>
                                </Grid>
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="Medium"
                                           Foreground="{StaticResource WhatsNew.Text3}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                <Setter TargetName="Flag" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WhatsNew.Text2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WhatsNew.PillOn}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WhatsNew.Text1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «Понятно» (.ok): светлая кнопка концепта. -->
        <Style x:Key="WhatsNewOkButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource WhatsNew.Ok}" CornerRadius="7" Padding="14,0">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource WhatsNew.OkText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WhatsNew.OkHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WhatsNew.OkPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        «Что нового» (1.37.0): сцена «Занавес» во весь слой и стеклянная карточка над ней. Слева —
        разделы заметок, справа — сами заметки; наведённый раздел подсвечен в колонке. Язык
        заметок — переключателем в подвале: перевод делает модель ИИ, если есть ключ.
    -->
    <Grid x:Name="Stage" SizeChanged="Stage_SizeChanged">
        <local:WhatsNewCurtain x:Name="Curtain" Fill="{StaticResource Curtain.Fill}" Line="{StaticResource Curtain.Line}"
                               Star="{StaticResource Curtain.Star}" Shade="{StaticResource Curtain.Shade}"
                               MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

        <!-- Карточка растрируется один раз (BitmapCache) и дальше только накладывается: фон под
             ней меняется каждый кадр, и без кэша WPF каждый кадр заново рисовал бы весь её текст. -->
        <Grid x:Name="Card" Width="680" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" TextElement.FontFamily="{StaticResource WhatsNew.Font}"
              UseLayoutRounding="True">
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/>
            </Grid.CacheMode>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale"/>
                    <TranslateTransform x:Name="CardShift"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Стекло: размытую сцену и тень под карточкой рисует сама сцена (SetGlass), здесь —
                 тонировка, рамка и светлая кромка сверху. -->
            <Grid x:Name="Glass">
                <Border Background="{StaticResource WhatsNew.Glass}" BorderBrush="{StaticResource WhatsNew.GlassLine}"
                        BorderThickness="1" CornerRadius="12"/>
                <Border Margin="1" BorderBrush="{StaticResource WhatsNew.GlassTop}" BorderThickness="0,1,0,0" CornerRadius="11"/>
            </Grid>

            <Grid Margin="17,15,17,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- .head -->
                <Grid Height="26" Margin="0,0,0,4">
                    <!-- Закрыть — «Понятно» в подвале, Esc и щелчок мимо: второй кнопки выхода в шапке нет. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Amarin Admin AI;component/jeklE-removebg-preview_1.ico" Width="18" Height="18"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource S.Updates.WhatsNewHeading}" FontSize="15"
                               FontWeight="SemiBold" FontFamily="{StaticResource WhatsNew.Display}"
                               Foreground="{StaticResource WhatsNew.Text1}" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="{StaticResource WhatsNew.Chip}" CornerRadius="4" Padding="6,4"
                            Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="11" FontWeight="Medium" LineHeight="11"
                                   LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource WhatsNew.Text3}"/>
                    </Border>
                </Grid>

                <!-- .lead -->
                <StackPanel x:Name="Lead" Grid.Row="1" Margin="0,0,0,8"/>

                <!-- .split -->
                <Grid x:Name="Split" Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TocColumn" Width="164"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TocBorder" BorderBrush="{StaticResource WhatsNew.Rule}" BorderThickness="0,0,1,0"
                            Padding="0,2,10,0" Margin="0,0,14,0">
                        <ScrollViewer x:Name="TocScroll" Style="{StaticResource WhatsNewScroll}" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="TocPanel"
                                        AutomationProperties.Name="{DynamicResource S.Updates.WhatsNewSections}"/>
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer x:Name="NotesScroll" Grid.Column="1" Style="{StaticResource WhatsNewScroll}"
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0"
                                  AutomationProperties.Name="{DynamicResource S.Updates.NotesTitle}">
                        <StackPanel x:Name="NotesPanel" Background="Transparent"/>
                    </ScrollViewer>
                </Grid>

                <!-- .foot -->
                <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource WhatsNew.Rule}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LanguageSwitch" Background="{StaticResource WhatsNew.Pill}" CornerRadius="7" Padding="2"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource S.Updates.WhatsNewLanguages}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NativeButton" Style="{StaticResource WhatsNewLanguageButton}"
                                             Margin="0,0,2,0" Checked="NativeButton_Checked"/>
                                <RadioButton x:Name="EnglishButton" Style="{StaticResource WhatsNewLanguageButton}"
                                             Content="English" Tag="{StaticResource Flag.En}" Checked="EnglishButton_Checked"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LanguageStatus" Grid.Column="1" FontSize="11.5" Foreground="{StaticResource WhatsNew.Text4}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="OkButton" Grid.Column="2" Style="{StaticResource WhatsNewOkButton}"
                                Content="{DynamicResource S.Updates.WhatsNewOk}" Click="Close_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
