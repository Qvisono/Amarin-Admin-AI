<UserControl x:Class="Amarin.UI.PlanReviewOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Cycle">
    <!-- Общие стили диалогов лежат в Resources.xaml: StaticResource из UserControl разбирается до
         того, как контрол вставлен в окно, и до ресурсов окна не дотягивается. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Overlay.Scrim}"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border x:Name="Card" Width="500" MinHeight="200" MaxHeight="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="20,18">
                <!-- Grid, а не StackPanel: длинный план уходит в прокрутку строки «*», а кнопки
                     в строке Auto остаются на карточке (см. памятку про модалки). -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource S.Plan.Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock x:Name="AgentText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SummaryText" FontSize="13.5" Foreground="{DynamicResource Text.Body}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="CountText" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer x:Name="StepsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,-8,0" Padding="0,0,8,0">
                        <ItemsControl x:Name="StepsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Bg.Card}" CornerRadius="8" Padding="10,8"
                                            Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Номер шага; у меняющих систему — отметка цветом предупреждения. -->
                                            <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                                                    Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ChangesSystem}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Status.WarningSurface}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Text.Body}"/>
                                                <TextBlock Text="{Binding Technical}" FontSize="11" TextWrapping="Wrap"
                                                           FontFamily="Consolas" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                                <TextBlock Text="{DynamicResource S.Plan.ChangesSystem}" FontSize="11"
                                                           Foreground="{DynamicResource Status.Warning}" Margin="0,3,0,0"
                                                           Visibility="{Binding ChangesVisibility}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Замечание к плану: появляется по «Поправить», уходит агенту дословно. -->
                    <StackPanel x:Name="RemarkPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource S.Plan.RemarkLabel}" FontSize="11.5"
                                   Foreground="{DynamicResource Text.Dim}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="8,6">
                            <TextBox x:Name="RemarkBox" MinHeight="54" MaxHeight="120" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" FontSize="12.5"
                                     Foreground="{DynamicResource Text.Body}" CaretBrush="{DynamicResource Text.Primary}"
                                     AutomationProperties.Name="{DynamicResource S.Plan.RemarkLabel}"
                                     TextChanged="RemarkBox_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <Border Height="1" Background="{DynamicResource Bg.Hover}" Margin="0,12,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CancelButton" Content="{DynamicResource S.Plan.Cancel}"
                                    Style="{StaticResource DialogSecondaryButton}" Click="CancelButton_Click"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="AmendButton" Content="{DynamicResource S.Plan.Amend}"
                                        Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0"
                                        Click="AmendButton_Click"/>
                                <Button x:Name="ExecuteButton" Content="{DynamicResource S.Plan.Execute}"
                                        Style="{StaticResource DialogPrimaryButton}" Click="ExecuteButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
