<UserControl x:Class="Amarin.UI.ReasoningPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="64" Height="28">
    <UserControl.Resources>
        <Style x:Key="ReasoningToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource Bg.Track}">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource Text.Dim}"
                                     HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EffortChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="8,0">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11"
                                       Foreground="{DynamicResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="OpenButton" Cursor="Hand" Focusable="False" ClickMode="Press">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" CornerRadius="6" Padding="6,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!--
                                Спидометр силы размышления. Геометрию обеих дуг строит код
                                (ReasoningPicker.UpdateGauge) из одного набора констант: дуга
                                уровня обязана лечь ровно на фоновую, а два независимых набора
                                чисел — в разметке и в коде — рано или поздно разъезжаются.
                                Прежний рисунок был полукругом радиусом 8 со стрелкой длиной 7.5,
                                прижатым к низу бокса: стрелка почти упиралась в дугу, а ось
                                стояла на полупиксельных координатах.
                            -->
                            <Grid x:Name="GaugeIcon" Width="20" Height="20" Margin="0,0,6,0"
                                  Visibility="Collapsed" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Path x:Name="GaugeTrack" Width="20" Height="20" Stretch="None"
                                      Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path x:Name="GaugeProgress" Width="20" Height="20" Stretch="None"
                                      Stroke="{DynamicResource Accent.Fill}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path x:Name="GaugeNeedle" Width="20" Height="20" Stretch="None"
                                      Data="M 10,12 L 10,7.4"
                                      Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="GaugeNeedleRotate" Angle="-110"
                                                         CenterX="10" CenterY="12"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Ellipse x:Name="GaugeHub" Width="3" Height="3"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="8.5,10.5,0,0"
                                         Fill="{DynamicResource Text.Secondary}"/>
                            </Grid>
                            <TextBlock x:Name="Label" Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="8" Height="4" Stretch="Uniform"
                                  Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Top"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=OpenButton, Mode=TwoWay}">
            <Border Width="240" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <Grid x:Name="DisableRow" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource S.Reasoning.Disable}" FontSize="12.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center"/>
                        <CheckBox x:Name="DisableToggle" HorizontalAlignment="Right"
                                  Style="{StaticResource ReasoningToggle}"
                                  Checked="DisableToggle_Changed"
                                  Unchecked="DisableToggle_Changed"/>
                    </Grid>
                    <TextBlock x:Name="AutoHint"
                               Text="{DynamicResource S.Reasoning.AutoHint}"
                               FontSize="11" Foreground="{DynamicResource Text.Faint}"
                               TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="EffortCaption" Text="{DynamicResource S.Reasoning.Effort}" FontSize="11"
                               Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,6"
                               Visibility="Collapsed"/>
                    <WrapPanel x:Name="EffortHost"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
