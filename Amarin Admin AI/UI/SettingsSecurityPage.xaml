<UserControl x:Class="Amarin.UI.SettingsSecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Страница — строки, как у остальных: режим доступа выпадающим списком с одной строкой о
        выбранном режиме, план, приватность. Список инструментов в сорок строк — подстраницей «›»:
        на первом уровне он закрывал собой всё остальное.
    -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid local:SettingsDrill.IsHost="True">
            <StackPanel Margin="20,14,20,16">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Security.Title}"/>

                <!-- ═══════════ РЕЖИМ ДОСТУПА ═══════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.ModeLabel}"/>
                        <TextBlock x:Name="ModeDesc" Style="{StaticResource SettingDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="ModeCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190" SelectedIndex="0"
                              AutomationProperties.Name="{DynamicResource S.Security.ModeLabel}"
                              SelectionChanged="ModeCombo_SelectionChanged">
                        <ComboBoxItem Tag="Normal" Content="{DynamicResource S.Access.Normal}"/>
                        <ComboBoxItem Tag="AskAll" Content="{DynamicResource S.Access.AskAll}"/>
                        <ComboBoxItem Tag="ReadOnly" Content="{DynamicResource S.Access.ReadOnly}"/>
                        <ComboBoxItem Tag="AlwaysApprove" Content="{DynamicResource S.Access.AlwaysApprove}"/>
                    </ComboBox>
                </Grid>

                <!-- ═══════════ ПЛАН ПЕРЕД ИЗМЕНЕНИЯМИ ═══════════ -->
                <Border Style="{StaticResource SettingsDivider}"/>
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,4,0,2" Text="{DynamicResource S.Security.PlanLabel}"/>
                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,0,10" Text="{DynamicResource S.Security.PlanDesc}"/>
                <Grid Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center"
                               Text="{DynamicResource S.Customize.AgentLight}"/>
                    <CheckBox x:Name="PlanLiteToggle" Tag="lite" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                              AutomationProperties.Name="{DynamicResource S.Customize.AgentLight}"
                              Checked="PlanTierToggle_Changed" Unchecked="PlanTierToggle_Changed"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center"
                               Text="{DynamicResource S.Customize.AgentFast}"/>
                    <CheckBox x:Name="PlanFastToggle" Tag="fast" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                              AutomationProperties.Name="{DynamicResource S.Customize.AgentFast}"
                              Checked="PlanTierToggle_Changed" Unchecked="PlanTierToggle_Changed"/>
                </Grid>
                <Grid>
                    <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center"
                               Text="{DynamicResource S.Customize.AgentHeavy}"/>
                    <CheckBox x:Name="PlanHeavyToggle" Tag="heavy" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                              AutomationProperties.Name="{DynamicResource S.Customize.AgentHeavy}"
                              Checked="PlanTierToggle_Changed" Unchecked="PlanTierToggle_Changed"/>
                </Grid>

                <!-- ═══════════ ПРИВАТНОСТЬ ═══════════ -->
                <Border Style="{StaticResource SettingsDivider}"/>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Security.DataLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.Encrypt}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.EncryptDesc}"/>
                    </StackPanel>
                    <CheckBox AutomationProperties.Name="{DynamicResource S.Security.Encrypt}" x:Name="EncryptChatsToggle" Grid.Column="1"
                              Style="{StaticResource SettingsToggle}"
                              Checked="EncryptChatsToggle_Changed" Unchecked="EncryptChatsToggle_Changed"/>
                </Grid>
                <Border Style="{StaticResource SettingsDivider}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.AutoLock}"/>
                        <TextBlock x:Name="AutoLockDesc" Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.AutoLockDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="AutoLockCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="140"
                              AutomationProperties.Name="{DynamicResource S.Security.AutoLock}"
                              SelectionChanged="AutoLockCombo_SelectionChanged">
                        <ComboBoxItem Tag="0" Content="{DynamicResource S.Security.AutoLockOff}"/>
                        <ComboBoxItem Tag="5"/>
                        <ComboBoxItem Tag="15"/>
                        <ComboBoxItem Tag="30"/>
                        <ComboBoxItem Tag="60"/>
                    </ComboBox>
                </Grid>
                <Border Style="{StaticResource SettingsDivider}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,16,0"
                               Text="{DynamicResource S.Security.LockNowTitle}"/>
                    <Button x:Name="LockNowButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource S.Security.LockNow}" Click="LockNowButton_Click"/>
                </Grid>

                <!-- ═══════════ ИНСТРУМЕНТЫ ═══════════ -->
                <Border Style="{StaticResource SettingsDivider}"/>
                <Button x:Name="ToolsLinkRow" Style="{StaticResource SettingsLinkRow}"
                        local:SettingsDrill.Opens="{Binding ElementName=ToolsSub}"
                        AutomationProperties.Name="{DynamicResource S.Security.ToolsLabel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.ToolsLabel}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.ToolsDesc}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ═══════════ ПОДСТРАНИЦА: ИНСТРУМЕНТЫ ═══════════ -->
            <StackPanel x:Name="ToolsSub" Margin="20,14,20,16" Visibility="Collapsed">
                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Security.ToolsLabel}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,16,0" VerticalAlignment="Center"
                               Text="{DynamicResource S.Security.ToolsHint}"/>
                    <Button x:Name="EnableAllToolsButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource S.Security.EnableAll}" Click="EnableAllToolsButton_Click"/>
                </Grid>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,14,0,6" Text="{DynamicResource S.Security.ChatGroup}"/>
                <StackPanel x:Name="ChatToolRows"/>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,14,0,6" Text="{DynamicResource S.Security.AgentGroup}"/>
                <StackPanel x:Name="AgentToolRows"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
