<UserControl x:Class="Amarin.UI.SettingsSecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Страница — строки, как у остальных: режим доступа выпадающим списком с одной строкой о
        выбранном режиме, план, приватность. Список инструментов в сорок строк — подстраницей «›»:
        на первом уровне он закрывал собой всё остальное.
    -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid local:SettingsDrill.IsHost="True">
            <StackPanel Margin="20,14,20,16">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Security.Title}"/>

                <!-- ═══════════ РЕЖИМ ДОСТУПА ═══════════ -->
                <Border Style="{StaticResource SettingsGroup}">
                    <Grid Style="{StaticResource GroupRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.ModeLabel}"/>
                            <TextBlock x:Name="ModeDesc" Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <ComboBox x:Name="ModeCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" MinWidth="190" SelectedIndex="0"
                                  AutomationProperties.Name="{DynamicResource S.Security.ModeLabel}"
                                  SelectionChanged="ModeCombo_SelectionChanged">
                            <ComboBoxItem Tag="Normal" Content="{DynamicResource S.Access.Normal}"/>
                            <ComboBoxItem Tag="AskAll" Content="{DynamicResource S.Access.AskAll}"/>
                            <ComboBoxItem Tag="ReadOnly" Content="{DynamicResource S.Access.ReadOnly}"/>
                            <ComboBoxItem Tag="AlwaysApprove" Content="{DynamicResource S.Access.AlwaysApprove}"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!--
                    ═══════════ ЗАЩИТА: SYNGUARD ═══════════
                    Переехал сюда с «Моделей»: это защита, а не выбор модели. События тумблера и пикеров
                    подписывает главное окно (WireSecurityPage) — логика слотов моделей живёт там.
                -->
                <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource S.Customize.Protection}"/>
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Grid Style="{StaticResource GroupRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <!-- Имя защитника не переводится: это название, а не подпись. -->
                                <TextBlock Style="{StaticResource SettingTitle}" Text="SynGuard"/>
                                <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="{DynamicResource S.Customize.GuardDesc}"/>
                                <!-- Модель защитника: голым ID и мелко — она нужна редко. -->
                                <ToggleButton x:Name="SynGuardModelToggle" Style="{StaticResource InlineExpanderToggle}"
                                              HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock x:Name="SynGuardModelLabel" FontSize="11"
                                               Foreground="{DynamicResource Text.Faint}"
                                               VerticalAlignment="Center"/>
                                </ToggleButton>
                            </StackPanel>
                            <CheckBox x:Name="SynGuardToggle" AutomationProperties.Name="SynGuard" Grid.Column="1"
                                      Style="{StaticResource SettingsToggle}"/>
                        </Grid>

                        <!-- Раскрытый выбор — ещё одной строкой той же группы, а не рамкой в рамке. -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=SynGuardModelToggle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource GroupDivider}"/>
                            <Grid Style="{StaticResource GroupRowDense}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitle}" TextWrapping="Wrap"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Text="{DynamicResource S.Customize.GuardModel}"/>
                                <local:ReasoningPicker x:Name="SynGuardReasoningPicker" Grid.Column="1"
                                                       Height="28" MinWidth="72" ShowGaugeIcon="True"
                                                       Margin="8,0" VerticalAlignment="Center"/>
                                <local:ModelPickerField x:Name="SynGuardModelPicker" Grid.Column="2"
                                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════ ПЛАН ПЕРЕД ИЗМЕНЕНИЯМИ ═══════════ -->
                <!-- Пояснение одно на группу — под её подписью, а не в каждой из трёх строк. -->
                <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource S.Security.PlanLabel}"/>
                <TextBlock Style="{StaticResource GroupNote}" Text="{DynamicResource S.Security.PlanDesc}"/>
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Grid Style="{StaticResource GroupRow}">
                            <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center"
                                       Text="{DynamicResource S.Customize.AgentLight}"/>
                            <CheckBox x:Name="PlanLiteToggle" Tag="lite" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                                      AutomationProperties.Name="{DynamicResource S.Customize.AgentLight}"
                                      Checked="PlanTierToggle_Changed" Unchecked="PlanTierToggle_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource GroupDivider}"/>
                        <Grid Style="{StaticResource GroupRow}">
                            <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center"
                                       Text="{DynamicResource S.Customize.AgentFast}"/>
                            <CheckBox x:Name="PlanFastToggle" Tag="fast" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                                      AutomationProperties.Name="{DynamicResource S.Customize.AgentFast}"
                                      Checked="PlanTierToggle_Changed" Unchecked="PlanTierToggle_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource GroupDivider}"/>
                        <Grid Style="{StaticResource GroupRow}">
                            <TextBlock Style="{StaticResource SettingTitle}" VerticalAlignment="Center"
                                       Text="{DynamicResource S.Customize.AgentHeavy}"/>
                            <CheckBox x:Name="PlanHeavyToggle" Tag="heavy" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                                      AutomationProperties.Name="{DynamicResource S.Customize.AgentHeavy}"
                                      Checked="PlanTierToggle_Changed" Unchecked="PlanTierToggle_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    ═══════════ УПРАВЛЕНИЕ КОМПЬЮТЕРОМ (1.36.0) ═══════════
                    Здесь, а не в «Моделях»: это разрешение агенту трогать окна, а снимки экрана
                    при нём уходят провайдеру модели. Включается без вопроса, с одним уведомлением.
                -->
                <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource S.Security.ComputerLabel}"/>
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Grid Style="{StaticResource GroupRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.Computer}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.ComputerDesc}"/>
                            </StackPanel>
                            <CheckBox AutomationProperties.Name="{DynamicResource S.Security.Computer}" x:Name="ComputerControlToggle" Grid.Column="1"
                                      Style="{StaticResource SettingsToggle}"
                                      Checked="ComputerControlToggle_Changed" Unchecked="ComputerControlToggle_Changed"/>
                        </Grid>
                        <!-- Браузер агента (1.37.0): рядом с мышью — то же разрешение, только для сайтов. -->
                        <Border Style="{StaticResource GroupDivider}"/>
                        <Grid Style="{StaticResource GroupRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.Browser}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.BrowserDesc}"/>
                            </StackPanel>
                            <CheckBox AutomationProperties.Name="{DynamicResource S.Security.Browser}" x:Name="AgentBrowserToggle" Grid.Column="1"
                                      Style="{StaticResource SettingsToggle}"
                                      Checked="AgentBrowserToggle_Changed" Unchecked="AgentBrowserToggle_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    ═══════════ ИНСТРУМЕНТЫ И ИСТОЧНИКИ ЗАГРУЗКИ ═══════════
                    Белый список загрузок — здесь, а не в «Данных»: он решает, откуда агенту качать файлы.
                -->
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <!-- Приватность (1.37.0): шифрование, провайдеры без хранения данных, временный чат. -->
                        <Button x:Name="PrivacyLinkRow" Style="{StaticResource SettingsLinkRow}" Margin="-8,5"
                                local:SettingsDrill.Opens="{Binding ElementName=PrivacySub}"
                                AutomationProperties.Name="{DynamicResource S.Security.DataLabel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.DataLabel}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.PrivacyDesc}"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource GroupDivider}"/>
                        <Button x:Name="ToolsLinkRow" Style="{StaticResource SettingsLinkRow}" Margin="-8,5"
                                local:SettingsDrill.Opens="{Binding ElementName=ToolsSub}"
                                AutomationProperties.Name="{DynamicResource S.Security.ToolsLabel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.ToolsLabel}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.ToolsDesc}"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource GroupDivider}"/>
                        <Button x:Name="SourcesLinkRow" Style="{StaticResource SettingsLinkRow}" Margin="-8,5"
                                local:SettingsDrill.Opens="{Binding ElementName=SourcesSub}"
                                AutomationProperties.Name="{DynamicResource S.Security.SourcesLabel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.SourcesLabel}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.SourcesDesc}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════ ПОДСТРАНИЦА: ИНСТРУМЕНТЫ ═══════════ -->
            <!-- Строки собирает код (AddRows) — черта между ними та же, что у групп. -->
            <StackPanel x:Name="ToolsSub" Margin="20,14,20,16" Visibility="Collapsed">
                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Security.ToolsLabel}"/>
                <Grid Margin="4,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,16,0" VerticalAlignment="Center"
                               Text="{DynamicResource S.Security.ToolsHint}"/>
                    <Button x:Name="EnableAllToolsButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource S.Security.EnableAll}" Click="EnableAllToolsButton_Click"/>
                </Grid>

                <TextBlock Style="{StaticResource GroupLabel}" Margin="4,14,0,7" Text="{DynamicResource S.Security.ChatGroup}"/>
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel x:Name="ChatToolRows"/>
                </Border>

                <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource S.Security.AgentGroup}"/>
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel x:Name="AgentToolRows"/>
                </Border>
            </StackPanel>

            <!--
                ═══════════ ПОДСТРАНИЦА: ИСТОЧНИКИ ЗАГРУЗКИ ═══════════
                Своей прокрутки у списка нет: на подстранице ему некого теснить, а вложенный список
                забирал бы колесо у страницы. Диалог добавления и запись — у главного окна.
            -->
            <StackPanel x:Name="SourcesSub" Margin="20,14,20,16" Visibility="Collapsed">
                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Security.SourcesLabel}"/>
                <!-- Белый список можно выключить (1.37.0): тогда список ниже приглушён, но не стирается. -->
                <Border Style="{StaticResource SettingsGroup}">
                    <Grid Style="{StaticResource GroupRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.AnySite}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.AnySiteDesc}"/>
                        </StackPanel>
                        <CheckBox AutomationProperties.Name="{DynamicResource S.Security.AnySite}" x:Name="DownloadAnySiteToggle" Grid.Column="1"
                                  Style="{StaticResource SettingsToggle}"
                                  Checked="DownloadAnySiteToggle_Changed" Unchecked="DownloadAnySiteToggle_Changed"/>
                    </Grid>
                </Border>
                <!-- Разрешённые сайты: заголовок строкой группы, список — под чертой в ней же. -->
                <Border x:Name="AllowlistGroup" Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Grid Style="{StaticResource GroupRow}">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,34,0">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Data.Allowlist}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Data.AllowlistDesc}"/>
                            </StackPanel>
                            <Button x:Name="AddDomainButton" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="+" Width="26" Padding="0" FontSize="14"
                                    AutomationProperties.Name="{DynamicResource S.Data.Allowlist}"
                                    Click="AddDomainButton_Click"/>
                        </Grid>
                        <Border Style="{StaticResource GroupDivider}"/>
                        <!-- Поля строк списка (8) — внутрь группы, чтобы адрес стоял по краю подписи. -->
                        <Grid Margin="-8,4,-8,4">
                            <TextBlock x:Name="AllowedDomainsEmpty" Margin="8,7"
                                       Text="{DynamicResource S.Data.AllowlistEmpty}"
                                       FontSize="12" Foreground="{DynamicResource Text.Faint}"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="AllowedDomainsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,5">
                                            <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       VerticalAlignment="Center" Margin="0,0,30,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                                    Content="–" Width="22" Height="22" Padding="0"
                                                    Tag="{Binding}" ToolTip="{DynamicResource S.Data.AllowlistRemove}"
                                                    AutomationProperties.Name="{DynamicResource S.Data.AllowlistRemove}"
                                                    Click="RemoveDomainButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════ ПОДСТРАНИЦА: ПРИВАТНОСТЬ (1.37.0) ═══════════ -->
            <StackPanel x:Name="PrivacySub" Margin="20,14,20,16" Visibility="Collapsed">
                <Button Style="{StaticResource SubPageBack}" Content="{DynamicResource S.Security.DataLabel}"/>
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Grid Style="{StaticResource GroupRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.Encrypt}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.EncryptDesc}"/>
                            </StackPanel>
                            <CheckBox AutomationProperties.Name="{DynamicResource S.Security.Encrypt}" x:Name="EncryptChatsToggle" Grid.Column="1"
                                      Style="{StaticResource SettingsToggle}"
                                      Checked="EncryptChatsToggle_Changed" Unchecked="EncryptChatsToggle_Changed"/>
                        </Grid>
                        <!-- Приватность OpenRouter и срок временного чата (1.37.0). -->
                        <Border Style="{StaticResource GroupDivider}"/>
                        <Grid Style="{StaticResource GroupRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.NoRetention}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.NoRetentionDesc}"/>
                            </StackPanel>
                            <CheckBox AutomationProperties.Name="{DynamicResource S.Security.NoRetention}" x:Name="NoRetentionToggle" Grid.Column="1"
                                      Style="{StaticResource SettingsToggle}"
                                      Checked="NoRetentionToggle_Changed" Unchecked="NoRetentionToggle_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource GroupDivider}"/>
                        <Grid Style="{StaticResource GroupRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{DynamicResource S.Security.TemporaryUntilClose}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.TemporaryUntilCloseDesc}"/>
                            </StackPanel>
                            <CheckBox AutomationProperties.Name="{DynamicResource S.Security.TemporaryUntilClose}" x:Name="TemporaryUntilCloseToggle" Grid.Column="1"
                                      Style="{StaticResource SettingsToggle}"
                                      Checked="TemporaryUntilCloseToggle_Changed" Unchecked="TemporaryUntilCloseToggle_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
