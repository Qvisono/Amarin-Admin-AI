<UserControl x:Class="Amarin.UI.SettingsSecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Стили настроек объявлены локально в SettingsOverlay.Resources главного окна, и
        StaticResource из этого файла их не достанет: поиск идёт по словарям разметки, а не по
        дереву. Поэтому нужные ключи повторены здесь — тем же приёмом, что у страниц Key, Info и
        Instructions.
    -->
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="0,18,0,4"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- Карточка выбора — копия DialogChoiceCard из Resources.xaml. -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тумблер — копия SettingsToggle из настроек главного окна. -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource Bg.Track}">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource Text.Dim}"
                                     HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.Tertiary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,14,20,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Security.Title}"/>
            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.Subtitle}" Margin="0,4,0,0"/>

            <!-- ═══════════ РЕЖИМ ДОСТУПА ═══════════ -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Security.ModeLabel}"/>
            <StackPanel x:Name="ModeCards" Margin="0,6,0,0">
                <RadioButton x:Name="ModeNormal" Tag="Normal" GroupName="AccessMode"
                             Style="{StaticResource ChoiceCard}" Checked="ModeCard_Checked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingTitle}" FontWeight="SemiBold"
                                   Text="{DynamicResource S.Access.Normal}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Access.NormalDesc}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeAskAll" Tag="AskAll" GroupName="AccessMode"
                             Style="{StaticResource ChoiceCard}" Checked="ModeCard_Checked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingTitle}" FontWeight="SemiBold"
                                   Text="{DynamicResource S.Access.AskAll}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Access.AskAllDesc}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeReadOnly" Tag="ReadOnly" GroupName="AccessMode"
                             Style="{StaticResource ChoiceCard}" Checked="ModeCard_Checked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingTitle}" FontWeight="SemiBold"
                                   Text="{DynamicResource S.Access.ReadOnly}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Access.ReadOnlyDesc}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeAlwaysApprove" Tag="AlwaysApprove" GroupName="AccessMode"
                             Style="{StaticResource ChoiceCard}" Checked="ModeCard_Checked">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource Status.Warning}"/>
                            <TextBlock Style="{StaticResource SettingTitle}" FontWeight="SemiBold"
                                       Text="{DynamicResource S.Access.AlwaysApprove}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Access.AlwaysApproveDesc}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- ═══════════ ИНСТРУМЕНТЫ ═══════════ -->
            <Grid Margin="0,18,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Security.ToolsLabel}"
                               Margin="0"/>
                    <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Security.ToolsDesc}"/>
                </StackPanel>
                <Button x:Name="EnableAllToolsButton" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Content="{DynamicResource S.Security.EnableAll}" Click="EnableAllToolsButton_Click"/>
            </Grid>

            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource S.Security.ChatGroup}"/>
            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="8" Padding="12,4">
                <StackPanel x:Name="ChatToolRows"/>
            </Border>

            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource S.Security.AgentGroup}"/>
            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="8" Padding="12,4">
                <StackPanel x:Name="AgentToolRows"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
