<UserControl x:Class="Amarin.UI.DeferredPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Amarin.Core;assembly=Amarin.Core">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
                <ResourceDictionary Source="DeferredIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Отметка состояния — та же точка, что у расписания. -->
            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="7"/>
                <Setter Property="Height" Value="7"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{DynamicResource Text.Faint}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Ok">
                        <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Attention">
                        <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Failed">
                        <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Running">
                        <Setter Property="Fill" Value="{DynamicResource Accent.Fill}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Знак вида задачи в плитке карточки. -->
            <Style x:Key="KindGlyph" TargetType="Path">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{DynamicResource Text.Muted}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Data" Value="{StaticResource DeferredIcon.Reminder}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DeferredKind.Reminder}">
                        <Setter Property="Stroke" Value="{DynamicResource Accent.Fill}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DeferredKind.Agent}">
                        <Setter Property="Data" Value="{StaticResource DeferredIcon.Agent}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DeferredKind.Command}">
                        <Setter Property="Data" Value="{StaticResource DeferredIcon.Command}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DeferredKind.RestorePrograms}">
                        <Setter Property="Data" Value="{StaticResource DeferredIcon.RestorePrograms}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Высота и одна строка — общие с остальными вкладками Automation, иначе список прыгает. -->
        <Grid Height="28" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource SettingDesc}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="{DynamicResource S.Deferred.Desc}"/>
        </Grid>

        <!-- Планировщик отказал: задачи сработают, только пока программа открыта. -->
        <TextBlock x:Name="WakeProblemText" Grid.Row="1" FontSize="11.5" Margin="1,-4,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource Status.Warning}" Visibility="Collapsed"
                   Text="{DynamicResource S.Deferred.WakeFailed}"/>

        <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="WaitingTitle" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                           Text="{DynamicResource S.Deferred.Waiting}" Visibility="Collapsed"/>
                <ItemsControl x:Name="WaitingItems" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,11" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardGlyphTile}">
                                        <Path Style="{StaticResource KindGlyph}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}"
                                                   ToolTip="{Binding Detail}"/>
                                        <TextBlock Text="{Binding When}" FontSize="11.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Text.Dim}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse Style="{StaticResource StatusDot}"/>
                                            <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding ChatId}"
                                                Click="OpenChat_Click" Visibility="{Binding ChatVisibility}"
                                                ToolTip="{DynamicResource S.Deferred.OpenChat}"
                                                AutomationProperties.Name="{DynamicResource S.Deferred.OpenChat}"
                                                Margin="0,0,2,0">
                                            <Path Style="{StaticResource IconGlyph}"
                                                  Data="M1,2 L13,2 L13,10 L6,10 L3,13 L3,10 L1,10 Z"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding Id}"
                                                Click="Cancel_Click" Visibility="{Binding CancelVisibility}"
                                                ToolTip="{DynamicResource S.Deferred.Cancel}"
                                                AutomationProperties.Name="{DynamicResource S.Deferred.Cancel}"
                                                Margin="0,0,4,0">
                                            <Path Style="{StaticResource IconGlyph}" Width="9" Height="9"
                                                  Data="M1,1 L9,9 M9,1 L1,9"/>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Tag="{Binding Id}"
                                                Click="Action_Click" Visibility="{Binding ActionVisibility}"
                                                Content="{Binding ActionText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyState" Style="{StaticResource SettingDesc}" Margin="0,2,0,0"
                           Foreground="{DynamicResource Text.Faint}" Visibility="Collapsed"
                           Text="{DynamicResource S.Deferred.Empty}"/>

                <TextBlock x:Name="HistoryTitle" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"
                           Text="{DynamicResource S.Deferred.History}" Visibility="Collapsed"/>
                <ItemsControl x:Name="HistoryItems" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" ToolTip="{Binding Detail}">
                                <Ellipse Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
