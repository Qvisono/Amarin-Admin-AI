<Window x:Class="Amarin.UI.ComputerBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        Title="Amarin">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Кнопки плашки — кнопки диалогов, только ниже: плашка у края экрана, а не окно. -->
            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
            <Style x:Key="BarPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Поля под тень, как у карточек в углу: тень видна внутри своего окна. -->
    <Border x:Name="Card" Width="440" Margin="18,12,18,22"
            Background="{DynamicResource Bg.Panel}"
            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
            CornerRadius="12" Padding="14,10,10,10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка: кто держит мышь или о чём вопрос, справа — номер шага. -->
            <TextBlock x:Name="HeadingText" Grid.Row="0" Grid.Column="0"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="StepText" Grid.Row="0" Grid.Column="1"
                       FontSize="12" Margin="12,0,4,0"
                       Foreground="{DynamicResource Text.Tertiary}"/>

            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BodyText" Grid.Column="0"
                           FontSize="13.5" TextWrapping="Wrap" MaxHeight="58"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Primary}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource BarPrimaryButton}" Click="PrimaryButton_Click"/>
                    <Button x:Name="SecondaryButton" Style="{StaticResource BarButton}" Click="SecondaryButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
