<!--
    Значки отложенных задач: вид задачи (вкладка «Отложенные») и карточка напоминания.

    Рисуются по правилам значков навигации (SettingsNavIcons.xaml): контур на сетке 24×24 одним
    пером, круглые концы и углы, без заливок; «M24,24z M0,0z» в начале держит размер сетки, и
    Stretch="Uniform" сжимает знак вместе с полями. Цвет даёт место, где знак стоит, а не словарь.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Напоминание — колокольчик. -->
    <Geometry x:Key="DeferredIcon.Reminder">M24,24z M0,0z M7,10.5 A5,5 0 0 1 17,10.5 L17,14.2 L18.8,17.3 L5.2,17.3 L7,14.2 Z M10.2,19.8 A1.9,1.9 0 0 0 13.8,19.8</Geometry>
    <!-- Задача агенту — та же звезда, что у раздела «Модели». -->
    <Geometry x:Key="DeferredIcon.Agent">M24,24z M0,0z M10.5,6.5 Q11.5,12.5 17.5,13.5 Q11.5,14.5 10.5,20.5 Q9.5,14.5 3.5,13.5 Q9.5,12.5 10.5,6.5 Z M17.5,3.5 L17.5,8.5 M15,6 L20,6</Geometry>
    <!-- Команда — окно консоли с приглашением. -->
    <Geometry x:Key="DeferredIcon.Command">M24,24z M0,0z M5.5,5 L18.5,5 A2,2 0 0 1 20.5,7 L20.5,17 A2,2 0 0 1 18.5,19 L5.5,19 A2,2 0 0 1 3.5,17 L3.5,7 A2,2 0 0 1 5.5,5 Z M7.5,9.5 L10,12 L7.5,14.5 M12.5,14.5 L16.5,14.5</Geometry>
    <!-- Возврат программ — два окна, одно за другим. -->
    <Geometry x:Key="DeferredIcon.RestorePrograms">M24,24z M0,0z M8,8.5 L8,6 A1.5,1.5 0 0 1 9.5,4.5 L18.5,4.5 A1.5,1.5 0 0 1 20,6 L20,14 A1.5,1.5 0 0 1 18.5,15.5 L16,15.5 M5.5,8.5 L14.5,8.5 A1.5,1.5 0 0 1 16,10 L16,18 A1.5,1.5 0 0 1 14.5,19.5 L5.5,19.5 A1.5,1.5 0 0 1 4,18 L4,10 A1.5,1.5 0 0 1 5.5,8.5 Z M4,11.5 L16,11.5</Geometry>
    <!-- Выполнена — галочка. -->
    <Geometry x:Key="DeferredIcon.Done">M24,24z M0,0z M5.5,12.5 L10,17 L18.5,7.5</Geometry>
    <!-- Не удалась — восклицательный знак в круге. -->
    <Geometry x:Key="DeferredIcon.Failed">M24,24z M0,0z M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 M12,7.5 L12,12.8 M12,16.2 L12,16.5</Geometry>
    <!-- Прервалась, ждёт срока — часы. -->
    <Geometry x:Key="DeferredIcon.Clock">M24,24z M0,0z M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 M12,7.5 L12,12 L15,14</Geometry>
</ResourceDictionary>
