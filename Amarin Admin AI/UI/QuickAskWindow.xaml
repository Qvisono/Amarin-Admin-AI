<Window x:Class="Amarin.UI.QuickAskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="580"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Title="Amarin Admin AI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="QuickIconButton" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!--
        Быстрый вопрос (1.37.0): строка ввода поверх всех окон по глобальной клавише, под ней —
        ответ и «Открыть в чате». Поля вокруг карточки — под тень: тень видна внутри своего окна.
    -->
    <Grid x:Name="Root" Margin="10,8,10,22">
        <Border x:Name="Card" Background="{DynamicResource Bg.Sheet}" BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1" CornerRadius="12" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка вопроса: Enter спрашивает, Shift+Enter переносит строку, Esc прячет. -->
                <Grid MinHeight="46" Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M8,1 L9.6,6.4 L15,8 L9.6,9.6 L8,15 L6.4,9.6 L1,8 L6.4,6.4 Z" Stroke="{DynamicResource Text.Muted}"
                          StrokeThickness="1.3" StrokeLineJoin="Round" Width="16" Height="16" Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                    <TextBox x:Name="Input" Grid.Column="1" Style="{StaticResource DialogInput}" FontSize="14"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" Margin="0,12"
                             VerticalScrollBarVisibility="Auto"
                             Tag="{DynamicResource S.QuickAsk.Placeholder}"
                             AutomationProperties.Name="{DynamicResource S.QuickAsk.Title}"
                             PreviewKeyDown="Input_PreviewKeyDown"/>
                    <Button Grid.Column="2" Style="{StaticResource QuickIconButton}" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="Close_Click"
                            ToolTip="{DynamicResource S.Common.Close}" AutomationProperties.Name="{DynamicResource S.Common.Close}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Ответ: появляется с первым словом; пока слов нет — строка состояния. -->
                <Border x:Name="AnswerArea" Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <StackPanel Margin="16,8,8,4">
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Text.Faint}"
                                   TextWrapping="Wrap" Margin="0,2,8,6"/>
                        <RichTextBox x:Name="Answer" IsReadOnly="True" IsDocumentEnabled="True" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0" Padding="0,0,8,0" Margin="0,0,0,6"
                                     MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                     Foreground="{DynamicResource Text.Body}"
                                     AutomationProperties.Name="{DynamicResource S.QuickAsk.Title}"/>
                    </StackPanel>
                </Border>

                <!-- Подвал: модель и цена, «Копировать» и «Открыть в чате». -->
                <Border x:Name="Footer" Grid.Row="2" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <Grid Height="38" Margin="16,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MetaText" FontSize="11.5" Foreground="{DynamicResource Text.Faint}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource QuickIconButton}"
                                Click="Copy_Click" ToolTip="{DynamicResource S.Common.Copy}"
                                AutomationProperties.Name="{DynamicResource S.Common.Copy}">
                            <Path Data="M5,5 L13,5 L13,13 L5,13 Z M3,11 L3,3 L11,3" Stroke="{DynamicResource Text.Dim}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="OpenInChatButton" Grid.Column="2" Style="{StaticResource DialogSecondaryButton}"
                                Height="26" Padding="12,0" Margin="6,0,0,0" Content="{DynamicResource S.QuickAsk.OpenInChat}"
                                Click="OpenInChat_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
