<UserControl x:Class="Amarin.UI.ModelPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AIlogos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PickerTab" TargetType="RadioButton">
                <Setter Property="GroupName" Value="ModelPickerTabs"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="11" Foreground="#FF9A9A9A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FF232323"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FF2E2E2E"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PickerGroupHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#FF5A5A5A"/>
                <Setter Property="Margin" Value="8,8,6,3"/>
            </Style>

            <Style x:Key="ModelItem" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="7,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FF1F1F1F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FF2A2A2A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModelName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FFD8D8D8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="SelectedCheck" TargetType="Path">
                <Setter Property="Data" Value="M0,3.5 L3,6.5 L8,0"/>
                <Setter Property="Stroke" Value="#FFEAEAEA"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Width" Value="9"/>
                <Setter Property="Height" Value="7"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0,2,0"/>
            </Style>

            <Style x:Key="FilterChip" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="#FF1F1F1F" BorderBrush="#FF2E2E2E"
                                    BorderThickness="1" CornerRadius="5" Padding="8,0">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="10.5" Foreground="#FF9A9A9A"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FF242424"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FFEAEAEA"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#FFEAEAEA"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="#FF0E0E0E"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Width="250" Height="320" Background="#FF161616" BorderBrush="#FF2A2A2A"
            BorderThickness="1" CornerRadius="10" Padding="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#FF1B1B1B" BorderBrush="#FF262626" BorderThickness="1"
                    CornerRadius="7" Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="TabRecommended" Style="{StaticResource PickerTab}"
                                 Content="Рекомендованы" IsChecked="True"/>
                    <RadioButton x:Name="TabAll" Grid.Column="1" Style="{StaticResource PickerTab}"
                                 Content="Все"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="RecommendedScroll" Grid.Row="1" Margin="0,2,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=TabRecommended}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="0,2,0,2">
                    <Button x:Name="AutoItem" Style="{StaticResource ModelItem}"
                            ToolTip="Маршрутизатор сам выберет модель"
                            Click="AutoItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AutoLogo" Width="15" Height="15"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="Авто"/>
                            <Path x:Name="AutoCheck" Grid.Column="2" Style="{StaticResource SelectedCheck}"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="RecommendedGroups"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="AllTab" Grid.Row="1" Margin="0,6,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=TabAll}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="24" CornerRadius="5" Background="#FF1F1F1F"
                            BorderBrush="#FF2E2E2E" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="ModelSearchBox"
                                     Background="Transparent" BorderThickness="0" Padding="7,0"
                                     VerticalContentAlignment="Center" FontSize="11"
                                     Foreground="#FFEAEAEA" CaretBrush="#FFEAEAEA"
                                     TextChanged="ModelSearchBox_TextChanged"/>
                            <TextBlock Text="Поиск..." FontSize="11" Foreground="#FF6E6E6E"
                                       Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ModelSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ToggleButton x:Name="VisionChip" Grid.Column="1" Style="{StaticResource FilterChip}"
                                  Content="Vision" Click="FilterChip_Click"/>
                    <ToggleButton x:Name="CodeChip" Grid.Column="2" Style="{StaticResource FilterChip}"
                                  Content="Code" Click="FilterChip_Click"/>
                </Grid>

                <ScrollViewer x:Name="AllScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                    <StackPanel x:Name="AllItems" Margin="0,0,0,2"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
