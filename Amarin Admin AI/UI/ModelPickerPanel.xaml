<UserControl x:Class="Amarin.UI.ModelPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Подсказка строки модели: карточка общей подсказки, но без стрелки сверху —
                 она встаёт сбоку от плашки, а не под строкой, и показывать стрелке не на что.
                 Мышь её не ловит: подсказка не должна задерживать сама себя под курсором. -->
            <Style x:Key="ModelSideTip" TargetType="ToolTip">
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Body}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="MaxWidth" Value="320"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{DynamicResource Bg.Card}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type system:String}">
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="15"
                                                       LineStackingStrategy="BlockLineHeight"/>
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кнопка провайдера в левом столбце. Форма взята у SettingsNavItem: это тот же
                 жест выбора раздела, и расходиться им незачем. -->
            <Style x:Key="ProviderItem" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PickerGroupHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                <Setter Property="Margin" Value="8,2,6,4"/>
            </Style>

            <!-- Подсказки строк ждут дольше общих и не цепляются друг за другом
                 (BetweenShowDelay=0): прежде, стоило показаться одной, соседние выскакивали
                 мгновенно, пока курсор ехал к нужной модели, и закрывали собой список.
                 Встают они сбоку от плашки — это делает ModelItem_ToolTipOpening. -->
            <Style x:Key="ModelItem" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
                <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                <EventSetter Event="ToolTipOpening" Handler="ModelItem_ToolTipOpening"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="7,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка ключа в правом столбце: показывается только имя, сам ключ здесь не нужен. -->
            <Style x:Key="KeyItem" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="7,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModelName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="SelectedCheck" TargetType="Path">
                <Setter Property="Data" Value="M0,3.5 L3,6.5 L8,0"/>
                <Setter Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Width" Value="9"/>
                <Setter Property="Height" Value="7"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0,2,0"/>
            </Style>

            <!-- Строка модели. Шаблоном, а не сборкой в коде: только так VirtualizingStackPanel
                 может переиспользовать контейнеры, и список из трёхсот моделей перестаёт
                 строиться целиком на каждый символ в поиске. -->
            <DataTemplate x:Key="ModelRowTemplate">
                <Button Style="{StaticResource ModelItem}"
                        Tag="{Binding Id}" Click="ModelRow_Click">
                    <!-- Объектом, а не строкой: объект живёт на контейнере и переживает его
                         переиспользование, а размещение сбоку ставится именно ему. -->
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource ModelSideTip}" Content="{Binding Tooltip}"/>
                    </Button.ToolTip>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Logo}" Width="{Binding LogoSize}" Height="{Binding LogoSize}"
                               Margin="{Binding LogoMargin}" Stretch="Uniform"
                               Visibility="{Binding LogoVisibility}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Visibility="{Binding LetterVisibility}"
                                   Margin="2,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="{Binding Display}"/>
                        <Path Grid.Column="2" Style="{StaticResource SelectedCheck}"
                              Visibility="{Binding CheckVisibility}"/>
                    </Grid>
                </Button>
            </DataTemplate>

            <Style x:Key="FilterChip" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="5" Padding="8,0">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="10.5" Foreground="{DynamicResource Text.Muted}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PickerAddKeyButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6" Padding="14,0">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.OnAccent}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="PanelFrame" Width="548" Height="360" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="1" CornerRadius="10" Padding="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="158"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Провайдер ===== -->
            <DockPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PickerGroupHeader}"
                           Text="{DynamicResource S.Models.ProviderColumn}"/>
                <StackPanel x:Name="ProviderItems"/>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource Border.Subtle}"/>

            <!-- ===== Модели ===== -->
            <Grid Grid.Column="2" Margin="5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="SearchRow" Margin="0,2,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="24" CornerRadius="5" Background="{DynamicResource Bg.Raised}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="ModelSearchBox"
                                     Background="Transparent" BorderThickness="0" Padding="7,0"
                                     VerticalContentAlignment="Center" FontSize="11"
                                     Foreground="{DynamicResource Text.Bright}" CaretBrush="{DynamicResource Text.Bright}"
                                     TextChanged="ModelSearchBox_TextChanged"/>
                            <TextBlock Text="{DynamicResource S.Models.SearchPlaceholder}" FontSize="11" Foreground="{DynamicResource Text.Faint}"
                                       Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ModelSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ToggleButton x:Name="VisionChip" Grid.Column="1" Style="{StaticResource FilterChip}"
                                  Content="{DynamicResource S.Models.FilterVision}" Click="FilterChip_Click"/>
                    <ToggleButton x:Name="CodeChip" Grid.Column="2" Style="{StaticResource FilterChip}"
                                  Content="{DynamicResource S.Models.FilterCode}" Click="FilterChip_Click"/>
                </Grid>

                <!-- «Авто» закреплена над списком, а не едет вместе с ним: это не модель,
                     а просьба выбрать её маршрутизатором, и искать её прокруткой незачем. -->
                <Button x:Name="AutoItem" Grid.Row="1" Style="{StaticResource ModelItem}"
                        Click="AutoItem_Click">
                    <Button.ToolTip>
                        <ToolTip x:Name="AutoTip" Style="{StaticResource ModelSideTip}"
                                 Content="{DynamicResource S.Models.AutoTip}"/>
                    </Button.ToolTip>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AutoLogo" Width="15" Height="15"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ModelName}" Text="{DynamicResource S.Models.Auto}"/>
                        <Path x:Name="AutoCheck" Grid.Column="2" Style="{StaticResource SelectedCheck}"
                              Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- Список виртуализован: у OpenRouter моделей сотни, и строить их все кнопками
                     на каждый набранный в поиске символ значило вешать окно на треть секунды.
                     Прокрутка пиксельная (ScrollUnit=Pixel) — иначе она едет строками и рвётся. -->
                <ItemsControl x:Name="ModelItems" Grid.Row="2"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingStackPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              ItemTemplate="{StaticResource ModelRowTemplate}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="PART_Scroll" Focusable="False"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          ClipToBounds="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- «Загрузка», «ничего не найдено» и текст отказа. Отдельной строкой, а не
                     первым элементом списка: элемент списка виртуализуется и ездит вместе с ним. -->
                <TextBlock x:Name="ModelStatus" Grid.Row="2" FontSize="11"
                           Foreground="{DynamicResource Text.Faint}"
                           Margin="8,10,8,8" TextWrapping="Wrap"
                           VerticalAlignment="Top" Visibility="Collapsed"/>

                <!-- Ключа у провайдера нет: показывать список моделей не из чего, и вместо
                     ошибки сервера человек видит, что именно надо сделать. -->
                <StackPanel x:Name="NoKeyPane" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center"
                            Margin="10,0" Visibility="Collapsed">
                    <TextBlock x:Name="NoKeyText" FontSize="11.5" Foreground="{DynamicResource Text.Dim}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    <Button x:Name="AddKeyButton" Style="{StaticResource PickerAddKeyButton}"
                            Content="{DynamicResource S.Models.AddKey}" Click="AddKeyButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="3" Background="{DynamicResource Border.Subtle}"/>

            <!-- ===== Ключ этой модели ===== -->
            <DockPanel Grid.Column="4" Margin="5,0,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PickerGroupHeader}"
                           Text="{DynamicResource S.Models.KeyColumn}"/>
                <ScrollViewer x:Name="KeyScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                    <StackPanel x:Name="KeyItems"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
