    <system:String x:Key="S.Instructions.NoTriggers" xml:space="preserve">без триггеров — только по названию</system:String>
    <system:String x:Key="S.Instructions.OpenFolder" xml:space="preserve">Открыть папку с инструкциями</system:String>
    <system:String x:Key="S.Instructions.SaveFailed" xml:space="preserve">Не удалось записать файл инструкции. Проверьте доступ к папке данных программы.</system:String>
    <system:String x:Key="S.Instructions.SearchPlaceholder" xml:space="preserve">Поиск по названию, триггерам и тексту</system:String>
    <system:String x:Key="S.Instructions.TextEmpty" xml:space="preserve">Напишите текст инструкции.</system:String>
    <system:String x:Key="S.Instructions.TextLabel" xml:space="preserve">Текст инструкции</system:String>
    <system:String x:Key="S.Instructions.TextPlaceholder" xml:space="preserve">Что модели нужно знать и как действовать. Можно писать в Markdown.</system:String>
    <system:String x:Key="S.Instructions.TextTooLong" xml:space="preserve">Текст длиннее {0} знаков — сократите его.</system:String>
    <system:String x:Key="S.Instructions.ToggleTip" xml:space="preserve">Модель видит эту инструкцию</system:String>
    <system:String x:Key="S.Instructions.TriggersFull" xml:space="preserve">Не больше {0} триггеров.</system:String>
    <system:String x:Key="S.Instructions.TriggersHint" xml:space="preserve">Enter или запятая — добавить. Регистр не важен: модель сверяет смысл, а не написание.</system:String>
    <system:String x:Key="S.Instructions.TriggersLabel" xml:space="preserve">Триггеры</system:String>
    <system:String x:Key="S.Instructions.TriggersPlaceholder" xml:space="preserve">Слово или фраза</system:String>
