<UserControl x:Class="Amarin.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <!--
        Оболочка настроек: затемнение, карточка 720×520 в Viewbox, навигация со значками, плашка
        версии, крестик и хост страниц (PageHost). Страницы — по UserControl на файл, создаёт их
        SettingsView по требованию. Стили страниц — в SettingsPageStyles.xaml, свои — ниже.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedDictionary Path="UI/SettingsPageStyles.xaml"/>
                <local:SharedDictionary Path="UI/SettingsNavIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Значок раздела — белый знак на цветной плитке (Background пункта), путь знака — в Tag
                (геометрии и цвета плиток — SettingsNavIcons.xaml): одиннадцать подписей одного
                цвета читались столбцом слов, и нужный раздел искали чтением. Выбранный пункт — та
                же карточка, что у групп строк справа. Высота та же 30: колонка обязана помещаться
                без прокрутки вместе с плашкой версии.
            -->
            <Style x:Key="SettingsNavItem" TargetType="RadioButton">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="8,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="GroupName" Value="SettingsNav"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="9" Padding="5,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,9,0"
                                            Background="{TemplateBinding Background}">
                                        <!-- Перо не масштабируется вместе с путём 24×24: при 12 точках
                                             знака толще 1.3 линии слипаются в кляксу. -->
                                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                              Width="12" Height="12" Stretch="Uniform"
                                              Stroke="White" StrokeThickness="1.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid VerticalAlignment="Center">
                                        <!-- Полужирная копия-невидимка держит ширину выбранного. -->
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Visibility="Hidden"/>
                                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                                   FontSize="12.5" Foreground="{DynamicResource Text.Secondary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Body}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Panel}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Отступ сверху 12, а не 14: с пунктом «Инструкции» в колонке восемь страниц,
                 и плашка версии с надписью об обновлении в две строки иначе вставала
                 почти вплотную к последнему пункту. -->
            <Style x:Key="SettingsNavGroup" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                <Setter Property="Margin" Value="18,12,8,4"/>
            </Style>

            <!--
                Нижняя половина плашки «версия и репозиторий». Своим шаблоном, а не Hyperlink:
                Hyperlink живёт только внутри текстового потока и тянет собственное
                подчёркивание, а здесь нужен кликабельный прямоугольник во всю ширину плашки.

                Фон Bg.Selected, а не Bg.Raised: от Bg.Card, которым залита верхняя половина,
                Raised отличается на четыре уровня яркости — в тёмных палитрах две части
                сливались бы в одну. Плюс отбивка сверху линией, чтобы граница читалась даже
                там, где палитра выбрана малоконтрастной.
            -->
            <Style x:Key="SettingsAboutLink" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!--
                                Нижние углы скругляются здесь: ClipToBounds у родителя режет по
                                прямоугольнику и CornerRadius не учитывает, так что нижние углы
                                плашки оставались квадратными. Радиус 6 — это внешние 7 минус
                                пиксель рамки карточки.
                            -->
                            <Border x:Name="Bg" Padding="8,4" CornerRadius="0,0,6,6"
                                    Background="{DynamicResource Bg.Selected}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Path x:Name="Mark" Data="{DynamicResource Icon.Github}"
                                          Stretch="Uniform" Width="11" Height="11"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource Text.Body}"/>
                                    <TextBlock x:Name="Label" Text="{DynamicResource S.About.Github}"
                                               FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Body}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--
                                    Подсветка цветом акцента, а не фоном: Bg.Hover в тёмных
                                    палитрах темнее Bg.Selected, и наведение выглядело бы
                                    как «кнопка погасла».
                                -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource Accent.Fill}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Accent.Fill}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Затемнение -->
        <Border Background="{DynamicResource Overlay.Scrim}">
            <Button x:Name="ScrimCloseButton" Opacity="0" IsTabStop="False" AutomationProperties.Name="{DynamicResource S.Common.Close}"></Button>
        </Border>

        <!-- Окно -->
        <!--
            690×520 и десять страниц в четырёх группах, как в 1.27.1 (там было 690×460 и восемь).
            1.28.0 растянула окно до 620: каждая новая страница шла отдельным пунктом, и колонка
            перестала помещаться. Теперь компьютеры и MCP — вкладки Automation, а тяжёлые блоки
            живут на подстраницах (SettingsDrill), и окно снова не выше, чем нужно. Колонка
            навигации всё равно прокручивается, а плашка версии стоит своей строкой под ней.
            На маленьком экране Viewbox ужимает окно целиком. Ширина 720, а не 690: строки
            лежат в группах-карточках, и поля карточки (2×16) отняли бы у подписей место —
            на Customize рядом с двумя выпадашками «Маршрутизатор» уже обрезался.
        -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
        <Border x:Name="SettingsCard" Width="720" Height="520" Background="{DynamicResource Bg.Window}"
        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== НАВИГАЦИЯ ===== -->
                <!-- Колонка — на той же подложке, что и страница: выбранный пункт поднят карточкой, как группы справа. -->
                <Border Background="Transparent" CornerRadius="14,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="SettingsNavScroll" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled" local:SmoothScroll.IsEnabled="True">
                        <StackPanel Margin="0,0,0,8">
                            <!--
                                Одиннадцать разделов в три группы: общее, работа модели, защита и данные.
                                Подписей три, а не четыре: с четырьмя колонка не оставляла места плашке
                                версии (InstructionUiTests).
                            -->
                            <TextBlock Style="{StaticResource SettingsNavGroup}" Text="{DynamicResource S.Settings.NavGroup.Main}" Margin="18,16,8,4"/>
                            <RadioButton x:Name="NavGeneral" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.General}" Tag="{StaticResource NavIcon.General}" Content="{DynamicResource S.Settings.Nav.General}"/>
                            <RadioButton x:Name="NavAppearance" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Appearance}" Tag="{StaticResource NavIcon.Appearance}" Content="{DynamicResource S.Settings.Nav.Appearance}"/>
                            <RadioButton x:Name="NavProfile" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Profile}" Tag="{StaticResource NavIcon.Profile}" Content="{DynamicResource S.Settings.Nav.Profile}"/>
                            <TextBlock Style="{StaticResource SettingsNavGroup}" Text="{DynamicResource S.Settings.NavGroup.Model}"/>
                            <RadioButton x:Name="NavModels" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Models}" Tag="{StaticResource NavIcon.Models}" Content="{DynamicResource S.Settings.Nav.Models}"/>
                            <RadioButton x:Name="NavPrompts" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Prompts}" Tag="{StaticResource NavIcon.Prompts}" Content="{DynamicResource S.Settings.Nav.Prompts}"/>
                            <RadioButton x:Name="NavInstructions" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Instructions}" Tag="{StaticResource NavIcon.Instructions}" Content="{DynamicResource S.Settings.Nav.Instructions}"/>
                            <RadioButton x:Name="NavAutomation" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Automation}" Tag="{StaticResource NavIcon.Automation}" Content="{DynamicResource S.Settings.Nav.Automation}"/>
                            <TextBlock Style="{StaticResource SettingsNavGroup}" Text="{DynamicResource S.Settings.NavGroup.SecurityData}"/>
                            <RadioButton x:Name="NavSecurity" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Security}" Tag="{StaticResource NavIcon.Security}" Content="{DynamicResource S.Settings.Nav.Security}"/>
                            <RadioButton x:Name="NavKey" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Keys}" Tag="{StaticResource NavIcon.Keys}" Content="{DynamicResource S.Settings.Nav.Keys}"/>
                            <RadioButton x:Name="NavData" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.Data}" Tag="{StaticResource NavIcon.Data}" Content="{DynamicResource S.Settings.Nav.Data}"/>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource SettingsNavItem}" Background="{StaticResource NavTile.About}" Tag="{StaticResource NavIcon.About}" Content="{DynamicResource S.Settings.Nav.About}"/>
                        </StackPanel>
                        </ScrollViewer>

                        <!--
                            Плашка «версия и репозиторий»: верхняя половина — номер версии,
                            нижняя — ссылка на репозиторий, залитая своим фоном.

                            Растягивается по ширине колонки, а не по содержимому: при найденном
                            обновлении MainWindow.Updates.cs переписывает SettingsVersionText
                            длинной строкой S.Updates.SidebarNewer. Сжатая по содержимому
                            карточка на ней раздувалась бы за пределы колонки в 170 пикселей
                            прямо под страницу настроек; здесь ширина задана полями, а лишнее
                            уходит в перенос.
                        -->
                        <Border x:Name="SettingsAboutCard" Grid.Row="1"
                                VerticalAlignment="Bottom" Margin="20,0,20,12"
                                Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Text.Secondary, а не Text.Faint: блёклый серый на тёмной карточке не читался. -->
                                <TextBlock x:Name="SettingsVersionText"
                                           Text="v1.30.0"
                                           FontSize="10"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="7,3,7,4"/>
                                <Button x:Name="GithubLinkButton" Grid.Row="1"
                                        Style="{StaticResource SettingsAboutLink}"
                                        ToolTip="{DynamicResource S.About.GithubHint}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== КОНТЕНТ ===== -->
                <Grid x:Name="PageHost" Grid.Column="1">

                    <!-- Крестик поверх всех страниц -->
                    <Button x:Name="SettingsCloseButton" AutomationProperties.Name="{DynamicResource S.Common.Close}" Width="26" Height="26" Panel.ZIndex="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                    Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                    <Path x:Name="Icon" Data="M0,0 L8,8 M8,0 L0,8"
                                  Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="9" Height="9" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Text.Primary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>
            </Grid>
        </Border>
        </Viewbox>
    </Grid>
</UserControl>