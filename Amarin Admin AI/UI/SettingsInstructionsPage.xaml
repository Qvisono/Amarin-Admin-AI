<UserControl x:Class="Amarin.UI.SettingsInstructionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <!--
        Стили настроек объявлены локально в SettingsOverlay.Resources главного окна, и
        StaticResource из этого файла их не достанет: поиск идёт по словарям разметки, а не по
        дереву. Поэтому нужные ключи повторены здесь — тем же приёмом, что у страниц Key и Info.
    -->
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="1,5,0,0"/>
        </Style>
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Рамка поля ввода: та же, что у поля названия заготовки промпта. -->
        <Style x:Key="FieldFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text.Bright}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Fill}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Тумблер — копия SettingsToggle из настроек главного окна. -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource Bg.Track}">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource Text.Dim}"
                                     HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Fill}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.Tertiary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
        </Style>

        <!-- Главная кнопка редактора: та же заливка акцентом, что у «Сохранить» под промптом. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource Accent.Fill}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent.FillPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «+ Создать»: копия AddKeyButton со страницы Key. -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Raised}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Path Data="M4,0 L4,8 M0,4 L8,4" Stroke="{DynamicResource Accent.Fill}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="9" Height="9" Stretch="Uniform"
                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                           Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Кнопка-значок. Значок — Path в Content, а не символ шрифта: стрелки загрузки и
            выгрузки в Segoe UI есть не везде, а подменный шрифт рисует их другой толщиной.
            Цвет штриха берётся у самой кнопки, поэтому наведение красит его одной строкой.
        -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconGlyph" TargetType="Path">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!--
            Карточка инструкции. Кнопкой, как плитка заготовки: вся карточка открывает правку.
            Шаблон — по форме карточек страницы Key: та же заливка Bg.Card и тонкая рамка, чуть
            больше воздуха внутри и мягкий подсвет рамки под курсором вместо смены заливки
            целиком.
        -->
        <Style x:Key="InstructionCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="10" Padding="12,12,12,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка со значком: книга в акценте у включённой, блёклая у выключенной. -->
        <Style x:Key="CardGlyphTile" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="CardGlyph" TargetType="Path">
            <Setter Property="Data" Value="M1,2 C3,1 6,1 8,2.5 C10,1 13,1 15,2 L15,13 C13,12 10,12 8,13.5 C6,12 3,12 1,13 Z M8,2.5 L8,13.5"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{DynamicResource Accent.Fill}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Stroke" Value="{DynamicResource Text.Faint}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Триггер в карточке: пилюля с тонкой рамкой. Длинный триггер обрезается многоточием
            внутри своей пилюли, а ряд переносится — прежде ряд просто срезался краем карточки
            посреди слова.
        -->
        <Style x:Key="TriggerTag" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1,8,2"/>
            <Setter Property="Margin" Value="0,6,5,0"/>
            <Setter Property="MaxWidth" Value="190"/>
        </Style>
        <Style x:Key="TriggerTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <DataTemplate x:Key="InstructionRowTemplate">
            <Button Style="{StaticResource InstructionCard}" Tag="{Binding Id}" Click="Card_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardGlyphTile}">
                        <Path Style="{StaticResource CardGlyph}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Preview}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text.Dim}" TextTrimming="CharacterEllipsis"
                                   Opacity="{Binding ContentOpacity}"/>

                        <WrapPanel Opacity="{Binding ContentOpacity}" Visibility="{Binding TriggersVisibility}">
                            <ItemsControl ItemsSource="{Binding Triggers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TriggerTag}">
                                            <TextBlock Style="{StaticResource TriggerTagText}" Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource TriggerTag}" Background="Transparent"
                                    Visibility="{Binding MoreVisibility}">
                                <TextBlock Style="{StaticResource TriggerTagText}" Text="{Binding MoreTriggers}"
                                           Foreground="{DynamicResource Text.Faint}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource S.Instructions.NoTriggers}" Margin="0,6,0,0"
                                   Style="{StaticResource TriggerTagText}" FontStyle="Italic"
                                   Foreground="{DynamicResource Text.Faint}"
                                   Visibility="{Binding NoTriggersVisibility}"/>
                    </StackPanel>

                    <!-- Справа: тумблер сверху, действия под ним. Действия видны под курсором —
                         иначе у каждой карточки по паре значков шума; место под них занято
                         всегда, чтобы карточка не прыгала при наведении. -->
                    <Grid Grid.Column="2" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- OneWay: правда о включённости лежит в файле, а не в тумблере.
                             Щелчок пишет файл, а список перестраивается из библиотеки. -->
                        <CheckBox Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" Margin="0,1,0,0"
                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                  Tag="{Binding Id}" Click="Toggle_Click"
                                  ToolTip="{DynamicResource S.Instructions.ToggleTip}"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,6,-5,-4">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="ExportRow_Click"
                                    ToolTip="{DynamicResource S.Instructions.Export}">
                                <Path Style="{StaticResource IconGlyph}"
                                      Data="M7,1 L7,9 M3.5,5.5 L7,9 L10.5,5.5 M1,10 L1,13 L13,13 L13,10"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="DeleteRow_Click"
                                    ToolTip="{DynamicResource S.Common.Delete}">
                                <Path Style="{StaticResource IconGlyph}"
                                      Data="M2,4 L12,4 M5,4 L5,2 L9,2 L9,4 M3,4 L4,13 L10,13 L11,4"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Пилюля триггера в редакторе: с крестиком, которым её убирают. -->
        <Style x:Key="ChipRemove" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                            <Path Data="M0,0 L6,6 M6,0 L0,6" Width="6" Height="6" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Bright}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,1,3,1"/>
            <Setter Property="Margin" Value="0,2,5,2"/>
            <Setter Property="Height" Value="22"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════ СПИСОК ═══════════ -->
        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,14,20,16">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Settings.Instructions.Title}"
                           Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource S.Instructions.Desc}"/>

                <Grid Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Поиск появляется, когда инструкций становится много: на трёх он лишний. -->
                    <Border x:Name="SearchFrame" Style="{StaticResource FieldFrame}" Padding="9,0"
                            Height="26" Margin="0,0,10,0" Visibility="Collapsed">
                        <Grid>
                            <TextBox x:Name="SearchBox" Style="{StaticResource FieldTextBox}" FontSize="11.5"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Style="{StaticResource Placeholder}" FontSize="11.5"
                                       Text="{DynamicResource S.Instructions.SearchPlaceholder}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="CountText" Style="{StaticResource SettingDesc}" Margin="0"
                               VerticalAlignment="Center" Text=" " TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="OpenFolderButton" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                                Click="OpenFolder_Click" ToolTip="{DynamicResource S.Instructions.OpenFolder}">
                            <Path Style="{StaticResource IconGlyph}"
                                  Data="M1,3 L1,12 L13,12 L13,4.5 L6.5,4.5 L5,3 Z"/>
                        </Button>
                        <Button x:Name="ImportButton" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                Content="{DynamicResource S.Instructions.Import}" Click="Import_Click"/>
                        <Button x:Name="CreateButton" Style="{StaticResource AddButton}"
                                Content="{DynamicResource S.Instructions.Create}" Click="Create_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Итог импорта и экспорта. Строкой на странице: окна-тоста для настроек нет. -->
                <TextBlock x:Name="StatusText" Style="{StaticResource SettingDesc}" Margin="0,-4,0,10"
                           Foreground="{DynamicResource Text.Muted}" Text=" " Visibility="Collapsed"/>

                <ItemsControl x:Name="InstructionItems" ItemTemplate="{StaticResource InstructionRowTemplate}"/>

                <TextBlock x:Name="NothingFoundText" Style="{StaticResource SettingDesc}" Margin="2,4,0,0"
                           Text="{DynamicResource S.Common.NothingFound}" Visibility="Collapsed"/>

                <!-- Пустое состояние: объясняет, зачем это, и сразу даёт начать. -->
                <Border x:Name="EmptyState" Margin="0,18,0,0" Padding="24,26" CornerRadius="10"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        Background="{DynamicResource Bg.Card}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="330">
                        <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                                Background="{DynamicResource Bg.Selected}">
                            <Path Data="M1,2 C3,1 6,1 8,2.5 C10,1 13,1 15,2 L15,13 C13,12 10,12 8,13.5 C6,12 3,12 1,13 Z M8,2.5 L8,13.5"
                                  Width="18" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Text.Muted}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource S.Instructions.EmptyTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Body}" HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource SettingDesc}" TextAlignment="Center" Margin="0,5,0,0"
                                   Text="{DynamicResource S.Instructions.EmptyDesc}"/>
                        <Button Style="{StaticResource AddButton}" HorizontalAlignment="Center" Margin="0,14,0,0"
                                Content="{DynamicResource S.Instructions.CreateFirst}" Click="Create_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--
            ═══════════ РЕДАКТОР ═══════════
            В самой странице, а не модалкой: модалки обязаны жить в главном окне, а у страницы вся
            её высота под длинный текст. Grid, а не StackPanel: StackPanel меряет детей
            бесконечностью, и на длинном тексте подвал с «Сохранить» уехал бы ниже края страницы.
            Здесь всё растущее — в строке «*», и подвал стоит на месте при любом тексте.
        -->
        <Grid x:Name="EditorPane" Margin="20,12,20,16" Visibility="Collapsed"
              PreviewKeyDown="Editor_PreviewKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка: назад, заголовок, видимость для модели. Справа поле в 30: над всеми
                 страницами настроек в этом углу висит общий крестик (26 и отступ 12 от края),
                 и тумблер без поля уезжал под него. -->
            <Grid Grid.Row="0" Margin="0,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Margin="-6,0,4,0"
                        Click="Back_Click" ToolTip="{DynamicResource S.Settings.Nav.Instructions}">
                    <Path Style="{StaticResource IconGlyph}" Width="7" Data="M6,1 L1,6 L6,11"/>
                </Button>
                <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center" Text="{DynamicResource S.Instructions.NewTitle}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource S.Instructions.EnabledLabel}" FontSize="11.5"
                               Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource SettingsToggle}" IsChecked="True"
                              Click="Draft_Changed" ToolTip="{DynamicResource S.Instructions.ToggleTip}"/>
                </StackPanel>
            </Grid>

            <!-- Название -->
            <StackPanel Grid.Row="1">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Instructions.NameLabel}"/>
                <Border Style="{StaticResource FieldFrame}" Height="30">
                    <Grid>
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" FontSize="12.5"
                                 TextChanged="NameBox_TextChanged"/>
                        <TextBlock x:Name="NamePlaceholder" Style="{StaticResource Placeholder}" FontSize="12.5"
                                   Text="{DynamicResource S.Instructions.NamePlaceholder}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Триггеры: пилюли и поле ввода в одном потоке -->
            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Instructions.TriggersLabel}"/>
                <Border x:Name="TriggerFrame" Style="{StaticResource FieldFrame}" Padding="6,3"
                        MinHeight="30" Cursor="IBeam" MouseLeftButtonDown="TriggerFrame_MouseLeftButtonDown">
                    <WrapPanel x:Name="TriggerPanel" VerticalAlignment="Center">
                        <Grid x:Name="TriggerInputHost" MinWidth="80" Margin="3,0,0,0">
                            <TextBox x:Name="TriggerInput" Style="{StaticResource FieldTextBox}" Height="24"
                                     PreviewKeyDown="TriggerInput_PreviewKeyDown"
                                     TextChanged="TriggerInput_TextChanged"
                                     LostKeyboardFocus="TriggerInput_LostKeyboardFocus"
                                     DataObject.Pasting="TriggerInput_Pasting"/>
                            <TextBlock x:Name="TriggerPlaceholder" Style="{StaticResource Placeholder}"
                                       Text="{DynamicResource S.Instructions.TriggersPlaceholder}"/>
                        </Grid>
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="TriggerHint" Style="{StaticResource FieldHint}"
                           Text="{DynamicResource S.Instructions.TriggersHint}"/>
            </StackPanel>

            <!-- Текст: растёт в строке «*», своя прокрутка, счётчик в углу -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Instructions.TextLabel}"/>
                    <TextBlock x:Name="CounterText" FontSize="10.5" Foreground="{DynamicResource Text.Faint}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,5"
                               Text="0 / 10 000"/>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource FieldFrame}" Padding="10,8,4,8" MinHeight="90">
                    <Grid>
                        <TextBox x:Name="BodyBox" Style="{StaticResource FieldTextBox}"
                                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalAlignment="Stretch"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"
                                 TextChanged="BodyBox_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" local:SmoothScroll.IsEnabled="True"
                                                  Padding="0,0,6,0"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock x:Name="BodyPlaceholder" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{DynamicResource S.Instructions.TextPlaceholder}"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="ErrorText" Grid.Row="4" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Status.Danger}" Text=" " Visibility="Collapsed"/>

            <!-- Подвал -->
            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                        Content="{DynamicResource S.Common.Delete}" Click="Delete_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="ExportButton" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S.Instructions.Export}" Click="ExportEditor_Click"/>
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S.Common.Cancel}" Click="Back_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                            Content="{DynamicResource S.Common.Save}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
