<UserControl x:Class="Amarin.UI.TranslationEditorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Overlay_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Overlay.Scrim}"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Width="640" Height="620"
                    Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="20,18">
                <!-- Grid: список в строке «*» прокручивается, кнопки в строке Auto всегда на карточке. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{DynamicResource S.TranslationEditor.Desc}" FontSize="11.5" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,10">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="12.5"
                                     Foreground="{DynamicResource Text.Body}" CaretBrush="{DynamicResource Text.Primary}"
                                     AutomationProperties.Name="{DynamicResource S.TranslationEditor.Search}"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource S.TranslationEditor.Search}"
                                       FontSize="12.5" Margin="2,0,0,0" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Text.Faint}"/>
                        </Grid>
                    </Border>

                    <!-- Строк почти две тысячи: список виртуализован, контейнеры переиспользуются. -->
                    <ItemsControl x:Name="Rows" Grid.Row="2" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Key}" FontSize="10.5" FontFamily="Consolas"
                                                           Foreground="{DynamicResource Text.Faint}"/>
                                                <TextBlock Text="{Binding EditedMark}" FontSize="10.5" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Accent.Fill}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource InlineLinkButton}" FontSize="11"
                                                    Content="{DynamicResource S.TranslationEditor.Retranslate}"
                                                    Click="Retranslate_Click"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Original}" FontSize="12" Margin="0,3,0,4" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Muted}"/>
                                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                                BorderThickness="1" CornerRadius="6" Padding="6,4">
                                            <TextBox Text="{Binding Translation, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Key}"
                                                     Background="Transparent" BorderThickness="0" FontSize="12.5" TextWrapping="Wrap"
                                                     AcceptsReturn="True" Foreground="{DynamicResource Text.Body}"
                                                     CaretBrush="{DynamicResource Text.Primary}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Problem}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Status.Warning}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="3">
                        <Border Height="1" Background="{DynamicResource Bg.Hover}" Margin="0,10,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,12,0" Foreground="{DynamicResource Text.Muted}"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{DynamicResource S.Common.Cancel}" Style="{StaticResource DialogSecondaryButton}"
                                        Margin="0,0,8,0" Click="CancelButton_Click"/>
                                <Button x:Name="SaveButton" Content="{DynamicResource S.Common.Save}"
                                        Style="{StaticResource DialogPrimaryButton}" Click="SaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
