<UserControl x:Class="Amarin.UI.HotkeyField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}"
             Height="26">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!--
            Само поле. Кнопкой, а не полем ввода: печатать сюда нечего, сочетание набирают
            клавишами, и текстовая каретка обещала бы не то.
        -->
        <Border x:Name="Frame" Grid.Column="0" MinWidth="104" Height="26" CornerRadius="6"
                Background="{DynamicResource Bg.Raised}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                Cursor="Hand" Padding="10,0"
                MouseLeftButtonDown="Frame_MouseLeftButtonDown">
            <TextBlock x:Name="GestureText" FontSize="11.5"
                       Foreground="{DynamicResource Text.Body}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!--
            Возврат к заводскому. Прячется, когда сочетание и так заводское: кнопка, которой
            нечего делать, — лишний вопрос на странице.
        -->
        <Button x:Name="ResetButton" Grid.Column="1" Width="22" Height="22" Margin="6,0,0,0"
                Cursor="Hand" Focusable="False" Visibility="Collapsed"
                ToolTip="{DynamicResource S.Hotkeys.Reset}"
                Click="ResetButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                        <Path x:Name="Glyph" Data="{DynamicResource Icon.Revert}"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
