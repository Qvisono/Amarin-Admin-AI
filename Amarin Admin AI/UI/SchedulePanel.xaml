<UserControl x:Class="Amarin.UI.SchedulePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amarin.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Цвет отметки последнего прогона. -->
            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="7"/>
                <Setter Property="Height" Value="7"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{DynamicResource Text.Faint}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Ok">
                        <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Attention">
                        <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Problem">
                        <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Failed">
                        <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════ СПИСОК ═══════════ -->
        <Grid x:Name="ListPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Высота и одна строка — общие с остальными вкладками Automation, иначе список прыгает. -->
            <Grid Height="28" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,12,0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Text="{DynamicResource S.Schedule.Desc}"/>
                <Button Grid.Column="1" Style="{StaticResource AddButton}" VerticalAlignment="Center"
                        Content="{DynamicResource S.Schedule.Create}" Click="Create_Click"/>
            </Grid>

            <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="JobItems" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}" Tag="{Binding Id}" Click="Card_Click"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding When}" FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Text.Dim}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Ellipse Style="{StaticResource StatusDot}"/>
                                                <TextBlock Text="{Binding Last}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <!-- OneWay: правда о включённости — в файле, щелчок пишет его. -->
                                            <CheckBox Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Id}"
                                                      Click="Toggle_Click"
                                                      AutomationProperties.Name="{DynamicResource S.Schedule.EnabledLabel}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource IconButton}" Tag="{Binding LastChatId}"
                                                        Click="OpenChat_Click" Visibility="{Binding ChatVisibility}"
                                                        ToolTip="{DynamicResource S.Schedule.OpenChat}"
                                                        AutomationProperties.Name="{DynamicResource S.Schedule.OpenChat}"
                                                        Margin="0,0,4,0">
                                                    <Path Style="{StaticResource IconGlyph}"
                                                          Data="M1,2 L13,2 L13,10 L6,10 L3,13 L3,10 L1,10 Z"/>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Tag="{Binding Id}"
                                                        Click="RunNow_Click" Content="{DynamicResource S.Schedule.RunNow}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Пусто — строка и готовое задание одной кнопкой: с него проще всего начать. -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Text.Faint}" Text="{DynamicResource S.Schedule.EmptyDesc}"/>
                        <Button x:Name="HealthPresetButton" Style="{StaticResource AddButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Content="{DynamicResource S.Schedule.AddHealth}" Click="AddHealth_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="RecentTitle" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"
                               Text="{DynamicResource S.Schedule.Recent}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="RecentItems" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Style="{StaticResource StatusDot}"/>
                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════ РЕДАКТОР ═══════════ -->
        <Grid x:Name="EditorPane" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,30,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Margin="-6,0,4,0" Click="Back_Click"
                        ToolTip="{DynamicResource S.Schedule.Tab}" AutomationProperties.Name="{DynamicResource S.Schedule.Tab}">
                    <Path Style="{StaticResource IconGlyph}" Width="7" Data="M6,1 L1,6 L6,11"/>
                </Button>
                <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"
                           Text="{DynamicResource S.Schedule.NewTitle}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource S.Schedule.EnabledLabel}" FontSize="11.5"
                               Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource SettingsToggle}" IsChecked="True"
                              AutomationProperties.Name="{DynamicResource S.Schedule.EnabledLabel}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Schedule.NameLabel}"/>
                <Border Style="{StaticResource FieldFrame}" Height="30">
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" FontSize="12.5"
                             AutomationProperties.Name="{DynamicResource S.Schedule.NameLabel}"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Schedule.PromptLabel}"/>
                <Border Grid.Row="1" Style="{StaticResource FieldFrame}" Padding="10,8,4,8" MinHeight="70">
                    <TextBox x:Name="PromptBox" Style="{StaticResource FieldTextBox}" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalAlignment="Stretch"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{DynamicResource S.Schedule.PromptLabel}"/>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Schedule.WhenLabel}"/>
                <WrapPanel x:Name="KindChoices">
                    <RadioButton x:Name="KindDaily" Tag="Daily" GroupName="ScheduleKind" Style="{StaticResource PageTab}"
                                 Content="{DynamicResource S.Schedule.Kind.Daily}" Checked="Kind_Checked"/>
                    <RadioButton x:Name="KindWeekly" Tag="Weekly" GroupName="ScheduleKind" Style="{StaticResource PageTab}"
                                 Content="{DynamicResource S.Schedule.Kind.Weekly}" Checked="Kind_Checked"/>
                    <RadioButton x:Name="KindEveryHours" Tag="EveryHours" GroupName="ScheduleKind" Style="{StaticResource PageTab}"
                                 Content="{DynamicResource S.Schedule.Kind.EveryHours}" Checked="Kind_Checked"/>
                    <RadioButton x:Name="KindAtStartup" Tag="AtStartup" GroupName="ScheduleKind" Style="{StaticResource PageTab}"
                                 Content="{DynamicResource S.Schedule.Kind.AtStartup}" Checked="Kind_Checked"/>
                </WrapPanel>

                <StackPanel x:Name="TimeRow" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource S.Schedule.TimeLabel}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Body}" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource FieldFrame}" Height="28" Width="70">
                        <TextBox x:Name="TimeBox" Style="{StaticResource FieldTextBox}" MaxLength="5"
                                 HorizontalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource S.Schedule.TimeLabel}"/>
                    </Border>
                </StackPanel>
                <WrapPanel x:Name="DaysRow" Margin="0,8,0,0"/>
                <StackPanel x:Name="HoursRow" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource S.Schedule.EveryLabel}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Body}" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource FieldFrame}" Height="28" Width="56">
                        <TextBox x:Name="HoursBox" Style="{StaticResource FieldTextBox}" MaxLength="3"
                                 HorizontalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource S.Schedule.EveryLabel}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource S.Schedule.HoursUnit}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Body}" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- Потолок цены прогона (E1): дойдя до него, прогон обрывается без вопроса. -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource S.Schedule.CapLabel}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Body}" Margin="0,0,8,0"/>
                    <TextBlock Text="$" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Dim}" Margin="0,0,4,0"/>
                    <Border Style="{StaticResource FieldFrame}" Height="28" Width="70">
                        <Grid>
                            <TextBox x:Name="CapBox" Style="{StaticResource FieldTextBox}" MaxLength="8"
                                     HorizontalContentAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource S.Schedule.CapLabel}"/>
                            <TextBlock x:Name="CapPlaceholder" Style="{StaticResource Placeholder}" HorizontalAlignment="Center"
                                       Text="{DynamicResource S.Limit.None}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.Schedule.ReadOnlyHint}"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="4" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Status.Danger}" Visibility="Collapsed"/>

            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                        Content="{DynamicResource S.Common.Delete}" Click="Delete_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Content="{DynamicResource S.Common.Cancel}" Click="Back_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.Common.Save}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
