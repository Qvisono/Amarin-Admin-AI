<UserControl x:Class="Amarin.UI.ChatSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Overlay_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Overlay.Scrim}"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border x:Name="Card" Style="{StaticResource DialogCard}" Width="520" MaxHeight="620">
                <!-- Grid, а не StackPanel: длинный список инструкций уходит в прокрутку строки «*»,
                     кнопки в строке Auto остаются на карточке (см. памятку про модалки). -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource S.ChatProfile.Title}" Style="{StaticResource DialogTitle}"/>
                        <TextBlock Text="{DynamicResource S.ChatProfile.Desc}" Style="{StaticResource DialogText}" Margin="0,4,0,4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{DynamicResource S.ChatProfile.Prompt}" Style="{StaticResource DialogLabel}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="8,6">
                            <Grid>
                                <TextBox x:Name="PromptBox" MinHeight="84" MaxHeight="160" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="Transparent" BorderThickness="0" FontSize="12.5"
                                         Foreground="{DynamicResource Text.Body}" CaretBrush="{DynamicResource Text.Primary}"
                                         AutomationProperties.Name="{DynamicResource S.ChatProfile.Prompt}"
                                         TextChanged="PromptBox_TextChanged"/>
                                <TextBlock x:Name="PromptPlaceholder" Text="{DynamicResource S.ChatProfile.PromptEmpty}"
                                           FontSize="12.5" Margin="2,0,0,0" IsHitTestVisible="False" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text.Faint}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,14,0,6">
                        <TextBlock Text="{DynamicResource S.ChatProfile.Instructions}" Style="{StaticResource DialogLabel}" Margin="0,16,0,6"/>
                        <CheckBox x:Name="AllInstructionsBox" Style="{StaticResource DialogCheckBox}"
                                  Content="{DynamicResource S.ChatProfile.AllInstructions}"
                                  Checked="AllInstructionsBox_Changed" Unchecked="AllInstructionsBox_Changed"/>
                        <TextBlock x:Name="NoInstructionsText" Text="{DynamicResource S.ChatProfile.NoInstructions}"
                                   FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource Text.Faint}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="18,0,-8,0" Padding="0,0,8,0">
                        <ItemsControl x:Name="InstructionList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DialogCheckBox}" Content="{Binding Name}"
                                              IsChecked="{Binding Chosen, Mode=TwoWay}" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4">
                        <Border Height="1" Background="{DynamicResource Bg.Hover}" Margin="0,14,0,0"/>
                        <!-- «Сбросить» — слева, отдельно от пары «Отмена/Сохранить»: это не ответ на окно. -->
                        <Grid Margin="0,14,0,0">
                            <Button x:Name="ResetButton" Content="{DynamicResource S.ChatProfile.Reset}"
                                    Style="{StaticResource DialogSecondaryButton}" HorizontalAlignment="Left"
                                    Click="ResetButton_Click"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="CancelButton" Content="{DynamicResource S.Common.Cancel}"
                                        Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0"
                                        Click="CancelButton_Click"/>
                                <Button x:Name="SaveButton" Content="{DynamicResource S.Common.Save}"
                                        Style="{StaticResource DialogPrimaryButton}" Click="SaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
