<Window x:Class="Amarin.UI.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Title="Amarin Admin AI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <!-- Палитра: в работе — ThemeManager, в конструкторе —
                     Properties/DesignTimeResources.xaml. -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow. -->
    <Grid Margin="24">
        <Border x:Name="Card" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="12" Padding="22,20"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Введите пароль" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Body}"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Faint}"/>

                <Border x:Name="FirstFieldBorder" Margin="0,16,0,0" CornerRadius="6" Height="32"
                        Background="{DynamicResource Bg.Raised}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                    <PasswordBox x:Name="FirstBox" Background="Transparent" BorderThickness="0"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                 Foreground="{DynamicResource Text.Bright}"
                                 CaretBrush="{DynamicResource Text.Bright}"
                                 KeyDown="Box_KeyDown"/>
                </Border>

                <Border x:Name="SecondFieldBorder" Margin="0,8,0,0" CornerRadius="6" Height="32"
                        Visibility="Collapsed"
                        Background="{DynamicResource Bg.Raised}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                    <PasswordBox x:Name="SecondBox" Background="Transparent" BorderThickness="0"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                 Foreground="{DynamicResource Text.Bright}"
                                 CaretBrush="{DynamicResource Text.Bright}"
                                 KeyDown="Box_KeyDown"/>
                </Border>

                <TextBlock x:Name="ErrorText" FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource Status.Danger}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource DialogSecondaryButton}"
                            Content="Отмена" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}"
                            Content="Продолжить" Click="OkButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
