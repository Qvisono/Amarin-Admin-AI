<Window x:Class="Amarin.UI.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Title="Amarin Admin AI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <!-- Палитра: в работе — ThemeManager, в конструкторе —
                     Properties/DesignTimeResources.xaml. -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Строка списка пользователей на экране входа -->
            <Style x:Key="ProfileRowButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow. -->
    <Grid Margin="24">
        <Border x:Name="Card" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="12" Padding="22,20,22,18"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <!--
                    Заголовок и кнопка смены пользователя — колонками, а не наложением.
                    Кнопка была подписью «Сменить пользователя» в нижнем ряду, в одной ячейке
                    Grid с «Отмена» и «Войти»: место друг под друга они не резервировали, ширина
                    окна прибита к 400, и на длинном переводе подпись уезжала под соседей.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="HeadingText" Text="{DynamicResource S.Password.Prompt}" Style="{StaticResource DialogTitle}"/>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource DialogText}"/>
                    </StackPanel>

                    <Button x:Name="SwitchUserButton" Grid.Column="1"
                            Width="26" Height="26" VerticalAlignment="Top"
                            Cursor="Hand" Visibility="Collapsed"
                            ToolTip="{DynamicResource S.Password.SwitchUser}"
                            Click="SwitchUserButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="4"
                                        Background="{DynamicResource Bg.Raised}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                    <Path x:Name="Glyph" Data="{DynamicResource Icon.SwitchProfile}"
                                          Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{DynamicResource Text.Dim}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                        <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                    </Trigger>
                                    <!-- Список открыт: кнопка это переключатель, и её состояние видно. -->
                                    <Trigger Property="Tag" Value="open">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                        <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Text.Bright}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!--
                    Подписи у полей — только когда полей два (новый пароль): без них было не понять,
                    куда пароль, а куда повтор. У одного поля входа подпись повторяла бы заголовок.
                -->
                <TextBlock Style="{StaticResource DialogLabel}" Text="{DynamicResource S.Password.Label}"
                           Visibility="{Binding Visibility, ElementName=SecondFieldBorder}"/>
                <Border x:Name="FirstFieldBorder" Style="{StaticResource DialogField}" Margin="0,16,0,0">
                    <PasswordBox x:Name="FirstBox" Style="{StaticResource DialogPasswordInput}"
                                 AutomationProperties.Name="{DynamicResource S.Password.Label}"
                                 KeyDown="Box_KeyDown"/>
                </Border>

                <TextBlock Style="{StaticResource DialogLabel}" Margin="0,12,0,6" Text="{DynamicResource S.Password.Repeat}"
                           Visibility="{Binding Visibility, ElementName=SecondFieldBorder}"/>
                <Border x:Name="SecondFieldBorder" Style="{StaticResource DialogField}" Visibility="Collapsed">
                    <PasswordBox x:Name="SecondBox" Style="{StaticResource DialogPasswordInput}"
                                 AutomationProperties.Name="{DynamicResource S.Password.Repeat}"
                                 KeyDown="Box_KeyDown"/>
                </Border>

                <!-- Список пользователей: раскрывается кнопкой «Сменить пользователя» -->
                <Border x:Name="ProfileSwitchPanel" Visibility="Collapsed" Margin="0,14,0,0"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="8" Padding="4">
                    <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProfileSwitchList"/>
                    </ScrollViewer>
                </Border>

                <!-- Ошибка — в подвале слева от кнопок: окно подогнано по высоте и от неё не растёт. -->
                <Grid Style="{StaticResource DialogFooter}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource DialogError}" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Style="{StaticResource DialogSecondaryButton}"
                                Content="{DynamicResource S.Common.Cancel}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                        <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}"
                                Content="{DynamicResource S.Common.Continue}" Click="OkButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
