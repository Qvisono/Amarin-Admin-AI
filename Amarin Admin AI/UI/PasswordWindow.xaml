<Window x:Class="Amarin.UI.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Title="Amarin Admin AI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
                <!-- Палитра: в работе — ThemeManager, в конструкторе —
                     Properties/DesignTimeResources.xaml. -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Строка списка пользователей на экране входа -->
            <Style x:Key="ProfileRowButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow. -->
    <Grid Margin="24">
        <Border x:Name="Card" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="12" Padding="22,20"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="{DynamicResource S.Password.Prompt}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Body}"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Faint}"/>

                <Border x:Name="FirstFieldBorder" Margin="0,16,0,0" CornerRadius="6" Height="32"
                        Background="{DynamicResource Bg.Raised}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                    <PasswordBox x:Name="FirstBox" Background="Transparent" BorderThickness="0"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                 Foreground="{DynamicResource Text.Bright}"
                                 CaretBrush="{DynamicResource Text.Bright}"
                                 KeyDown="Box_KeyDown"/>
                </Border>

                <Border x:Name="SecondFieldBorder" Margin="0,8,0,0" CornerRadius="6" Height="32"
                        Visibility="Collapsed"
                        Background="{DynamicResource Bg.Raised}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                    <PasswordBox x:Name="SecondBox" Background="Transparent" BorderThickness="0"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                 Foreground="{DynamicResource Text.Bright}"
                                 CaretBrush="{DynamicResource Text.Bright}"
                                 KeyDown="Box_KeyDown"/>
                </Border>

                <TextBlock x:Name="ErrorText" FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource Status.Danger}"/>

                <!-- Список пользователей: раскрывается кнопкой «Сменить пользователя» -->
                <Border x:Name="ProfileSwitchPanel" Visibility="Collapsed" Margin="0,14,0,0"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="8" Padding="4">
                    <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProfileSwitchList"/>
                    </ScrollViewer>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Button x:Name="SwitchUserButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Style="{StaticResource DialogSecondaryButton}"
                            Content="{DynamicResource S.Password.SwitchUser}" Visibility="Collapsed"
                            Click="SwitchUserButton_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Style="{StaticResource DialogSecondaryButton}"
                                Content="{DynamicResource S.Common.Cancel}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                        <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}"
                                Content="{DynamicResource S.Common.Continue}" Click="OkButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
