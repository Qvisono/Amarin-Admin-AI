<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RootNamespace>Amarin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.31.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>jeklE-removebg-preview_1.ico</ApplicationIcon>
    <!-- API key: dotnet user-secrets set "VENICE_API_KEY" "..." -->
    <UserSecretsId>amarin-admin-ai-8f3c2a1b-4d5e-6f70-8192-a3b4c5d6e7f8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="jeklE-removebg-preview_1.ico" />
    <Resource Include="Fonts\*.ttf" />
    <!--
      Скриншоты гайда на странице Info. Маской, а не поимённо: картинки добавляют по мере
      того, как их снимают, и забытый Include означал бы молча пустое место на странице.
      GuideShot ищет файл в коде, поэтому отсутствие любого из них — не ошибка сборки.
    -->
    <Resource Include="Assets\Guide\*.png" />
  </ItemGroup>

  <!--
    Штатный крючок конструктора XAML: словарь с этими метаданными он подмешивает в ресурсы
    приложения, а работающая программа его не грузит. Без него окна в конструкторе белые —
    палитру подставляет ThemeManager, а его код там не выполняется. Update, а не Include:
    SDK и так забирает все *.xaml как Page, второй элемент был бы дубликатом.
  -->
  <ItemGroup>
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.4" />
    <!-- Распознавание речи на этом ПК (D14): распознаватели SAPI, что установлены в Windows. -->
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <!--
    Логика и инструменты — в Amarin.Core (сборка без WPF). Пакеты разборщика PowerShell, WMI и
    служб приходят оттуда, поэтому исключения ReadyToRun и чистка нативной части PowerShell ниже
    по-прежнему про них: публикуется приложение со всем, что ему досталось.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Amarin.Core\Amarin.Core.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    SMA и её зависимости не предкомпилируются: ReadyToRun почти удваивает их вес, а работает
    из них только разборщик, которому хватает JIT при первом вызове (~0,2 с один раз за запуск).
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishReadyToRunExclude Include="System.Management.Automation.dll" />
    <PublishReadyToRunExclude Include="Microsoft.PowerShell.CoreCLR.Eventing.dll" />
    <PublishReadyToRunExclude Include="Microsoft.ApplicationInsights.dll" />
    <PublishReadyToRunExclude Include="Newtonsoft.Json.dll" />
    <PublishReadyToRunExclude Include="System.DirectoryServices.dll" />
    <PublishReadyToRunExclude Include="System.CodeDom.dll" />
  </ItemGroup>

  <!--
    Нативная часть PowerShell (плагин удалённого доступа, манифесты сборки) разборщику не нужна,
    а публикация клала её рядом с exe двумя лишними файлами — релиз обязан быть одним exe.
  -->
  <Target Name="DropPowerShellNativeFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'Microsoft.PowerShell.Native'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Amarin.AdminAI.Tests" />
  </ItemGroup>

  <!--
    Неявные using WPF убраны намеренно: System.Windows.Shapes.Path сталкивается с System.IO.Path,
    который здесь нужен постоянно. Пространства имён WPF каждый файл подключает руками —
    удалять этот блок нельзя, сборка развалится.
  -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Remove="System.Windows" />
    <Using Remove="System.Windows.Controls" />
    <Using Remove="System.Windows.Data" />
    <Using Remove="System.Windows.Documents" />
    <Using Remove="System.Windows.Input" />
    <Using Remove="System.Windows.Media" />
    <Using Remove="System.Windows.Media.Imaging" />
    <Using Remove="System.Windows.Navigation" />
    <Using Remove="System.Windows.Shapes" />
  </ItemGroup>

</Project>