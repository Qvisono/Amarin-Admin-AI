# Правила анализаторов для всех проектов. Сборка идёт с -warnaserror, поэтому «warning» здесь —
# это ошибка сборки. Выбраны правила, которые ловят ошибки и лишнюю работу, а не вкус: что
# включено и почему не включено остальное — в HANDOFF-1.30.md («Анализаторы»).
root = true

[*.cs]

# ── Производительность ─────────────────────────────────────────────────────────────────────
# Запечатать internal-типы. По умолчанию правило молчит в сборках с InternalsVisibleTo, а такие
# здесь все: тестам видны internal-типы, но наследоваться от них тестам незачем.
dotnet_code_quality.CA1852.ignore_internalsvisibleto = true
dotnet_diagnostic.CA1852.severity = warning
# «Сделать статическим» — только для закрытых членов: публичный экземплярный метод, ставший
# статическим, ломает всех, кто зовёт его через экземпляр.
dotnet_code_quality.CA1822.api_surface = private, internal
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1802.severity = warning
dotnet_diagnostic.CA1825.severity = warning
dotnet_diagnostic.CA1826.severity = warning
dotnet_diagnostic.CA1827.severity = warning
dotnet_diagnostic.CA1828.severity = warning
