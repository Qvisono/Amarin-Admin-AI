dotnet_diagnostic.CA2265.severity = warning

# ── Стиль, который ловит ошибки ────────────────────────────────────────────────────────────
# Фигурные скобки всегда: строка, дописанная под if без скобок, молча выпадает из условия.
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
# Неиспользуемые закрытые члены. В окнах выключено ниже: обработчики, которые разметка
# подключает по имени, анализатор считает мёртвыми.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0062.severity = warning
dotnet_diagnostic.IDE0063.severity = warning
dotnet_diagnostic.IDE0066.severity = warning
dotnet_diagnostic.IDE0071.severity = warning
dotnet_diagnostic.IDE0074.severity = warning
