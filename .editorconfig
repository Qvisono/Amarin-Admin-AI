dotnet_diagnostic.IDE0250.severity = warning
dotnet_diagnostic.IDE0251.severity = warning
dotnet_diagnostic.IDE0270.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning

# ── Окна: обработчики из разметки ──────────────────────────────────────────────────────────
[Amarin Admin AI/UI/**.cs]
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0052.severity = none

# ── Тесты ──────────────────────────────────────────────────────────────────────────────────
# Помощники тестов читаются лучше экземплярными, а массив-литерал в аргументе теста — это
# данные проверки, а не горячий путь.
[Amarin.AdminAI.Tests/**.cs]
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1861.severity = none

# ── Замороженные зоны 1.30.0 ───────────────────────────────────────────────────────────────
# Инструменты и их шлюз, прокрутка, лупа: их по заданию не переписывают, и правка ради
# анализатора — тоже правка. Правила выключены для этих файлов поимённо (настройка категории
# поимённую не перебивает), а не подавлены в коде.
[{Amarin.Core/Tools/**.cs,Amarin.Core/Security/ToolGate.cs,Amarin Admin AI/UI/SmoothScroll.cs,Amarin Admin AI/UI/ChatZoom*.cs,Amarin Admin AI/UI/MainWindow.ChatZoom.cs,Amarin Admin AI/UI/PanZoom.cs,Amarin Admin AI/UI/MainWindow.ScrollJump.cs}]
